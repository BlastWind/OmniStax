 "concepts": [
  {
   "id": "induction",
   "kind": "axiom",
   "section": "23.1",
   "name": "电磁感应",
   "terms": [
    "电磁感应",
    "电磁感应"
   ],
   "statement": "法拉第闭合开关，第二个线圈上的电流计指针随之摆动。他断开开关，指针朝相反方向摆动。开关保持闭合期间，铁环中的电流稳定、磁场也稳定，指针停在零位。产生电动势的是磁场的变化，而不是磁场本身，读者若从本章只带走一件事，就应当带走这一点。用条形磁铁做同样的实验，也说明了同一件事：磁体运动得越快，电动势越大，而静止在线圈内的磁体则完全不产生电动势。"
  },
  {
   "id": "magnetic-flux",
   "kind": "definition",
   "section": "23.1",
   "name": "磁通量",
   "symbol": "Φ",
   "terms": [
    "磁通量"
   ],
   "type": "magnetic-flux",
   "statement": "通过一块面积的磁通量等于磁感应强度乘以面积，再乘以磁场与该面积法线之间夹角的余弦，即 $\\Phi = BA\\cos\\theta$，其单位是 $\\text{T}\\cdot\\text{m}^2$。大线圈比小线圈聚拢更多的磁场，而边缘朝向磁场的线圈则一点也聚拢不到。本章中每一个感应电动势，都是这一个量的变化率。",
   "forms": [
    {
     "id": "eq-magnetic-flux",
     "latex": "\\Phi = BA\\cos\\theta",
     "ktex": "\\kPhi = \\kBmag A\\cos\\theta",
     "anchor": "23.1-flux-defined"
    }
   ]
  },
  {
   "id": "flux-and-orientation",
   "kind": "result",
   "section": "23.1",
   "name": "磁通量与取向",
   "statement": "由于 $B\\cos\\theta$ 是磁场沿该面积法线方向的分量，磁通量也就是面积乘以笔直穿过它的那部分磁场。这种形式使棘手的情形一目了然：位于线圈平面内的磁场没有垂直分量，无论多强，都没有磁通量穿过线圈。心里有了这种形式，你就不必再去判断角度应当放在余弦里还是正弦里。",
   "forms": [
    {
     "id": "eq-flux-perpendicular",
     "latex": "\\Phi = B_{\\perp}A",
     "ktex": "\\kPhi = \\kBmag_{\\perp}A",
     "anchor": "23.1-flux-defined"
    }
   ]
  },
  {
   "id": "ways-to-change-flux",
   "kind": "skill",
   "section": "23.1",
   "name": "识别磁通量如何变化",
   "statement": "由于磁通量是磁场、面积和余弦三者的乘积，改变它恰好有三种方式，而本章中产生电动势的每一种方法都是其中之一。法拉第通过接通和断开线圈来改变磁场；拿条形磁铁的实验者通过移动磁体来改变线圈处的磁场；发电机通过转动线圈来改变角度；而下一节中在导轨上滑动的杆则改变了面积。把一个新情形归入这三种之一，是本章每道习题的第一步。"
  },
  {
   "id": "faradays-law",
   "kind": "axiom",
   "section": "23.2",
   "name": "法拉第电磁感应定律",
   "terms": [
    "法拉第电磁感应定律"
   ],
   "statement": "法拉第的实验表明，感应电动势只取决于很少几样东西。它与磁通量的变化成正比，变化发生得越快，电动势越大，并且与线圈的匝数成正比。这三个事实合在一起就是一个方程，本章其余部分都建立在它之上。其单位是伏特，这是必然的，因为电动势是一种电势差。",
   "forms": [
    {
     "id": "eq-faradays-law",
     "latex": "\\text{emf} = -N\\frac{\\Delta\\Phi}{\\Delta t}",
     "ktex": "\\kemf = -N\\frac{\\kdPhi}{\\kdt}",
     "anchor": "23.2-faradays-and-lenzs-law"
    }
   ]
  },
  {
   "id": "turns-multiply-emf",
   "kind": "result",
   "section": "23.2",
   "name": "N 匝线圈的电动势",
   "statement": "线圈的每一匝都围住同一变化的磁通量，并贡献它自己的电动势，又因为各匝首尾相连，这些电动势相加。这就是实际应用中的电磁感应使用线圈而不是单个线圈环的原因。例题中的单个线圈环得到 22.6 mV，书中称之为容易测量，但还不足以派上用场，而同样的导线绕一千匝，就能达到伏特的量级。"
  },
  {
   "id": "lenzs-law",
   "kind": "axiom",
   "section": "23.2",
   "name": "楞次定律",
   "terms": [
    "楞次定律"
   ],
   "statement": "法拉第定律中的负号不是记账用的。感应电动势驱动的电流，其自身的磁场会反抗产生它的磁通量变化。把北极推向线圈，线圈就升起一个北极来迎接它；把磁体拉开，线圈就升起一个南极来挽留它。方向与大小同样是物理的一部分，而这个符号是本章中唯一不能靠代入得到的部分。"
  },
  {
   "id": "lenz-from-energy-conservation",
   "kind": "idea",
   "section": "23.2",
   "name": "楞次定律与能量守恒",
   "statement": "磁通量的变化就是能量的变化，能量可以进入或离开一个系统，但不能瞬间完成。如果感应电动势的方向相反，它就会加强产生它的那个变化，这一变化会自我助长，凭空给出没有任何来源的能量。因此楞次定律不是法拉第定律之外另需记忆的规则：它是该定律唯一可能有的符号，明白这一点的读者永远不会把它写反。"
  },
  {
   "id": "apply-lenzs-law",
   "kind": "skill",
   "section": "23.2",
   "name": "确定感应电流的方向",
   "statement": "要把方向弄对，需要遵循固定的步骤顺序，因为同时有三个右手定则和两个磁场在起作用：画出情形的草图，找出磁场的方向，判断磁通量是在增大还是在减小，让感应磁场取反抗这一变化的方向，用右手定则 2 找出能产生这种磁场的电流，再由电流读出电动势的极性。本章中每一个方向问题，以及涡流那一整节，都是把这个序列运行一遍。"
  },
  {
   "id": "induction-applications",
   "kind": "idea",
   "section": "23.2",
   "name": "电磁感应的应用",
   "statement": "电磁感应把变化的磁图样重新变回变化的电压，这就是磁记录的全部。磁带或硬盘带有朝一个方向或另一个方向磁化的区域，线圈从它们上方经过时，其中感应出的电动势重现了信号。同样的想法还能把信号传过导线无法穿越的屏障，例如人工耳蜗。它还能报告身体中的变化，例如呼吸暂停监测仪，其线圈的面积随婴儿胸部的起伏而变化。"
  },
  {
   "id": "motional-emf",
   "kind": "result",
   "section": "23.3",
   "name": "动生电动势",
   "statement": "当长度为 $\\ell$ 的导体以速率 $v$ 横穿磁场 $B$，且三者互相垂直时，导体上出现大小为 $B\\ell v$ 的电动势。这与上一章中霍尔效应给出的表达式相同，而这正是要点所在：霍尔效应原来是电磁感应的一种情形，而不是一种单独的现象。它也是本章中第一个可以反过来使用的结果，即由电压来测量磁场或速率。",
   "forms": [
    {
     "id": "eq-motional-emf",
     "latex": "\\text{emf} = B\\ell v",
     "ktex": "\\kemf = \\kBmag\\ell\\kv",
     "anchor": "23.3-rod-on-rails"
    }
   ]
  },
  {
   "id": "motional-emf-from-faradays-law",
   "kind": "skill",
   "section": "23.3",
   "name": "由法拉第电磁感应定律得出动生电动势",
   "statement": "这一推导很短，值得跟着做一遍，因为它表明动生电动势不是一条新定律。杆、导轨和电阻器围成的面积随杆的运动而增大；磁场垂直于该面积，所以 $\\Delta\\Phi = B\\Delta A = B\\ell\\Delta x$；除以 $\\Delta t$，$\\Delta x/\\Delta t$ 就是速率。能够走完这一论证的读者，也能处理公式所不涵盖的情形，例如与磁场不垂直的导体。",
   "forms": [
    {
     "id": "eq-swept-area",
     "latex": "\\Delta\\Phi = B\\Delta A = B\\ell\\Delta x",
     "ktex": "\\kdPhi = \\kBmag\\Delta A = \\kBmag\\ell\\kdx",
     "anchor": "23.3-rod-on-rails"
    }
   ]
  },
  {
   "id": "relative-motion-induces",
   "kind": "idea",
   "section": "23.3",
   "name": "只有相对运动才起作用",
   "statement": "杆可以运动而磁场静止，磁场也可以运动而杆静止，电动势是一样的。运动的磁场通过它所感应的电动势产生电场，正如运动的电荷产生磁场一样，这也是如今把电力和磁力看作同一种力的两个面、而不是两种力的原因之一。"
  },
  {
   "id": "motional-emf-power-conversion",
   "kind": "idea",
   "section": "23.3",
   "name": "动生电动势的能量转换",
   "statement": "凡感应电动势驱动电流之处，作用在该电流上的磁力都反抗运动，克服它所做的功提供了电能。绳系卫星实验就是这种情形的大规模演示。一条 20 km 长的缆绳以轨道速率穿过地球磁场，在电离层使回路闭合的情况下，本应产生 5 kV 的电动势，电流所受的阻力会从航天飞机自身的动能和势能中汲取能量。同样的核算也解释了为什么发电机在输出功率时很难转动。"
  },
  {
   "id": "eddy-current",
   "kind": "definition",
   "section": "23.4",
   "name": "涡流",
   "terms": [
    "涡流"
   ],
   "statement": "导体不必是导线，电磁感应也能驱动电流流过它。当一块实心金属穿过变化的磁通量时，感应电动势会驱动电流在金属内部形成闭合回路。这些回路就是涡流。它们是没有画出电路的电磁感应，也是金属板在同一实验中的表现与塑料板如此不同的原因。"
  },
  {
   "id": "magnetic-damping",
   "kind": "result",
   "section": "23.4",
   "name": "磁阻尼",
   "terms": [
    "磁阻尼"
   ],
   "statement": "穿过磁场的板中的涡流是磁场中的电流，因此受到磁力，而由楞次定律，这个力反抗产生它的运动。在磁体两极之间摆动的金属摆锤很快就会静止，而绝缘的摆锤则不受影响地继续摆动。这种阻力有两个特点值得注意。它在进入时和离开时都起作用，因为磁通量在一种情形中增大，在另一种情形中减小。它还与速率成正比，所以运动一停止它就消失，这正是灵敏仪器所需要的。"
  },
  {
   "id": "slotting-reduces-eddy-currents",
   "kind": "result",
   "section": "23.4",
   "name": "减小涡流",
   "statement": "电流在必须折返之前能走多远，决定了涡流回路的大小。在板上开槽，或用被绝缘隔开的薄层构成板，就把一个大回路拆成许多小回路。相邻的小回路中电流方向相反，它们的力几乎完全抵消。这就是开槽的摆锤几乎不减速的原因，也是变压器铁芯是叠片的而不是实心的原因，本章后面的一节会说明这一点。"
  },
  {
   "id": "applications-of-magnetic-damping",
   "kind": "idea",
   "section": "23.4",
   "name": "磁阻尼的应用",
   "statement": "磁阻尼在通常的意义上没有摩擦，并且随运动一同消失，所以仪器在必须迅速稳定下来然后保持不动的地方都使用它：实验室天平用一个在固定磁场中转动的圆盘来阻尼自身的振动。它只作用于导体，所以能把导体分拣出来：沿斜面滑过强磁体的垃圾，金属会被留下。附近的导体会改变线圈中的感应，所以能被探测到，手持金属探测器和机场安检门就是这样。过山车的制动用同样的阻力把能量从运动的车辆中取出，而在电磁炉中，加热的则是涡流本身。"
  },
  {
   "id": "electric-generator",
   "kind": "definition",
   "section": "23.5",
   "name": "发电机",
   "terms": [
    "发电机"
   ],
   "statement": "发电机是在磁场中转动的线圈，带有滑环和电刷把感应电动势引出。转动线圈改变了磁场与线圈法线之间的夹角，所以通过线圈的磁通量发生变化，由法拉第定律就出现电动势。发电机与上一章的电动机是同一种机器，只不过转轴由手转动，而不是由电流驱动。"
  },
  {
   "id": "average-emf-of-a-generator",
   "kind": "skill",
   "section": "23.5",
   "name": "求发电机的平均电动势",
   "statement": "在讨论完整的时间依赖关系之前，书中先做了简单的情形：把线圈从磁通量最大的位置转到磁通量为零的位置，由法拉第定律，这四分之一转内的平均电动势为 $NAB/\\Delta t$，因为磁通量的变化恰好是 $AB$。例题中 200 匝、5.00 cm 的线圈在 15.0 ms 内给出 131 V，接近家用电压，这说明普通大小的发电机是一种实用的电源。"
  },
  {
   "id": "generator-emf-versus-time",
   "kind": "result",
   "section": "23.5",
   "name": "发电机的电动势",
   "terms": [
    "发电机线圈中感应的电动势"
   ],
   "statement": "平均电动势掩盖了你最想知道的东西，即每一时刻的电动势。取矩形线圈两条侧边导线上的动生电动势，每条都与磁场成角 $\\theta$ 运动，并对以恒定角速度转动的线圈写出 $\\theta = \\omega t$。于是电动势按 $\\sin\\omega t$ 变化。第 20 章中的正弦交流电压就来源于此：它不是一种约定，而是转动线圈产生的形状。",
   "forms": [
    {
     "id": "eq-generator-emf",
     "latex": "\\text{emf} = NAB\\omega\\sin\\omega t",
