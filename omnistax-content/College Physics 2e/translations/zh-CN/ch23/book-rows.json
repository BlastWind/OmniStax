     "anchor": "23.5-the-emf-at-each-instant"
    },
    {
     "id": "eq-two-side-emf",
     "latex": "\\text{emf} = 2B\\ell v\\sin\\theta",
     "ktex": "\\kemf = 2\\kBmag\\ell\\kv\\sin\\theta",
     "anchor": "23.5-the-emf-at-each-instant"
    },
    {
     "id": "eq-generator-emf-peak-form",
     "latex": "\\text{emf} = \\text{emf}_0\\sin\\omega t",
