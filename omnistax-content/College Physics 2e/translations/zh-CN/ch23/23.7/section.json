 "derivations": [
  {
   "id": "transformer-equation",
   "what": "变压器方程",
   "source": "《大学物理（第2版）》，23.7 变压器",
   "nodes": [
    {
     "assumes": [
      {
       "text": "线圈电阻很小，所以输出电压等于感应电动势，$\\kVsec = {\\text{emf}}_{\\text{s}}$。",
       "src": "23.7"
      },
      {
       "text": "线圈电阻可以忽略时，由基尔霍夫回路定则，原线圈中感应的电动势恰好等于输入电压，并且由楞次定律，它反抗磁通量的变化。",
       "src": "23.7"
      },
      {
       "tex": "\\kVprim = -N_{\\text{p}}\\dfrac{\\kdPhi}{\\kdt}",
       "src": "23.7"
      },
      {
       "text": "两侧线圈的横截面积和磁感应强度相同，所以两侧的 $\\kdPhi/\\kdt$ 相同。",
       "src": "23.7"
      }
     ],
     "then": {
      "tex": "\\mk{V}{\\kVsec} = -\\mk{N}{N_{\\text{s}}}\\mk{P}{\\dfrac{\\kdPhi}{\\kdt}}",
      "src": "23.2",
      "uses": [
       0
      ],
      "why": "副线圈的法拉第电磁感应定律。"
     },
     "steps": [
      {
       "tex": "\\dfrac{\\mk{V}{\\kVsec}}{\\mk{Vp}{\\kVprim}} = \\dfrac{-\\mk{N}{N_{\\text{s}}}\\mk{P}{\\dfrac{\\kdPhi}{\\kdt}}}{-\\mk{Np}{N_{\\text{p}}}\\mk{Pp}{\\dfrac{\\kdPhi}{\\kdt}}}",
       "uses": [
        1,
        2,
        3
       ]
      },
      {
       "tex": "\\dfrac{\\mk{V}{\\kVsec}}{\\mk{Vp}{\\kVprim}} = \\dfrac{\\mk{N}{N_{\\text{s}}}}{\\mk{Np}{N_{\\text{p}}}}",
       "uses": []
      }
     ],
     "src": "23.7"
    }
   ]
  },
  {
   "id": "transformer-currents",
   "what": "变压器的电流之比",
   "source": "《大学物理（第2版）》，23.7 变压器",
   "nodes": [
    {
     "assumes": [
      {
       "text": "电阻可以忽略时，变压器输出的电功率等于其输入。",
       "src": "23.7"
      },
      {
       "tex": "\\kP = \\kIcur\\kV",
       "src": "20.4"
      },
      {
       "tex": "\\dfrac{\\kVsec}{\\kVprim} = \\dfrac{N_{\\text{s}}}{N_{\\text{p}}}",
       "src": "23.7"
      }
     ],
     "then": {
      "tex": "\\mk{Pp}{\\kPprim} = \\mk{Ps}{\\kPsec}",
      "src": "23.7",
      "uses": [
       0
      ]
     },
     "steps": [
      {
       "tex": "\\mk{Pp}{\\kPprim} = \\mk{IpVp}{\\kIprim\\kVprim} = \\mk{IsVs}{\\kIsec\\kVsec} = \\mk{Ps}{\\kPsec}",
       "uses": [
        1
       ]
      },
      {
       "tex": "\\dfrac{\\mk{Vs}{\\kVsec}}{\\mk{Vp}{\\kVprim}} = \\dfrac{\\mk{Ip}{\\kIprim}}{\\mk{Is}{\\kIsec}}",
       "uses": [],
       "map": {
        "IpVp": [
         "Ip",
         "Vp"
        ],
        "IsVs": [
         "Is",
         "Vs"
        ]
       }
      },
      {
       "tex": "\\mk{Vs}{\\dfrac{N_{\\text{s}}}{N_{\\text{p}}}} = \\dfrac{\\mk{Ip}{\\kIprim}}{\\mk{Is}{\\kIsec}}",
       "uses": [
        2
       ],
       "map": {
        "Vp": "Vs"
       }
      },
      {
       "tex": "\\dfrac{\\mk{Is}{\\kIsec}}{\\mk{Ip}{\\kIprim}} = \\mk{Vs}{\\dfrac{N_{\\text{p}}}{N_{\\text{s}}}}",
       "uses": []
      }
     ],
     "src": "23.7"
    }
   ]
  }
 ]
