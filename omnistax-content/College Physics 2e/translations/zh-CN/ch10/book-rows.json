 "concepts": [
  {
   "id": "nonuniform-circular-motion",
   "kind": "definition",
   "section": "10.1",
   "name": "变速圆周运动",
   "statement": "变速圆周运动是角速度发生变化的圆周运动，例如孩子从静止开始推动的旋转木马，或是逐渐慢下来直至停止的硬盘。"
  },
  {
   "id": "angular-acceleration",
   "kind": "definition",
   "section": "10.1",
   "name": "角加速度",
   "symbol": "α",
   "terms": [
    "角加速度"
   ],
   "type": "angular-acceleration",
   "statement": "角加速度是角速度的变化率，$\\alpha = \\Delta\\omega / \\Delta t$，这与线加速度是速度的变化率完全一样。它的单位是弧度每二次方秒，角速度变化得越快，角加速度就越大。",
   "forms": [
    {
     "id": "eq-angular-acceleration",
     "latex": "\\alpha = \\frac{\\Delta\\omega}{\\Delta t}",
     "ktex": "\\kalpha = \\frac{\\kdw}{\\kdt}",
     "anchor": "10.1-angular-acceleration"
    }
   ]
  },
  {
   "id": "tangential-acceleration",
   "kind": "definition",
   "section": "10.1",
   "name": "切向加速度",
   "symbol": "a_t",
   "terms": [
    "切向加速度"
   ],
   "type": "acceleration",
   "statement": "在圆周运动中，改变一个点的速率的线加速度沿圆的切线方向，所以我们称之为切向加速度。与直线运动中一样，它是速度大小的变化量除以所用的时间，说明边缘上的点沿其路径加快或减慢得有多快。",
   "forms": [
    {
     "id": "eq-tangential-acceleration",
     "latex": "a_{\\text{t}} = \\frac{\\Delta v}{\\Delta t}",
     "ktex": "\\kat = \\frac{\\kdv}{\\kdt}",
     "anchor": "10.1-tangential-acceleration"
    }
   ]
  },
  {
   "id": "tangential-and-centripetal-are-independent",
   "kind": "result",
   "section": "10.1",
   "name": "切向加速度与向心加速度的相互独立",
   "statement": "向心加速度改变速度的方向而不改变其大小，切向加速度改变速度的大小而不改变其方向。两者相互垂直，所以做圆周运动的物体可以只有其中一个、两个都有或两个都没有，而且每一个都可以单独考虑。"
  },
  {
   "id": "tangential-angular-acceleration",
   "kind": "result",
   "section": "10.1",
   "name": "切向加速度与角加速度",
   "statement": "因为圆周运动中半径不变，线速度的变化量等于半径乘以角速度的变化量，所以切向加速度等于半径乘以角加速度。角加速度越大，切向加速度就越大；对于相同的角加速度，车轮越小，它给出的切向加速度就越小。",
   "forms": [
    {
     "id": "eq-tangential-from-angular",
     "latex": "a_{\\text{t}} = r\\alpha",
     "ktex": "\\kat = \\kr\\kalpha",
     "anchor": "10.1-linear-angular"
    },
    {
     "id": "eq-angular-from-tangential",
     "latex": "\\alpha = \\frac{a_{\\text{t}}}{r}",
     "ktex": "\\kalpha = \\frac{\\kat}{\\kr}",
     "anchor": "10.1-linear-angular"
    }
   ]
  },
  {
   "id": "rotational-translational-analogy",
   "kind": "idea",
   "section": "10.1",
   "name": "转动与平动的类比",
   "statement": "转角、角速度和角加速度分别是位置、速度和加速度在转动中的对应量，而半径把每一对联系起来。转角是距离除以半径，角速度是速度除以半径，角加速度是切向加速度除以半径。有了这一类比，你学过的关于直线运动的一切都可以移到转动上来。"
  },
  {
   "id": "change-in-angular-velocity",
   "kind": "definition",
   "section": "10.1",
   "name": "角速度的变化量",
   "symbol": "Δω",
   "terms": [
    "角速度的变化量"
   ],
   "type": "angular-rate",
   "statement": "角速度的变化量是角速度的末值与初值之差。"
  },
  {
   "id": "rotational-kinematic-equations",
   "kind": "result",
   "section": "10.2",
   "name": "转动运动学方程",
   "statement": "把 $v = r\\omega$ 和 $a = r\\alpha$ 代入直线运动的四个运动学方程中的每一个，半径就会消去，留下关于转角、角速度、角加速度和时间的四个方程。它们描述运动时不涉及产生运动的任何力或质量，并且只要角加速度恒定就成立。",
   "forms": [
    {
     "id": "eq-omega-from-alpha-t",
     "latex": "\\omega = \\omega_0 + \\alpha t",
     "ktex": "\\kw = \\kwo + \\kalpha\\kt",
     "condition": "恒定角加速度",
     "anchor": "10.2-rotational-kinematics"
    },
    {
     "id": "eq-theta-quadratic",
     "latex": "\\theta = \\omega_0 t + \\frac{1}{2}\\alpha t^2",
     "ktex": "\\theta = \\kwo\\kt + \\frac{1}{2}\\kalpha\\kt^2",
     "condition": "恒定角加速度",
     "anchor": "10.2-four-equations"
    },
    {
     "id": "eq-omega-squared",
     "latex": "\\omega^2 = {\\omega_0}^2 + 2\\alpha\\theta",
     "ktex": "\\kw^2 = {\\kwo}^2 + 2\\kalpha\\theta",
     "condition": "恒定角加速度",
     "anchor": "10.2-four-equations"
    }
   ]
  },
  {
   "id": "average-angular-velocity",
   "kind": "result",
   "section": "10.2",
   "name": "平均角速度",
   "statement": "当角加速度恒定时，平均角速度处在初值与末值的正中间，就像直线运动中平均速度处在初速度与末速度的正中间一样。于是转过的角度就简单地等于平均角速度乘以时间。",
   "forms": [
    {
     "id": "eq-theta-from-average",
     "latex": "\\theta = \\bar{\\omega}t",
     "ktex": "\\theta = \\kwb\\kt",
     "anchor": "10.2-four-equations"
    },
    {
     "id": "eq-average-angular-velocity",
     "latex": "\\bar{\\omega} = \\frac{\\omega_0 + \\omega}{2}",
     "ktex": "\\kwb = \\frac{\\kwo + \\kw}{2}",
     "anchor": "10.2-four-equations"
    }
   ]
  },
  {
   "id": "linear-from-angular",
   "kind": "result",
   "section": "10.2",
   "name": "由角量求线量",
   "statement": "原地旋转的物体仍然会使它的边缘经过一段距离，这段距离是半径乘以转过的角度（以弧度计）。同样，边缘上一点的速率是半径乘以角速度。这些关系中必须始终使用弧度，而且因为弧度是无量纲的，长度与角度的乘积仍是长度。",
   "forms": [
    {
     "id": "eq-distance-from-angle",
     "latex": "\\theta = \\frac{x}{r} \\quad\\text{或}\\quad x = r\\theta",
     "ktex": "\\theta = \\frac{\\kx}{\\kr} \\quad\\text{或}\\quad \\kx = \\kr\\theta",
     "anchor": "10.2-ex-train"
    }
   ]
  },
  {
   "id": "rotational-kinematics-strategy",
   "kind": "skill",
   "section": "10.2",
   "name": "求解转动运动学问题",
   "statement": "求解转动运动学问题，与求解直线运动问题的方法一样。检查它是否涉及转动且不需要力或质量，确定未知量，并列出已知量。选择含有未知量而别无其他未知量的方程，代入带单位的数值，并问一问答案是否合理。想一想平动中的类比量会有帮助，因为那种运动已经很熟悉了。"
  },
  {
   "id": "kinematics-of-rotational-motion",
   "kind": "definition",
   "section": "10.2",
   "name": "转动运动学",
   "terms": [
    "转动运动学"
   ],
   "statement": "转动运动学描述转角、角速度、角加速度和时间之间的关系，而不考虑引起转动的力和质量。"
  },
  {
   "id": "torque-on-a-point-mass",
   "kind": "result",
   "section": "10.3",
   "name": "质点所受的力矩",
   "statement": "垂直于半径施加的力使质点获得加速度 $a = F/m$，又因 $a = r\\alpha$，这就是 $F = mr\\alpha$。两边同乘半径，左边就变成力矩，结果就是单个质点的牛顿第二定律的转动类比，其中 $mr^2$ 所处的位置正是 $F = ma$ 中质量所处的位置。",
   "forms": [
    {
     "id": "eq-torque-on-point-mass",
     "latex": "\\tau = mr^2\\alpha",
     "ktex": "\\ktau = mr^2\\kalpha",
     "anchor": "10.3-point-mass"
    },
    {
     "id": "eq-force-on-point-mass",
     "latex": "F = mr\\alpha",
     "ktex": "\\kF = mr\\kalpha",
     "anchor": "10.3-point-mass"
    }
   ]
  },
  {
   "id": "moment-of-inertia",
   "kind": "definition",
   "section": "10.3",
   "name": "转动惯量",
   "symbol": "I",
   "terms": [
    "转动惯量",
    "转动惯量"
   ],
   "type": "rotational-inertia",
   "statement": "要使质点以外的任何物体转动，就把 $mr^2$ 的概念推广到整个物体：转动惯量是组成该物体的所有质点的 $mr^2$ 之和。它在转动中所起的作用，就是质量在直线运动中所起的作用，它的单位是千克二次方米。因为它含有到转轴的距离，所以同一个物体绕每一根转轴都有不同的转动惯量。",
   "forms": [
    {
     "id": "eq-moment-of-inertia",
     "latex": "I = \\sum mr^2",
     "ktex": "\\kI = \\sum mr^2",
     "anchor": "10.3-moment-of-inertia"
    }
   ]
  },
  {
   "id": "mass-distribution-and-inertia",
   "kind": "idea",
   "section": "10.3",
   "name": "质量分布与转动惯量",
   "statement": "转动惯量不仅取决于物体有多少质量，还取决于这些质量相对于转轴处在什么位置。载满孩子的旋转木马，当孩子们站在靠近转轴的地方时，要比他们都站在边缘时容易加速得多，尽管质量是一样的。到转轴的距离在求和的每一项中都是平方出现的。"
  },
  {
   "id": "newtons-second-law-rotation",
   "kind": "result",
   "section": "10.3",
   "name": "转动的牛顿第二定律",
   "statement": "力矩、转动惯量和角加速度之间的一般关系是：合力矩等于转动惯量乘以角加速度。力矩越大，角加速度越大；转动惯量越大，角加速度越小。这一关系对任何力矩、作用于任何物体、绕任何转轴都成立，这使它成为牛顿第二定律的转动形式。",
   "forms": [
    {
     "id": "eq-second-law-rotation",
     "latex": "\\text{合力矩}\\;\\tau = I\\alpha",
     "ktex": "\\text{合力矩}\\;\\ktau = \\kI\\kalpha",
     "anchor": "10.3-second-law-rotation"
    },
    {
     "id": "eq-angular-acceleration-from-torque",
     "latex": "\\alpha = \\frac{\\text{合力矩}\\;\\tau}{I}",
     "ktex": "\\kalpha = \\frac{\\text{合力矩}\\;\\ktau}{\\kI}",
     "anchor": "10.3-second-law-rotation"
    }
   ]
  },
  {
   "id": "choosing-a-moment-of-inertia",
   "kind": "skill",
   "section": "10.3",
   "name": "选取转动惯量",
   "statement": "用积分计算转动惯量超出了本书的范围，所以要根据手头的物体和转轴，从各种形状的表中查出：绕自身轴的细圆环、圆盘、绕端点或绕中心的杆、球。当几个物体绕同一根转轴转动时，它们的转动惯量相加，因为每一个都是绕同一转轴的 $mr^2$ 之和。"
  },
  {
   "id": "rotational-dynamics-strategy",
   "kind": "skill",
   "section": "10.3",
   "name": "求解转动动力学问题",
   "statement": "要建立转动动力学问题，先检查它是否涉及力矩和质量，并选择所研究的系统。画出作用在它上面的外力的受力图，并绕转动点应用牛顿第二定律的转动形式。要留意哪个转动惯量属于该物体，以及你是绕哪根转轴取力矩的。和往常一样，要检查答案是否合理。"
  },
  {
   "id": "rotational-work",
   "kind": "result",
   "section": "10.4",
   "name": "力矩的功",
   "statement": "当合力始终垂直于转动圆盘的半径时，力与位移平行，合外力的功等于力乘以所经过的弧长。乘以并除以半径，力就变成力矩，弧长就变成角度，于是合外力的功等于合力矩乘以转过的角度。在这里，力矩与力相类似，角度与距离相类似。",
   "forms": [
    {
     "id": "eq-rotational-work",
     "latex": "\\text{合外力的功}\\;W = (\\text{合力矩}\\;\\tau)\\theta",
     "ktex": "\\text{合外力的功}\\;\\kW = (\\text{合力矩}\\;\\ktau)\\theta",
     "anchor": "10.4-rotational-work"
    }
   ]
  },
  {
   "id": "rotational-kinetic-energy",
   "kind": "result",
   "section": "10.4",
   "name": "转动动能",
   "symbol": "KE_rot",
   "terms": [
    "转动动能"
   ],
   "type": "energy",
   "statement": "物体既可以因平动而具有动能，也可以因转动而具有动能，转动动能等于转动惯量乘以角速度的平方的一半。这个表达式与平动动能的表达式完全类似，转动惯量所处的位置是质量所处的位置，角速度所处的位置是速度所处的位置。",
   "forms": [
    {
     "id": "eq-rotational-kinetic-energy",
     "latex": "\\text{KE}_{\\text{rot}} = \\frac{1}{2}I\\omega^2",
     "ktex": "\\kKErot = \\frac{1}{2}\\kI\\kw^2",
     "anchor": "10.4-rotational-kinetic-energy"
    }
   ]
  },
  {
   "id": "rotational-work-energy-theorem",
   "kind": "result",
   "section": "10.4",
   "name": "转动的动能定理",
   "terms": [
    "动能定理"
   ],
   "statement": "把牛顿第二定律的转动形式代入力矩的功的表达式，再利用角速度与角度之间的运动学关系，就得到合外力的功等于二分之一转动惯量乘以角速度的平方的变化量。合外力的功改变系统的动能，对转动的物体来说，这个动能就是转动动能。",
   "forms": [
    {
     "id": "eq-rotational-work-energy-theorem",
     "latex": "\\text{合外力的功}\\;W = \\frac{1}{2}I\\omega^2 - \\frac{1}{2}I{\\omega_0}^2",
     "ktex": "\\text{合外力的功}\\;\\kW = \\frac{1}{2}\\kI\\kw^2 - \\frac{1}{2}\\kI{\\kwo}^2",
     "anchor": "10.4-rotational-kinetic-energy"
    }
   ]
  },
  {
   "id": "rolling-splits-the-energy",
   "kind": "result",
   "section": "10.4",
   "name": "滚动物体的能量",
   "statement": "沿斜面不打滑地滚下的物体，会把它的重力势能同时转化为两种动能，即平动动能和转动动能。它的转动惯量越大，用于转动的能量就越多，剩下用来带它下斜坡的就越少。因此，内容物随罐一起转动的一罐浓汤，会输给一罐稀汤，而一个只滑动不滚动的罐子则会赢。",
   "forms": [
    {
     "id": "eq-energy-of-a-rolling-body",
     "latex": "\\text{PE}_{\\text{grav}} = \\text{KE}_{\\text{trans}} + \\text{KE}_{\\text{rot}}",
     "ktex": "\\kPEgrav = \\kKEtrans + \\kKErot",
     "anchor": "10.4-rolling"
    },
    {
     "id": "eq-rolling-down-an-incline",
     "latex": "mgh = \\frac{1}{2}mv^2 + \\frac{1}{2}I\\omega^2",
     "ktex": "m\\kg\\kh = \\frac{1}{2}m\\kv^2 + \\frac{1}{2}\\kI\\kw^2",
     "anchor": "10.4-rolling"
    }
   ]
  },
  {
   "id": "rotational-energy-strategy",
   "kind": "skill",
   "section": "10.4",
   "name": "求解转动能问题",
   "statement": "求解涉及转动的能量问题，与求解其他能量问题的方法一样。检查是否涉及功或能量，选择系统，并判断存在哪几种功和能量。对于封闭系统，令初动能与初势能之和等于末动能与末势能之和，同时记住动能可能既有平动部分也有转动部分。对于开放系统，还要考虑其他形式的能量。"
  },
