     },
     "steps": [
      {
       "tex": "\\mk{f}{\\kfobs} = \\frac{\\mk{c}{\\kc}}{\\mk{l}{\\klams\\sqrt{\\frac{1 + \\frac{\\ku}{\\kc}}{1 - \\frac{\\ku}{\\kc}}}}}",
       "uses": [
