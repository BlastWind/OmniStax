      },
      {
       "tex": "\\kdt = \\gamma\\kdto",
       "src": "28.2"
      }
     ],
     "then": {
      "tex": "\\mk{t}{\\kdto} = \\mk{f}{\\frac{1}{\\kfsrc}}",
      "uses": [
