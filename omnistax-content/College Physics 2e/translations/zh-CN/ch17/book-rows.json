 "concepts": [
  {
   "id": "sound",
   "kind": "definition",
   "section": "17.1",
   "name": "声",
   "terms": [
    "声"
   ],
   "statement": "声是物质的一种扰动，由声源向外传播，它是一种波。在原子尺度上，它是原子的一种扰动，比原子的热运动有序得多；在许多情形下，它是一种周期波，其中的原子做简谐运动。"
  },
  {
   "id": "sound-longitudinal-pressure-wave",
   "kind": "idea",
   "section": "17.1",
   "name": "作为压强波的声",
   "statement": "振动的弦压缩它前方的空气，并使它后方的空气膨胀，这些密部和疏部以弦的频率作为纵向压强波向外传播。空气和大多数流体中的声波是纵波，因为流体几乎没有抗切强度。表压强随离声源距离变化的图像是一条正弦波，对于一般的声音，压强只比大气压略有变化。振幅随距离减小，原因有三。能量分布在更大的面积上；鼓膜等物体会吸收它；空气的黏度以及密部与疏部之间的热传递会把它变成热运动。"
  },
  {
   "id": "hearing",
   "kind": "definition",
   "section": "17.1",
   "name": "听觉",
   "terms": [
    "听觉"
   ],
   "statement": "听觉是对声音的知觉，正如视觉是对可见光的知觉。物理现象与对它的知觉有关联，但并不是一回事，本章把二者区分开：波长、频率、振幅和传播速率属于波，音调和响度属于听者。"
  },
  {
   "id": "pitch",
   "kind": "definition",
   "section": "17.2",
   "name": "音调",
   "terms": [
    "音调"
   ],
   "statement": "对频率的知觉称为音调。你直接感知声音的频率，而只是间接地通过乐器的大小感知波长。短笛等小型乐器发出音调高、波长短的声音，大号等大型乐器发出音调低、波长长的声音。"
  },
  {
   "id": "speed-of-sound-frequency-wavelength",
   "kind": "result",
   "section": "17.2",
   "name": "声速、频率和波长",
   "statement": "声速、频率和波长之间的关系与一切波相同。波长是波中相邻相同部分之间的距离，例如相邻密部之间的距离，频率是声源的频率，即单位时间内经过某一点的波的个数。在给定介质、条件固定时，速率是恒定的，所以频率越高，波长越小。",
   "forms": [
    {
     "id": "eq-speed-frequency-wavelength",
     "latex": "v_{\\text{w}} = f\\lambda",
     "ktex": "\\kvw = \\kf\\klam",
     "anchor": "17.2-wave-relation"
    },
    {
     "id": "eq-wavelength-from-speed",
     "latex": "\\lambda = \\frac{v_{\\text{w}}}{f}",
     "ktex": "\\klam = \\frac{\\kvw}{\\kf}",
     "anchor": "17.2-ex-wavelengths"
    }
   ]
  },
  {
   "id": "speed-of-sound-in-media",
   "kind": "idea",
   "section": "17.2",
   "name": "不同介质中的声速",
   "statement": "介质中的声速由介质的刚性（气体则为压缩性）与其密度共同决定。介质越刚硬或越不易压缩，声速越大；对于刚性相近的材料，声音在密度较低的材料中传播得更快。空气中的声速较小，因为空气可压缩，而液体和固体中的声速通常更大。地震表现出同样的依赖关系：在花岗岩中，纵向的 P 波比横向的 S 波跑得快，因为花岗岩的体积模量大于它的剪切模量。"
  },
  {
   "id": "speed-of-sound-temperature",
   "kind": "result",
   "section": "17.2",
   "name": "声速与温度",
   "statement": "对于海平面处的空气，0 °C 时的声速为 331 m/s，并随热力学温度的平方根增大。气体中的声速跟随其粒子的平均速率，而粒子的平均速率本身与温度的平方根成正比。这种依赖关系是真实的，但并不强：在 20.0 °C 时声速为 343 m/s，增大不到 4%。",
   "forms": [
    {
     "id": "eq-speed-of-sound-air",
     "latex": "v_{\\text{w}} = (331\\ \\text{m/s})\\sqrt{\\frac{T}{273\\ \\text{K}}}",
     "ktex": "\\kvw = (331\\ \\text{m/s})\\sqrt{\\frac{\\kTemp}{273\\ \\text{K}}}",
     "condition": "海平面处的空气，T 以开尔文计",
     "anchor": "17.2-temperature"
    }
   ]
  },
  {
   "id": "speed-of-sound-independent-of-frequency",
   "kind": "idea",
   "section": "17.2",
   "name": "声速与频率",
   "statement": "在开阔的空气中，可听范围内所有频率的声速都相同。如果不是这样，行进中的乐队的音乐到达时就会节奏错乱，你站得越远，低音调乐器就越落后于高音调乐器；因为无论多远所有乐器的声音都同时到达，所以所有频率的传播速率几乎相同，于是固定的声速把频率和波长联系在一起。"
  },
  {
   "id": "frequency-fixed-across-media",
   "kind": "idea",
   "section": "17.2",
   "name": "跨介质的频率",
   "statement": "声音从一种介质传入另一种介质时，它的速率改变，但频率通常保持不变，因为它就像受迫振动，具有原始声源的频率。既然速率变了而频率没变，波长就必然改变：对于给定的频率，声速越大，波长越长。"
  },
  {
   "id": "echo-ranging",
   "kind": "skill",
   "section": "17.2",
   "name": "由回声求距离",
   "statement": "蝙蝠利用声音的回声找路并捕捉猎物，声呐和医学成像也以同样的方式使用回声。声音以介质中的声速往返传播，所以回声返回所需的时间与距离成正比。回声时间的精度决定了你能分辨的最小距离差。"
  },
  {
   "id": "sound-intensity",
   "kind": "definition",
   "section": "17.3",
   "name": "声强",
   "statement": "声强是波每单位面积所携带的功率，其中功率是波传递能量的速率，其国际单位是瓦特每平方米。它是响度背后的物理量，适用于每一种声音，无论可听与否。一般声音的声强很小：在听阈处，落在鼓膜上的功率只有约 10⁻¹⁶ W。",
   "forms": [
    {
     "id": "eq-intensity-17",
     "latex": "I = \\frac{P}{A}",
     "ktex": "\\kIntens = \\frac{\\kP}{A}",
     "anchor": "17.3-intensity"
    }
   ]
  },
  {
   "id": "intensity-and-pressure-amplitude",
   "kind": "result",
   "section": "17.3",
   "name": "强度与压强振幅",
   "statement": "声波的强度与其振幅的平方成正比。压强振幅是波中最大压强与最小压强之差的一半，密度是声音所在材料的密度，速率是该介质中的声速。空气振动元的能量与其振幅的平方成正比，而压强的变化与振动的振幅成正比。因此强度与压强振幅的平方成正比：振幅越大，声音对空气的压缩越厉害。",
   "forms": [
    {
     "id": "eq-intensity-pressure-amplitude",
     "latex": "I = \\frac{(\\Delta p)^2}{2\\rho v_{\\text{w}}}",
     "ktex": "\\kIntens = \\frac{(\\kdpamp)^2}{2\\krho\\kvw}",
     "anchor": "17.3-pressure-amplitude"
    }
   ]
  },
  {
   "id": "sound-intensity-level",
   "kind": "definition",
   "section": "17.3",
   "name": "声强级",
   "symbol": "β_dB",
   "terms": [
    "声强级"
   ],
   "statement": "我们引用分贝表示的声强级，远比引用以瓦特每平方米表示的声强更频繁，因为强度的对数比强度本身更能描述我们的耳朵如何感知声音。强度为 $I$ 的声音的声强级，是它与参考强度 $I_0 = 10^{-12}$ W/m² 之比的对数的十倍。因为它是一个比值，所以声强级是无量纲的，给出的是声音相对于一个固定标准的大小。分贝中的“分”（deci）表示比值的对数要乘以十。",
   "forms": [
    {
     "id": "eq-sound-intensity-level",
     "latex": "\\beta\\ (\\text{dB}) = 10\\log_{10}\\left(\\frac{I}{I_0}\\right)",
     "ktex": "\\beta\\ (\\text{dB}) = 10\\log_{10}\\left(\\frac{\\kIntens}{\\kIo}\\right)",
     "condition": "I₀ = 10⁻¹² W/m²",
     "anchor": "17.3-decibels"
    }
   ]
  },
  {
   "id": "threshold-of-hearing",
   "kind": "idea",
   "section": "17.3",
   "name": "听阈",
   "statement": "参考强度 $I_0 = 10^{-12}$ W/m² 是听力正常的人在 1000 Hz 频率下能感知的最低声强，它的声强级是 0 dB，因为 1 的对数为零。耳朵能感受到低至万亿分之一瓦特每平方米的声强，此时空气分子的振动幅度不到一个分子直径，表压强小于 10⁻⁹ atm，而它又能承受强度大 10¹² 倍的声音；范围如此之宽，正是对数标度比强度本身更符合经验的原因。"
  },
  {
   "id": "decibel-ratios",
   "kind": "result",
   "section": "17.3",
   "name": "以分贝表示的强度之比",
   "statement": "强度每增大到 10 倍，就对应 10 dB，所以 90 dB 的声音是三个 10 倍，即 1000 倍，其强度是 60 dB 声音的 1000 倍。因为比值的对数是对数之差，所以两个声音的声强级之差只取决于它们强度之比：强度加倍使声强级升高约 3 dB，增大到 5 倍使其升高 7 dB，无论强度本身是多少。",
   "forms": [
    {
     "id": "eq-sound-level-difference",
     "latex": "\\beta_2 - \\beta_1 = 10\\log_{10}\\left(\\frac{I_2}{I_1}\\right)",
     "ktex": "\\beta_2 - \\beta_1 = 10\\log_{10}\\left(\\frac{\\kItwo}{\\kIone}\\right)",
     "anchor": "17.3-ratios"
    },
    {
     "id": "eq-log-of-ratio",
     "latex": "\\log_{10} b - \\log_{10} a = \\log_{10}\\left(\\frac{b}{a}\\right)",
     "anchor": "17.3-ratios"
    }
   ]
  },
  {
   "id": "combining-sound-sources",
   "kind": "skill",
   "section": "17.3",
   "name": "声源强度相加",
   "statement": "当许多声源一起发声并且可以忽略干涉时，它们的强度相加，声强级升高声源数目的对数的十倍：一千只苍蝇各发出 40.0 dB，合起来是 70.0 dB；十台立体声音响在圆心处合成 120 dB，每台贡献 110 dB。这一规则就是把分贝关系应用于一个是计数的比值。"
  },
  {
   "id": "sound-pressure-level",
   "kind": "definition",
   "section": "17.3",
   "name": "声压级",
   "terms": [
    "声压级"
   ],
   "statement": "另一种分贝标度，即声压级，使用压强振幅与参考压强之比，而不是强度与参考强度之比。它常用于声音在水中传播的场合，对同一个声音可以给出很不相同的分贝数。船只发出的海洋噪声以声压级计可能是 200 dB，而以声强级计则低于 140 dB。它的数值比本书使用的声强级高 60 至 70 dB，正如 17.7 节所指出的。"
  },
  {
   "id": "doppler-effect",
   "kind": "idea",
   "section": "17.4",
   "name": "多普勒效应",
   "terms": [
    "多普勒效应"
   ],
   "statement": "多普勒效应是由于声源或观察者的运动而引起的声音的观测频率的改变，频率的实际改变量就是多普勒频移。每个密部从声源发出它的那一点起向四周呈球面扩展。声源运动时，发射点也随之移动，所以密部在声源前方靠得更近，在声源后方离得更远。介质决定声速，所以较短的波长到达时就是较高的频率。当观察者运动而不是声源运动时，她遇到密部的速率会改变。相向的相对运动使接收频率升高，相背的运动使之降低，相对速率越大，效应越大。"
  },
  {
   "id": "doppler-shift-moving-source",
   "kind": "result",
   "section": "17.4",
   "name": "声源运动时的多普勒频移",
   "statement": "对于静止的观察者和运动的声源，接收到的频率等于声源频率乘以声速与“声速加减声源沿二者连线的速率”之比，声源朝向观察者运动时取减号，远离时取加号。声源的速率越大，效应越大，而且朝向与远离的频移并不对称。",
   "forms": [
    {
     "id": "eq-doppler-moving-source",
     "latex": "f_{\\text{obs}} = f_{\\text{s}}\\left(\\frac{v_{\\text{w}}}{v_{\\text{w}} \\pm v_{\\text{s}}}\\right)",
     "ktex": "\\kfobs = \\kfsrc\\left(\\frac{\\kvw}{\\kvw \\pm \\kvs}\\right)",
     "condition": "观察者静止，声源运动；声源朝向观察者运动时取减号，远离时取加号",
     "anchor": "17.4-doppler-shift"
    }
   ]
  },
  {
   "id": "doppler-shift-moving-observer",
   "kind": "result",
   "section": "17.4",
   "name": "观察者运动时的多普勒频移",
   "statement": "对于静止的声源和运动的观察者，接收到的频率等于声源频率乘以“声速加减观察者的速率”与声速之比。朝向声源运动时取加号，远离时取减号。这一形式不同于声源运动的情形，因为观察者穿过的是波长保持不变的波的更多或更少的波峰。",
   "forms": [
    {
     "id": "eq-doppler-moving-observer",
     "latex": "f_{\\text{obs}} = f_{\\text{s}}\\left(\\frac{v_{\\text{w}} \\pm v_{\\text{obs}}}{v_{\\text{w}}}\\right)",
     "ktex": "\\kfobs = \\kfsrc\\left(\\frac{\\kvw \\pm \\kvobs}{\\kvw}\\right)",
     "condition": "声源静止，观察者运动；朝向声源运动时取加号，远离时取减号",
     "anchor": "17.4-doppler-shift"
    }
   ]
  },
  {
   "id": "doppler-shift-source-and-observer",
   "kind": "result",
   "section": "17.4",
   "name": "声源和观察者都运动时的多普勒频移",
   "statement": "当二者相对于空气都在运动时，有两个多普勒频移，一个来自运动的观察者，一个来自运动的声源，接收到的频率是这两个因子的乘积。声源和观察者一起被带着运动，例如同一列火车上的司机和这列火车的喇叭，接收到的是未改变的发射频率，因为两个因子相互抵消；重要的是二者之间没有相对运动。",
   "forms": [
    {
     "id": "eq-doppler-source-and-observer",
     "latex": "f_{\\text{obs}} = \\left[f_{\\text{s}}\\left(\\frac{v_{\\text{w}} \\pm v_{\\text{obs}}}{v_{\\text{w}}}\\right)\\right]\\left(\\frac{v_{\\text{w}}}{v_{\\text{w}} \\pm v_{\\text{s}}}\\right)",
     "ktex": "\\kfobs = \\left[\\kfsrc\\left(\\frac{\\kvw \\pm \\kvobs}{\\kvw}\\right)\\right]\\left(\\frac{\\kvw}{\\kvw \\pm \\kvs}\\right)",
     "condition": "声源和观察者都在运动",
     "anchor": "17.4-ex-train-horn"
    }
   ]
  },
  {
   "id": "sonic-boom",
   "kind": "idea",
   "section": "17.4",
   "name": "声爆",
   "terms": [
    "声爆"
   ],
   "statement": "当声源的速率接近声速时，它前方的观测频率趋于无穷大，因为每一个后来的波都堆叠在前一个波上。如果声源超过声速，则在声源经过之前，没有任何声音到达观察者。这些波沿着一个圆锥的母线发生相长干涉，这种叠加就是声爆，即由速率超过声速的物体所产生的声音的相长干涉。圆锥内部的干涉大部分是相消的。声源越快，圆锥的角越小。一架飞机会产生两次声爆，一次来自机头，一次来自机尾。"
  },
  {
   "id": "bow-wake",
   "kind": "idea",
   "section": "17.4",
   "name": "弓形波",
   "terms": [
