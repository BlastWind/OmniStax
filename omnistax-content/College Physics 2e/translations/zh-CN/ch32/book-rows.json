  },
  {
   "id": "fusion-energy-from-a-mass-of-fuel",
   "kind": "skill",
   "section": "32.5",
   "name": "由燃料质量求聚变能量",
   "statement": "聚变一定质量的燃料所得的能量，是该质量中的反应次数乘以每次反应的能量，再用能量除以释放它所用的时间，就得到平均功率。"
  },
  {
   "id": "ignition-and-break-even",
   "kind": "idea",
   "section": "32.5",
   "name": "得失相当与点火",
   "statement": "实用的聚变需要燃料足够热、足够密，并且被约束足够长的时间；这三者互相制约。得失相当与点火是反应堆必须越过的里程碑。"
  },
  {
   "id": "magnetic-and-inertial-confinement",
   "kind": "idea",
   "section": "32.5",
   "name": "磁约束与惯性约束",
   "statement": "磁约束在磁场中把热而稀薄的等离子体约束很长时间，托卡马克就是如此；而惯性约束则用激光束在极短的时间内压缩致密的燃料靶丸。这两种技术在密度与约束时间之间做出不同的取舍。"
  },
  {
   "id": "nuclear-fusion",
   "kind": "definition",
   "section": "32.5",
   "name": "核聚变",
   "terms": [
    "核聚变"
   ],
   "statement": "核聚变是两个核结合成一个更大的核的反应。"
  },
  {
   "id": "break-even",
   "kind": "definition",
   "section": "32.5",
   "name": "得失相当",
   "terms": [
    "得失相当"
   ],
   "statement": "得失相当是聚变反应堆由聚变产生的能量与用于加热和约束其燃料的投入能量相等的那一点。"
  },
  {
   "id": "ignition",
   "kind": "definition",
   "section": "32.5",
   "name": "点火",
   "terms": [
    "点火"
   ],
   "statement": "点火是反应堆中的聚变产生足够的能量，使燃料保持高温并持续聚变，而无需再投入任何能量的那一点。"
  },
  {
   "id": "magnetic-confinement-fusion",
   "kind": "definition",
   "section": "32.5",
   "name": "磁约束",
   "terms": [
    "磁约束"
   ],
   "statement": "磁约束是用磁场使热的聚变等离子体离开容器壁的技术，托卡马克就是如此。"
  },
  {
   "id": "inertial-confinement",
   "kind": "definition",
   "section": "32.5",
   "name": "惯性约束",
   "terms": [
    "惯性约束"
   ],
   "statement": "惯性约束是把一小粒聚变燃料靶丸压缩并加热得如此之快（通常用激光束），以致它在自身惯性使其飞散之前就发生聚变的技术。"
  },
  {
   "id": "fission-releases-energy",
   "kind": "result",
   "section": "32.6",
   "name": "裂变释放的能量",
   "statement": "裂变是结合能曲线的另一侧。读出 $A = 240$ 附近每核子约 7.6 MeV，对比 $A = 120$ 附近的 8.6 MeV，就估算出一次裂变的能量约为 200 MeV，是一次聚变的十倍，一次衰变的一百倍。"
  },
  {
   "id": "fission-energy-from-masses",
   "kind": "skill",
   "section": "32.6",
   "name": "计算裂变能",
   "statement": "一次裂变释放的能量是被消灭的质量乘以 $c^{2}$，质量由反应物和产物的原子质量求出，产物中要把中子算在内。"
  },
  {
   "id": "neutron-induced-fission",
   "kind": "idea",
   "section": "32.6",
   "name": "中子诱发裂变",
   "terms": [
    "中子诱发裂变"
   ],
   "statement": "在中子诱发裂变中，不带电荷的中子以低能量进入重核，沉积足够的能量使它像被敲击的液滴一样振荡，直到库仑斥力把它分裂成两个碎片和几个中子：$n + {}^{A}\\text{X} \\to \\text{FF}_{1} + \\text{FF}_{2} + xn$。",
   "forms": [
    {
     "id": "eq-neutron-induced-fission",
     "latex": "n + {}^{A}\\text{X} \\to \\text{FF}_{1} + \\text{FF}_{2} + xn",
     "anchor": "32.6-neutron-induced-fission"
    },
    {
     "id": "eq-uranium-235-fission",
     "latex": "n + {}^{235}_{92}\\text{U} \\to {}^{142}_{56}\\text{Ba} + {}^{91}_{36}\\text{Kr} + 3n",
     "anchor": "32.6-neutron-induced-fission"
    }
   ]
  },
  {
   "id": "chain-reaction-and-critical-mass",
   "kind": "idea",
   "section": "32.6",
   "name": "链式反应",
   "statement": "由于裂变产生的中子能引起更多裂变，所以当每次裂变有多于一个中子继续去使另一个核裂变时，链式反应就可能发生。这需要多少材料，就是临界质量，它是反应堆和原子弹共同的核心量。"
  },
  {
   "id": "odd-neutron-number-fissile",
   "kind": "idea",
   "section": "32.6",
   "name": "奇中子数核的裂变",
   "statement": "为什么是 ${}^{235}\\text{U}$ 和 ${}^{239}\\text{Pu}$，而不是储量丰富的 ${}^{238}\\text{U}$？当俘获的中子使中子数变成偶数时，核力的吸引更强，所以多沉积约 2 MeV，液滴变形得更厉害。"
  },
  {
   "id": "reactor-moderation-and-control",
   "kind": "idea",
   "section": "32.6",
   "name": "反应堆的慢化与控制",
   "statement": "${}^{235}\\text{U}$ 最容易俘获慢中子，而裂变给出的是快中子，所以反应堆需要慢化剂；控制棒使它保持在临界。水还带来一项安全特性，因为失去水就会使链式反应停止。"
  },
  {
   "id": "fission-energy-per-kilogram",
   "kind": "skill",
   "section": "32.6",
   "name": "由燃料质量求裂变能量",
   "statement": "裂变一定质量的燃料所得的能量，是该质量中的核数乘以每次裂变的能量。每次裂变给出的能量是一次聚变的十倍，但一千克裂变燃料给出的能量只有一千克聚变燃料的约四分之一，因为它所含的核少得多。"
  },
  {
   "id": "breeding-plutonium",
   "kind": "idea",
   "section": "32.6",
   "name": "增殖钚",
   "terms": [
    "增殖"
   ],
   "statement": "增殖把 ${}^{238}\\text{U}$ 变成可裂变的 ${}^{239}\\text{Pu}$：${}^{238}\\text{U}$ 俘获一个中子，生成的 ${}^{239}\\text{U}$ 经两次 $\\beta^{-}$ 衰变，通过 ${}^{239}\\text{Np}$ 衰变而成。增殖使天然铀的另外 99% 可以利用，同时也产生了炸弹材料。",
   "forms": [
    {
     "id": "eq-breeding-capture",
     "latex": "{}^{238}\\text{U} + n \\to {}^{239}\\text{U} + \\gamma",
     "anchor": "32.6-breeding"
    },
    {
     "id": "eq-breeding-uranium-decay",
     "latex": "{}^{239}\\text{U} \\to {}^{239}\\text{Np} + \\beta^{-} + v_{e}\\;(t_{1/2} = 23\\;\\text{min})",
     "ktex": "{}^{239}\\text{U} \\to {}^{239}\\text{Np} + \\beta^{-} + v_{e}\\;(\\kthalf = 23\\;\\text{min})",
     "anchor": "32.6-breeding"
    },
    {
     "id": "eq-breeding-neptunium-decay",
     "latex": "{}^{239}\\text{Np} \\to {}^{239}\\text{Pu} + \\beta^{-} + v_{e}\\;(t_{1/2} = 2.4\\;\\text{d})",
     "ktex": "{}^{239}\\text{Np} \\to {}^{239}\\text{Pu} + \\beta^{-} + v_{e}\\;(\\kthalf = 2.4\\;\\text{d})",
     "anchor": "32.6-breeding"
    }
   ]
  },
  {
   "id": "nuclear-fission",
   "kind": "definition",
   "section": "32.6",
   "name": "核裂变",
   "terms": [
    "核裂变"
   ],
   "statement": "核裂变是一个核分裂成两个或更多个较小的核的反应。"
  },
  {
   "id": "fission-fragments",
   "kind": "definition",
   "section": "32.6",
   "name": "裂变碎片",
   "symbol": "FF_1",
   "terms": [
    "裂变碎片"
   ],
   "statement": "裂变碎片是一个核在裂变中分裂成的两个子核。"
  },
  {
   "id": "liquid-drop-model",
   "kind": "idea",
   "section": "32.6",
   "name": "液滴模型",
   "terms": [
    "液滴模型"
   ],
   "statement": "液滴模型把核看作一滴核物质：沉积在其中的能量使它振荡并变形，当它变形到足够大时，其两端的库仑斥力就压倒了短程的吸引性核力，它便分裂开来。"
  },
  {
   "id": "critical-mass",
   "kind": "definition",
   "section": "32.6",
   "name": "临界质量",
   "terms": [
    "临界质量"
   ],
   "statement": "临界质量是自持链式反应所需的可裂变材料的最小质量。"
  },
  {
   "id": "criticality",
   "kind": "definition",
   "section": "32.6",
   "name": "临界",
   "terms": [
    "临界"
   ],
   "statement": "临界是这样一种状态：平均而言，每次裂变恰好有一个中子继续引起另一次裂变，因此链式反应以稳定的速率进行。"
  },
  {
   "id": "supercriticality",
   "kind": "definition",
   "section": "32.6",
   "name": "超临界",
   "terms": [
    "超临界"
   ],
   "statement": "超临界是这样一种状态：平均而言，每次裂变有多于一个中子继续引起另一次裂变，因此链式反应不断增长。"
  },
  {
   "id": "breeder-reactor",
   "kind": "definition",
   "section": "32.6",
   "name": "增殖反应堆",
   "terms": [
    "增殖反应堆"
   ],
   "statement": "增殖反应堆是设计成产生的可裂变燃料（例如由 ${}^{238}\\text{U}$ 产生 ${}^{239}\\text{Pu}$）多于消耗的反应堆。"
  },
  {
   "id": "fission-bomb-assembly",
   "kind": "idea",
   "section": "32.7",
   "name": "原子弹",
   "statement": "炸弹必须在自己炸开之前，把一块超临界质量聚在一起保持几微秒。两种设计的差别在于装配得多快，这就是钚为什么需要内爆。"
  },
  {
   "id": "thermonuclear-bomb",
   "kind": "idea",
   "section": "32.7",
   "name": "氢弹",
   "statement": "聚变每千克给出更多的能量，而且快中子对它有帮助，所以几乎没有什么东西限制氢弹的大小。裂变引爆装置产生氚并加热燃料。",
   "forms": [
    {
     "id": "eq-lithium-tritium",
     "latex": "n + {}^{6}\\text{Li} \\to {}^{3}\\text{H} + {}^{4}\\text{He}",
     "anchor": "32.7-thermonuclear-bombs"
    }
   ]
  },
  {
   "id": "nuclear-weapon-energy-output",
   "kind": "idea",
   "section": "32.7",
   "name": "核武器当量",
   "statement": "核武器的当量以千吨或兆吨 TNT 来表示，对应于几克到几千克的被消灭质量。它的能量分配到冲击波、热辐射和核辐射中，其比例与常规炸药的不同。"
  }
