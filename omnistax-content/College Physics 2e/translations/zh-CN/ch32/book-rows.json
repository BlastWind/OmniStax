 "concepts": [
  {
   "id": "radiopharmaceuticals-and-tagging",
   "kind": "definition",
   "section": "32.1",
   "name": "放射性药物",
   "terms": [
    "放射性药物"
   ],
   "statement": "放射性药物是标记了放射性核素的化合物，之所以选用它，是因为人体会把它输送到被研究的器官。由于 $\\gamma$ 射线很容易穿出人体，而且无论核素处在哪种化合物中，其原子核辐射的情形都相同，所以体外的探测器能够看出这种化合物去了哪里。"
  },
  {
   "id": "technetium-99m",
   "kind": "idea",
   "section": "32.1",
   "name": "锝-99m",
   "statement": "一种核素承担了大约 80% 的核医学，其原因正是本章物理学的缩影：只有单一而清晰的 $\\gamma$ 能量，半衰期短因而限制了剂量，而且有一个母体能就地衰变成它。"
  },
  {
   "id": "anger-camera",
   "kind": "idea",
   "section": "32.1",
   "name": "安格照相机",
   "terms": [
    "安格照相机",
    "γ 照相机"
   ],
   "statement": "安格照相机用一个只让沿其孔道行进的 $\\gamma$ 射线通过的铅准直器、一个把每个 $\\gamma$ 射线变成光的闪烁体，以及把光变成信号的光电倍增管，来给放射性药物成像。它形成的图像是平面的，不含深度。"
  },
  {
   "id": "spect-imaging",
   "kind": "idea",
   "section": "32.1",
   "name": "单光子发射计算机断层成像",
   "terms": [
    "单光子发射计算机断层成像"
   ],
   "statement": "单光子发射计算机断层成像给发射 $\\gamma$ 射线的放射性药物成像。它把探测器围在患者周围，再用计算机把各探测器的图像合成为三维图像，就像 X 射线 CT 对阴影所做的那样。它获得了深度，代价是分辨率。"
  },
  {
   "id": "pet-annihilation-pair",
   "kind": "idea",
   "section": "32.1",
   "name": "正电子发射断层成像",
   "terms": [
    "正电子发射断层成像"
   ],
   "statement": "正电子发射断层成像是守恒定律在医学中最干净利落的应用：静止的正电子与电子湮没时，必定沿相反方向发出两个相等的 0.511 MeV 的 $\\gamma$ 射线，所以两个探测器同时触发，就确定了源所在的直线。"
  },
  {
   "id": "mass-from-activity",
   "kind": "skill",
   "section": "32.1",
   "name": "由活度求质量",
   "statement": "放射性样品的质量可由其活度和半衰期求出：活度和半衰期给出核的数目，再由阿伏伽德罗常量和摩尔质量把这个数目换算成质量。几毫居里的医用活度，对应的质量小得惊人。"
  },
  {
   "id": "tagged-compound",
   "kind": "definition",
   "section": "32.1",
   "name": "标记化合物",
   "terms": [
    "标记的"
   ],
   "statement": "当一种放射性核素附着在某化合物上时，这种化合物就被标记了，这样核素的辐射就能显示该化合物的去向。"
  },
  {
   "id": "radiation-damages-dna",
   "kind": "idea",
   "section": "32.2",
   "name": "DNA 辐射损伤",
   "statement": "辐射的一切生物效应，从致癌到治癌，都源于这一个论断。它解释了为什么快速增殖的细胞，包括癌细胞，最为敏感。"
  },
  {
   "id": "absorbed-dose-rad-and-gray",
   "kind": "definition",
   "section": "32.2",
   "name": "辐射剂量",
   "symbol": "dose",
   "type": "dose",
   "statement": "吸收剂量是受影响组织每千克所沉积的电离能量。它以拉德为单位来度量，其中 $1\\;\\text{rad} = 0.01\\;\\text{J/kg}$，或以戈瑞为单位，其中 $1\\;\\text{Gy} = 1\\;\\text{J/kg} = 100\\;\\text{rad}$。"
  },
  {
   "id": "relative-biological-effectiveness",
   "kind": "definition",
   "section": "32.2",
   "name": "相对生物效能",
   "symbol": "RBE",
   "terms": [
    "相对生物效能",
    "品质因数"
   ],
   "statement": "某种辐射的相对生物效能（RBE），或称品质因数，是指该辐射每单位吸收剂量的生物效应超过 X 射线的倍数。诸如 $\\alpha$ 粒子之类的短程辐射把损伤集中起来，更难修复，因此 RBE 较大。"
  },
  {
   "id": "dose-equivalent-rem-and-sievert",
   "kind": "definition",
   "section": "32.2",
   "name": "剂量当量",
   "statement": "剂量当量是吸收剂量乘以 RBE，这个数与生物效应成正比：$\\text{rem} = \\text{rad}\\times\\text{RBE}$，$\\text{Sv} = \\text{Gy}\\times\\text{RBE}$。剂量限值和风险都用这个量来表述。",
   "type": "dose"
  },
  {
   "id": "dose-from-a-source",
   "kind": "skill",
   "section": "32.2",
   "name": "计算剂量",
   "statement": "源的剂量要沿着它的衰变一直算到焦耳每千克：活度和时间给出衰变的次数，每次衰变的能量给出沉积的能量，受照组织的质量给出以戈瑞为单位的剂量，再由 RBE 给出以希沃特为单位的剂量。计算中不要把活度与剂量混淆。"
  },
  {
   "id": "immediate-effects-and-dose-levels",
   "kind": "idea",
   "section": "32.2",
   "name": "剂量的即时效应",
   "statement": "低于约 0.1 Sv 的一次全身剂量没有可观察到的即时效应，接近 1 Sv 的剂量会引起放射病，接近 5 Sv 的剂量会使约一半的受照者死亡。血细胞数目最先下降，因为血细胞增殖得最快。"
  },
  {
   "id": "linear-hypothesis-and-long-term-risk",
   "kind": "idea",
   "section": "32.2",
   "name": "线性假说",
   "terms": [
    "线性假说"
   ],
   "statement": "线性假说假定，辐射致癌的风险与剂量成正比，即使剂量低到观察不到任何效应也是如此。按这种方式从高剂量往下推算，得到癌症风险约为 $10/10^{6}\\;\\text{rem}\\cdot\\text{y}$。"
  },
  {
   "id": "background-radiation",
   "kind": "idea",
   "section": "32.2",
   "name": "本底辐射",
   "statement": "每个人都受到本底辐射，平均每年约 3 mSv，来自宇宙线、岩石和土壤、人体自身的核素，而最主要的是来自氡。它的大小因地而异，是衡量其他一切剂量的天然标尺。"
  },
  {
   "id": "radiation-protection",
   "kind": "idea",
   "section": "32.2",
   "name": "辐射防护",
   "statement": "限制剂量只有三种方法：缩短受照时间，增大与源的距离，以及在源与人体之间放置屏蔽。"
  },
