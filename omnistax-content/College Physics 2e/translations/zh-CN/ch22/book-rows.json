 "concepts": [
  {
   "id": "magnetic-poles",
   "kind": "axiom",
   "section": "22.1",
   "name": "磁极",
   "statement": "所有磁体都吸引铁，但一块磁体靠近另一块磁体时，可能吸引它，也可能排斥它，因为每块磁体都有两个表现不同的端点。把一块磁体自由悬挂起来，它的一端会指向北方。这两端分别是磁北极和磁南极，是按它们所指的方向命名的。本章后面的每一条规则，从磁感线的方向到载流线圈所受的力矩，都要用到这两个磁极。"
  },
  {
   "id": "like-poles-repel",
   "kind": "axiom",
   "section": "22.1",
   "name": "同名磁极相斥",
   "statement": "把两块磁体靠在一起，你会发现两个北极互相推开，两个南极也是如此，而北极和南极则互相吸引。把这与静电学的规则作比较：异号电荷相吸，同号电荷相斥。两者看上去很相像，人们很容易把整个静电学照搬过来，但后面的各节会表明这种类比在哪里成立、在哪里失效。"
  },
  {
   "id": "no-magnetic-monopoles",
   "kind": "axiom",
   "section": "22.1",
   "name": "不存在磁单极子",
   "terms": [
    "磁单极子"
   ],
   "statement": "把一根条形磁体从中间切成两半，你得不到一手拿着北极、另一手拿着南极的结果；你得到的是两块更短的磁体，每块都有两个磁极。再切一次，情形依旧，一直切到铁原子本身。这正是与电荷的类比失效之处，因为正电荷和负电荷很容易分开；也正是这一事实迫使本章后面把全部磁性都解释为电流：载流线圈总是产生一对磁极，而从不产生单个磁极。"
  },
  {
   "id": "north-magnetic-pole",
   "kind": "definition",
   "section": "22.1",
   "name": "磁北极",
   "terms": [
    "磁北极"
   ],
   "statement": "磁体的磁北极是被地球地理北极吸引的那一端或那一侧，也就是磁体可以自由转动时指向北方的那一端。"
  },
  {
   "id": "south-magnetic-pole",
   "kind": "definition",
   "section": "22.1",
   "name": "磁南极",
   "terms": [
    "磁南极"
   ],
   "statement": "磁体的磁南极是被地球地理南极吸引的那一端或那一侧。"
  },
  {
   "id": "ferromagnetic-materials",
   "kind": "definition",
   "section": "22.2",
   "name": "铁磁材料与磁化",
   "terms": [
    "铁磁性的"
   ],
   "statement": "只有少数几种材料表现出很强的磁效应，其中有铁、钴、镍、钆和一些稀土合金。它们被称为铁磁性的，得名于拉丁语中表示铁的 ferrum 一词。它们的作用不止于对磁体做出响应：它们本身可以被磁化，也就是可以被诱导而带有磁性，或被制成永磁体，这就是为什么靠近未磁化铁块的磁体会吸引它。"
  },
  {
   "id": "magnetic-domains",
   "kind": "idea",
   "section": "22.2",
   "name": "磁畴",
   "terms": [
    "磁畴"
   ],
   "statement": "铁磁材料内部有一些称为磁畴的区域，由于其中各个原子的磁极排列一致，每个磁畴都像一根小条形磁体。在未磁化的物体中，磁畴很小，指向随机，因此它们的效应相互抵消。在外磁场中，原本就指向正确的磁畴以其他磁畴为代价而增大，其余的磁畴则转向同一方向，整块材料就成为一块磁体。加热后冷却，或在施加磁场时敲击它，可使这种排列永久保持。"
  },
  {
   "id": "curie-temperature",
   "kind": "definition",
   "section": "22.2",
   "name": "居里温度",
   "terms": [
    "居里温度"
   ],
   "statement": "热运动不利于磁畴的排列，因此在没有另一块磁体的情况下加热永磁体会使其退磁，猛烈敲击也会如此。每种铁磁材料都有一个确定的温度，即居里温度，超过这个温度它就根本不能被磁化；铁的居里温度是 1043 K，即 770 °C，远高于室温。有些元素和合金的居里温度低于室温，只有在低温下才是铁磁性的。"
  },
  {
   "id": "electromagnet",
   "kind": "idea",
   "section": "22.2",
   "name": "电磁铁",
   "terms": [
    "电磁铁"
   ],
   "statement": "奥斯特在 1820 年发现，载流导线会使指南针的指针偏转，这是运动电荷与磁体有关的最早证据。利用电流制造磁体称为电磁学，以这种方式制成的磁体称为电磁铁。撒在载流线圈周围的铁屑形成的图样，与它们在条形磁体周围形成的图样相同。电磁铁同样有无法分开的北极和南极，并且遵循同样的规则相互排斥和吸引，所以这两种磁体是同一类东西。"
  },
  {
   "id": "current-is-the-source-of-magnetism",
   "kind": "idea",
   "section": "22.2",
   "name": "作为磁性来源的电流",
   "statement": "电磁铁用电流产生磁场，铁磁体也是如此，只不过尺度小到看不见。绕原子核运动的电子是一个闭合的载流线圈，电子的自旋是第二种电流，二者都产生带有北极和南极的磁场。铁磁性是这些自旋的协同排列。孤立的磁极从未被发现，因为载流线圈总是产生一对磁极。本章其余部分都建立在这一想法之上。"
  },
  {
   "id": "electromagnetism",
   "kind": "definition",
   "section": "22.2",
   "name": "电磁学",
   "terms": [
    "电磁学"
   ],
   "statement": "电磁学是利用电流产生磁性，更广泛地说，是指一旦知道电流能产生磁场，电和磁就合而为一的那门学科。"
  },
  {
   "id": "magnetized",
   "kind": "definition",
   "section": "22.2",
   "name": "被磁化的",
   "terms": [
    "被磁化的"
   ],
   "statement": "一种材料已被变成磁体时就是被磁化的，这既可以是在一段时间内被诱导而带有磁性，也可以是被制成永磁体。"
  },
  {
   "id": "magnetic-field",
   "kind": "definition",
   "section": "22.3",
   "name": "磁场",
   "symbol": "B_mag",
   "terms": [
    "磁场",
    "B 场"
   ],
   "type": "magnetic-field",
   "statement": "磁场，传统上称为 B 场，是对磁力的表示。与引力场和电场一样，它描绘出物体周围的力，这些力可以作用于远处的另一个物体；它表示的是产生它的物体，而不是用来探测它的指南针。"
  },
  {
   "id": "direction-of-field-lines",
   "kind": "definition",
   "section": "22.3",
   "name": "磁感线的方向",
   "terms": [
    "磁感线的方向"
   ],
   "statement": "我们用磁感线来画磁场，这是一种显示磁场强弱和方向的图示工具。磁感线的方向就是小指南针的指针北端所指的方向，所以你可以用桌上的一只指南针来检验。小指南针不会扰动它所检验的磁场，就像小检验电荷不会扰动电场一样，所以它们描出的图只是磁体本身的图。"
  },
  {
   "id": "rules-for-magnetic-field-lines",
   "kind": "axiom",
   "section": "22.3",
   "name": "磁感线的规则",
   "statement": "对许多磁场的描绘确立了四条规则。磁场在每一点都与磁感线相切，所以指南针沿着磁感线摆放。磁感应强度与磁感线的密集程度成正比，确切地说，与垂直于磁感线的单位面积上穿过的磁感线条数成正比。磁感线从不相交，因为磁场在空间每一点只有一个值。而且磁感线是连续的闭合回路，没有起点也没有终点，这是四条中最深刻的一条，因为电场线始于电荷、止于电荷，而磁感线没有可供其始终的单极子。"
  },
  {
   "id": "magnetic-field-lines",
   "kind": "definition",
   "section": "22.3",
   "name": "磁感线",
   "terms": [
    "磁感线"
   ],
   "statement": "磁感线是磁场的一种图示表示：磁场沿着磁感线的方向，磁场较强的地方磁感线靠得较近。"
  },
  {
   "id": "magnetic-force-on-a-moving-charge",
   "kind": "axiom",
   "section": "22.4",
   "name": "运动电荷所受的磁力",
   "terms": [
    "洛伦兹力",
    "磁力"
   ],
   "statement": "磁场只在电荷运动时才对电荷施加力。这个力的大小等于电荷、速率、磁感应强度以及速度与磁场夹角的正弦四者的乘积。正弦与其余各量同样重要：沿磁感线运动的电荷完全不受力，而垂直穿过磁感线运动的电荷受力最大。这个力常被称为洛伦兹力，一块磁体就是靠它推动另一块磁体的，因为每块磁体都由运动的电荷构成。",
   "forms": [
    {
     "id": "eq-magnetic-force",
     "latex": "F = qvB\\sin\\theta",
     "ktex": "\\kF = \\kq\\kv\\kBmag\\sin\\theta",
     "anchor": "22.4-force-law"
    }
   ]
  },
  {
   "id": "magnetic-field-strength-defined",
   "kind": "definition",
   "section": "22.4",
   "name": "磁感应强度",
   "symbol": "B_mag",
   "terms": [
    "磁感应强度"
   ],
   "type": "magnetic-field",
   "statement": "磁感线显示磁场的样子；把力的定律反过来，就说出了它的强度是什么。解出 $B$，就把磁感应强度定义为单位电荷、单位速度所受的力（沿垂直于磁场的方向度量），正如电场强度是单位电荷所受的力一样。所以我们只能通过磁场对运动电荷的作用来了解它。",
   "forms": [
    {
     "id": "eq-field-from-force",
