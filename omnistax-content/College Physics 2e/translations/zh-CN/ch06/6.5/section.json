   },
   "cite": "gravitational-constant",
   "prompt": "在公式 $\\kg = \\frac{GM}{\\kr^2}$ 中，<em>G</em> 代表什么？",
   "answer": {
    "type": "choice",
    "generated_by": "source",
    "options": [
