 "concepts": [
  {
   "id": "uniform-circular-motion",
   "kind": "definition",
   "section": "6.1",
   "name": "匀速圆周运动",
   "terms": [
    "匀速圆周运动"
   ],
   "statement": "匀速圆周运动是以恒定速率沿圆形路径的运动，是最简单的曲线运动形式。向心加速度、向心力和卫星的轨道都是先针对这种情形推导出来的。"
  },
  {
   "id": "arc-length",
   "kind": "definition",
   "section": "6.1",
   "name": "弧长",
   "symbol": "Δs",
   "terms": [
    "弧长"
   ],
   "type": "position",
   "statement": "弧长是物体沿圆形路径走过的路程，也就是第 2 章中的距离，只不过沿曲线而不是沿直线来度量。圆周运动的每一个转角和每一个线速率都由它而来。",
   "forms": [
    {
     "id": "eq-arc",
     "latex": "s = L\\theta",
     "ktex": "\\ks = L\\theta",
     "section": "16.4",
     "anchor": "16.4-small-angle"
    }
   ]
  },
  {
   "id": "rotation-angle",
   "kind": "definition",
   "section": "6.1",
   "name": "转角",
   "symbol": "Δθ",
   "terms": [
    "转角"
   ],
   "type": "angle",
   "statement": "转角是转动的量，定义为弧长与曲率半径之比，它是代替线性距离的角量。由于它是两个长度之比，所以转动物体上的每一点在相同的时间内转过相同的转角，不论该点离转轴多远。",
   "forms": [
    {
     "id": "eq-rotation-angle",
     "latex": "\\Delta\\theta = \\frac{\\Delta s}{r}",
     "ktex": "\\Delta\\theta = \\frac{\\kds}{\\kr}",
     "anchor": "6.1-rotation-angle"
    }
   ]
  },
  {
   "id": "radian",
   "kind": "definition",
   "section": "6.1",
   "name": "弧度",
   "terms": [
    "弧度"
   ],
   "statement": "转完一整圈，点沿圆周绕行一次，所以一圈的转角是 $2\\pi r / r = 2\\pi$。这就确定了单位：$2\\pi$ rad 是一圈，而一弧度约为 57.3º。弧度是两个长度之比，本身没有单位，所以你可以在答案中加上它，也可以略去它。",
   "forms": [
    {
     "id": "eq-radian-revolution",
     "latex": "2\\pi\\;\\text{rad} = 1\\;\\text{圈} = 360^\\circ",
     "anchor": "6.1-radians"
    },
    {
     "id": "eq-one-revolution",
     "latex": "\\Delta\\theta = \\frac{2\\pi r}{r} = 2\\pi",
     "ktex": "\\Delta\\theta = \\frac{2\\pi \\kr}{\\kr} = 2\\pi",
     "condition": "转完一整圈",
     "anchor": "6.1-radians"
    },
    {
     "id": "eq-radian-degree",
     "latex": "1\\;\\text{rad} = \\frac{360^\\circ}{2\\pi} \\approx 57.3^\\circ",
     "anchor": "6.1-radians"
    }
   ]
  },
  {
   "id": "angular-velocity",
   "kind": "definition",
   "section": "6.1",
   "name": "角速度",
   "symbol": "ω",
   "terms": [
    "角速度"
   ],
   "type": "angular-rate",
   "statement": "角速度是转角的变化率，它回答物体转得多快的问题。它是与线速度相类似的角量，以弧度每秒来度量，相对于转轴只有顺时针和逆时针两个方向。",
   "forms": [
    {
     "id": "eq-omega",
     "latex": "\\omega = \\frac{\\Delta\\theta}{\\Delta t}",
     "ktex": "\\kw = \\frac{\\Delta\\theta}{\\kdt}",
     "anchor": "6.1-angular-velocity"
    },
    {
     "id": "eq-angular-velocity-recalled",
     "latex": "\\omega = \\frac{\\Delta\\theta}{\\Delta t}",
     "ktex": "\\kw = \\frac{\\Delta\\theta}{\\kdt}",
     "section": "10.1",
     "anchor": "10.1-uniform-circular-motion"
    }
   ]
  },
  {
   "id": "linear-angular-velocity",
   "kind": "result",
   "section": "6.1",
   "name": "线速度和角速度",
   "statement": "转动的光盘上的一个凹坑在时间 $\\Delta t$ 内移动弧长 $\\Delta s = r\\Delta\\theta$，所以它的线速率为 $v = r\\omega$。从一个角度读这个关系，它说明边缘上的点比靠近转轴的点运动得快；从另一个角度读，$\\omega = v/r$ 说明小轮胎的汽车要想以同样的速率行驶，必须比大轮胎的汽车把轮胎转得更快。",
   "forms": [
    {
     "id": "eq-v-romega",
     "latex": "v = r\\omega \\quad\\text{或}\\quad \\omega = \\frac{v}{r}",
     "ktex": "\\kv = \\kr\\kw \\quad\\text{或}\\quad \\kw = \\frac{\\kv}{\\kr}",
     "anchor": "6.1-linear-angular"
    },
    {
     "id": "eq-v-arc",
     "latex": "v = \\frac{\\Delta s}{\\Delta t}",
     "ktex": "\\kv = \\frac{\\kds}{\\kdt}",
     "anchor": "6.1-linear-angular"
    },
    {
     "id": "eq-omega-from-v",
     "latex": "v = r\\omega \\quad\\text{或}\\quad \\omega = \\frac{v}{r}",
     "ktex": "\\kv = \\kr\\kw \\quad\\text{或}\\quad \\kw = \\frac{\\kv}{\\kr}",
     "section": "10.1",
     "anchor": "10.1-uniform-circular-motion"
    }
   ]
  },
  {
   "id": "circular-path-radius",
   "kind": "definition",
   "section": "6.1",
   "name": "曲率半径",
   "symbol": "r_curv",
   "terms": [
    "曲率半径"
   ],
   "type": "position",
   "statement": "曲率半径是圆形路径的半径，即从转动中心到运动的点的距离。"
  },
  {
   "id": "cd-pit",
   "kind": "definition",
   "section": "6.1",
   "name": "凹坑",
   "terms": [
    "凹坑"
   ],
   "statement": "凹坑是光盘聚碳酸酯层顶部所压制的螺旋形轨道上的一个微小凹痕。"
  },
  {
   "id": "centripetal-acceleration",
   "kind": "definition",
   "section": "6.2",
   "name": "向心加速度",
   "symbol": "a_c",
   "terms": [
    "向心加速度"
   ],
   "type": "acceleration",
   "statement": "在匀速圆周运动中，速度的大小从不改变，但它的方向不断改变，所以存在加速度。取相邻两点处速度之差可知，速度的变化直指曲率中心，加速度也是如此。向心的意思是寻求中心，它就是你驾车转弯时所感到的侧向加速度。"
  },
  {
   "id": "centripetal-acceleration-magnitude",
   "kind": "result",
   "section": "6.2",
   "name": "向心加速度的大小",
   "statement": "由两个速度构成的三角形与由两条半径构成的三角形相似，顺着这一点推下去得到 $a_{\\text{c}} = v^2/r$。代入 $v = r\\omega$ 得到第二种形式 $a_{\\text{c}} = r\\omega^2$，你可以使用其中更方便的一种。因为速率是以平方的形式出现的，所以以 100 km/h 过弯的难度是以 50 km/h 的四倍，而急转弯因为半径小，要求还要更高。",
   "forms": [
    {
     "id": "eq-ac",
     "latex": "a_{\\text{c}} = \\frac{v^2}{r}",
     "ktex": "\\kac = \\frac{\\kv^2}{\\kr}",
     "anchor": "6.2-magnitude"
    },
    {
     "id": "eq-similar-triangles",
     "latex": "\\frac{\\Delta v}{v} = \\frac{\\Delta s}{r}",
     "ktex": "\\frac{\\kdv}{\\kv} = \\frac{\\kds}{\\kr}",
     "condition": "速度构成的三角形与半径构成的三角形相似",
     "anchor": "6.2-magnitude"
    },
    {
     "id": "eq-dv-step",
     "latex": "\\Delta v = \\frac{v}{r}\\Delta s",
     "ktex": "\\kdv = \\frac{\\kv}{\\kr}\\kds",
     "anchor": "6.2-magnitude"
    },
    {
     "id": "eq-ac-omega",
     "latex": "a_{\\text{c}} = r\\omega^2",
     "ktex": "\\kac = \\kr\\kw^2",
     "anchor": "6.2-magnitude"
    }
   ]
  },
  {
   "id": "centrifuge",
   "kind": "idea",
   "section": "6.2",
   "name": "离心机",
   "statement": "离心机是用来分离不同密度样品的旋转装置，它之所以有效，是因为很高的向心加速度比重力快得多地把它们分开，并且只需少量样品。超速离心机是针对很高转速而优化的离心机，在真空中可以达到几十万 $g$ 的最大向心加速度。"
  },
  {
   "id": "acceleration-in-multiples-of-g",
   "kind": "skill",
   "section": "6.2",
   "name": "用 g 的倍数表示加速度",
   "statement": "把向心加速度除以重力加速度，就是用 g 的倍数来表示它，这让你立刻知道它与我们静止站立时所感受到的加速度相比如何。离心机的额定值用 g 的倍数标出，航天员对发射和再入的耐受力也是这样表示的，而这个比值显示一次乘坐是会令人不适还是危险。"
  },
  {
   "id": "ultracentrifuge",
   "kind": "definition",
   "section": "6.2",
   "name": "超速离心机",
   "terms": [
    "超速离心机"
   ],
   "statement": "超速离心机是为使转子以很高的转速旋转而优化的离心机。"
  },
  {
   "id": "centripetal-force",
   "kind": "definition",
   "section": "6.3",
   "name": "向心力",
   "symbol": "F_c",
   "terms": [
    "向心力"
   ],
   "type": "force",
   "statement": "任何引起匀速圆周运动的合力都是向心力。它不是一种新的力：系绳球上绳中的张力、地球对月球的引力、冰鞋与溜冰场地面之间的摩擦力，以及倾斜路面对汽车的力，都可以是向心力。使一个力成为向心力的是它的方向，即指向曲率中心，而牛顿第二定律随后给出它的大小。",
   "forms": [
    {
     "id": "eq-Fc-mac",
     "latex": "F_{\\text{c}} = m a_{\\text{c}}",
     "ktex": "\\kFc = m\\kac",
     "anchor": "6.3-centripetal-force"
    }
   ]
  },
  {
   "id": "centripetal-force-magnitude",
   "kind": "result",
   "section": "6.3",
   "name": "向心力的大小",
   "statement": "把向心加速度的两种形式代入 $F_{\\text{c}} = ma_{\\text{c}}$，得到向心力的两种形式，你可以使用其中更方便的一种：已知速率时用第一种，已知角速度时用第二种。这个力总是垂直于路径，并且总是指向曲率中心，因为加速度就是如此。",
   "forms": [
    {
     "id": "eq-Fc",
     "latex": "F_{\\text{c}} = m\\frac{v^2}{r}",
     "ktex": "\\kFc = m\\frac{\\kv^2}{\\kr}",
     "anchor": "6.3-two-forms"
    },
    {
     "id": "eq-Fc-omega",
     "latex": "F_{\\text{c}} = mr\\omega^2",
     "ktex": "\\kFc = m\\kr\\kw^2",
     "anchor": "6.3-two-forms"
    }
   ]
  },
  {
   "id": "radius-and-centripetal-force",
   "kind": "result",
   "section": "6.3",
   "name": "由向心力求半径",
   "statement": "把向心力解出半径可知，对给定的质量和速率，大的力使曲线弯得急，小的力使曲线弯得缓。这样读就能说明为什么脚下摩擦力太小的汽车会向外冲出路面而不是停下来，也能说明为什么高速轮胎中的应力取决于轮胎的直径。",
   "forms": [
    {
     "id": "eq-r-from-Fc",
     "latex": "r = \\frac{mv^2}{F_{\\text{c}}}",
     "ktex": "\\kr = \\frac{m\\kv^2}{\\kFc}",
     "anchor": "6.3-radius"
    }
   ]
  },
  {
   "id": "friction-as-centripetal-force",
   "kind": "result",
   "section": "6.3",
   "name": "水平弯道上的摩擦力",
   "statement": "在水平弯道上，作用在汽车上的唯一水平力是摩擦力，所以摩擦力就是全部的向心力。令 $mv^2/r$ 等于最大静摩擦力 $\\mu_{\\text{s}}N = \\mu_{\\text{s}}mg$ 并约去质量，就得到使汽车能以该速率通过弯道的最小摩擦因数。质量之所以能约去，是因为摩擦力与法向力成正比，所以汽车的载重无关紧要。",
   "forms": [
    {
     "id": "eq-mu-s",
     "latex": "\\mu_{\\text{s}} = \\frac{v^2}{rg}",
     "ktex": "\\mu_{\\text{s}} = \\frac{\\kv^2}{\\kr\\kg}",
     "condition": "水平弯道，取静摩擦力所允许的最大速率",
     "anchor": "6.3-ex-flat-curve"
    },
    {
     "id": "eq-friction-centripetal",
     "latex": "F_{\\text{c}} = f = \\mu_{\\text{s}} N = \\mu_{\\text{s}} mg",
     "ktex": "\\kFc = \\kff = \\mu_{\\text{s}} \\kN = \\mu_{\\text{s}} m\\kg",
     "condition": "水平弯道，其中摩擦力是唯一的水平力",
     "anchor": "6.3-ex-flat-curve"
    }
   ]
  },
  {
   "id": "banked-curve",
   "kind": "definition",
   "section": "6.3",
   "name": "倾斜弯道",
   "terms": [
    "倾斜弯道"
   ],
   "statement": "倾斜弯道使路面倾斜，使坡度有助于你通过弯道，角度越大，你通过的速度就可以越快。在理想倾斜的弯道上，你可以以某一个速率通过弯道而完全不需要摩擦力，因为单靠法向力就提供了向心力。"
  },
  {
   "id": "ideal-banking-angle",
   "kind": "result",
   "section": "6.3",
   "name": "理想倾斜角",
   "terms": [
    "理想倾斜角"
   ],
   "statement": "在无摩擦的倾斜弯道上，法向力的水平分量 $N\\sin\\theta$ 必须提供向心力，竖直分量 $N\\cos\\theta$ 必须与重力平衡。把一个除以另一个，就同时消去了法向力和质量，得到 $\\tan\\theta = v^2/rg$。因此，高速和急弯的道路必须有很陡的倾斜，而且这个角度与车辆的质量无关。",
   "forms": [
    {
     "id": "eq-banking",
     "latex": "\\theta = \\tan^{-1}\\left(\\frac{v^2}{rg}\\right)",
     "ktex": "\\theta = \\tan^{-1}\\left(\\frac{\\kv^2}{\\kr\\kg}\\right)",
     "condition": "理想倾斜弯道，无摩擦",
     "anchor": "6.3-banked"
    },
    {
     "id": "eq-N-sin",
     "latex": "N\\sin\\theta = \\frac{mv^2}{r}",
     "ktex": "\\kN\\sin\\theta = \\frac{m\\kv^2}{\\kr}",
     "condition": "理想倾斜弯道，无摩擦",
     "anchor": "6.3-banked"
    },
    {
     "id": "eq-N-cos",
     "latex": "N\\cos\\theta = mg",
     "ktex": "\\kN\\cos\\theta = m\\kg",
     "condition": "理想倾斜弯道，无摩擦",
     "anchor": "6.3-banked"
    },
    {
     "id": "eq-tan-theta",
     "latex": "\\tan\\theta = \\frac{v^2}{rg}",
     "ktex": "\\tan\\theta = \\frac{\\kv^2}{\\kr\\kg}",
     "condition": "理想倾斜弯道，无摩擦",
     "anchor": "6.3-banked"
    }
   ]
  },
  {
   "id": "ideal-speed",
   "kind": "result",
   "section": "6.3",
   "name": "理想速率",
   "terms": [
    "理想速率"
   ],
   "statement": "把倾斜关系反过来读，就得到某一给定半径和倾斜度的弯道所设计的速率，书中称之为理想速率。在这个速率下，仅靠路面就能让你保持在弯道上，而摩擦力随后让你能以更大或更小的速率通过弯道而不打滑。",
   "forms": [
    {
     "id": "eq-ideal-speed",
     "latex": "v = (rg\\tan\\theta)^{1/2}",
     "ktex": "\\kv = (\\kr\\kg\\tan\\theta)^{1/2}",
     "condition": "理想倾斜弯道，无摩擦",
     "anchor": "6.3-ex-ideal-speed"
    }
   ]
  },
  {
   "id": "free-body-circular-motion",
   "kind": "skill",
   "section": "6.3",
   "name": "求解圆周运动问题",
   "statement": "圆周运动问题是一个牛顿第二定律问题，其中你事先就知道加速度的方向：它指向曲率中心。画出受力图，取一个轴沿半径方向，令沿该轴的合力等于 $mv^2/r$。水平弯道、倾斜弯道、竖直圆环和摆动的吊笼都是这样处理的。"
  },
  {
   "id": "ideal-banking",
   "kind": "definition",
   "section": "6.3",
   "name": "理想倾斜",
   "terms": [
    "理想倾斜"
   ],
   "statement": "理想倾斜是公路弯道的倾斜，其角度使车辆能够以给定的速率通过弯道，而无需轮胎与路面之间的摩擦力的帮助。"
  },
  {
   "id": "non-inertial-frame",
   "kind": "definition",
   "section": "6.4",
   "name": "非惯性参考系",
   "terms": [
    "非惯性参考系"
   ],
   "statement": "非惯性参考系是加速的参考系。转弯的汽车和转动的旋转木马都是非惯性的，而在这样的参考系内，除非给牛顿定律加上没有物理来源的力，否则牛顿定律不能照原样成立。"
  },
  {
   "id": "fictitious-force",
   "kind": "definition",
   "section": "6.4",
   "name": "虚拟力",
   "terms": [
    "虚拟力"
   ],
   "statement": "虚拟力是没有物理来源的力，是为了能在加速或转动的参考系内应用牛顿定律而设想出来的。汽车向右转弯时，并没有什么在把乘客推向左边；乘客沿直线运动，是汽车在他下面向右运动。两种看法都能让我们描述自然，但从惯性参考系出发的看法最简单也最真实，因为在其中每一个力都有真实的起源。"
  },
  {
   "id": "centrifugal-force",
   "kind": "definition",
   "section": "6.4",
   "name": "离心力",
   "terms": [
    "离心力"
   ],
   "statement": "离心力是似乎要把你甩出转动参考系的虚拟力。不要把它与向心力混淆，向心力是真实的，指向相反的方向。在地球参考系中，没有什么东西把乘坐者甩出旋转木马；乘坐者必须抓牢才能作圆周运动，而不是沿直线径直飞出边缘。离心机出于同样的原因而起作用：试管转动时，粒子的惯性带着它们沿切线运动。"
  },
  {
