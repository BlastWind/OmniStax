 "derivations": [
  {
   "id": "ideal-banking-angle",
   "what": "弯道的理想倾斜角",
   "source": "《大学物理（第2版）》，6.3 向心力",
   "nodes": [
    {
     "assumes": [
      {
       "text": "在无摩擦的倾斜弯道上，只有法向力有水平分量，所以它必须等于向心力。",
       "src": "6.3"
      },
      {
       "text": "法向力的水平分量为 $\\kN\\ \\sin\\ \\ktheta$。",
       "src": "图 6.11"
      },
      {
       "tex": "\\kFc = \\km\\frac{\\kv^2}{\\kr}",
       "src": "6.3"
      }
     ],
     "then": {
      "tex": "\\mk{N}{\\kN\\ \\sin\\ \\ktheta} = \\mk{c}{\\kFc}",
      "src": "6.3",
      "uses": [
       0,
       1
      ]
     },
     "steps": [
      {
       "tex": "\\mk{N}{\\kN\\ \\sin\\ \\ktheta} = \\mk{c}{\\frac{\\km\\kv^2}{\\kr}}",
       "uses": [
        2
       ]
      }
     ],
     "src": "6.3"
    },
    {
     "assumes": [
      {
       "text": "汽车不离开路面，所以竖直方向的合力为零。",
       "src": "6.3"
      },
      {
       "text": "法向力的竖直分量为 $\\kN\\ \\cos\\ \\ktheta$，竖直方向上唯一的另一个力是重力 $\\km\\kg$。",
       "src": "图 6.11"
      }
     ],
     "then": {
      "tex": "\\mk{N}{\\kN\\ \\cos\\ \\ktheta} = \\mk{w}{\\km\\kg}",
      "src": "6.3",
      "uses": [
       0,
       1
      ]
     },
     "steps": [
      {
       "tex": "\\mk{N}{\\kN} = \\frac{\\mk{w}{\\km\\kg}}{\\mk{c}{\\cos\\ \\ktheta}}",
       "uses": [],
       "map": {
        "N": [
         "N",
         "c"
        ]
       }
      }
     ],
     "src": "6.3"
    },
    {
     "assumes": [
      {
       "step": 0
      },
      {
       "step": 1
      }
     ],
     "then": {
      "tex": "\\mk{L}{\\kN\\ \\sin\\ \\ktheta} = \\mk{R}{\\frac{\\km\\kv^2}{\\kr}}",
      "src": "6.3",
      "uses": []
     },
     "steps": [
      {
       "tex": "\\mk{L}{\\km\\kg\\frac{\\sin\\ \\ktheta}{\\cos\\ \\ktheta}} = \\mk{R}{\\frac{\\km\\kv^2}{\\kr}}",
       "uses": [
        1
       ]
      },
      {
       "tex": "\\mk{L}{\\km\\kg\\ \\tan(\\ktheta)} = \\mk{R}{\\frac{\\km\\kv^2}{\\kr}}",
       "uses": [],
       "cap": "$\\sin\\ktheta/\\cos\\ktheta = \\tan\\ktheta$."
      },
      {
       "tex": "\\mk{L}{\\tan\\ \\ktheta} = \\mk{R}{\\frac{\\kv^2}{\\kr\\kg}}",
       "uses": []
      },
      {
       "tex": "\\mk{L}{\\ktheta} = \\mk{R}{\\tan^{-1}\\left(\\frac{\\kv^2}{\\kr\\kg}\\right)}\\ \\text{（理想倾斜弯道，无摩擦）}",
       "uses": []
      }
     ],
     "src": "6.3"
    }
   ]
  }
