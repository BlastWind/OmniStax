 "exercises": [
  {
   "id": "cq1",
   "source_id": "fs-id3119404",
   "kind": "conceptual-question",
   "bloom": "Understand",
   "place": {
    "at": "end"
   },
   "cite": "linear-angular",
   "prompt": "转动的物理量与线性的物理量之间存在类比关系。哪些转动量类似于距离和速度？",
   "answer": {
    "type": "open",
    "generated_by": "ai",
    "solution": "一个点沿圆形路径走过的路程是弧长 $\\kds$，与之类似的转动量是转角 $\\Delta\\theta$，它就是该弧长除以曲率半径。线速度 $\\kv$ 是一个点走过路程的快慢，与之类似的转动量是角速度 $\\kw$，它是转角变化的快慢。关系式 $\\kds = \\kr\\Delta\\theta$ 和 $\\kv = \\kr\\kw$ 把这两对量联系起来：把每个转动量乘以曲率半径，就得到它对应的线性量。请注意，转动物体上每个点的转角和角速度都相同，而弧长和线速度则随点离中心越远而越大。"
   }
  },
  {
   "id": "p1",
   "source_id": "fs-id3004274",
   "kind": "problem",
   "bloom": "Apply",
   "place": {
    "at": "end"
   },
   "cite": "radians",
   "prompt": "半挂车的一个挂车车轮的轮毂上装有里程表。轮毂加了配重，使它不会转动，但里面有齿轮来计数车轮转过的圈数——然后它计算出所行驶的路程。如果车轮的直径为 1.15 m，转过 200,000 圈，里程表应该读出多少千米？",
   "answer": {
    "type": "number",
    "generated_by": "source",
    "value": 723,
    "unit": "km",
    "hint": "每转一圈，车轮转过的转角为 $\\Delta\\theta = 2\\pi$ rad，所以它在路面上留下的弧长为 $\\kds = \\kr\\Delta\\theta = 2\\pi \\kr$，即一个周长。把它乘以转过的圈数，并记住直径是半径的两倍。",
    "solution": "723 km"
   }
  },
  {
   "id": "p3",
   "source_id": "fs-id1921627",
   "kind": "problem",
   "bloom": "Apply",
   "place": {
    "at": "end"
   },
   "cite": "radians",
   "prompt": "一辆汽车的轮胎半径为 0.260 m，行驶 80,000 km 后轮胎磨损报废。忽略任何倒车以及半径因磨损而产生的任何变化，轮胎转了多少圈？",
   "answer": {
    "type": "number",
    "generated_by": "source",
    "value": 50000000,
    "unit": "rotations",
    "hint": "每转一圈留下一个周长的弧长，即 $2\\pi \\kr$，所以用它去除整个路程，注意全程使用同一个长度单位。",
    "solution": "$5 \\times 10^{7}\\;\\text{圈}$"
   }
  },
