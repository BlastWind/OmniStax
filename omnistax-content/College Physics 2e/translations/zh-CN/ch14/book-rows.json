 "concepts": [
  {
   "id": "heat",
   "kind": "definition",
   "section": "14.1",
   "name": "热量",
   "symbol": "Q_heat",
   "terms": [
    "热量"
   ],
   "type": "energy",
   "statement": "热量是由温差引起的能量自发传递。当两个温度不同的物体相接触时，能量由高温物体传向低温物体，直到它们达到相同的温度；在此过程中没有力作用一段距离，所以这种传递不是功。因此，热量是一种传递中的能量形式：它只在温差驱动它的时候存在，一旦温度相等便终止。"
  },
  {
   "id": "heat-vs-temperature",
   "kind": "idea",
   "section": "14.1",
   "name": "热量与温度之别",
   "statement": "我们可能会说热量令人难以忍受，而实际想说的是温度很高。热量是能量的一种形式，以焦耳计量；温度不是能量，而是原子和分子平均动能的量度。之所以产生这种混淆，是因为我们感觉到的是热量的流动，而不是温度本身。把两者区分开，本章后面的内容才能说明，加入热量并不一定会使温度升高。"
  },
  {
   "id": "units-of-heat",
   "kind": "definition",
   "section": "14.1",
   "name": "热量的单位",
   "statement": "由于热量是能量的一种形式，其 SI 单位是焦耳，但热量也用卡来计量，卡是使 1.00 g 水的温度升高 1.00 °C 所需的能量，而最常用的是千卡，它使 1.00 kg 水升高同样的温度。食物卡路里（大卡）就是千卡，这一点很难从包装标签上确定，而在这些单位之间换算是本章几乎每道题的一部分。"
  },
  {
   "id": "mechanical-equivalent-of-heat",
   "kind": "axiom",
   "section": "14.1",
   "name": "热功当量",
   "terms": [
    "热功当量"
   ],
   "statement": "做功也可以改变物质的温度，詹姆斯·普雷斯科特·焦耳的实验确立了热功当量，即产生与热传递相同效果的功。现代最佳值是 1.000 kcal = 4186 J，我们把它当作两个能量单位之间的换算关系。在焦耳的装置中，下落的重物带动水中的桨叶转动。重力势能变为动能，黏度把它随机化为分子的运动，温度计的示数恰好像加入热量时一样上升。",
   "forms": [
    {
     "id": "eq-mechanical-equivalent",
     "latex": "1.000\\;\\text{kcal} = 4186\\;\\text{J}",
     "condition": "15 °C 卡",
     "anchor": "14.1-mechanical-equivalent"
    }
   ]
  },
  {
   "id": "internal-energy-changed-by-heat-or-work",
   "kind": "idea",
   "section": "14.1",
   "name": "由热量或功改变内能",
   "statement": "加给系统的热量会改变其内能，通常也改变其温度，对系统做功（通过搅拌或摩擦）同样如此。系统有确定的内能，却没有热含量，也没有功含量：能量一旦进入内部，样品本身就看不出它是以哪种方式进来的。这就是本书说热传递而不说热量的原因，也是第 15 章建立热力学第一定律所依据的思想。"
  },
  {
   "id": "kilocalorie",
   "kind": "definition",
   "section": "14.1",
   "name": "千卡",
   "terms": [
    "千卡"
   ],
   "statement": "千卡是热量的单位，等于 1000 卡，即使 1.00 kg 水的温度升高 1.00 °C 所需的能量。食物卡路里（大卡）就是千卡。",
   "forms": [
    {
     "id": "eq-kilocalorie",
     "latex": "1\\;\\text{kcal} = 1000\\;\\text{cal}"
    }
   ]
  },
  {
   "id": "three-factors-of-heat-transfer",
   "kind": "idea",
   "section": "14.2",
   "name": "热传递中的因素",
   "statement": "实验表明，使物体温度改变所传递的热量取决于三个因素：温度的变化、物体的质量，以及物质及其相。给定质量的温度变化加倍，所需热量加倍；质量加倍，在同样的温度变化下所需热量也加倍；而相同质量的水发生同样的温度变化，所需热量是铜的 10.8 倍。前两条源于内能与热力学温度和分子数成正比；第三条是材料的性质。"
  },
  {
   "id": "heat-and-temperature-change",
   "kind": "axiom",
   "section": "14.2",
   "name": "热量与温度变化",
   "statement": "在没有相变且不做功的条件下，传递的热量等于质量乘以比热容再乘以温度变化。温度变化以开尔文计和以摄氏度计是相同的，所以用哪个都行；热量以千卡为单位时，比热容的单位是 kcal/(kg·°C)。这是整章的工作方程，因为之后每一种热传递方式都要回到它所产生的温度变化上来。",
   "forms": [
    {
     "id": "eq-heat-temperature-change",
     "latex": "Q = mc\\Delta T",
     "ktex": "\\kQh = m\\,c\\,\\kdTemp",
     "condition": "没有相变且不做功",
     "anchor": "14.2-heat-equation"
    }
   ]
  },
  {
   "id": "specific-heat",
   "kind": "definition",
   "section": "14.2",
   "name": "比热容",
   "symbol": "c_spec",
   "terms": [
    "比热容"
   ],
   "type": "specific-heat",
   "statement": "比热容是使 1.00 kg 某种物质的温度改变 1.00 °C 所需的热量。它取决于材料及其相，一般必须查表，因为没有简单的方法可以计算它，而且对大多数固体和液体，它随温度变化不大。水的比热容是所有材料中最大的之一，是玻璃的五倍、铁的十倍，这对维持地球上的生命很重要。"
  },
  {
   "id": "temperature-rise-from-work",
   "kind": "skill",
   "section": "14.2",
   "name": "由功求温度升高",
   "statement": "当功转化为内能时，把同一个方程对温度变化求解，就得到温度升高：传递的能量除以吸收它的物体的质量与比热容。卡车在下坡行驶时，刹车把卡车失去的重力势能转化为刹车材料的内能。由于刹车相对于卡车很小，即使只有十分之一的能量也会使它们迅速升温。",
   "forms": [
    {
     "id": "eq-temperature-change-from-heat",
     "latex": "\\Delta T = \\frac{Q}{mc}",
     "ktex": "\\kdTemp = \\frac{\\kQh}{m\\,c}",
     "anchor": "14.2-work-into-heat"
    }
   ]
  },
  {
   "id": "calorimetry",
   "kind": "result",
   "section": "14.2",
   "name": "量热学",
   "statement": "当两个温度不同的物体在隔热容器中接触时，热量由高温物体传向低温物体，直到它们达到共同温度。没有热量离开这一对物体，所以高温物体失去的热量就是低温物体得到的热量。考虑正负号，流入低温物体的热量为正，流出高温物体的热量为负，二者之和为零。这是一个量热学问题，而量热学测量食物的热含量和材料的比热容。",
   "forms": [
    {
     "id": "eq-calorimetry",
     "latex": "Q_{\\text{cold}} + Q_{\\text{hot}} = 0",
     "ktex": "\\kQcold + \\kQhot = 0",
     "condition": "与周围环境没有热交换",
     "anchor": "14.2-calorimetry"
    },
    {
     "id": "eq-heat-balance",
     "latex": "m_W c_W (T_{\\text{f}} - T_{\\text{i},W}) = -m_{\\text{Al}} c_{\\text{Al}} (T_{\\text{f}} - T_{\\text{i},\\text{Al}})",
     "anchor": "14.2-calorimetry"
    }
   ]
  },
  {
   "id": "final-temperature-from-heat-exchange",
   "kind": "skill",
   "section": "14.2",
   "name": "求两个物体的末温",
   "statement": "对量热学平衡式求解末温，得到两个起始温度的加权平均，每个起始温度的权重是该物体的质量乘以比热容。150 °C 的锅与 20.0 °C 的水最终达到 59.1 °C，更接近水的温度，因为水的比热容是铝的四倍多，其质量乘以比热容是较大的权重。关键技巧是用唯一的未知温度写出失去的热量和得到的热量，然后合并各项。",
   "forms": [
    {
     "id": "eq-final-temperature",
     "latex": "T_{\\text{f}} = \\frac{m_{\\text{Al}} c_{\\text{Al}} T_{\\text{i},\\text{Al}} + m_W c_W T_{\\text{i},W}}{m_{\\text{Al}} c_{\\text{Al}} + m_W c_W}",
     "condition": "两个物体交换热量且没有相变",
     "anchor": "14.2-calorimetry"
    }
   ]
  },
  {
   "id": "water-moderates-temperature",
   "kind": "idea",
   "section": "14.2",
   "name": "水对温度的调节作用",
   "statement": "由于水的比热容比大多数常见物质大，在给定的热传递下它的温度变化很小。像湖泊这样的大片水体需要大量热量才能明显升温，所以即使气温在一天中变化很大，它的温度也几乎保持不变，而在从夏季到冬季的较长时间内它的温度确实会变化。陆地比水升温和降温更快，这正是陆风和海风的成因。"
  },
  {
   "id": "latent-heat",
   "kind": "definition",
   "section": "14.3",
   "name": "潜热",
   "symbol": "L_latent",
   "terms": [
    "潜热系数"
   ],
   "type": "latent-heat",
   "statement": "物质发生相变时，热传递并不引起温度变化。能量用于破坏分子之间的内聚键，而不是增加它们的动能，所以 0 °C 的冰在全部熔化之前一直保持 0 °C。当键在凝固或凝结中重新形成时，同样的能量又释放出来，通常以热能的形式。改变一定质量的相所需的热量，等于该质量乘以潜热系数，这是一个材料常量。之所以称为潜热，即隐藏的热，是因为能量进入或离开时并不改变温度。",
   "forms": [
    {
     "id": "eq-latent-heat",
     "latex": "Q = mL",
     "ktex": "\\kQh = m\\,L",
     "condition": "相变期间",
     "anchor": "14.3-phase-change"
    }
   ]
  },
  {
   "id": "heat-of-fusion",
   "kind": "definition",
   "section": "14.3",
   "name": "熔化热",
   "symbol": "L_f",
   "type": "latent-heat",
   "statement": "熔化热是使一千克物质在熔点熔化所需的热量，这一千克物质凝固时释放同样的热量。对水而言它是 334 kJ/kg，足以使一千克液态水从 0 °C 升温到 79.8 °C。因此，一袋 0 °C 的冰比同样温度的一袋水吸收的能量多得多，在喷过水的果园里，水结冰会使树木变暖。",
   "forms": [
    {
     "id": "eq-heat-fusion",
     "latex": "Q = mL_{\\text{f}}",
     "ktex": "\\kQh = m\\,L_{\\text{f}}",
     "condition": "熔化或凝固",
     "anchor": "14.3-phase-change"
    },
    {
     "id": "eq-melting-heat",
     "latex": "Q = mL_{\\text{f}}",
     "ktex": "\\kQh = mL_{\\text{f}}",
     "condition": "在熔点温度下熔化",
     "section": "15.6",
     "anchor": "15.6-order-to-disorder"
    }
   ]
  },
  {
   "id": "heat-of-vaporization",
   "kind": "definition",
   "section": "14.3",
   "name": "汽化热",
   "symbol": "L_v",
   "type": "latent-heat",
   "statement": "汽化热是使一千克液体在沸点变为蒸气所需的热量，蒸气凝结时释放同样的热量。对水而言它是 2256 kJ/kg，几乎是其熔化热的七倍，所以把一千克水煮干所耗的热量，比把它从冰冷升温到沸腾还多。一杯冰茶外壁上的凝结把能量释放到杯子里，加速了冰的熔化。",
   "forms": [
    {
     "id": "eq-heat-vaporization",
     "latex": "Q = mL_{\\text{v}}",
     "ktex": "\\kQh = m\\,L_{\\text{v}}",
     "condition": "汽化或凝结",
     "anchor": "14.3-phase-change"
    }
   ]
  },
  {
   "id": "heating-curve",
   "kind": "idea",
   "section": "14.3",
   "name": "水的加热曲线",
   "statement": "给 −20 °C 的冰加热，描出的图线有斜坡也有平台。冰升温时温度线性上升；冰熔化时停在 0 °C，每一焦耳都用于相变；然后在液态水中再次上升，但更慢，因为水的比热容是冰的两倍；水沸腾时停在 100 °C，平台长得多；之后作为蒸汽再次上升。这些平台就是潜热，把它们的长度与斜坡相比较可以看出，相变的能量比温度变化的能量大得多。"
  },
  {
   "id": "evaporation-below-boiling",
   "kind": "idea",
   "section": "14.3",
   "name": "沸点以下的蒸发",
   "statement": "水在低于沸点的温度也会蒸发，而且每千克所耗的能量更多，因为分子可资利用的动能更少：在体温下汽化热为 2430 kJ/kg，比 100 °C 时约高百分之十。汗液从皮肤带走这份热量，所以出汗能降温，而高湿度减缓蒸发，汗就留在你的额头上。同样的蒸发也是潮湿气候中气温很少升到 35 °C 以上的原因。"
  },
  {
   "id": "condensation-and-freezing-release-heat",
   "kind": "idea",
   "section": "14.3",
   "name": "凝结和凝固释放热量",
   "statement": "要使蒸气凝结或使液体凝固，必须移走相变在相反方向上所吸收的全部能量，周围环境接收这些能量。这就是为什么冷杯上的凝结加快了杯内冰的熔化，为什么潮湿天气里气温很少降到露点以下，为什么给果园喷水能使它免受严重霜冻，以及为什么结冰的水保持在 0 °C 而不会更冷。"
  },
  {
   "id": "heat-of-sublimation",
   "kind": "definition",
   "section": "14.3",
   "name": "升华热",
   "symbol": "L_s",
   "terms": [
    "升华热"
   ],
   "type": "latent-heat",
   "statement": "升华是由固相直接变为气相的转变，如雪不留一点液体痕迹地消失，干冰冒出它的烟，或霜仅由蒸气在冷窗上形成。它的发生是因为固体的平衡蒸气压不为零。所需能量是质量乘以升华热，升华热是与其他潜热同一数量级的常量，所以干冰是有效的冷却剂，而凝华释放能量。",
   "forms": [
    {
     "id": "eq-heat-sublimation",
     "latex": "Q = mL_{\\text{s}}",
     "ktex": "\\kQh = m\\,L_{\\text{s}}",
     "condition": "固体变为蒸气，或蒸气变为固体",
     "anchor": "14.3-sublimation"
    }
   ]
  },
  {
   "id": "phase-change-calorimetry",
   "kind": "skill",
   "section": "14.3",
   "name": "求有相变时的末温",
   "statement": "当相变参与热交换时，要分阶段求解。使冰熔化的热量，再加上使熔化后的水升温的热量，与另一物体放出的热量相平衡，每一项都含有唯一的未知末温。先试着按没有相变来求解。如果温度变化会使某个物体越过熔点或沸点，就回去分步来做，并在最后检查有没有漏掉任何相变。",
   "forms": [
    {
     "id": "eq-ice-soda-balance",
     "latex": "m_{\\text{ice}} L_{\\text{f}} + m_{\\text{ice}} c_W (T_{\\text{f}} - 0^\\circ\\text{C}) = -m_{\\text{soda}} c_W (T_{\\text{f}} - 20^\\circ\\text{C})",
     "condition": "汽水和冰不与其他任何东西交换热量",
     "anchor": "14.3-cooling-soda"
    }
   ]
  },
  {
   "id": "heat-transfer-methods",
   "kind": "idea",
   "section": "14.4",
   "name": "热传递的三种方式",
   "statement": "只要有温差，就会发生热传递，而热传递的每一个过程都只通过三种方式进行：热传导、对流和辐射。三者有一个共同点，即它们传递热量仅仅是因为温差，我们通过选择材料、控制空气的运动和选择颜色来控制它们的速率。壁炉同时显示了这三种方式。"
