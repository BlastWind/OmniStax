   "id": "visible-light",
   "kind": "definition",
   "section": "24.3",
   "name": "可见光",
   "terms": [
    "可见光"
   ],
   "statement": "可见光是电磁波谱中正常人眼能够响应的狭窄波段，其波长约从 380 nm 到 760 nm。"
  },
  {
   "id": "ultraviolet-radiation",
   "kind": "definition",
   "section": "24.3",
   "name": "紫外辐射",
   "terms": [
    "紫外辐射（UV）",
    "紫外辐射"
   ],
   "statement": "紫外辐射是电磁波谱中的一个波段，从紫光向上延伸到更高的频率，并与最低频的 X 射线重叠。"
  },
  {
   "id": "x-ray-radiation",
   "kind": "definition",
   "section": "24.3",
   "name": "X 射线",
   "terms": [
    "X 射线",
    "X 射线",
    "X 射线"
   ],
   "statement": "X 射线是不可见的、穿透性的、频率很高的电磁辐射，它与下面的紫外线和上面的 γ 射线重叠。"
  },
  {
   "id": "gamma-ray-radiation",
   "kind": "definition",
   "section": "24.3",
   "name": "γ 射线",
   "terms": [
    "γ 射线",
    "γ 射线"
   ],
   "statement": "γ 射线是频率极高的电磁辐射，由原子核在核衰变或其他核过程和粒子过程中发射。"
  },
  {
   "id": "carrier-wave",
   "kind": "definition",
   "section": "24.3",
   "name": "载波",
   "terms": [
    "载波"
   ],
   "statement": "载波是通过对其振幅或频率进行调制来携带信号的电磁波。"
  },
  {
   "id": "amplitude-modulation",
   "kind": "definition",
   "section": "24.3",
   "name": "调幅",
   "terms": [
    "调幅（AM）"
   ],
   "statement": "调幅是用信号改变载波的振幅，而其频率保持不变，从而把信息放到电磁波上。"
  },
  {
   "id": "frequency-modulation",
   "kind": "definition",
   "section": "24.3",
   "name": "调频",
   "terms": [
    "调频（FM）"
   ],
   "statement": "调频是用信号改变载波的频率，而其振幅保持不变，从而把信息放到电磁波上。"
  },
  {
   "id": "radar",
   "kind": "idea",
   "section": "24.3",
   "name": "雷达",
   "terms": [
    "雷达"
   ],
   "statement": "雷达是微波的一种常见应用：它由反射脉冲返回所用的时间，求出到云和飞机等各种物体的距离。"
  },
  {
   "id": "extremely-low-frequency",
   "kind": "definition",
   "section": "24.3",
   "name": "极低频",
   "terms": [
    "极低频（ELF）"
   ],
   "statement": "极低频辐射是频率最低的电磁辐射，通常为 0 到 300 Hz，但也可达约 1 kHz。"
  },
  {
   "id": "television",
   "kind": "idea",
   "section": "24.3",
   "name": "电视机",
   "terms": [
    "电视机"
   ],
   "statement": "电视把视频信号和音频信号载在电磁波上，在无线电波段中广播。"
  },
  {
   "id": "very-high-frequency",
   "kind": "definition",
   "section": "24.3",
   "name": "甚高频",
   "terms": [
    "甚高频（VHF）"
   ],
   "statement": "甚高频电视频道使用 54 到 88 MHz 和 174 到 222 MHz 这两个范围内的频率。"
  },
  {
   "id": "ultra-high-frequency",
   "kind": "definition",
   "section": "24.3",
   "name": "特高频",
   "terms": [
    "特高频（UHF）"
   ],
   "statement": "特高频电视频道使用高于 VHF 的频率，从 470 到 1000 MHz。"
  },
  {
   "id": "wave-energy-from-field-amplitude",
   "kind": "result",
   "section": "24.4",
   "name": "波的能量与场的振幅",
   "statement": "波把能量带进一个系统，是因为它的场对电荷施力并使其运动，场越大，所能做的功越多。对各种波，能量都与振幅的平方成正比，而对电磁波，振幅就是最大场强，所以能量与 $\\kEfo^2$ 成正比，也与 $\\kBmago^2$ 成正比。场加倍，能量变为四倍，这就是本节第一幅图的全部内容，也是场减半的微波炉要花四倍时间的原因。"
  },
  {
   "id": "average-intensity-from-e0",
   "kind": "result",
   "section": "24.4",
   "name": "由电场振幅求平均强度",
   "statement": "强度是单位面积上的功率，对连续的正弦电磁波，只用电场振幅就能写出它。二分之一的因子来自对正弦的平方在一个周期上取平均，而光速和真空电容率把场强变成每平方米的功率。当已知或所求的量是电场时，用这种形式。",
   "forms": [
    {
     "id": "eq-intensity-from-e0",
     "latex": "I_{\\text{ave}} = \\frac{c\\varepsilon_0 E_0^2}{2}",
     "ktex": "\\kIave = \\frac{\\kc\\varepsilon_0 \\kEfo^2}{2}",
     "anchor": "24.4-average-intensity"
    },
    {
     "id": "eq-e0-from-intensity",
     "latex": "E_0 = \\left(\\frac{2I_{\\text{ave}}}{c\\varepsilon_0}\\right)^{1/2}",
     "ktex": "\\kEfo = \\left(\\frac{2\\kIave}{\\kc\\varepsilon_0}\\right)^{1/2}",
     "anchor": "24.4-fields-from-intensity"
    }
   ]
  },
  {
   "id": "intensity-from-the-magnetic-amplitude",
   "kind": "result",
   "section": "24.4",
   "name": "由磁场振幅求平均强度",
   "statement": "把 $\\kBmag = \\kEf/\\kc$ 和 $\\varepsilon_0 = 1/\\mu_0\\kc^2$ 代入第一个表达式，就得到用磁场振幅表示的强度，只代入一部分，就得到同时用两个振幅表示的强度。这三种形式不是三个结果而是一个，它们按题目所给的量写成不同的样子，而三者背后的原理相同：波中的能量与振幅的平方有关。",
   "forms": [
    {
     "id": "eq-intensity-from-b0",
     "latex": "I_{\\text{ave}} = \\frac{cB_0^2}{2\\mu_0}",
     "ktex": "\\kIave = \\frac{\\kc\\kBmago^2}{2\\mu_0}",
     "anchor": "24.4-average-intensity"
    },
    {
     "id": "eq-intensity-from-e0-b0",
     "latex": "I_{\\text{ave}} = \\frac{E_0B_0}{2\\mu_0}",
     "ktex": "\\kIave = \\frac{\\kEfo\\kBmago}{2\\mu_0}",
     "anchor": "24.4-average-intensity"
    }
   ]
  },
  {
   "id": "peak-intensity-is-twice-average",
   "kind": "result",
   "section": "24.4",
   "name": "峰值强度",
   "statement": "这三个表达式是针对正弦波写出的，对正弦的平方在一个周期上取平均，只剩下其最大值的一半。所以波峰处的强度是同样的表达式所给出的平均强度的两倍，而要求峰值而不是平均值的题目需要这个因子 2。同一个因子也是方均根场等于振幅除以二的平方根的原因。",
   "forms": [
    {
     "id": "eq-peak-intensity",
     "latex": "I_0 = 2I_{\\text{ave}}",
     "ktex": "\\kIopeak = 2\\kIave",
     "anchor": "24.4-average-intensity"
    }
   ]
  },
  {
   "id": "find-fields-from-intensity",
   "kind": "skill",
   "section": "24.4",
   "name": "由强度求场的振幅",
   "statement": "本节常见的问题只朝一个方向：已知功率的波源把功率分布在已知的面积上，由此得到强度，再把第一个表达式改写，由强度得到电场振幅，然后除以光速，得到磁场振幅。按这个顺序做，可以两次避开麻烦的常量，而答案也值得看一眼大小，因为炉子里的一千瓦会给出几千伏每米的场和几微特斯拉。"
  },
  {
   "id": "maximum-field-strength",
   "kind": "definition",
   "section": "24.4",
   "name": "最大场强",
   "symbol": "E_0field",
   "terms": [
    "最大场强"
   ],
   "statement": "电磁波的最大场强是其电场或磁场的振幅，即场在振荡时达到的最大值。"
  }
 ],
