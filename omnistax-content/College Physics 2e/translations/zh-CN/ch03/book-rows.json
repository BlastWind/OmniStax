  {
   "id": "analytical-vector-addition",
   "kind": "skill",
   "section": "3.3",
   "name": "用分量求矢量和",
   "statement": "用解析法相加矢量时，先确定 $x$ 轴和 $y$ 轴，用 $\\kAx = \\kA\\cos\\theta$ 和 $\\kAy = \\kA\\sin\\theta$ 求出每个矢量的分量。把沿每个轴的分量相加，得到 $\\kRx = \\kAx + \\kBx$ 和 $\\kRy = \\kAy + \\kBy$。然后求出合矢量的大小 $\\kR = \\sqrt{\\kRx^2 + \\kRy^2}$ 和方向 $\\theta = \\tan^{-1}(\\kRy / \\kRx)$。这种方法之所以有效，是因为沿同一轴的分量像普通的数一样相加。减法完全相同，因为 $-\\mathbf{B}$ 的分量是 $\\mathbf{B}$ 的分量的相反数。解析法比图解法更简明、更准确、更精密，而图解法的准确度只取决于作图。",
   "forms": [
    {
     "id": "eq-Rx",
     "latex": "R_x = A_x + B_x",
     "ktex": "\\kRx = \\kAx + \\kBx",
     "anchor": "3.3-adding"
    },
    {
     "id": "eq-Ry",
     "latex": "R_y = A_y + B_y",
     "ktex": "\\kRy = \\kAy + \\kBy",
     "anchor": "3.3-adding"
    },
    {
     "id": "eq-R-magnitude",
     "latex": "R = \\sqrt{R_x^2 + R_y^2}",
     "ktex": "\\kR = \\sqrt{\\kRx^2 + \\kRy^2}",
     "anchor": "3.3-adding"
    },
    {
     "id": "eq-R-direction",
     "latex": "\\theta = \\tan^{-1}(R_y / R_x)",
     "ktex": "\\theta = \\tan^{-1}(\\kRy / \\kRx)",
     "anchor": "3.3-adding"
    },
    {
     "id": "eq-Rx-subtraction",
     "latex": "R_x = A_x + (-B_x),\\quad R_y = A_y + (-B_y)",
     "ktex": "\\kRx = \\kAx + (-\\kBx),\\quad \\kRy = \\kAy + (-\\kBy)",
     "condition": "A − B 的合矢量",
     "anchor": "3.3-subtraction"
    }
   ]
  },
