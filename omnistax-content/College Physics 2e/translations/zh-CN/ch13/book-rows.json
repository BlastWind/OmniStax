 "concepts": [
  {
   "id": "temperature",
   "kind": "definition",
   "section": "13.1",
   "name": "温度",
   "symbol": "T_temp",
   "terms": [
    "温度"
   ],
   "type": "temperature",
   "statement": "温度在操作上被定义为用温度计测量的量。你对冷热的感觉是相对的：对于刚才放在热水里的手，温水感觉是凉的；对于刚才放在冷水里的手，温水感觉是暖的。放在同一水中的两支精确的温度计给出相同的读数。许多物理量只是由我们测量它们的方式来定义的，而在本章后面，温度获得了更偏物理的含义，它与原子和分子的动能相联系。",
   "forms": [
    {
     "id": "eq-temperature-difference",
     "latex": "\\Delta T = T_{\\text{f}} - T_{\\text{i}}",
     "ktex": "\\kdTemp = \\kTempf - \\kTempi",
     "section": "14.2",
     "anchor": "14.2-heat-equation"
    }
   ]
  },
  {
   "id": "thermometer",
   "kind": "idea",
   "section": "13.1",
   "name": "温度计",
   "statement": "任何依赖于温度、且对温度的响应可重复的物理性质，都可以作为温度计的基础。对大多数物质来说，体积随温度升高而增大，这是酒精温度计、水银温度计和双金属片的基础。电阻、颜色和红外辐射的发射同样可以用。由于有这么多性质依赖于温度，温度计的种类之多令人惊叹。"
  },
  {
   "id": "temperature-scales",
   "kind": "definition",
   "section": "13.1",
   "name": "温标",
   "statement": "温标以两个易于复现的温度为起点，通常是水在标准大气压下的凝固点和沸点。摄氏温标把它们定为 0 °C 和 100 °C，华氏温标把它们定为 32 °F 和 212 °F，所以一摄氏度的大小是一华氏度的 1.8 倍。开尔文温标是科学上的热力学温标。它的零点是绝对零度，它的单位是开尔文，不带度的符号，一开尔文与一摄氏度大小相等，所以水在 273.15 K 凝固，在 373.15 K 沸腾。"
  },
  {
   "id": "convert-temperature-scales",
   "kind": "skill",
   "section": "13.1",
   "name": "温标之间的温度换算",
   "statement": "三种常用温标之间的温度换算用表 13.1 的方程进行。由摄氏温标换算到华氏温标是乘以五分之九再加 32，由摄氏温标换算到开尔文温标是加 273.15，而华氏温标与开尔文温标之间的换算看起来复杂，其实就是这两者的简单组合。温差的换算与温度的换算不同：摄氏度改变一度，就是开尔文改变一度，也是华氏度改变五分之九度，没有偏移量。",
   "forms": [
    {
     "id": "eq-celsius-to-fahrenheit",
     "latex": "T_{{}^\\circ\\text{F}} = \\frac{9}{5}T_{{}^\\circ\\text{C}} + 32",
     "ktex": "\\kTempF = \\frac{9}{5}\\kTempC + 32",
     "anchor": "13.1-temperature-scales"
    },
    {
     "id": "eq-fahrenheit-to-celsius",
     "latex": "T_{{}^\\circ\\text{C}} = \\frac{5}{9}\\left(T_{{}^\\circ\\text{F}} - 32\\right)",
     "ktex": "\\kTempC = \\frac{5}{9}\\left(\\kTempF - 32\\right)",
     "anchor": "13.1-temperature-scales"
    },
    {
     "id": "eq-celsius-to-kelvin",
     "latex": "T_{\\text{K}} = T_{{}^\\circ\\text{C}} + 273.15",
     "ktex": "\\kTempK = \\kTempC + 273.15",
     "anchor": "13.1-temperature-scales"
    },
    {
     "id": "eq-kelvin-to-celsius",
     "latex": "T_{{}^\\circ\\text{C}} = T_{\\text{K}} - 273.15",
     "ktex": "\\kTempC = \\kTempK - 273.15",
     "anchor": "13.1-temperature-scales"
    },
    {
     "id": "eq-fahrenheit-to-kelvin",
     "latex": "T_{\\text{K}} = \\frac{5}{9}\\left(T_{{}^\\circ\\text{F}} - 32\\right) + 273.15",
     "ktex": "\\kTempK = \\frac{5}{9}\\left(\\kTempF - 32\\right) + 273.15",
     "anchor": "13.1-temperature-scales"
    },
    {
     "id": "eq-kelvin-to-fahrenheit",
     "latex": "T_{{}^\\circ\\text{F}} = \\frac{9}{5}\\left(T_{\\text{K}} - 273.15\\right) + 32",
     "ktex": "\\kTempF = \\frac{9}{5}\\left(\\kTempK - 273.15\\right) + 32",
     "anchor": "13.1-temperature-scales"
    }
   ]
  },
  {
   "id": "absolute-zero",
   "kind": "idea",
   "section": "13.1",
   "name": "绝对零度",
   "terms": [
    "绝对零度"
   ],
   "statement": "绝对零度的概念来自气体的行为。保持体积不变的气体的压强，随温度降低而沿一条直线下降，不同气体的直线都外推到同一温度时压强为零，这个温度是 −273.15 °C。这表明存在一个最低温度，而其他热力学关系也导出同样的结论。在绝对零度 0 K 时，分子运动处于可能的最低能量；大多数气体在达到绝对零度之前就已液化然后凝固，而且实际上不可能达到绝对零度。"
  },
  {
   "id": "thermal-equilibrium",
   "kind": "definition",
   "section": "13.1",
   "name": "热平衡",
   "terms": [
    "热平衡"
   ],
   "statement": "两个处于热接触的系统，当它们的温度相同时就处于热平衡，这时没有热量在它们之间流动，两者的温度也都不再变化。任何两个处于热接触、但与环境的其余部分隔绝的系统都会达到这种状态：热量从较热的物体流向较冷的物体，直到它们的温度相等。这就是为什么温度计（它实际测量的是它自己的温度）在经过足够长的时间之后，读出的是它所接触物体的温度。单个物体在其内部没有热量流动、温度均匀时，处于内部热平衡。"
  },
  {
   "id": "zeroth-law-of-thermodynamics",
   "kind": "axiom",
   "section": "13.1",
   "name": "热力学第零定律",
   "terms": [
    "热力学第零定律"
   ],
   "statement": "如果系统 A 和 B 彼此处于热平衡，而 B 又与第三个系统 C 处于热平衡，那么 A 也与 C 处于热平衡。这个结论看似显而易见，因为三者具有相同的温度，但它是热力学的基础。它之所以称为第零定律，是因为它在逻辑上先于第一和第二定律，尽管物理学家是在它们之后才表述它的。它让你可以相信，分别接触同一块板上两个不同物块的两支温度计，读出的是同一个数，因此它使温度成为一个有意义的概念。"
  },
  {
   "id": "celsius-scale",
   "kind": "definition",
   "section": "13.1",
   "name": "摄氏温标",
   "terms": [
    "摄氏温标"
   ],
   "statement": "摄氏温标是这样一种温标：在标准大气压下，水的凝固点为 0 °C，沸点为 100 °C。"
  },
  {
   "id": "degree-celsius",
   "kind": "definition",
   "section": "13.1",
   "name": "摄氏度",
   "terms": [
    "摄氏度"
   ],
   "statement": "摄氏度是摄氏温标的单位，为水的凝固点与沸点之间间隔的百分之一。它与开尔文大小相同。"
  },
  {
   "id": "fahrenheit-scale",
   "kind": "definition",
   "section": "13.1",
   "name": "华氏温标",
   "terms": [
    "华氏温标"
   ],
   "statement": "华氏温标是这样一种温标：在标准大气压下，水的凝固点为 32 °F，沸点为 212 °F。"
  },
  {
   "id": "degree-fahrenheit",
   "kind": "definition",
   "section": "13.1",
   "name": "华氏度",
   "terms": [
    "华氏度"
   ],
   "statement": "华氏度是华氏温标的单位，为水的凝固点与沸点之间间隔的一百八十分之一，所以一摄氏度的大小是它的 1.8 倍。"
  },
  {
   "id": "kelvin-scale",
   "kind": "definition",
   "section": "13.1",
   "name": "开尔文温标",
   "terms": [
    "开尔文温标"
   ],
   "statement": "开尔文温标是科学上的热力学温标。它的零点是绝对零度，它的单位开尔文写作 K，不带度的符号，与一摄氏度大小相等，所以水在 273.15 K 凝固，在 373.15 K 沸腾。"
  },
  {
   "id": "thermal-expansion",
   "kind": "idea",
   "section": "13.2",
   "name": "热膨胀",
   "terms": [
    "热膨胀"
   ],
   "statement": "热膨胀是给定质量的物体的大小或体积随温度的变化。热空气上升是由于热膨胀：膨胀的空气密度比周围的空气小，对给定质量的浮力更大；铁轨和桥需要伸缩缝也是由于它。其原因在于，温度升高使原子的动能增大，原子微小而快速的振动平均而言把相邻的原子推得稍远一些，这稍大一点的间距累积起来就成为更大的物体。对大多数物质来说，没有择优的方向，物体在每个维度上按相同的比例增大。"
  },
  {
   "id": "linear-thermal-expansion",
   "kind": "axiom",
   "section": "13.2",
   "name": "线膨胀",
   "statement": "物体长度的变化与其长度和温度的变化成正比，比例系数是线胀系数，它取决于材料，并随温度略有变化。由于一开尔文与一摄氏度大小相同，系数和温度变化都可以用其中任何一种。该方程对温度的小变化是精确的，对大的变化可以用线胀系数的平均值。",
   "forms": [
    {
     "id": "eq-linear-expansion",
     "latex": "\\Delta L = \\alpha L\\Delta T",
     "ktex": "\\kdL = \\alpha L\\kdTemp",
     "condition": "温度的小变化",
     "anchor": "13.2-linear-expansion"
    }
   ]
  },
  {
   "id": "area-thermal-expansion",
   "kind": "result",
   "section": "13.2",
   "name": "二维热膨胀",
   "statement": "物体在所有维度上都膨胀，所以面积增大，是因为它的长度和宽度都增大。对于小的温度变化，面积的变化等于线胀系数的两倍乘以面积再乘以温度的变化，因为两个维度各自贡献线性的比例。",
   "forms": [
    {
     "id": "eq-area-expansion",
     "latex": "\\Delta A = 2\\alpha A\\Delta T",
     "ktex": "\\Delta A = 2\\alpha A\\kdTemp",
     "condition": "温度的小变化",
     "anchor": "13.2-two-and-three-dimensions"
    }
   ]
  },
  {
   "id": "holes-expand-too",
   "kind": "result",
   "section": "13.2",
   "name": "孔的膨胀",
   "statement": "如果在一块金属板上切出一个孔，剩下的材料的膨胀恰如那块圆塞仍在原处时一样。圆塞会变大，所以孔也一定变大：孔壁上相邻的一圈原子随温度升高而相互推得更远，这一圈就变得稍大一些。加热一个物体时，孔不会闭合。"
  },
  {
   "id": "volume-thermal-expansion",
   "kind": "axiom",
   "section": "13.2",
   "name": "三维热膨胀",
   "statement": "体积的变化非常接近于线胀系数的三倍乘以体积再乘以温度变化。该方程通常使用约为线胀系数三倍的体胀系数，表 13.2 中的数值几乎精确地显示了这一点。液体和气体只有体胀系数，而气体的系数是所有系数中最大的，并且对每一种气体几乎相同。",
   "forms": [
    {
     "id": "eq-volume-expansion",
     "latex": "\\Delta V = \\beta V\\Delta T",
     "ktex": "\\Delta V = \\beta V\\kdTemp",
     "anchor": "13.2-two-and-three-dimensions"
    },
    {
     "id": "eq-beta-three-alpha",
     "latex": "\\beta \\approx 3\\alpha",
     "anchor": "13.2-two-and-three-dimensions"
    }
   ]
  },
  {
   "id": "differential-thermal-expansion",
   "kind": "skill",
   "section": "13.2",
   "name": "求膨胀的液体溢出多少",
   "statement": "当装满的容器和其中的液体一起变暖时，两者都膨胀，但液体膨胀得更多，溢出的量是两者体积变化之差。由于原来的体积相等，三个方程合并成一个：溢出量等于两个体胀系数之差乘以体积再乘以温度变化。同样的差值，也是夏天油箱里的质量比冬天更少时油量表就显示为空的原因，也是装满到杯口的烧杯变暖时会溢出的原因。",
   "forms": [
    {
     "id": "eq-spill-volume",
     "latex": "V_{\\text{spill}} = \\left(\\beta_{\\text{gas}} - \\beta_{\\text{s}}\\right)V\\Delta T",
     "ktex": "V_{\\text{spill}} = \\left(\\beta_{\\text{gas}} - \\beta_{\\text{s}}\\right)V\\kdTemp",
     "anchor": "13.2-filling-the-tank"
    }
   ]
  },
  {
   "id": "anomalous-expansion-of-water",
   "kind": "idea",
   "section": "13.2",
   "name": "水的反常膨胀",
   "statement": "水是物体随温度升高而膨胀这一规律的最重要的例外。在 4 °C 以上，它随温度升高而膨胀，但在 4 °C 和 0 °C 之间，它随温度降低而膨胀，所以它在 4 °C 时密度最大。最显著的效应是池塘的结冰：表面的水冷却到 4 °C，下沉，并使池塘的水上下翻转，直到整个池塘的水都处于 4 °C；表面一层进一步冷却后，密度比下面的水小而留在上面，于是表面结冰，冰使下面的水与外界隔热，鱼就在那里度过冬天。"
  },
  {
   "id": "thermal-stress",
   "kind": "result",
   "section": "13.2",
   "name": "热应力",
   "terms": [
    "热应力"
   ],
   "statement": "当有东西限制热膨胀或收缩时，就会产生热应力。要求一个受热物体若不能膨胀将会施加的压强，先取它在固定压强下会产生的体积变化，再用体积模量求出把这一体积挤回去所需的压强。这样的压强通常大得惊人：保持体积不变的汽油经历 20 °C 的升温，将达到 1.83 × 10⁷ Pa，约 2500 lb/in²，远远超出油箱所能承受的。热应力使铁轨弯曲，使输电线绷断，使冷却不均匀的玻璃开裂，使岩石和路面风化，也使食物冻结时的生物细胞胀破。",
   "forms": [
    {
     "id": "eq-thermal-stress",
     "latex": "P = \\frac{F}{A} = \\frac{\\Delta V}{V_0}B",
     "ktex": "\\kPr = \\frac{\\kF}{A} = \\frac{\\Delta V}{V_0}\\kBb",
     "anchor": "13.2-thermal-stress"
    }
   ]
  },
  {
   "id": "coefficient-of-linear-expansion",
   "kind": "definition",
   "section": "13.2",
   "name": "线胀系数",
   "symbol": "α_exp",
   "terms": [
    "线膨胀系数"
   ],
   "type": "temperature-coefficient",
   "statement": "线胀系数是每单位长度、温度每改变一度时长度的变化。它取决于材料，并随温度略有变化，它的单位是摄氏度的倒数，1/°C。"
  },
  {
   "id": "coefficient-of-volume-expansion",
   "kind": "definition",
   "section": "13.2",
   "name": "体胀系数",
   "symbol": "β",
   "terms": [
    "体膨胀系数"
   ],
   "type": "temperature-coefficient",
   "statement": "体胀系数是每单位体积、温度每改变一度时体积的变化。对固体来说，它非常接近线胀系数的三倍，而液体的值比固体大得多。"
  },
  {
   "id": "ideal-gas",
   "kind": "idea",
   "section": "13.3",
   "name": "理想气体",
