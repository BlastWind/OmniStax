 "concepts": [
  {
   "id": "restoring-force",
   "kind": "definition",
   "section": "16.1",
   "name": "回复力",
   "symbol": "F",
   "terms": [
    "回复力"
   ],
   "type": "force",
   "statement": "当物体偏离其平衡位置时，形变会产生一个方向相反的力，把物体推回去。没有这样的力就没有振动，因为物体只会沿直线匀速运动。"
  },
  {
   "id": "force-constant",
   "kind": "definition",
   "section": "16.1",
   "name": "劲度系数",
   "symbol": "k",
   "terms": [
    "劲度系数"
   ],
   "type": "stiffness",
   "statement": "劲度系数表明一个系统的刚度有多大。$\\kk$ 越大，同样的位移下回复力越大，系统的刚度也越大。它是回复力—位移图像的斜率，单位为牛每米。"
  },
  {
   "id": "hookes-law",
   "kind": "axiom",
   "section": "16.1",
   "name": "胡克定律",
   "terms": [
    "胡克定律"
   ],
   "statement": "发生形变的系统的回复力与它偏离平衡位置的位移成正比，方向与位移相反，$\\kF = -\\kk\\kx$。这就是胡克定律，最简单的振动出现在服从它的系统中。由力和位移可以求出劲度系数。",
   "forms": [
    {
     "id": "eq-hooke",
     "latex": "F = -kx",
     "ktex": "\\kF = -\\kk\\kx",
     "anchor": "16.1-hookes-law"
    },
    {
     "id": "eq-hooke-dl",
     "latex": "F = k\\Delta L",
     "ktex": "\\kF = \\kk\\kdL",
     "condition": "小形变，物体能恢复原来的形状",
     "section": "5.3",
     "anchor": "5.3-deformation"
    },
    {
     "id": "eq-dl-from-k",
     "latex": "\\Delta L = \\frac{F}{k}",
     "ktex": "\\kdL = \\frac{\\kF}{\\kk}",
     "section": "5.3",
     "anchor": "5.3-deformation"
    },
    {
     "id": "eq-k",
     "latex": "k = -\\frac{F}{x}",
     "ktex": "\\kk = -\\frac{\\kF}{\\kx}",
     "anchor": "16.1-ex-car"
    }
   ]
  },
  {
   "id": "periodic-motion",
   "kind": "definition",
   "section": "16.2",
   "name": "周期运动",
   "terms": [
    "周期运动"
   ],
   "statement": "以规则的时间间隔重复自身的运动，例如被拨动的吉他弦或弹簧上上下下运动的物体，就是周期运动。每一次重复所用的时间都与前一次相同，这正是周期和频率有意义的原因。"
  },
  {
   "id": "period",
   "kind": "definition",
   "section": "16.2",
   "name": "周期",
   "symbol": "T",
   "terms": [
    "周期"
   ],
   "type": "time",
   "statement": "周期是完成一次振动所用的时间。其单位通常是秒，但也可以是任何方便的时间单位。这个词适用于任何事件所用的时间，无论是否重复，但这里指的是周期运动一个循环所用的时间。"
  },
  {
   "id": "frequency",
   "kind": "definition",
   "section": "16.2",
   "name": "频率",
   "symbol": "f",
   "terms": [
    "频率"
   ],
   "type": "frequency",
   "statement": "频率是单位时间内事件发生的次数。对周期运动而言，它是单位时间内的振动次数，以赫兹为单位，一赫兹就是每秒一个循环。用循环数除以所用的时间就得到频率，无论这个数是否是在一秒内数出的。"
  },
  {
   "id": "period-frequency",
   "kind": "result",
   "section": "16.2",
   "name": "周期与频率",
   "statement": "如果一个循环用时 $\\kT$，那么每单位时间内容纳 $1/\\kT$ 个循环，所以频率是周期的倒数，周期也是频率的倒数。已知其中一个，另一个立即可得。",
   "forms": [
    {
     "id": "eq-period-frequency",
     "latex": "f = \\frac{1}{T}",
     "ktex": "\\kf = \\frac{1}{\\kT}",
     "anchor": "16.2-frequency"
    },
    {
     "id": "eq-frequency-period",
     "latex": "T = \\frac{1}{f}",
     "ktex": "\\kT = \\frac{1}{\\kf}",
     "anchor": "16.2-ex-ultrasound"
    },
    {
     "id": "eq-generator-period",
     "latex": "T = \\frac{1}{f} = \\frac{2\\pi}{\\omega}",
     "ktex": "\\kT = \\frac{1}{\\kf} = \\frac{2\\pi}{\\kw}",
     "section": "23.5",
     "anchor": "23.5-the-emf-at-each-instant"
    }
   ]
  },
  {
   "id": "simple-harmonic-motion",
   "kind": "definition",
   "section": "16.3",
   "name": "简谐运动",
   "terms": [
    "简谐运动"
   ],
   "statement": "当系统所受的合力可以用胡克定律描述且没有阻尼时，系统在平衡位置两侧以相等的位移振动。这就是简谐运动，是最简单也最常见的振动，而这样的系统就是简谐振子。"
  },
  {
   "id": "amplitude",
   "kind": "definition",
   "section": "16.3",
   "name": "振幅",
   "symbol": "X",
   "terms": [
    "振幅"
   ],
   "type": "position",
   "statement": "振幅是偏离平衡位置的最大位移。它的单位与位移相同，弹簧上的物体以米为单位，并且与振动中的能量有关。在一个完整的周期内，物体走过四个振幅的路程。"
  },
  {
   "id": "shm-period",
   "kind": "result",
   "section": "16.3",
   "name": "简谐振子的周期",
   "statement": "简谐振子的周期和频率只取决于质量和劲度系数，与振幅无关。刚度越大的系统周期越短，质量越大的系统周期越长。因为周期是恒定的，简谐振子可以用作时钟。",
   "forms": [
    {
     "id": "eq-shm-period",
     "latex": "T = 2\\pi\\sqrt{\\frac{m}{k}}",
     "ktex": "\\kT = 2\\pi\\sqrt{\\frac{m}{\\kk}}",
     "anchor": "16.3-shm-period"
    },
    {
     "id": "eq-shm-frequency",
     "latex": "f = \\frac{1}{2\\pi}\\sqrt{\\frac{k}{m}}",
     "ktex": "\\kf = \\frac{1}{2\\pi}\\sqrt{\\frac{\\kk}{m}}",
     "anchor": "16.3-shm-period"
    }
   ]
  },
  {
   "id": "shm-kinematics",
   "kind": "result",
   "section": "16.3",
   "name": "简谐运动的运动学",
   "statement": "任何简谐运动的位移都是时间的余弦函数，$\\kx(t) = \\kX\\cos(2\\pi\\kt/\\kT)$。速度是正弦函数，最大值为 $\\kvmax = 2\\pi\\kX/\\kT = \\kX\\sqrt{\\kk/m}$，在折返点为零，经过平衡位置时最大；加速度是余弦函数，方向与位移相反。这些正弦波把简谐运动与波联系起来。",
   "forms": [
    {
     "id": "eq-shm-x",
     "latex": "x(t) = X\\cos\\frac{2\\pi t}{T}",
     "ktex": "\\kx(\\kt) = \\kX\\cos\\frac{2\\pi\\kt}{\\kT}",
     "anchor": "16.3-shm-waves"
    },
    {
     "id": "eq-shm-v",
     "latex": "v(t) = -v_{\\text{max}}\\sin\\frac{2\\pi t}{T}",
     "ktex": "\\kv(\\kt) = -\\kvmax\\sin\\frac{2\\pi\\kt}{\\kT}",
     "anchor": "16.3-shm-waves"
    },
    {
     "id": "eq-vmax",
     "latex": "v_{\\text{max}} = \\frac{2\\pi X}{T} = X\\sqrt{\\frac{k}{m}}",
     "ktex": "\\kvmax = \\frac{2\\pi\\kX}{\\kT} = \\kX\\sqrt{\\frac{\\kk}{m}}",
     "anchor": "16.3-shm-waves"
    },
    {
     "id": "eq-shm-a",
     "latex": "a(t) = -\\frac{kX}{m}\\cos\\frac{2\\pi t}{T}",
     "ktex": "\\ka(\\kt) = -\\frac{\\kk\\kX}{m}\\cos\\frac{2\\pi\\kt}{\\kT}",
     "anchor": "16.3-shm-waves"
    },
    {
     "id": "eq-wave-at-a-point",
     "latex": "x = X\\cos\\left(\\frac{2\\pi t}{T}\\right) = X\\cos(2\\pi f t)",
     "ktex": "\\kx = \\kX\\cos\\left(\\frac{2\\pi\\kt}{\\kT}\\right) = \\kX\\cos(2\\pi\\kf\\kt)",
     "section": "16.10",
     "anchor": "16.10-beats"
    }
   ]
  },
  {
   "id": "simple-harmonic-oscillator",
   "kind": "definition",
   "section": "16.3",
   "name": "简谐振子",
   "terms": [
    "简谐振子"
   ],
   "statement": "简谐振子是服从胡克定律、因而做简谐运动的系统，例如连在弹簧上的物体。"
  },
  {
   "id": "simple-pendulum",
   "kind": "definition",
   "section": "16.4",
   "name": "单摆",
   "terms": [
    "单摆"
   ],
   "statement": "单摆是用轻细绳悬挂的一个小质量物体，即摆锤。沿其圆弧发生位移时，它受到指向最低点的合力 $-m\\kg\\sin\\theta$，因为张力抵消了重力沿绳方向的分量。对于小位移，它是简谐振子。"
  },
  {
   "id": "pendulum-restoring-force",
   "kind": "result",
   "section": "16.4",
   "name": "摆所受的回复力",
   "statement": "对于小于约 15° 的角度，$\\sin\\theta$ 与 $\\theta$ 相差不超过 1%，所以回复力 $-m\\kg\\sin\\theta$ 变为 $-m\\kg\\theta$，再由 $\\ks = L\\theta$，它就是 $-\\frac{m\\kg}{L}\\ks$。这就是劲度系数为 $\\kk = m\\kg/L$ 的胡克定律，也正是它使摆成为简谐振子。",
   "forms": [
    {
     "id": "eq-pendulum-force",
     "latex": "F \\approx -\\frac{mg}{L}s",
     "ktex": "\\kF \\approx -\\frac{m\\kg}{L}\\ks",
     "anchor": "16.4-small-angle"
    }
   ]
  },
  {
   "id": "pendulum-period",
   "kind": "result",
   "section": "16.4",
   "name": "单摆的周期",
   "statement": "把 $\\kk = m\\kg/L$ 代入 $\\kT = 2\\pi\\sqrt{m/\\kk}$，质量被消去，得到 $\\kT = 2\\pi\\sqrt{L/\\kg}$。只有摆长和重力加速度影响周期；质量不影响，对于小幅摆动，振幅也几乎不影响。这就是摆能够计时的原因。",
   "forms": [
    {
     "id": "eq-pendulum-period",
     "latex": "T = 2\\pi\\sqrt{\\frac{L}{g}}",
     "ktex": "\\kT = 2\\pi\\sqrt{\\frac{L}{\\kg}}",
     "anchor": "16.4-pendulum-period"
    }
   ]
  },
  {
   "id": "measuring-g",
   "kind": "skill",
   "section": "16.4",
   "name": "用摆测量 g",
   "statement": "把周期公式平方并解出 $\\kg$，得 $\\kg = 4\\pi^2 L/\\kT^2$。如果摆长已精确知道，并且在小角度下对许多次摆动计时，就能把当地的重力加速度测到几位数字，这在地质勘探中很重要。",
   "forms": [
    {
     "id": "eq-g-from-pendulum",
     "latex": "g = 4\\pi^2\\frac{L}{T^2}",
     "ktex": "\\kg = 4\\pi^2\\frac{L}{\\kT^2}",
     "anchor": "16.4-ex-measuring-g"
    }
   ]
  },
  {
   "id": "shm-energy",
   "kind": "result",
   "section": "16.5",
   "name": "简谐振子的能量",
   "statement": "简谐振子没有耗散力，所以它的能量在弹性势能和动能之间分配，总量不变。随着系统振动，能量完全地从一种形式转为另一种：在折返点全是势能，经过平衡位置时全是动能。从静止开始、起始 $\\kx = \\kX$ 时，总能量为 $\\tfrac{1}{2}\\kk\\kX^2$。",
   "forms": [
    {
     "id": "eq-shm-energy",
     "latex": "\\tfrac{1}{2}mv^2 + \\tfrac{1}{2}kx^2 = \\text{常量}",
     "ktex": "\\tfrac{1}{2}m\\kv^2 + \\tfrac{1}{2}\\kk\\kx^2 = \\text{常量}",
     "anchor": "16.5-shm-energy"
    },
    {
     "id": "eq-shm-total",
     "latex": "\\tfrac{1}{2}mv^2 + \\tfrac{1}{2}kx^2 = \\tfrac{1}{2}kX^2",
     "ktex": "\\tfrac{1}{2}m\\kv^2 + \\tfrac{1}{2}\\kk\\kx^2 = \\tfrac{1}{2}\\kk\\kX^2",
     "anchor": "16.5-max-speed"
    },
    {
     "id": "eq-pendulum-energy",
     "latex": "\\tfrac{1}{2}mL^2\\omega^2 + \\tfrac{1}{2}mgL\\theta^2 = \\text{常量}",
     "ktex": "\\tfrac{1}{2}mL^2\\kw^2 + \\tfrac{1}{2}m\\kg L\\theta^2 = \\text{常量}",
     "anchor": "16.5-shm-energy"
    },
    {
     "id": "eq-omega-max",
     "latex": "\\omega_{\\text{max}} = \\sqrt{\\frac{g}{L}}\\theta_{\\text{max}}",
     "ktex": "\\kwmax = \\sqrt{\\frac{\\kg}{L}}\\theta_{\\text{max}}",
     "anchor": "16.5-max-speed"
    }
   ]
  },
  {
   "id": "shm-max-speed",
   "kind": "result",
   "section": "16.5",
   "name": "简谐运动中的速率",
   "statement": "由能量守恒解出速度，就得到每个位置处的速率，在平衡位置最大，在折返点为零，其中 $\\kvmax = \\kX\\sqrt{\\kk/m}$。最大速度与振幅成正比，刚度越大的系统越大，质量越大则越小。",
   "forms": [
    {
     "id": "eq-v-of-x",
     "latex": "v = \\pm v_{\\text{max}}\\sqrt{1 - \\frac{x^2}{X^2}}",
     "ktex": "\\kv = \\pm\\kvmax\\sqrt{1 - \\frac{\\kx^2}{\\kX^2}}",
     "anchor": "16.5-max-speed"
    },
    {
     "id": "eq-vmax-energy",
     "latex": "v_{\\text{max}} = X\\sqrt{\\frac{k}{m}}",
     "ktex": "\\kvmax = \\kX\\sqrt{\\frac{\\kk}{m}}",
     "anchor": "16.5-max-speed"
    }
   ]
  },
  {
   "id": "ucm-shm-projection",
   "kind": "result",
   "section": "16.6",
   "name": "匀速圆周运动的投影",
   "statement": "一个以恒定角速度 $\\kw$ 绕圆周运动的点，在固定轴上的投影位于 $\\kx = \\kX\\cos\\kw\\kt$，而由 $\\kw = 2\\pi/\\kT$，这恰好就是简谐振子的位置。因此转盘上小球的影子做简谐运动，任何简谐振子的速率和周期都可以从圆上读出：由相似三角形得 $\\kv = \\kvmax\\sqrt{1 - \\kx^2/\\kX^2}$，转一周则得 $\\kT = 2\\pi\\kX/\\kvmax = 2\\pi\\sqrt{m/\\kk}$。",
   "forms": [
    {
     "id": "eq-omega-T",
     "latex": "\\omega = \\frac{2\\pi}{T}",
     "ktex": "\\kw = \\frac{2\\pi}{\\kT}",
     "anchor": "16.6-projection"
    },
    {
     "id": "eq-x-cos-theta",
     "latex": "x = X\\cos\\theta",
     "ktex": "\\kx = \\kX\\cos\\theta",
     "anchor": "16.6-projection"
    },
    {
     "id": "eq-x-cos-wt",
     "latex": "x = X\\cos\\omega t",
     "ktex": "\\kx = \\kX\\cos\\kw\\kt",
     "anchor": "16.6-projection"
    },
    {
     "id": "eq-v-similar",
     "latex": "\\frac{v}{v_{\\text{max}}} = \\sqrt{1 - \\frac{x^2}{X^2}}",
     "ktex": "\\frac{\\kv}{\\kvmax} = \\sqrt{1 - \\frac{\\kx^2}{\\kX^2}}",
     "anchor": "16.6-from-the-circle"
    },
    {
     "id": "eq-T-from-circle",
     "latex": "T = \\frac{2\\pi X}{v_{\\text{max}}}",
     "ktex": "\\kT = \\frac{2\\pi\\kX}{\\kvmax}",
     "anchor": "16.6-from-the-circle"
    }
   ]
  },
  {
   "id": "damped-harmonic-motion",
   "kind": "idea",
   "section": "16.7",
   "name": "阻尼简谐运动",
   "statement": "完全无阻尼的运动是罕见的，因为摩擦和其他非保守力很少可以忽略；吉他弦在你拨动后几秒钟就停了。阻尼很小时，周期和频率几乎保持简谐运动的值，但随着阻尼力带走能量（通常变为热能），振幅逐渐减小。阻尼越大，对运动的阻碍和减慢越多，于是周期和频率开始变化。阻尼非常大时，系统根本不振动。"
  },
  {
   "id": "nonconservative-work-damping",
   "kind": "result",
   "section": "16.7",
   "name": "阻尼带走的能量",
   "statement": "非保守力带走的能量由 $\\kWnc = \\Delta(\\kKE + \\kPEtot)$ 描述，其中 $\\kWnc$ 是非保守力（这里是阻尼力）所做的功。对阻尼简谐振子，这个功是负的，因为它从系统中带走机械能，所以阻尼振子的机械能只会随时间减小。",
   "forms": [
    {
     "id": "eq-wnc-damping",
     "latex": "W_{\\text{nc}} = \\Delta(\\text{KE} + \\text{PE})",
     "ktex": "\\kWnc = \\Delta(\\kKE + \\kPEtot)",
     "anchor": "16.7-damping"
    }
   ]
  },
  {
   "id": "critical-damping",
   "kind": "definition",
   "section": "16.7",
   "name": "临界阻尼",
   "terms": [
    "临界阻尼"
   ],
   "statement": "临界阻尼使振子尽可能快地回到平衡位置。临界阻尼系统可能越过平衡位置，但如果越过，也只会越过一次。汽车悬架和体重秤都用它，因为系统能迅速回到平衡并停在那里。恒力使它在最短的时间内、不经振动地移到新的平衡位置。"
  },
  {
   "id": "underdamping",
   "kind": "definition",
   "section": "16.7",
   "name": "欠阻尼",
   "terms": [
    "欠阻尼"
   ],
   "statement": "阻尼小于临界阻尼时，系统比临界阻尼系统更快地趋向平衡，但会越过并一次或多次穿过平衡位置，其振幅逐渐减小到零。这样的系统是欠阻尼的，而振幅缓慢衰减、周期几乎不变的轻阻尼振子是常见的情形。"
  },
  {
   "id": "overdamping",
   "kind": "definition",
   "section": "16.7",
   "name": "过阻尼",
   "terms": [
    "过阻尼"
   ],
   "statement": "过阻尼系统（曲线 B）不经振动就回到平衡位置，所用时间比临界阻尼系统更长；与临界阻尼系统一样，它可能越过平衡位置，但很慢才到达平衡。在小振幅运动比快速回位更重要的场合需要大阻尼，其代价是缓慢。"
  },
  {
   "id": "friction-damped-oscillator",
   "kind": "skill",
   "section": "16.7",
   "name": "求摩擦阻尼振子经过的路程",
   "statement": "当阻尼是简单的摩擦时，它做的功是 $-\\kff\\kd$，其中 $\\kff = \\mu_{\\text{k}} m\\kg$，$\\kd$ 是经过的总路程，运动停在摩擦力与弹簧力平衡的位置，即 $\\kx = \\mu_{\\text{k}} m\\kg/\\kk$。令摩擦力所做的功等于储存的弹性势能的变化，就得到物体停下之前经过的总路程。这是一道综合概念题：先用牛顿定律处理摩擦，再用功和能量守恒。",
   "forms": [
