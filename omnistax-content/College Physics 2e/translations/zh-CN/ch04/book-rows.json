 "concepts": [
  {
   "id": "dynamics",
   "kind": "definition",
   "section": "4.1",
   "name": "动力学",
   "terms": [
    "动力学"
   ],
   "statement": "动力学是研究使物体和系统运动的力的学科。运动学描述物体如何运动，而动力学追问它为什么那样运动；牛顿运动定律是动力学的基础。"
  },
  {
   "id": "force",
   "kind": "definition",
   "section": "4.1",
   "name": "力",
   "symbol": "F",
   "terms": [
    "力"
   ],
   "type": "force",
   "statement": "力是一种推或拉，它既有大小又有方向，所以是矢量，其相加方式与其他矢量相同。"
  },
  {
   "id": "external-force",
   "kind": "definition",
   "section": "4.1",
   "name": "外力",
   "terms": [
    "外力"
   ],
   "statement": "只有从物体外部作用于它的力才会改变它的运动。在应用任何定律之前，先把力分成来自外部的力和作用于物体各部分之间的力。物体不能靠自己推动自己前进。"
  },
  {
   "id": "free-body-diagram",
   "kind": "skill",
   "section": "4.1",
   "name": "画受力图",
   "statement": "受力图把物体画成一个点，把作用于它的每一个外力画成从该点出发的箭头，这样就可以把这些力相加，而不会被情境的画面所干扰。"
  },
  {
   "id": "force-standard",
   "kind": "idea",
   "section": "4.1",
   "name": "力的标准单位",
   "statement": "只有与某个可以一再产生的力相比，你才能测量一个力，就像你要与一个标准距离相比才能测量距离一样。拉伸的弹簧提供了这样一个标准，这样你就可以把任何其他力的大小表示为它的倍数。"
  },
  {
   "id": "free-body-diagram-def",
   "kind": "definition",
   "section": "4.1",
   "name": "受力图",
   "terms": [
    "受力图"
   ],
   "statement": "受力图是一幅草图，它显示作用于物体或系统的所有外力，其中系统用一个点表示，力用从该点向外延伸的箭头表示。"
  },
  {
   "id": "newtons-first-law",
   "kind": "axiom",
   "section": "4.2",
   "name": "牛顿第一定律",
   "terms": [
    "惯性定律",
    "牛顿第一定律"
   ],
   "statement": "静止的物体保持静止，运动的物体保持恒定速度的运动，除非有合外力作用于它。这条定律说明速度的变化是有原因的，所以一个停下来的滑动物体是被某种东西止住的，而摩擦力就是那种东西。"
  },
  {
   "id": "inertia",
   "kind": "definition",
   "section": "4.2",
   "name": "惯性",
   "terms": [
    "惯性"
   ],
   "statement": "惯性是物体使其保持静止或保持恒定速度运动的性质，这就是牛顿第一定律又称惯性定律的原因。有些物体的惯性比另一些大，而这种差别正是质量所衡量的。"
  },
  {
   "id": "mass",
   "kind": "definition",
   "section": "4.2",
   "name": "质量",
   "symbol": "m",
   "terms": [
    "质量"
   ],
   "type": "mass",
   "statement": "质量是物体所含物质的量，也是物体具有多大惯性的量度。与重力不同，质量不随位置而变：一个物体在地球上、在轨道上和在月球上的质量相同，而质量在实践中是通过与千克原器比较得到的。"
  },
  {
   "id": "system-of-interest",
   "kind": "skill",
   "section": "4.3",
   "name": "确定所研究的系统",
   "statement": "哪些力算作外力取决于你在哪里划定系统的边界，所以在写出牛顿第二定律之前先选定边界。四轮小车及其乘坐者构成一个系统；四轮小车单独构成另一个系统，而这两个系统给出不同的合力。",
   "forms": [
    {
     "id": "eq-fnet-floor",
     "latex": "F_{\\text{net}} = F_{\\text{floor}} - f",
     "ktex": "\\kFnet = \\kFfloor - \\kff",
     "condition": "教授、小车和设备取作一个系统",
     "section": "4.4",
     "anchor": "4.4-choosing-a-system"
    },
    {
     "id": "eq-fprof",
     "latex": "F_{\\text{prof}} = F_{\\text{net}} + f",
     "ktex": "\\kFprof = \\kFnet + \\kff",
     "condition": "小车和设备取作系统",
     "section": "4.4",
     "anchor": "4.4-choosing-a-system"
    }
   ]
  },
  {
   "id": "net-external-force",
   "kind": "definition",
   "section": "4.3",
   "name": "合外力",
   "symbol": "F_net",
   "terms": [
    "合外力"
   ],
   "type": "force",
   "statement": "合外力是作用于一个系统的所有外力的矢量和，可以像其他矢量那样用首尾相接法或按分量求出。它是代替所有这些力的单个力，也是第二定律把它与加速度联系起来的那个量。",
   "forms": [
    {
     "id": "eq-fapp-magnitude",
     "latex": "F_{\\text{app}} = \\sqrt{F_x^2 + F_y^2}",
     "ktex": "\\kFa = \\sqrt{\\kFx^2 + \\kFy^2}",
     "condition": "两个外加力相互垂直",
     "section": "4.7",
     "anchor": "4.7-drag"
    }
   ]
  },
  {
   "id": "newtons-second-law",
   "kind": "axiom",
   "section": "4.3",
   "name": "牛顿第二定律",
   "terms": [
    "牛顿第二定律"
   ],
   "statement": "系统的加速度与作用于它的合外力成正比，方向与合外力相同，并与它的质量成反比。它是三个各自都可以单独测量的量之间的关系，而不是一个定义。",
   "forms": [
    {
     "id": "eq-newton2",
     "latex": "\\mathbf{F}_{\\text{net}} = m\\mathbf{a}",
     "anchor": "4.3-second-law"
    },
    {
     "id": "eq-a-prop-fnet",
     "latex": "\\mathbf{a} \\propto \\mathbf{F}_{\\text{net}}",
     "anchor": "4.3-net-force"
    },
    {
     "id": "eq-a-prop-mass",
     "latex": "\\mathbf{a} \\propto \\frac{1}{m}",
     "anchor": "4.3-net-force"
    },
    {
     "id": "eq-newton2-a",
     "latex": "\\mathbf{a} = \\frac{\\mathbf{F}_{\\text{net}}}{m}",
     "anchor": "4.3-second-law"
    },
    {
     "id": "eq-newton2-mag",
     "latex": "F_{\\text{net}} = ma",
     "ktex": "\\kFnet = m\\ka",
     "condition": "只考虑力和加速度的大小",
     "anchor": "4.3-second-law"
    }
   ]
  },
  {
   "id": "newton-unit",
   "kind": "definition",
   "section": "4.3",
   "name": "牛顿",
   "statement": "力的 SI 单位由牛顿第二定律定义：一牛顿是使一个一千克的系统获得一米每二次方秒加速度的力。",
   "forms": [
    {
     "id": "eq-newton-unit",
     "latex": "1\\ \\text{N} = 1\\ \\text{kg}\\cdot\\text{m/s}^2",
     "anchor": "4.3-newton"
    }
   ]
  },
  {
   "id": "weight",
   "kind": "result",
   "section": "4.3",
   "name": "重力",
   "terms": [
    "重力"
   ],
   "type": "force",
   "statement": "物体的重力是作用于它的引力，对一个下落的物体应用牛顿第二定律，可得其大小为质量乘以重力加速度。重力是一种力，用牛顿来度量，并且它随物体附近的天体而变化。",
   "forms": [
    {
     "id": "eq-weight",
     "latex": "w = mg",
     "ktex": "\\kwgt = m\\kg",
     "anchor": "4.3-weight"
    }
   ]
  },
  {
   "id": "mass-versus-weight",
   "kind": "idea",
   "section": "4.3",
   "name": "质量与重力",
   "statement": "质量是物质的量，不随地点而变；重力是作用于这一质量的引力，会随地点而变。这两个词在日常语言中可以互换使用，但在物理学中它们的含义不同。"
  },
  {
   "id": "friction",
   "kind": "definition",
   "section": "4.3",
   "name": "摩擦力",
   "symbol": "f_fric",
   "terms": [
    "摩擦力"
   ],
   "type": "force",
   "statement": "摩擦力是阻碍相互接触的物体彼此相对运动的力。它是一种外力，也是使滑动的物体慢下来的原因。"
  },
  {
   "id": "system",
   "kind": "definition",
   "section": "4.3",
   "name": "系统",
   "terms": [
    "系统"
   ],
   "statement": "系统是被观察的物体或物体的集合，由它的边界界定。所有来自系统之外的力都是外力。"
  },
  {
   "id": "newtons-third-law",
   "kind": "axiom",
   "section": "4.4",
   "name": "牛顿第三定律",
   "terms": [
    "牛顿第三定律"
   ],
   "statement": "每当一个物体对第二个物体施加一个力，第一个物体就会受到一个大小相等、方向相反的力。力总是成对出现，没有哪个物体能在对另一个物体施力的同时自己不受力。"
  },
  {
   "id": "action-reaction-pairs",
   "kind": "idea",
   "section": "4.4",
   "name": "第三定律中的力对",
   "statement": "第三定律中一对力的两个力看起来似乎应该相互抵消，但它们并不抵消，因为它们作用在不同的系统上。池壁推游泳者的脚，游泳者的脚也推池壁，而其中只有前一个力是作用于游泳者的外力。"
  },
  {
   "id": "internal-forces-cancel",
   "kind": "result",
   "section": "4.4",
   "name": "内力的抵消",
   "statement": "一个系统两部分之间的力，其大小相等、方向相反的另一个力也在同一个系统之内，所以两者相加为零，合外力不变。这就是为什么把教授和手推车当作一个系统时，教授对手推车的推力就不再计入了。"
  },
  {
   "id": "thrust",
   "kind": "definition",
   "section": "4.4",
   "name": "推力",
   "symbol": "F_thrust",
   "terms": [
    "推力"
   ],
   "type": "force",
   "statement": "推力是向后抛出气体的火箭所受到的向前的反作用力：它对气体用力推，而根据第三定律，气体也同样用力地向前推火箭。推力驱动火箭、飞机和汽车。"
  },
  {
   "id": "normal-force",
   "kind": "definition",
   "section": "4.5",
   "name": "法向力",
   "symbol": "N",
   "terms": [
    "法向力"
   ],
   "type": "force",
   "statement": "凡是支撑一个重物的东西，都必须向上推它，而当这种支撑垂直于接触面时，就称为法向力。桌子在一袋狗粮的压力下下垂，直到它的回复力与重力一样大，在水平面上这使法向力等于重力；在斜面上，或者当物体加速时，则不然。",
   "forms": [
    {
     "id": "eq-normal",
     "latex": "N = mg",
     "ktex": "\\kN = m\\kg",
     "condition": "静止在不加速的水平面上的物体",
     "anchor": "4.5-normal-force"
    }
   ]
  },
  {
   "id": "weight-components-on-incline",
   "kind": "result",
   "section": "4.5",
   "name": "斜面上的重力",
   "statement": "在斜坡上方便的坐标轴是沿着和垂直于表面的方向，而重力是不沿其中任何一个方向的那个力，所以把它分解为平行于斜面的分量和垂直于斜面的分量，前者驱使物体沿斜面向下，后者由法向力平衡。",
   "forms": [
    {
     "id": "eq-w-parallel",
     "latex": "w_{\\parallel} = w\\sin\\theta = mg\\sin\\theta",
     "ktex": "\\kwpar = \\kwgt\\sin\\theta = m\\kg\\sin\\theta",
     "condition": "与水平面成角 θ 的斜面",
     "anchor": "4.5-weight-on-incline"
    },
    {
     "id": "eq-w-perp",
     "latex": "w_{\\perp} = w\\cos\\theta = mg\\cos\\theta",
     "ktex": "\\kwperp = \\kwgt\\cos\\theta = m\\kg\\cos\\theta",
     "condition": "与水平面成角 θ 的斜面",
     "anchor": "4.5-weight-on-incline"
    },
    {
     "id": "eq-N-incline",
     "latex": "N = w_{\\perp} = w\\cos\\theta = mg\\cos\\theta",
     "ktex": "\\kN = \\kwperp = \\kwgt\\cos\\theta = m\\kg\\cos\\theta",
     "condition": "垂直于斜坡方向没有运动",
     "section": "5.1",
     "anchor": "5.1-incline"
    }
   ]
  },
  {
   "id": "acceleration-on-frictionless-incline",
   "kind": "result",
   "section": "4.5",
   "name": "沿无摩擦斜面下滑的加速度",
   "statement": "用重力平行于斜面的分量除以质量，质量就约掉了，所以每个物体沿同一倾角的无摩擦斜面下滑的加速度都相同，正如在没有空气阻力时每个物体下落的加速度都相同一样。",
   "forms": [
    {
     "id": "eq-a-incline",
     "latex": "a_{\\parallel} = g\\sin\\theta",
     "ktex": "\\kapar = \\kg\\sin\\theta",
     "condition": "斜面上的摩擦可忽略",
     "anchor": "4.5-weight-on-incline"
    }
   ]
  },
  {
   "id": "tension",
   "kind": "definition",
   "section": "4.5",
   "name": "张力",
   "symbol": "T_force",
   "terms": [
    "张力"
   ],
   "type": "force",
   "statement": "张力是沿着绳、缆绳或肌腱等柔索的长度方向传递的力。柔索只能拉，不能推，所以它传递的力总是平行于它的长度，而且在没有摩擦的地方，张力沿柔索处处相同。"
  },
  {
   "id": "tension-supports-weight",
   "kind": "result",
   "section": "4.5",
   "name": "支撑重物的张力",
   "statement": "一个静止悬挂在绳上的物体没有加速度，所以作用于它的合力为零，张力必须等于重力。一旦知道了无摩擦柔索上某一点的张力，就知道了沿它各处的张力。",
   "forms": [
    {
     "id": "eq-tension-weight",
     "latex": "T = w = mg",
     "ktex": "\\kTf = \\kwgt = m\\kg",
     "condition": "质量可忽略的绳子，吊着一个静止的物体",
     "anchor": "4.5-tension"
    }
   ]
  },
  {
   "id": "tension-from-perpendicular-force",
   "kind": "result",
   "section": "4.5",
   "name": "垂直力产生的张力",
   "statement": "在几乎笔直的柔索的中间沿侧向推它，会产生远大于这个推力的张力，因为只有每一半的很小的竖直分量在支撑它。用一根链条把汽车从泥里拉出来就是这个道理，也是没有哪根柔索能完全水平的原因。",
   "forms": [
    {
     "id": "eq-tension-perp",
     "latex": "T = \\frac{F_{\\perp}}{2\\sin\\theta}",
     "ktex": "\\kTf = \\frac{\\kFperp}{2\\sin\\theta}",
     "condition": "垂直于柔索长度方向、作用在其中点的力",
     "anchor": "4.5-large-tension"
    },
    {
     "id": "eq-tension-sag",
     "latex": "T = \\frac{w}{2\\sin\\theta}",
     "ktex": "\\kTf = \\frac{\\kwgt}{2\\sin\\theta}",
     "condition": "重物挂在柔索中点，柔索两侧各下垂角度 θ",
     "anchor": "4.5-tightrope"
    }
   ]
  },
  {
   "id": "inertial-frame",
   "kind": "definition",
   "section": "4.5",
   "name": "惯性参考系",
   "terms": [
    "惯性参考系"
   ],
   "statement": "惯性参考系是既不加速也不转动的参考系，只有在这样的参考系中牛顿定律才取其简单形式。在加速的参考系中，观察者会看到没有物理来源的力，例如从转动的地球上看到的对卫星的向西的推力，而这些虚拟力是参考系造成的假象。"
  },
  {
   "id": "newtons-laws-problem-solving",
   "kind": "skill",
   "section": "4.6",
   "name": "求解力学问题",
   "statement": "一个关于力的问题每次都按相同的四个步骤来解：画出情境草图并把每个力画成箭头，列出已知量和未知量并选定所研究的系统，画出受力图并应用牛顿第二定律，检查答案及其单位是否合理。"
  },
  {
   "id": "net-force-by-axis",
   "kind": "result",
   "section": "4.6",
   "name": "沿各坐标轴的合力",
   "statement": "在写出力的方程之前，先确定系统在哪些方向上加速。在沿某一坐标轴没有加速度的地方，沿该轴的合力为零；有加速度的地方，沿该轴的合力等于质量乘以那个加速度；这样两个坐标轴就成了两个一维问题。",
   "forms": [
    {
     "id": "eq-fnet-x",
     "latex": "F_{\\text{net}\\,x} = ma",
     "ktex": "\\kFnetx = m\\ka",
     "condition": "系统沿 x 轴加速",
     "anchor": "4.6-axes"
    },
    {
     "id": "eq-a-incline-friction",
     "latex": "a_{\\parallel} = \\frac{mg\\sin\\theta - f}{m}",
     "ktex": "\\kapar = \\frac{m\\kg\\sin\\theta - \\kff}{m}",
     "condition": "大小为 f 的摩擦力阻碍沿斜面向下的运动",
     "section": "4.5",
     "anchor": "4.5-weight-on-incline"
    },
    {
     "id": "eq-fnet-y",
     "latex": "F_{\\text{net}\\,y} = 0",
     "ktex": "\\kFnety = 0",
     "condition": "系统沿 y 轴没有加速度",
     "anchor": "4.6-axes"
    }
   ]
  },
  {
   "id": "resolve-forces-into-components",
   "kind": "skill",
   "section": "4.6",
   "name": "把力分解到坐标轴上",
   "statement": "一旦把各个力投影到一对选得好的坐标轴上，二维的力的问题就变成一对一维问题：一个轴沿着运动方向，或沿着斜面，可以省去大部分工作。"
  },
  {
   "id": "unequal-tensions",
   "kind": "result",
   "section": "4.7",
   "name": "不相等的张力",
   "statement": "当一个物体悬挂在两根钢丝上时，两个张力的水平分量必须相互抵消，竖直分量相加必须等于重力。只有当两个角相等时两个张力才相等；更接近竖直的那根钢丝承担更大的份额。",
   "forms": [
    {
     "id": "eq-tension-two-wires",
     "latex": "T_1\\cos\\theta_1 = T_2\\cos\\theta_2, \\quad T_1\\sin\\theta_1 + T_2\\sin\\theta_2 = w",
     "ktex": "\\kTone\\cos\\theta_1 = \\kTtwo\\cos\\theta_2, \\quad \\kTone\\sin\\theta_1 + \\kTtwo\\sin\\theta_2 = \\kwgt",
     "condition": "物体由两根钢丝静止悬挂着",
     "anchor": "4.7-tensions"
    }
   ]
  },
  {
   "id": "apparent-weight",
   "kind": "result",
   "section": "4.7",
   "name": "视重",
   "type": "force",
   "statement": "体重秤显示的是它向上推的力，而不是重力。在向上加速的电梯里它显示的数值比重力大，以任何恒定速度运动时它恰好显示重力，而处于自由落体运动时它显示为零，人看起来就失重了。",
   "forms": [
    {
     "id": "eq-apparent-weight",
     "latex": "F_{\\text{s}} = ma + mg",
     "ktex": "\\kFs = m\\ka + m\\kg",
     "condition": "人站在秤上，系统在竖直方向加速",
     "anchor": "4.7-scale"
    }
   ]
  },
  {
   "id": "drag-force",
   "kind": "definition",
   "section": "4.7",
   "name": "阻力",
   "symbol": "F_D",
   "terms": [
    "阻力"
   ],
   "type": "force",
   "statement": "阻力是空气或水等流体对在其中运动的物体施加的摩擦力，与任何摩擦一样，它阻碍运动。",
   "forms": [
    {
     "id": "eq-drag",
     "latex": "F_{\\text{D}} = F_{\\text{app}} - ma",
     "ktex": "\\kFD = \\kFa - m\\ka",
     "condition": "阻力与外加力方向相反，运动沿一条直线",
     "anchor": "4.7-drag"
    }
   ]
  },
  {
   "id": "integrated-kinematics-dynamics",
   "kind": "skill",
   "section": "4.7",
   "name": "把运动学与牛顿定律结合起来",
   "statement": "力产生加速度，而运动学方程是用加速度写成的，所以你可以从一个力求出一段距离，或者从一段距离反过来求出一个力。先找出涉及哪些原理，然后依次使用每一章自己的策略。"
  },
  {
   "id": "four-basic-forces",
   "kind": "idea",
   "section": "4.8",
   "name": "四种基本力",
   "statement": "只有四种不同的力能解释每一种已知现象：引力、电磁力、弱核力和强核力。除了引力，我们直接感受到的一切都是电磁力，而两种核力只在一个原子核的尺度或更小的范围内起作用。"
  },
  {
   "id": "force-field",
   "kind": "idea",
   "section": "4.8",
   "name": "力场",
   "terms": [
    "力场",
    "场"
   ],
   "statement": "所有的力都是超距作用的，所以一定有某种东西在物体之间传递它们。力场围绕着产生它的物体，并且只是该物体的一种特征；放在场中的检验物体会受到一个力，这个力取决于它所在的位置。"
  },
  {
   "id": "carrier-particle",
   "kind": "idea",
   "section": "4.8",
   "name": "媒介粒子",
   "terms": [
    "媒介粒子",
    "规范玻色子"
   ],
   "statement": "场没有回答究竟是什么传递了力，而自汤川以来一直成立的设想是，每一种力都是由一种基本粒子的交换来传递的，就像两个人互相传篮球会彼此推开而并不接触一样。"
  }
