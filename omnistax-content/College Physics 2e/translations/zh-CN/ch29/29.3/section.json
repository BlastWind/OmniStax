    "solution": "$h\\kc = (6.62607\\times 10^{-34}\\;\\text{J}\\cdot\\text{s})(2.99792\\times 10^{8}\\;\\text{m/s})\\left(\\frac{10^{9}\\;\\text{nm}}{1\\;\\text{m}}\\right)\\left(\\frac{1.00000\\;\\text{eV}}{1.60218\\times 10^{-19}\\;\\text{J}}\\right) = 1239.84\\;\\text{eV}\\cdot\\text{nm} \\approx 1240\\;\\text{eV}\\cdot\\text{nm}$"
   }
