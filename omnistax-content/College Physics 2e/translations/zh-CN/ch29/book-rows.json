     "anchor": "29.7-energy-time-uncertainty"
    },
    {
     "id": "eq-energy-time-uncertainty-33",
     "latex": "\\Delta E\\,\\Delta t \\ge \\frac{h}{4\\pi}",
     "ktex": "\\kdE\\,\\kdt \\ge \\frac{h}{4\\pi}",
