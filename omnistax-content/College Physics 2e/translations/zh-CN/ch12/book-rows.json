 "concepts": [
  {
   "id": "flow-rate",
   "kind": "definition",
   "section": "12.1",
   "name": "流量",
   "symbol": "Q",
   "terms": [
    "流量"
   ],
   "type": "flow-rate",
   "statement": "流量是在一段时间内通过某一位置的某一面积的流体体积。几乎每一个关于运动流体的问题都要问到它：心脏泵出多少血液，水管送出多少水，风道输送多少空气。因为它数的是体积而不是距离，所以它本身并不告诉你流体运动得有多快或导管有多宽，只告诉你这两者的乘积。",
   "forms": [
    {
     "id": "eq-flow-rate",
     "latex": "Q = \\frac{V}{t}",
     "ktex": "\\kQ = \\frac{V}{\\kt}",
     "anchor": "12.1-flow-rate"
    }
   ]
  },
  {
   "id": "flow-rate-units",
   "kind": "skill",
   "section": "12.1",
   "name": "流量单位的换算",
   "statement": "流量的国际单位是立方米每秒，但几乎没有什么场合用它：心脏每分钟泵出若干升，消防水带每秒送出若干升，毛细血管每秒输送若干立方厘米。一升是一立方米的千分之一。要用对当前情形最方便的公制单位，并预期几乎每道题都要在它们之间换算。"
  },
  {
   "id": "flow-rate-velocity",
   "kind": "result",
   "section": "12.1",
   "name": "流量与速度",
   "statement": "流量等于导管的横截面积乘以流体穿过它的平均速度，$Q = A\\bar{v}$。因此流量和速度是相关但不同的量：宽而缓的河流可以比窄而急的河流输送更多的水。",
   "forms": [
    {
     "id": "eq-flow-rate-velocity",
     "latex": "Q = A\\bar{v}",
     "ktex": "\\kQ = A\\kvb",
     "anchor": "12.1-flow-rate-velocity"
    }
   ]
  },
  {
   "id": "incompressible-fluid",
   "kind": "definition",
   "section": "12.1",
   "name": "不可压缩流体",
   "statement": "当一定量的流体无论受到多大的挤压都始终占据相同的体积时，这种流体是不可压缩的。液体几乎是不可压缩的，所以连续性方程对所有液体都成立。气体是可压缩的，当它们被压缩或膨胀时，应用这个方程必须谨慎。本章的每一个结果，包括伯努利方程和泊肃叶定律在内，都假定流体是不可压缩的。"
  },
  {
   "id": "equation-of-continuity",
   "kind": "result",
   "section": "12.1",
   "name": "连续性方程",
   "statement": "因为流体是不可压缩的，所以在给定的时间内，同样多的流体必定流过管子的任何一点，因此沿管各点的流量相同。在横截面积减小的地方，速度必然增大；在横截面积增大的地方，速度就下降。这正是喷嘴的用途，也是河流汇入水库时水流明显变缓、离开水库时又重新加快的原因。",
   "forms": [
    {
     "id": "eq-continuity",
     "latex": "Q_1 = Q_2,\\quad A_1\\bar{v}_1 = A_2\\bar{v}_2",
     "ktex": "\\kQone = \\kQtwo,\\quad A_1\\kvbone = A_2\\kvbtwo",
     "condition": "不可压缩流体",
     "anchor": "12.1-continuity"
    }
   ]
  },
  {
   "id": "continuity-branching",
   "kind": "result",
   "section": "12.1",
   "name": "分支流动中的连续性",
   "statement": "在心血管系统和任何其他分支网络中，流动并不停留在一根管子里。连续性仍然成立，但它针对的是沿管任一部分中所有分支的流量之和，所以分支的数目与它们的面积和速率一起进入方程。毛细血管的总横截面积比主动脉大得多，所以其中的血液以大约每秒一毫米的速率流动。这个速率慢得足以让血液与细胞交换物质，又快得足以避免凝血。",
   "forms": [
    {
     "id": "eq-continuity-branching",
     "latex": "n_1A_1\\bar{v}_1 = n_2A_2\\bar{v}_2",
     "ktex": "n_1A_1\\kvbone = n_2A_2\\kvbtwo",
     "condition": "不可压缩流体发生分支",
     "anchor": "12.1-branching"
    }
   ]
  },
  {
   "id": "fluid-dynamics",
   "kind": "definition",
   "section": "12.1",
   "name": "流体动力学",
   "terms": [
    "流体动力学"
   ],
   "statement": "流体动力学是研究运动流体的物理学。"
  },
  {
   "id": "liter",
   "kind": "definition",
   "section": "12.1",
   "name": "升",
   "terms": [
    "升"
   ],
   "statement": "升是体积单位，等于 $10^{-3}\\;\\text{m}^3$，即 1000 立方厘米。"
  },
  {
   "id": "pressure-drops-in-fast-fluid",
   "kind": "result",
   "section": "12.2",
   "name": "高速流体中的压降低",
   "statement": "流体加速的地方，它的压强下降。流入较窄通道的流体获得动能，而这些能量来自后方较高的压强把它推入通道时所做的合外力的功。"
  },
  {
   "id": "bernoullis-equation",
   "kind": "result",
   "section": "12.2",
   "name": "伯努利方程",
   "terms": [
    "伯努利方程"
   ],
   "statement": "伯努利方程定量地给出了流体中压强与速度之间的关系：对于不可压缩、无摩擦的流体，压强、含速率平方的项和含高度的项这三者之和，沿着一小块流体所经过的路径保持不变。和中的各个量可以随流体的运动而变化，但总和不变，所以速率或高度的增加必须由压强来支付。",
   "forms": [
    {
     "id": "eq-bernoulli",
     "latex": "P + \\frac{1}{2}\\rho v^2 + \\rho gh = \\text{常量}",
     "ktex": "\\kPr + \\frac{1}{2}\\krho\\kv^2 + \\krho\\kg\\kh = \\text{常量}",
     "condition": "不可压缩、无摩擦的流体",
     "anchor": "12.2-bernoullis-equation"
    },
    {
     "id": "eq-bernoulli-two-points",
     "latex": "P_1 + \\frac{1}{2}\\rho v_1^2 + \\rho gh_1 = P_2 + \\frac{1}{2}\\rho v_2^2 + \\rho gh_2",
     "ktex": "\\kProne + \\frac{1}{2}\\krho\\kvone^2 + \\krho\\kg\\khone = \\kPrtwo + \\frac{1}{2}\\krho\\kvtwo^2 + \\krho\\kg\\khtwo",
     "condition": "不可压缩、无摩擦的流体",
     "anchor": "12.2-bernoullis-equation"
    }
   ]
  },
  {
   "id": "bernoulli-energy-per-volume",
   "kind": "idea",
   "section": "12.2",
   "name": "伯努利方程：单位体积的能量",
   "statement": "伯努利方程是能量守恒原理的一种形式。第二项和第三项分别是动能和重力势能，只是把质量换成了密度，所以每一项都是能量除以体积，而压强也是单位体积的能量，因为牛顿每平方米乘以米比米等于焦耳每立方米。事实上，伯努利方程只是对没有摩擦的不可压缩流体的能量守恒的一种方便的表述。",
   "forms": [
    {
     "id": "eq-ke-per-volume",
     "latex": "\\frac{1}{2}\\rho v^2 = \\frac{\\frac{1}{2}mv^2}{V} = \\frac{\\text{KE}}{V}",
     "ktex": "\\frac{1}{2}\\krho\\kv^2 = \\frac{\\frac{1}{2}m\\kv^2}{V} = \\frac{\\kKE}{V}",
     "anchor": "12.2-bernoullis-equation"
    },
    {
     "id": "eq-pe-per-volume",
     "latex": "\\rho gh = \\frac{mgh}{V} = \\frac{\\text{PE}_{\\text{g}}}{V}",
     "ktex": "\\krho\\kg\\kh = \\frac{m\\kg\\kh}{V} = \\frac{\\kPEg}{V}",
     "anchor": "12.2-bernoullis-equation"
    }
   ]
  },
  {
   "id": "bernoulli-static-fluid",
   "kind": "result",
   "section": "12.2",
   "name": "静止流体的伯努利方程",
   "statement": "当流体不运动时，两个速率项都消失，伯努利方程说明压强随深度增加：向下一段高度，就在压强上加上那一段流体柱的重力。在最简单的情形下，顶部的压强为零，你就得到了流体的重力所产生的压强这一熟悉的关系。所以，虽然伯努利方程描述的是流体的流动，它却包含了上一章对静止流体所得到的许多内容。",
   "forms": [
    {
     "id": "eq-bernoulli-static",
     "latex": "P_2 = P_1 + \\rho gh_1",
     "ktex": "\\kPrtwo = \\kProne + \\krho\\kg\\khone",
     "condition": "静止流体，取较低点为参考高度",
     "anchor": "12.2-static-fluids"
    }
   ]
  },
  {
   "id": "bernoullis-principle",
   "kind": "result",
   "section": "12.2",
   "name": "伯努利原理",
   "terms": [
    "伯努利原理"
   ],
   "statement": "当流体在运动但其深度不变时，含高度的项相减抵消，伯努利方程就成了只关于压强和速率的表述。这类情形非常重要，所以这个方程有了自己的名称。它说的正是本节开头所论证的：如果某一点的速率较大，则为了使等式成立，该点的压强必定较小。",
   "forms": [
    {
     "id": "eq-bernoullis-principle",
     "latex": "P_1 + \\frac{1}{2}\\rho v_1^2 = P_2 + \\frac{1}{2}\\rho v_2^2",
     "ktex": "\\kProne + \\frac{1}{2}\\krho\\kvone^2 = \\kPrtwo + \\frac{1}{2}\\krho\\kvtwo^2",
     "condition": "等深度",
     "anchor": "12.2-bernoullis-principle"
    }
   ]
  },
  {
   "id": "entrainment",
   "kind": "idea",
   "section": "12.2",
   "name": "挟带",
   "statement": "人们早就利用伯努利原理，用高速流体中降低的压强来推动东西：外侧压强较高，快速的流束就迫使其他流体进入它自身。挟带装置自古就被用作把水提升小高度的泵，同样的手法还驱动着本生灯、雾化器、喷漆器、抽气器和热水器的烟囱。"
  },
  {
   "id": "lift-from-bernoulli",
   "kind": "idea",
   "section": "12.2",
   "name": "机翼上的升力",
   "statement": "飞机机翼是伯努利原理实际应用的绝佳例子。机翼以小角度向上倾斜，上表面较长，所以空气在上方流得更快，那里的压强下降，压强差就是一个向上的合力。帆也具有机翼的特征形状：帆前面的压强比后面的压强低，这产生一个向前的力，甚至使船能够迎风航行。机翼还通过把空气向下推来获得升力，被偏转的空气根据牛顿第三定律反过来推机翼。"
  },
  {
   "id": "velocity-measurement",
   "kind": "result",
   "section": "12.2",
   "name": "流体速率的测量",
   "statement": "用压强计连接两根细到不会扰动流动的管子，可以测量流体的速率。迎着来流的那根管子在其前方形成一个速度为零的死区，而流经另一根管子的流体保持它的速率，所以第二个开口处的压强比前者低，低的量就是含速率平方的那一项。压强计中的流体升高的高度与该项成正比，因此速率与高度的平方根成正比。基于这一原理制成的皮托管就是飞机的空速表。",
   "forms": [
    {
     "id": "eq-speed-from-manometer",
     "latex": "v_2 \\propto \\sqrt{h}",
     "ktex": "\\kvtwo \\propto \\sqrt{\\kh}",
     "anchor": "12.2-velocity-measurement"
    },
    {
     "id": "eq-manometer-height",
     "latex": "h \\propto \\frac{1}{2}\\rho v_2^2",
     "ktex": "\\kh \\propto \\frac{1}{2}\\krho\\kvtwo^2",
     "anchor": "12.2-velocity-measurement"
    }
   ]
  },
  {
   "id": "torricellis-theorem",
   "kind": "result",
   "section": "12.3",
   "name": "托里拆利定理",
   "statement": "流体从水库表面以下高度 $h$ 处的开口流出时，其出流速率等于它自由下落这一高度所具有的速率，$v_2^2 = v_1^2 + 2gh$，与开口大小无关。",
   "forms": [
    {
     "id": "eq-torricelli",
     "latex": "v_2^2 = v_1^2 + 2gh",
     "ktex": "\\kvtwo^2 = \\kvone^2 + 2\\kg\\kh",
     "anchor": "12.3-torricellis-theorem"
    }
   ]
  },
  {
   "id": "bernoulli-general-application",
   "kind": "skill",
   "section": "12.3",
   "name": "伯努利方程的应用",
   "statement": "伯努利方程以前的每一次应用都先将它简化，或者令高度不变，或者令两点的压强相等。一般情形则在两点都保留全部三项。由流量和两处横截面积求出速率，从你取作参考的那一点量起测量高度，然后解出其余的压强。一条沿梯子向上延伸十米、接到窄喷嘴的消防水带正是这种情形，它的压强同时由于两个原因而下降。"
  },
  {
   "id": "power-in-fluid-flow",
   "kind": "result",
   "section": "12.3",
   "name": "流体流动中的功率",
   "statement": "功率是做功或使用或提供能量的快慢。伯努利方程的每一项都是单位体积的能量，所以把整个方程乘以流量（即单位时间的体积）就得到功率。于是每一项都有明确的物理意义：一项是为使流体具有其压强而提供的功率，一项是为使它具有其动能而提供的功率，还有一项是用于重力势能的功率。",
   "forms": [
    {
     "id": "eq-power-in-fluid-flow",
     "latex": "\\left(P + \\frac{1}{2}\\rho v^2 + \\rho gh\\right)Q = \\text{功率}",
     "ktex": "\\left(\\kPr + \\frac{1}{2}\\krho\\kv^2 + \\krho\\kg\\kh\\right)\\kQ = \\text{功率}",
     "anchor": "12.3-power-in-fluid-flow"
    }
   ]
  },
  {
   "id": "pump-power",
   "kind": "skill",
   "section": "12.3",
   "name": "求泵的功率",
   "statement": "一台泵把流体吸入，再通过同样直径、同样高度的水带送出，它既不改变流体的速率，也不改变流体的高度。流体的动能和重力势能保持不变，只剩下压强项。于是泵提供的功率就是它增加的压强乘以流量。像心脏那样同时提高速度和高度的泵，则需要全部三项。",
   "forms": [
    {
     "id": "eq-power-from-pressure",
     "latex": "\\text{功率} = PQ",
     "ktex": "\\text{功率} = \\kPr\\kQ",
     "anchor": "12.3-pump-power"
    }
   ]
  },
  {
   "id": "laminar-flow",
   "kind": "definition",
   "section": "12.4",
   "name": "层流",
   "terms": [
    "层流"
   ],
   "statement": "在层流中，流体分层平滑地运动，各层互不混合。本章图中的线条是流线，即小体积流体所遵循的路径，在层流中它们平滑而连续。黏度的精确定义建立在层流的基础上，泊肃叶定律也是如此。"
  },
  {
   "id": "turbulent-flow",
   "kind": "definition",
   "section": "12.4",
   "name": "湍流",
   "terms": [
    "湍流"
   ],
   "statement": "湍流的特征是涡旋和旋涡把各层流体混合在一起，它的流线断裂而不是平滑地延伸。它有两个主要原因：任何障碍物或急转弯都会产生垂直于流动方向的速度，而仅仅高速也足以引起湍流，因为只要速率足够大，相邻各层之间以及流体与周围环境之间的阻力就会形成旋涡。湍流使流体混合，使它发热更多，所受的阻力也比层流大。"
  },
  {
   "id": "viscosity",
   "kind": "definition",
   "section": "12.4",
   "name": "黏度",
   "symbol": "η_visc",
   "terms": [
    "黏度"
   ],
   "type": "viscosity",
   "statement": "黏度是流体摩擦，既包括流体内部的，也包括流体与周围环境之间的：果汁倒起来很顺畅，糖浆却黏在壶上。要测量它，就让流体在两块板之间受剪切，一块固定，另一块以恒定速率运动，然后求出保持上板运动的力。这个力随速率、板的面积和黏度的增大而增大，随两板的分开而减小。因此黏度等于力乘以间距再除以速率乘以面积。不同流体的黏度相差几个数量级，气体的黏度远小于液体，而且大多数流体的黏度都与温度有关。",
   "forms": [
    {
     "id": "eq-viscosity-force",
     "latex": "F = \\eta\\frac{vA}{L}",
     "ktex": "\\kF = \\keta\\frac{\\kv A}{L}",
     "condition": "层流",
     "anchor": "12.4-laminar-viscosity"
    },
    {
     "id": "eq-viscosity-definition",
