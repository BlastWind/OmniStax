 "exercises": [
  {
   "id": "cq1",
   "source_id": "fs-id3259487",
   "kind": "conceptual-question",
   "bloom": "Remember",
   "place": {
    "at": "end"
   },
   "cite": "intrinsic-spin",
   "prompt": "定义量子数 $n, l, m_l, s$ 和 $m_s$。",
   "answer": {
    "type": "open",
    "generated_by": "ai",
    "solution": "$n$ 是主量子数，$n = 1, 2, 3, \\ldots$，它标记原子的基本状态并决定它们的能量。$l$ 是角量子数，取 $0$ 到 $n - 1$，它决定轨道角动量的大小，$\\kL = \\sqrt{l(l+1)}\\,h/2\\pi$。$m_l$ 是磁量子数，取 $-l$ 到 $l$，以 1 为间隔，它决定 $z$ 分量 $\\kLz = m_l h/2\\pi$，从而决定 $\\kL$ 的方向。$s$ 是自旋量子数，对电子为 $1/2$，它决定内禀自旋的大小，$\\kSspin = \\sqrt{s(s+1)}\\,h/2\\pi$。$m_s$ 是自旋磁量子数，为 $+1/2$（自旋向上）或 $-1/2$（自旋向下），它决定 $\\kSz = m_s h/2\\pi$。"
   }
  },
  {
   "id": "cq2",
   "source_id": "fs-id1859624",
   "kind": "conceptual-question",
   "bloom": "Remember",
   "place": {
    "at": "end"
   },
   "cite": "magnitude-of-angular-momentum",
   "prompt": "对于给定的 $n$ 值，$l$ 的允许值是什么？",
   "answer": {
    "type": "open",
    "generated_by": "ai",
    "solution": "$l$ 可以是从 0 到 $n - 1$ 的任意整数，所以共有 $n$ 个允许值：$l = 0, 1, 2, \\ldots, n - 1$。对于 $n = 1$，只允许 $l = 0$；对于 $n = 3$，$l$ 可以是 0、1 或 2。"
   }
  },
  {
