 "exercises": [
  {
   "id": "cq1",
   "source_id": "fs-id2678225",
   "kind": "conceptual-question",
   "bloom": "Remember",
   "place": {
    "at": "end"
   },
   "cite": "evidence-today",
   "prompt": "说出原子存在的三种不同类型的证据。",
   "answer": {
    "type": "open",
    "generated_by": "ai",
    "solution": "化学反应中各反应物的质量比固定，表明存在按这些比例结合的基本单位。元素周期表的规律在元素被发现之前就预言了它们，气体动理论则从处于无规则热运动中的原子和分子出发解释了气体定律和热力学，这些是进一步的间接证据。布朗运动，即小颗粒被周围分子不均匀地撞击而抖动，是直接证据，能探测单个离子的质谱仪和能给单个原子成像的显微镜也是直接证据。"
   }
  },
  {
   "id": "cq2",
   "source_id": "fs-id3062232",
   "kind": "conceptual-question",
   "bloom": "Analyze",
   "place": {
    "at": "end"
   },
   "cite": "brownian-motion",
   "prompt": "解释为什么元素周期表中观察到的规律是原子存在的证据，以及为什么布朗运动是更直接的一类原子存在的证据。",
   "answer": {
    "type": "open",
    "generated_by": "ai",
    "solution": "元素周期表表明，元素的性质以规则的方式重复出现，而且它预言了后来被发现的元素，这些元素具有所预言的性质。如果每种元素都是由具有确定结构的一种基本单位构成的，我们预期的正是这样的秩序，但它只是从大量物质的行为推断出原子。在布朗运动中，我们看到的是单个可见颗粒被侧面受到的数目不均的分子撞击，一会儿推向这边，一会儿推向那边。我们仍然看不到分子，但看到了它们各自碰撞的效果，并且可以通过分析这种运动得出分子的大小，所以它比前者更接近于直接观察分子。"
   }
  },
  {
   "id": "cq3",
   "source_id": "fs-id3053482",
   "kind": "conceptual-question",
   "bloom": "Understand",
   "place": {
    "at": "end"
   },
   "cite": "size-of-atoms",
   "prompt": "如果原子存在，为什么我们不能用可见光看到它们？",
   "answer": {
    "type": "open",
    "generated_by": "ai",
    "solution": "一个原子的直径约为 $10^{-10}$ m，而可见光的波长约为 380 到 760 nm，要大几千倍。波不能分辨比其波长小得多的细节，因为它会绕过这些细节发生衍射，所以不论透镜多么好，使用可见光的显微镜都无法显示单个原子。"
   }
  }
 ],
