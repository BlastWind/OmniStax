   "important": true
  },
  {
   "id": "eq-seesaw-torques",
   "section": "9.2",
   "latex": "\\tau_1 = r_1 w_1 \\quad\\text{and}\\quad \\tau_2 = -r_2 w_2",
   "ktex": "\\ktauone = \\krone\\kwone \\quad\\text{and}\\quad \\ktautwo = -\\krtwo\\kwtwo",
