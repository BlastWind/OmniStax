   "important": true
  },
  {
   "id": "eq-lever-ma",
   "concept": "lever-mechanical-advantage",
   "section": "9.5",
   "latex": "\\text{MA} = \\frac{F_{\\text{o}}}{F_{\\text{i}}} = \\frac{l_{\\text{i}}}{l_{\\text{o}}}",
   "ktex": "\\text{MA} = \\frac{\\kFo}{\\kFi} = \\frac{\\kli}{\\klo}",
   "important": true
  },
  {
   "id": "eq-input-force",
   "section": "9.5",
   "latex": "F_{\\text{i}} = F_{\\text{o}}\\frac{l_{\\text{o}}}{l_{\\text{i}}}",
   "ktex": "\\kFi = \\kFo\\frac{\\klo}{\\kli}",
   "important": false
  },
  {
   "id": "eq-crank-ma",
   "concept": "crank-and-wheel",
   "section": "9.5",
   "latex": "\\text{MA} = \\frac{r_{\\text{i}}}{r_{\\text{o}}}",
   "important": true
  },
  {
   "id": "eq-pulley-force",
   "concept": "pulley-mechanical-advantage",
   "section": "9.5",
   "latex": "F_{\\text{o}} \\approx nT",
   "ktex": "\\kFo \\approx n\\kTf",
   "condition": "frictionless pulleys, with n cables pulling directly on the load",
   "important": true
  },
  {
   "id": "eq-biceps-torque-balance",
   "section": "9.6",
   "latex": "r_2 w_{\\text{a}} + r_3 w_{\\text{b}} = r_1 F_{\\text{B}}",
   "ktex": "\\krtwo\\kwarm + \\krthree\\kwbook = \\krone\\kFB",
   "condition": "the pivot taken at the elbow joint",
   "important": false
