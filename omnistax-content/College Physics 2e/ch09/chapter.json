  {
   "id": "eq-biceps-force",
   "concept": "muscle-force-from-torque",
   "section": "9.6",
   "latex": "F_{\\text{B}} = \\frac{r_2 w_{\\text{a}} + r_3 w_{\\text{b}}}{r_1}",
   "ktex": "\\kFB = \\frac{\\krtwo\\kwarm + \\krthree\\kwbook}{\\krone}",
   "important": true
  },
  {
   "id": "eq-vertebrae-magnitude",
   "section": "9.6",
   "latex": "F_{\\text{V}} = \\sqrt{F_{\\text{V}x}^{2} + F_{\\text{V}y}^{2}}",
   "ktex": "\\kFV = \\sqrt{\\kFVx^{2} + \\kFVy^{2}}",
   "important": false
  },
