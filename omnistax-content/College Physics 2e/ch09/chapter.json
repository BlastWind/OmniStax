  }
 ],
 "glossary": [
  {
   "section": "9.1",
   "term": "static equilibrium",
   "definition": "a state of equilibrium in which the net external force and torque acting on a system is zero"
  },
  {
   "section": "9.1",
   "term": "dynamic equilibrium",
   "definition": "a state of equilibrium in which the net external force and torque on a system moving with constant velocity are zero"
  },
  {
   "section": "9.2",
   "term": "torque",
   "definition": "turning or twisting effectiveness of a force"
  },
  {
   "section": "9.2",
   "term": "perpendicular lever arm",
   "definition": "the shortest distance from the pivot point to the line along which F lies"
  },
  {
   "section": "9.2",
   "term": "SI units of torque",
   "definition": "newton times meters, usually written as N·m"
  },
  {
   "section": "9.2",
   "term": "center of gravity",
   "definition": "the point where the total weight of the body is assumed to be concentrated"
  },
  {
   "section": "9.3",
   "term": "neutral equilibrium",
   "definition": "a state of equilibrium that is independent of a system’s displacements from its original position"
  },
  {
   "section": "9.3",
   "term": "stable equilibrium",
   "definition": "a system, when displaced, experiences a net force or torque in a direction opposite to the direction of the displacement"
  },
  {
   "section": "9.3",
   "term": "unstable equilibrium",
   "definition": "a system, when displaced, experiences a net force or torque in the same direction as the displacement from equilibrium"
  },
  {
   "section": "9.4",
   "term": "static equilibrium",
   "definition": "equilibrium in which the acceleration of the system is zero and accelerated rotation does not occur"
  },
  {
   "section": "9.5",
   "term": "mechanical advantage",
   "definition": "the ratio of output to input forces for any simple machine"
  }
 ]
}
