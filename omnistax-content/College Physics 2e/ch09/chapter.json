  },
  {
   "id": "eq-seesaw-balance",
   "section": "9.2",
   "latex": "r_2 w_2 = r_1 w_1",
   "ktex": "\\krtwo\\kwtwo = \\krone\\kwone",
   "condition": "the seesaw balanced",
   "important": false
  },
  {
   "id": "eq-seesaw-distance",
   "concept": "balanced-seesaw",
   "section": "9.2",
   "latex": "r_2 = r_1\\frac{m_1}{m_2}",
   "ktex": "\\krtwo = \\krone\\frac{m_1}{m_2}",
   "condition": "the seesaw balanced and of negligible mass",
   "important": false
  },
  {
   "id": "eq-pivot-force",
   "section": "9.2",
   "latex": "F_{\\text{p}} = w_1 + w_2",
   "ktex": "\\kFp = \\kwone + \\kwtwo",
   "condition": "the seesaw of negligible mass",
   "important": false
  },
  {
   "id": "eq-cw-ccw",
   "section": "9.4",
   "latex": "\\text{net}\\;\\tau_{\\text{cw}} = -\\,\\text{net}\\;\\tau_{\\text{ccw}}",
   "ktex": "\\text{net}\\;\\ktau_{\\text{cw}} = -\\,\\text{net}\\;\\ktau_{\\text{ccw}}",
   "important": true
  },
  {
   "id": "eq-equal-hands",
   "concept": "symmetric-support",
   "section": "9.4",
   "latex": "F_R = F_L = \\frac{w}{2}",
   "ktex": "\\kFR = \\kFL = \\frac{\\kwgt}{2}",
   "condition": "the center of gravity of the pole halfway between the hands",
   "important": true
  },
  {
   "id": "eq-hands-sum",
   "concept": "unequal-support-forces",
   "section": "9.4",
   "latex": "F_L + F_R = w = mg",
   "ktex": "\\kFL + \\kFR = \\kwgt = mg",
   "important": true
  },
  {
   "id": "eq-mechanical-advantage",
   "concept": "mechanical-advantage",
   "section": "9.5",
   "latex": "\\text{MA} = \\frac{F_{\\text{o}}}{F_{\\text{i}}}",
   "ktex": "\\text{MA} = \\frac{\\kFo}{\\kFi}",
   "important": true
  },
  {
   "id": "eq-lever-balance",
   "concept": "lever",
   "section": "9.5",
   "latex": "l_{\\text{i}}F_{\\text{i}} = l_{\\text{o}}F_{\\text{o}}",
   "ktex": "\\kli\\kFi = \\klo\\kFo",
