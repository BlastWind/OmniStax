   "important": true,
   "anchor": "14.7-stefan-boltzmann"
  },
  {
   "id": "eq-net-radiation",
   "concept": "net-radiation-rate",
   "section": "14.7",
   "latex": "\\frac{Q_{\\text{net}}}{t} = \\sigma e A (T_2^4 - T_1^4)",
