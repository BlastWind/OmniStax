   "important": true,
   "anchor": "14.6-phase-change"
  },
  {
   "id": "eq-stefan-boltzmann",
   "concept": "stefan-boltzmann-law",
   "section": "14.7",
   "latex": "\\frac{Q}{t} = \\sigma e A T^4",
