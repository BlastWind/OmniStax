 "glossary": [
  {
   "section": "14.1",
   "term": "heat",
   "definition": "the spontaneous transfer of energy due to a temperature difference"
  },
  {
   "section": "14.1",
   "term": "kilocalorie",
   "definition": "1 kilocalorie = 1000 calories"
  },
  {
   "section": "14.1",
   "term": "mechanical equivalent of heat",
   "definition": "the work needed to produce the same effects as heat transfer"
  },
  {
   "section": "14.2",
   "term": "specific heat",
   "definition": "the amount of heat necessary to change the temperature of 1.00 kg of a substance by 1.00 °C"
  },
  {
   "section": "14.3",
   "term": "heat of sublimation",
   "definition": "the energy required to change a substance from the solid phase to the vapor phase"
  },
  {
   "section": "14.3",
   "term": "latent heat coefficient",
   "definition": "a physical constant equal to the amount of heat transferred for every 1 kg of a substance during the change in phase of the substance"
  },
  {
   "section": "14.3",
   "term": "sublimation",
   "definition": "the transition from the solid phase to the vapor phase"
  },
  {
   "section": "14.4",
   "term": "conduction",
   "definition": "heat transfer through stationary matter by physical contact"
  },
  {
   "section": "14.4",
   "term": "convection",
   "definition": "heat transfer by the macroscopic movement of fluid"
  },
  {
   "section": "14.4",
   "term": "radiation",
   "definition": "heat transfer which occurs when microwaves, infrared radiation, visible light, or other electromagnetic radiation is emitted or absorbed"
  },
  {
   "section": "14.5",
   "term": "R factor",
   "definition": "the ratio of thickness to the conductivity of a material"
  },
  {
   "section": "14.5",
   "term": "rate of conductive heat transfer",
   "definition": "rate of heat transfer from one material to another"
  },
  {
   "section": "14.5",
   "term": "thermal conductivity",
   "definition": "the property of a material’s ability to conduct heat"
  },
  {
   "section": "14.7",
