 "equations": [
  {
   "id": "eq-mechanical-equivalent",
   "concept": "mechanical-equivalent-of-heat",
   "section": "14.1",
   "latex": "1.000\\;\\text{kcal} = 4186\\;\\text{J}",
   "condition": "the 15 °C calorie",
   "important": true,
   "anchor": "14.1-mechanical-equivalent"
  },
  {
   "id": "eq-heat-temperature-change",
   "concept": "heat-and-temperature-change",
   "section": "14.2",
   "latex": "Q = mc\\Delta T",
   "ktex": "\\kQh = m\\,c\\,\\kdTemp",
   "condition": "no phase change and no work done",
   "important": true,
   "anchor": "14.2-heat-equation"
  },
  {
   "id": "eq-temperature-difference",
   "section": "14.2",
   "latex": "\\Delta T = T_{\\text{f}} - T_{\\text{i}}",
   "ktex": "\\kdTemp = \\kTempf - \\kTempi",
   "important": false,
   "anchor": "14.2-heat-equation"
  },
  {
   "id": "eq-temperature-change-from-heat",
   "concept": "temperature-rise-from-work",
   "section": "14.2",
   "latex": "\\Delta T = \\frac{Q}{mc}",
   "ktex": "\\kdTemp = \\frac{\\kQh}{m\\,c}",
   "important": true,
   "anchor": "14.2-work-into-heat"
  },
  {
   "id": "eq-calorimetry",
   "concept": "calorimetry",
   "section": "14.2",
   "latex": "Q_{\\text{cold}} + Q_{\\text{hot}} = 0",
   "ktex": "\\kQcold + \\kQhot = 0",
   "condition": "no heat exchanged with the surroundings",
   "important": true,
   "anchor": "14.2-calorimetry"
  },
  {
   "id": "eq-heat-balance",
   "section": "14.2",
   "latex": "m_W c_W (T_{\\text{f}} - T_{\\text{i},W}) = -m_{\\text{Al}} c_{\\text{Al}} (T_{\\text{f}} - T_{\\text{i},\\text{Al}})",
   "important": false,
   "anchor": "14.2-calorimetry"
  },
  {
   "id": "eq-final-temperature",
   "concept": "final-temperature-from-heat-exchange",
   "section": "14.2",
   "latex": "T_{\\text{f}} = \\frac{m_{\\text{Al}} c_{\\text{Al}} T_{\\text{i},\\text{Al}} + m_W c_W T_{\\text{i},W}}{m_{\\text{Al}} c_{\\text{Al}} + m_W c_W}",
   "condition": "two bodies exchanging heat with no phase change",
   "important": true,
   "anchor": "14.2-calorimetry"
  },
  {
   "id": "eq-heat-fusion",
   "concept": "heat-of-fusion",
   "section": "14.3",
   "latex": "Q = mL_{\\text{f}}",
   "ktex": "\\kQh = m\\,L_{\\text{f}}",
   "condition": "melting or freezing",
   "important": true,
   "anchor": "14.3-phase-change"
  },
  {
   "id": "eq-heat-vaporization",
   "concept": "heat-of-vaporization",
   "section": "14.3",
   "latex": "Q = mL_{\\text{v}}",
   "ktex": "\\kQh = m\\,L_{\\text{v}}",
   "condition": "vaporization or condensation",
   "important": true,
   "anchor": "14.3-phase-change"
  },
  {
   "id": "eq-heat-sublimation",
   "concept": "heat-of-sublimation",
   "section": "14.3",
   "latex": "Q = mL_{\\text{s}}",
   "ktex": "\\kQh = m\\,L_{\\text{s}}",
   "condition": "solid to vapor, or vapor to solid",
   "important": true,
   "anchor": "14.3-sublimation"
  },
  {
   "id": "eq-latent-heat",
   "concept": "latent-heat",
   "section": "14.3",
   "latex": "Q = mL",
   "ktex": "\\kQh = m\\,L",
   "condition": "during a phase change",
   "important": true,
   "anchor": "14.3-phase-change"
  },
  {
   "id": "eq-ice-soda-balance",
   "concept": "phase-change-calorimetry",
   "section": "14.3",
   "latex": "m_{\\text{ice}} L_{\\text{f}} + m_{\\text{ice}} c_W (T_{\\text{f}} - 0^\\circ\\text{C}) = -m_{\\text{soda}} c_W (T_{\\text{f}} - 20^\\circ\\text{C})",
   "condition": "the soda and the ice exchange heat with nothing else",
   "important": false,
   "anchor": "14.3-cooling-soda"
  },
  {
   "id": "eq-conduction-rate",
   "concept": "rate-of-conductive-heat-transfer",
   "section": "14.5",
   "latex": "\\frac{Q}{t} = \\frac{kA(T_2 - T_1)}{d}",
   "ktex": "\\frac{\\kQh}{\\kt} = \\frac{k\\,A\\,(\\kTemptwo - \\kTempone)}{d}",
   "condition": "steady conduction through a slab",
   "important": true,
   "anchor": "14.5-conduction-rate"
  },
  {
   "id": "eq-conduction-temperature-difference",
   "concept": "temperature-difference-from-conduction",
   "section": "14.5",
   "latex": "T_2 - T_1 = \\frac{Q}{t}\\left(\\frac{d}{kA}\\right)",
   "ktex": "\\kTemptwo - \\kTempone = \\frac{\\kQh}{\\kt}\\left(\\frac{d}{k\\,A}\\right)",
   "important": true,
   "anchor": "14.5-pan"
  },
  {
   "id": "eq-heat-flux-temperature-difference",
   "section": "14.5",
   "latex": "\\Delta T = T_{\\text{hot}} - T_{\\text{cold}}",
   "ktex": "\\kdTemp = \\kTemphot - \\kTempcold",
   "important": false,
   "anchor": "14.5-collisions"
  },
  {
   "id": "eq-convection-heat-rate",
   "concept": "convection-heat-rate",
   "section": "14.6",
   "latex": "\\frac{Q}{t} = \\frac{mc\\Delta T}{t}",
   "ktex": "\\frac{\\kQh}{\\kt} = \\frac{m\\,c\\,\\kdTemp}{\\kt}",
   "condition": "the mass m of fluid is moved or replaced in the time t",
   "important": true,
   "anchor": "14.6-moving-mass"
  },
  {
   "id": "eq-evaporation-rate",
   "concept": "convection-with-phase-change",
   "section": "14.6",
   "latex": "\\frac{m}{t} = \\frac{Q/t}{L_{\\text{v}}}",
   "ktex": "\\frac{m}{\\kt} = \\frac{\\kQh/\\kt}{L_{\\text{v}}}",
