      "section": "16.3",
      "name": "Simple harmonic oscillator",
      "statement": "A simple harmonic oscillator is a system that obeys Hooke’s law and so moves in simple harmonic motion, such as a mass attached to a spring.",
      "introduces": "shm",
      "prereqs": [
        "simple-harmonic-motion",
        "hookes-law"
      ]
    }
