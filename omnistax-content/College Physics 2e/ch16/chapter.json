 ],
 "glossary": [
  {
   "section": "16.1",
   "term": "deformation",
   "definition": "displacement from equilibrium"
  },
  {
   "section": "16.1",
   "term": "elastic potential energy",
   "definition": "potential energy stored as a result of deformation of an elastic object, such as the stretching of a spring"
  },
  {
   "section": "16.1",
   "term": "force constant",
   "definition": "a constant related to the rigidity of a system: the larger the force constant, the more rigid the system; the force constant is represented by k"
  },
  {
   "section": "16.1",
   "term": "restoring force",
   "definition": "force acting in opposition to the force caused by a deformation"
  },
  {
   "section": "16.2",
   "term": "period",
   "definition": "time it takes to complete one oscillation"
  },
  {
   "section": "16.2",
   "term": "periodic motion",
   "definition": "motion that repeats itself at regular time intervals"
  },
  {
   "section": "16.2",
   "term": "frequency",
   "definition": "number of events per unit of time"
  },
  {
   "section": "16.3",
   "term": "amplitude",
   "definition": "the maximum displacement from the equilibrium position of an object oscillating around the equilibrium position"
  },
  {
   "section": "16.3",
   "term": "simple harmonic motion",
   "definition": "the oscillatory motion in a system where the net force can be described by Hooke’s law"
  },
  {
   "section": "16.3",
   "term": "simple harmonic oscillator",
   "definition": "a device that implements Hooke’s law, such as a mass that is attached to a spring, with the other end of the spring being connected to a rigid support such as a wall"
  },
  {
   "section": "16.4",
   "term": "simple pendulum",
   "definition": "an object with a small mass suspended from a light wire or string"
  },
  {
   "section": "16.7",
   "term": "critical damping",
   "definition": "the condition in which the damping of an oscillator causes it to return as quickly as possible to its equilibrium position without oscillating back and forth about this position"
  },
  {
   "section": "16.7",
   "term": "over damping",
   "definition": "the condition in which damping of an oscillator causes it to return to equilibrium without oscillating; oscillator moves more slowly toward equilibrium than in the critically damped system"
  },
  {
   "section": "16.7",
   "term": "under damping",
   "definition": "the condition in which damping of an oscillator causes it to return to equilibrium with the amplitude gradually decreasing to zero; system returns to equilibrium faster but overshoots and crosses the equilibrium position one or more times"
  },
  {
   "section": "16.8",
   "term": "natural frequency",
   "definition": "the frequency at which a system would oscillate if there were no driving and no damping forces"
  },
  {
   "section": "16.8",
   "term": "resonance",
   "definition": "the phenomenon of driving a system with a frequency equal to the system's natural frequency"
  },
  {
   "section": "16.8",
   "term": "resonate",
   "definition": "a system being driven at its natural frequency"
  },
  {
   "section": "16.9",
   "term": "longitudinal wave",
   "definition": "a wave in which the disturbance is parallel to the direction of propagation"
  },
  {
   "section": "16.9",
   "term": "transverse wave",
   "definition": "a wave in which the disturbance is perpendicular to the direction of propagation"
  },
  {
   "section": "16.9",
   "term": "wave velocity",
   "definition": "the speed at which the disturbance moves. Also called the propagation velocity or propagation speed"
  },
  {
   "section": "16.9",
   "term": "wavelength",
   "definition": "the distance between adjacent identical parts of a wave"
  },
  {
   "section": "16.10",
   "term": "antinode",
   "definition": "the location of maximum amplitude in standing waves"
  },
  {
   "section": "16.10",
   "term": "beat frequency",
   "definition": "the frequency of the amplitude fluctuations of a wave"
  },
  {
   "section": "16.10",
   "term": "constructive interference",
   "definition": "when two waves arrive at the same point exactly in phase; that is, the crests of the two waves are precisely aligned, as are the troughs"
  },
  {
   "section": "16.10",
   "term": "destructive interference",
   "definition": "when two identical waves arrive at the same point exactly out of phase; that is, precisely aligned crest to trough"
  },
  {
   "section": "16.10",
   "term": "fundamental frequency",
   "definition": "the lowest frequency of a periodic waveform"
  },
  {
   "section": "16.10",
   "term": "nodes",
   "definition": "the points where the string does not move; more generally, nodes are where the wave disturbance is zero in a standing wave"
  },
  {
   "section": "16.10",
   "term": "overtones",
   "definition": "multiples of the fundamental frequency of a sound"
  },
  {
   "section": "16.10",
   "term": "superposition",
   "definition": "the phenomenon that occurs when two or more waves arrive at the same point"
  },
  {
   "section": "16.11",
   "term": "intensity",
   "definition": "power per unit area"
  }
 ]
}
