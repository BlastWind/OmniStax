      "id": "change-in-angular-velocity",
      "kind": "definition",
      "section": "10.1",
      "name": "Change in angular velocity $\\kdw$",
      "statement": "The change in angular velocity is the difference between the final and the initial values of the angular velocity.",
      "introduces": "angular-acceleration",
      "prereqs": [
        "angular-velocity"
      ]
    },
    {
      "id": "kinematics-of-rotational-motion",
      "kind": "definition",
      "section": "10.2",
      "name": "Kinematics of rotational motion",
      "statement": "The kinematics of rotational motion describes the relationships among the rotation angle, angular velocity, angular acceleration and time, without regard to the forces and masses that cause the rotation.",
      "introduces": "rotational-kinematics",
      "prereqs": [
        "rotation-angle",
        "angular-velocity",
        "angular-acceleration",
        "time"
      ]
    },
    {
      "id": "right-hand-rule-for-rotation",
      "kind": "definition",
      "section": "10.7",
      "name": "The right-hand rule for rotation",
      "statement": "The right-hand rule defines the directions of angular velocity and angular momentum: when the fingers of the right hand curl in the direction of the rotation, the thumb points in the direction of $\\omega$ and of $L$, along the axis of rotation.",
      "introduces": "right-hand-rule",
      "prereqs": [
        "angular-velocity",
        "angular-momentum"
      ]
    }
  ],
