 "glossary": [
  {
   "section": "10.1",
   "term": "angular acceleration",
   "definition": "the rate of change of angular velocity with time"
  },
  {
   "section": "10.1",
   "term": "change in angular velocity",
   "definition": "the difference between final and initial values of angular velocity"
  },
  {
   "section": "10.1",
   "term": "tangential acceleration",
   "definition": "the acceleration in a direction tangent to the circle at the point of interest in circular motion"
  },
  {
   "section": "10.2",
   "term": "kinematics of rotational motion",
   "definition": "describes the relationships among rotation angle, angular velocity, angular acceleration, and time"
  },
  {
   "section": "10.3",
   "term": "torque",
   "definition": "the turning effectiveness of a force"
  },
  {
   "section": "10.3",
   "term": "rotational inertia",
   "definition": "resistance to change of rotation. The more rotational inertia an object has, the harder it is to rotate"
  },
  {
   "section": "10.3",
   "term": "moment of inertia",
   "definition": "mass times the square of perpendicular distance from the rotation axis; for a point mass, it is $I = mr^2$ and, because any object can be built up from a collection of point masses, this relationship is the basis for all other moments of inertia"
  },
  {
   "section": "10.4",
   "term": "work-energy theorem",
   "definition": "if one or more external forces act upon a rigid object, causing its kinetic energy to change from $\\text{KE}_1$ to $\\text{KE}_2$, then the work $W$ done by the net force is equal to the change in kinetic energy"
  },
  {
   "section": "10.4",
   "term": "rotational kinetic energy",
   "definition": "the kinetic energy due to the rotation of an object. This is part of its total kinetic energy"
  },
  {
   "section": "10.5",
   "term": "angular momentum",
   "definition": "the product of moment of inertia and angular velocity"
  },
  {
   "section": "10.5",
   "term": "law of conservation of angular momentum",
   "definition": "angular momentum is conserved, i.e., the initial angular momentum is equal to the final angular momentum when no external torque is applied to the system"
  },
  {
   "section": "10.7",
   "term": "right-hand rule",
   "definition": "direction of angular velocity $\\omega$ and angular momentum $L$ in which the thumb of your right hand points when you curl your fingers in the direction of the disk's rotation"
  }
 ]
}
