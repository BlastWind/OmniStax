 "variables": [
  { "sym": "θ_i", "concept": "angle-of-incidence", "meaning": "the angle of incidence, measured from the perpendicular to the surface at the point where the ray strikes it", "unit": "°", "section": "25.2", "anchor": "25.2-reflection-and-diffusion" },
  { "sym": "θ_r", "concept": "angle-of-reflection", "meaning": "the angle of reflection, measured from the same perpendicular, which equals the angle of incidence", "unit": "°", "section": "25.2", "anchor": "25.2-reflection-and-diffusion" },
  { "sym": "c", "concept": "speed-of-light-in-vacuum", "type": "velocity", "meaning": "the speed of light in a vacuum, a fixed value and one of the basic physical quantities", "unit": "m/s", "section": "25.3", "anchor": "25.3-speed-of-light" },
  { "sym": "v", "concept": "instantaneous-speed", "type": "velocity", "meaning": "the observed speed of light in a material, which is always less than its speed in a vacuum", "unit": "m/s", "section": "25.3", "anchor": "25.3-speed-of-light" },
  { "sym": "n", "concept": "index-of-refraction", "meaning": "the index of refraction of a material, the ratio of the speed of light in a vacuum to its speed in the material", "section": "25.3", "anchor": "25.3-speed-of-light" },
  { "sym": "n_1", "concept": "index-of-refraction", "meaning": "the index of refraction of the medium the ray starts in", "section": "25.3", "anchor": "25.3-law-of-refraction" },
  { "sym": "n_2", "concept": "index-of-refraction", "meaning": "the index of refraction of the medium the ray crosses into", "section": "25.3", "anchor": "25.3-law-of-refraction" },
  { "sym": "θ_1", "concept": "angle-of-incidence", "meaning": "the angle between the incident ray and the perpendicular to the surface, in medium 1", "unit": "°", "section": "25.3", "anchor": "25.3-law-of-refraction" },
  { "sym": "θ_2", "concept": "angle-of-refraction", "meaning": "the angle between the refracted ray and the perpendicular to the surface, in medium 2", "unit": "°", "section": "25.3", "anchor": "25.3-law-of-refraction" },
  { "sym": "θ_c", "concept": "critical-angle", "meaning": "the critical angle, the angle of incidence that produces an angle of refraction of 90°", "unit": "°", "section": "25.4", "anchor": "25.4-critical-angle" },
  { "sym": "θ_1", "concept": "angle-of-incidence", "meaning": "the angle of incidence inside the denser medium, which is compared with the critical angle", "unit": "°", "section": "25.4", "anchor": "25.4-critical-angle" },
  { "sym": "θ_2", "concept": "angle-of-refraction", "meaning": "the angle of refraction in the second medium, which reaches 90° at the critical angle", "unit": "°", "section": "25.4", "anchor": "25.4-critical-angle" },
  { "sym": "n_1", "concept": "index-of-refraction", "meaning": "the index of refraction of the medium the ray travels in, which must be the larger of the two", "section": "25.4", "anchor": "25.4-critical-angle" },
  { "sym": "n_2", "concept": "index-of-refraction", "meaning": "the index of refraction of the medium beyond the surface, which must be the smaller of the two", "section": "25.4", "anchor": "25.4-critical-angle" },
  { "sym": "λ", "concept": "wavelength", "type": "position", "meaning": "the wavelength of the light, which decides both the color the eye sees and the index of refraction the medium presents", "unit": "nm", "section": "25.5", "anchor": "25.5-colors-of-light" },
  { "sym": "n", "concept": "index-of-refraction", "meaning": "the index of refraction of a medium at one wavelength, which grows as the wavelength falls", "section": "25.5", "anchor": "25.5-index-and-wavelength" },
  { "sym": "f_focal", "concept": "focal-length", "type": "position", "meaning": "the focal length of the lens, the distance from its center to its focal point, positive for a converging lens and negative for a diverging one", "unit": "m", "section": "25.6", "anchor": "25.6-converging-lens" },
  { "sym": "P_lens", "concept": "power-of-a-lens", "meaning": "the power of the lens, the inverse of its focal length in meters", "unit": "D", "section": "25.6", "anchor": "25.6-lens-power" },
  { "sym": "d_obj", "concept": "object-distance", "type": "position", "meaning": "the object distance, the distance of the object from the center of the lens", "unit": "m", "section": "25.6", "anchor": "25.6-thin-lens-equations" },
  { "sym": "d_img", "concept": "image-distance", "type": "position", "meaning": "the image distance, the distance of the image from the center of the lens, positive for a real image and negative for a virtual one", "unit": "m", "section": "25.6", "anchor": "25.6-thin-lens-equations" },
  { "sym": "h_obj", "concept": "length", "type": "position", "meaning": "the height of the object", "unit": "m", "section": "25.6", "anchor": "25.6-thin-lens-equations" },
  { "sym": "h_img", "concept": "length", "type": "position", "meaning": "the height of the image, positive where the image is upright and negative where it is inverted", "unit": "m", "section": "25.6", "anchor": "25.6-thin-lens-equations" },
  { "sym": "m", "concept": "magnification", "meaning": "the magnification, the ratio of image height to object height", "section": "25.6", "anchor": "25.6-thin-lens-equations" },
  { "sym": "R_curv", "concept": "radius-of-curvature-of-a-mirror", "type": "position", "meaning": "the radius of curvature of a spherical mirror, twice its focal length", "unit": "m", "section": "25.7", "anchor": "25.7-mirror-focal-length" },
  { "sym": "f_focal", "concept": "focal-length", "type": "position", "meaning": "the focal length of the mirror, positive for a concave converging mirror and negative for a convex diverging one", "unit": "m", "section": "25.7", "anchor": "25.7-mirror-focal-length" },
  { "sym": "P_lens", "concept": "power-of-a-lens", "meaning": "the power of the mirror, the inverse of its focal length in meters", "unit": "D", "section": "25.7", "anchor": "25.7-mirror-focal-length" },
  { "sym": "d_obj", "concept": "object-distance", "type": "position", "meaning": "the object distance, the distance of the object from the center of the mirror", "unit": "m", "section": "25.7", "anchor": "25.7-mirror-cases" },
  { "sym": "d_img", "concept": "image-distance", "type": "position", "meaning": "the image distance, positive for a real image in front of the mirror and negative for a virtual image behind it", "unit": "m", "section": "25.7", "anchor": "25.7-mirror-cases" },
  { "sym": "h_obj", "concept": "length", "type": "position", "meaning": "the height of the object", "unit": "m", "section": "25.7", "anchor": "25.7-mirror-cases" },
  { "sym": "h_img", "concept": "length", "type": "position", "meaning": "the height of the image, negative where the image is inverted", "unit": "m", "section": "25.7", "anchor": "25.7-mirror-cases" },
  { "sym": "m", "concept": "magnification", "meaning": "the magnification, the ratio of image height to object height", "section": "25.7", "anchor": "25.7-mirror-cases" }
 ],
 "equations": [
  {
   "id": "eq-law-of-reflection",
   "concept": "law-of-reflection",
   "section": "25.2",
   "latex": "\\theta_{\\text{r}} = \\theta_{\\text{i}}",
   "important": true,
   "anchor": "25.2-law-of-reflection"
  },
  {
   "id": "eq-speed-of-light",
   "concept": "speed-of-light-in-vacuum",
   "section": "25.3",
   "latex": "c = 2.99792458 \\times 10^{8}\\;\\text{m/s} \\approx 3.00 \\times 10^{8}\\;\\text{m/s}",
   "ktex": "\\kc = 2.99792458 \\times 10^{8}\\;\\text{m/s} \\approx 3.00 \\times 10^{8}\\;\\text{m/s}",
   "important": true,
   "anchor": "25.3-speed-of-light"
  },
  {
   "id": "eq-index-of-refraction",
   "concept": "index-of-refraction",
   "section": "25.3",
   "latex": "n = \\frac{c}{v}",
   "ktex": "n = \\frac{\\kc}{\\kv}",
   "important": true,
   "anchor": "25.3-speed-of-light"
  },
  {
   "id": "eq-speed-from-index",
   "concept": "speed-in-a-medium-from-the-index",
   "section": "25.3",
   "latex": "v = \\frac{c}{n}",
   "ktex": "\\kv = \\frac{\\kc}{n}",
   "anchor": "25.3-speed-of-light"
  },
  {
   "id": "eq-snells-law",
   "concept": "snells-law",
   "section": "25.3",
   "latex": "n_1 \\sin\\theta_1 = n_2 \\sin\\theta_2",
   "important": true,
   "anchor": "25.3-law-of-refraction"
  },
  {
   "id": "eq-index-from-angles",
   "concept": "snells-law",
   "section": "25.3",
   "latex": "n_2 = n_1 \\frac{\\sin\\theta_1}{\\sin\\theta_2}",
   "anchor": "25.3-law-of-refraction"
  },
  {
   "id": "eq-refracted-angle",
   "concept": "snells-law",
   "section": "25.3",
   "latex": "\\sin\\theta_2 = \\frac{n_1}{n_2}\\sin\\theta_1",
   "anchor": "25.3-law-of-refraction"
  },
  {
   "id": "eq-critical-angle-condition",
   "concept": "critical-angle-from-the-indices",
   "section": "25.4",
   "latex": "n_1 \\sin\\theta_1 = n_2",
   "anchor": "25.4-critical-angle"
  },
  {
   "id": "eq-critical-angle",
   "concept": "critical-angle-from-the-indices",
   "section": "25.4",
   "latex": "\\theta_{\\text{c}} = \\sin^{-1}(n_2/n_1)\\;\\text{for}\\;n_1 > n_2",
   "important": true,
   "anchor": "25.4-critical-angle"
  },
  {
   "id": "eq-lens-power",
   "concept": "power-of-a-lens",
   "section": "25.6",
   "latex": "P = \\frac{1}{f}",
   "ktex": "P = \\frac{1}{\\kffoc}",
   "important": true,
   "anchor": "25.6-lens-power"
  },
  {
   "id": "eq-thin-lens",
   "concept": "thin-lens-equation",
   "section": "25.6",
   "latex": "\\frac{1}{d_{\\text{o}}} + \\frac{1}{d_{\\text{i}}} = \\frac{1}{f}",
   "ktex": "\\frac{1}{\\kdobj} + \\frac{1}{\\kdimg} = \\frac{1}{\\kffoc}",
   "important": true,
   "anchor": "25.6-thin-lens-equations"
  },
  {
   "id": "eq-magnification",
   "concept": "magnification",
   "section": "25.6",
   "latex": "\\frac{h_{\\text{i}}}{h_{\\text{o}}} = -\\frac{d_{\\text{i}}}{d_{\\text{o}}} = m",
   "ktex": "\\frac{\\khimg}{\\khobj} = -\\frac{\\kdimg}{\\kdobj} = m",
   "important": true,
   "anchor": "25.6-thin-lens-equations"
  },
  {
   "id": "eq-thin-lens-rearranged",
   "concept": "thin-lens-equation",
   "section": "25.6",
   "latex": "\\frac{1}{d_{\\text{i}}} = \\frac{1}{f} - \\frac{1}{d_{\\text{o}}}",
   "ktex": "\\frac{1}{\\kdimg} = \\frac{1}{\\kffoc} - \\frac{1}{\\kdobj}",
   "anchor": "25.6-thin-lens-equations"
  },
  {
   "id": "eq-image-distance-solved",
   "concept": "thin-lens-equation",
   "section": "25.6",
   "latex": "d_{\\text{i}} = \\frac{f d_{\\text{o}}}{d_{\\text{o}} - f}",
   "ktex": "\\kdimg = \\frac{\\kffoc \\kdobj}{\\kdobj - \\kffoc}",
   "anchor": "25.6-thin-lens-equations"
  },
  {
   "id": "eq-mirror-focal-length",
   "concept": "focal-length-of-a-spherical-mirror",
   "section": "25.7",
   "latex": "f = \\frac{R}{2}",
   "ktex": "\\kffoc = \\frac{\\kRcur}{2}",
   "important": true,
   "anchor": "25.7-mirror-focal-length"
  }
 ],
 "glossary": [
  { "section": "25.1", "term": "ray", "concept": "ray", "definition": "straight line that originates at some point" },
  { "section": "25.1", "term": "geometric optics", "concept": "geometric-optics", "definition": "part of optics dealing with the ray aspect of light" },
  { "section": "25.2", "term": "mirror", "concept": "mirror", "definition": "smooth surface that reflects light at specific angles, forming an image of the person or object in front of it" },
  { "section": "25.2", "term": "law of reflection", "concept": "law-of-reflection", "definition": "angle of reflection equals the angle of incidence" },
  { "section": "25.3", "term": "refraction", "concept": "refraction", "definition": "changing of a light ray’s direction when it passes through variations in matter" },
  { "section": "25.3", "term": "index of refraction", "concept": "index-of-refraction", "definition": "for a material, the ratio of the speed of light in vacuum to that in the material" },
  { "section": "25.4", "term": "critical angle", "concept": "critical-angle", "definition": "incident angle that produces an angle of refraction of 90°" },
  { "section": "25.4", "term": "fiber optics", "concept": "fiber-optics", "definition": "transmission of light down fibers of plastic or glass, applying the principle of total internal reflection" },
  { "section": "25.4", "term": "corner reflector", "concept": "corner-reflector", "definition": "an object consisting of two mutually perpendicular reflecting surfaces, so that the light that enters is reflected back exactly parallel to the direction from which it came" },
  { "section": "25.4", "term": "zircon", "concept": "zircon", "definition": "natural gemstone with a large index of refraction" },
  { "section": "25.5", "term": "dispersion", "concept": "dispersion", "definition": "spreading of white light into its full spectrum of wavelengths" },
  { "section": "25.5", "term": "rainbow", "concept": "rainbow", "definition": "dispersion of sunlight into a continuous distribution of colors according to wavelength, produced by the refraction and reflection of sunlight by water droplets in the sky" },
  { "section": "25.6", "term": "converging lens", "concept": "converging-lens", "definition": "a convex lens in which light rays that enter it parallel to its axis converge at a single point on the opposite side" },
  { "section": "25.6", "term": "diverging lens", "concept": "diverging-lens", "definition": "a concave lens in which light rays that enter it parallel to its axis bend away (diverge) from its axis" },
  { "section": "25.6", "term": "focal point", "concept": "focal-point", "definition": "for a converging lens or mirror, the point at which converging light rays cross; for a diverging lens or mirror, the point from which diverging light rays appear to originate" },
  { "section": "25.6", "term": "focal length", "concept": "focal-length", "definition": "distance from the center of a lens or curved mirror to its focal point" },
  { "section": "25.6", "term": "magnification", "concept": "magnification", "definition": "ratio of image height to object height" },
  { "section": "25.6", "term": "power", "concept": "power-of-a-lens", "definition": "inverse of focal length" },
  { "section": "25.6", "term": "real image", "concept": "real-image", "definition": "image that can be projected" },
  { "section": "25.6", "term": "virtual image", "concept": "virtual-image", "definition": "image that cannot be projected" },
  { "section": "25.7", "term": "converging mirror", "concept": "converging-mirror", "definition": "a concave mirror in which light rays that strike it parallel to its axis converge at one or more points along the axis" },
  { "section": "25.7", "term": "diverging mirror", "concept": "diverging-mirror", "definition": "a convex mirror in which light rays that strike it parallel to its axis bend away (diverge) from its axis" },
  { "section": "25.7", "term": "law of reflection", "concept": "law-of-reflection", "definition": "angle of reflection equals the angle of incidence" }
 ]
}
