      "kind": "definition",
      "section": "23.7",
      "name": "Step-up transformer",
      "statement": "A step-up transformer has more turns on its secondary coil than on its primary, so it raises the voltage.",
      "introduces": "the-transformer-equation",
      "prereqs": [
        "transformer-equation"
      ]
    },
    {
      "id": "step-down-transformer",
      "kind": "definition",
      "section": "23.7",
      "name": "Step-down transformer",
      "statement": "A step-down transformer has fewer turns on its secondary coil than on its primary, so it lowers the voltage.",
      "introduces": "the-transformer-equation",
      "prereqs": [
        "transformer-equation"
      ]
    },
    {
      "id": "inductor",
      "kind": "definition",
      "section": "23.9",
      "name": "Inductor",
      "statement": "An inductor is a device with a large self-inductance, usually a coil, whose induced emf strongly opposes any change in the current through it.",
      "introduces": "self-inductance",
      "prereqs": [
        "self-inductance"
      ]
    },
    {
      "id": "rlc-circuit",
      "kind": "definition",
      "section": "23.12",
      "name": "RLC circuit",
      "statement": "An RLC circuit contains a resistor, an inductor and a capacitor, and in a series RLC circuit the same alternating current passes through all three.",
      "introduces": "impedance",
      "prereqs": [
        "resistor",
        "inductor",
        "capacitor",
        "alternating-current"
      ]
    }
  ],
