 "glossary": [
  {
   "section": "23.1",
   "term": "induction",
   "definition": "(magnetic induction) the creation of emfs and hence currents by magnetic fields"
  },
  {
   "section": "23.1",
   "term": "magnetic flux",
   "definition": "the amount of magnetic field going through a particular area, calculated with $\\Phi = BA\\cos\\theta$ where $B$ is the magnetic field strength over an area $A$ at an angle $\\theta$ with the perpendicular to the area"
  },
  {
   "section": "23.1",
   "term": "electromagnetic induction",
   "definition": "the process of inducing an emf (voltage) with a change in magnetic flux"
  },
  {
   "section": "23.2",
   "term": "Faraday’s law of induction",
   "definition": "the means of calculating the emf in a coil due to changing magnetic flux, given by $\\text{emf} = -N\\frac{\\Delta\\Phi}{\\Delta t}$"
  },
  {
   "section": "23.2",
   "term": "Lenz’s law",
   "definition": "the minus sign in Faraday’s law, signifying that the emf induced in a coil opposes the change in magnetic flux"
  },
  {
   "section": "23.4",
   "term": "eddy current",
   "definition": "a current loop in a conductor caused by motional emf"
  },
  {
   "section": "23.4",
   "term": "magnetic damping",
   "definition": "the drag produced by eddy currents"
  },
  {
   "section": "23.5",
   "term": "electric generator",
   "definition": "a device for converting mechanical work into electric energy; it induces an emf by rotating a coil in a magnetic field"
  },
  {
   "section": "23.5",
   "term": "emf induced in a generator coil",
   "definition": "$\\text{emf} = NAB\\omega\\sin\\omega t$, where $A$ is the area of an $N$-turn coil rotated at a constant angular velocity $\\omega$ in a uniform magnetic field $B$, over a period of time $t$"
  },
  {
   "section": "23.5",
   "term": "peak emf",
   "definition": "$\\text{emf}_0 = NAB\\omega$"
  },
  {
   "section": "23.6",
   "term": "back emf",
   "definition": "the emf generated by a running motor, because it consists of a coil turning in a magnetic field; it opposes the voltage powering the motor"
  },
  {
   "section": "23.7",
   "term": "transformer",
   "definition": "a device that transforms voltages from one value to another using induction"
  },
  {
   "section": "23.7",
   "term": "transformer equation",
   "definition": "the equation showing that the ratio of the secondary to primary voltages in a transformer equals the ratio of the number of loops in their coils; $\\frac{V_{\\text{s}}}{V_{\\text{p}}} = \\frac{N_{\\text{s}}}{N_{\\text{p}}}$"
  },
  {
   "section": "23.7",
   "term": "step-up transformer",
   "definition": "a transformer that increases voltage"
  },
  {
   "section": "23.7",
   "term": "step-down transformer",
   "definition": "a transformer that decreases voltage"
  },
  {
   "section": "23.8",
   "term": "thermal hazard",
   "definition": "the term for electrical hazards due to overheating"
  },
  {
   "section": "23.8",
   "term": "shock hazard",
   "definition": "the term for electrical hazards due to current passing through a human"
  },
  {
   "section": "23.8",
   "term": "three-wire system",
   "definition": "the wiring system used at present for safety reasons, with live, neutral, and ground wires"
  },
  {
   "section": "23.9",
   "term": "inductance",
   "definition": "a property of a device describing how efficient it is at inducing emf in another device"
  },
  {
   "section": "23.9",
   "term": "mutual inductance",
   "definition": "how effective a pair of devices are at inducing emfs in each other"
  },
  {
   "section": "23.9",
   "term": "henry",
   "definition": "the unit of inductance; $1\\;\\text{H} = 1\\;\\Omega\\cdot\\text{s}$"
  },
  {
   "section": "23.9",
   "term": "self-inductance",
   "definition": "how effective a device is at inducing emf in itself"
  },
  {
   "section": "23.9",
   "term": "inductor",
   "definition": "a device that exhibits significant self-inductance"
  },
  {
   "section": "23.9",
   "term": "energy stored in an inductor",
   "definition": "self-explanatory; calculated by $E_{\\text{ind}} = \\frac{1}{2}LI^2$"
  },
  {
   "section": "23.10",
   "term": "characteristic time constant",
   "definition": "denoted by $\\tau$, of a particular series RL circuit is calculated by $\\tau = \\frac{L}{R}$, where $L$ is the inductance and $R$ is the resistance"
  },
  {
   "section": "23.11",
   "term": "inductive reactance",
   "definition": "the opposition of an inductor to a change in current; calculated by $X_L = 2\\pi fL$"
  },
  {
   "section": "23.11",
   "term": "capacitive reactance",
   "definition": "the opposition of a capacitor to a change in current; calculated by $X_C = \\frac{1}{2\\pi fC}$"
  },
  {
   "section": "23.12",
   "term": "impedance",
   "definition": "the AC analogue to resistance in a DC circuit; it is the combined effect of resistance, inductive reactance, and capacitive reactance in the form $Z = \\sqrt{R^2 + (X_L - X_C)^2}$"
  },
  {
   "section": "23.12",
   "term": "resonant frequency",
   "definition": "the frequency at which the impedance in a circuit is at a minimum, and also the frequency at which the circuit would oscillate if not driven by a voltage source; calculated by $f_0 = \\frac{1}{2\\pi\\sqrt{LC}}$"
  },
  {
   "section": "23.12",
   "term": "phase angle",
   "definition": "denoted by $\\phi$, the amount by which the voltage and current are out of phase with each other in a circuit"
  },
  {
   "section": "23.12",
   "term": "power factor",
   "definition": "the amount by which the power delivered in the circuit is less than the theoretical maximum of the circuit due to voltage and current being out of phase; calculated by $\\cos\\phi$"
  }
 ]
}
