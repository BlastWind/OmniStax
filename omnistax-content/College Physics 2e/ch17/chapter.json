  "glossary": [
    {
      "section": "17.1",
      "term": "sound",
      "definition": "a disturbance of matter that is transmitted from its source outward"
    },
    {
      "section": "17.1",
      "term": "hearing",
      "definition": "the perception of sound"
    },
    {
      "section": "17.2",
      "term": "pitch",
      "definition": "the perception of the frequency of a sound"
    },
    {
      "section": "17.3",
      "term": "intensity",
      "definition": "the power per unit area carried by a wave"
    },
    {
      "section": "17.3",
      "term": "sound intensity level",
      "definition": "a unitless quantity telling you the level of the sound relative to a fixed standard"
    },
    {
      "section": "17.3",
      "term": "sound pressure level",
      "definition": "the ratio of the pressure amplitude to a reference pressure"
    },
    {
      "section": "17.4",
      "term": "Doppler effect",
      "definition": "an alteration in the observed frequency of a sound due to motion of either the source or the observer"
    },
    {
      "section": "17.4",
      "term": "Doppler shift",
      "definition": "the actual change in frequency due to relative motion of source and observer"
    },
    {
      "section": "17.4",
      "term": "sonic boom",
      "definition": "a constructive interference of sound created by an object moving faster than sound"
    },
    {
      "section": "17.4",
      "term": "bow wake",
      "definition": "V-shaped disturbance created when the wave source moves faster than the wave propagation speed"
    },
    {
      "section": "17.5",
      "term": "antinode",
      "definition": "point of maximum displacement"
    },
    {
      "section": "17.5",
      "term": "node",
      "definition": "point of zero displacement"
    },
    {
      "section": "17.5",
      "term": "fundamental",
      "definition": "the lowest-frequency resonance"
    },
    {
      "section": "17.5",
      "term": "overtones",
      "definition": "all resonant frequencies higher than the fundamental"
    },
    {
      "section": "17.5",
      "term": "harmonics",
      "definition": "the term used to refer collectively to the fundamental and its overtones"
    },
    {
      "section": "17.6",
      "term": "loudness",
      "definition": "the perception of sound intensity"
    },
    {
      "section": "17.6",
      "term": "timbre",
      "definition": "number and relative intensity of multiple sound frequencies"
    },
    {
      "section": "17.6",
      "term": "note",
      "definition": "basic unit of music with specific names, combined to generate tunes"
    },
    {
      "section": "17.6",
      "term": "tone",
      "definition": "number and relative intensity of multiple sound frequencies"
    },
    {
      "section": "17.6",
      "term": "phon",
      "definition": "the numerical unit of loudness"
    },
    {
      "section": "17.6",
      "term": "ultrasound",
      "definition": "sounds above 20,000 Hz"
    },
    {
      "section": "17.6",
      "term": "infrasound",
      "definition": "sounds below 20 Hz"
    },
    {
      "section": "17.7",
      "term": "acoustic impedance",
      "definition": "property of medium that makes the propagation of sound waves more difficult"
    },
    {
      "section": "17.7",
      "term": "intensity reflection coefficient",
      "definition": "a measure of the ratio of the intensity of the wave reflected off a boundary between two media relative to the intensity of the incident wave"
    },
    {
      "section": "17.7",
      "term": "Doppler-shifted ultrasound",
      "definition": "a medical technique to detect motion and determine velocity through the Doppler shift of an echo"
    }
  ]
}
