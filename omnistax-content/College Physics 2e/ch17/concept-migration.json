  "statements": {
    "sound": "Sound is a disturbance of matter that is transmitted from its source outward, and it is a wave. On the atomic scale it is a disturbance of atoms that is far more ordered than their thermal motions, and in many instances it is a periodic wave in which the atoms undergo simple harmonic motion."
  },
  "new": [
    {
      "id": "phon",
      "kind": "definition",
      "section": "17.6",
      "name": "The phon",
      "statement": "The phon is the numerical unit of loudness. A sound's loudness in phons is the intensity level in decibels of a 1000 Hz tone that sounds equally loud, so at 1000 Hz phons and decibels are numerically equal.",
      "introduces": "equal-loudness",
      "prereqs": [
        "loudness",
        "sound-intensity-level"
      ]
    },
    {
      "id": "doppler-shift",
      "kind": "definition",
      "section": "17.4",
      "name": "Doppler shift",
      "statement": "The Doppler shift is the actual change in frequency due to relative motion of source and observer.",
      "introduces": "doppler-shift",
      "prereqs": [
        "doppler-effect",
        "frequency"
      ]
    },
    {
      "id": "antinode",
      "kind": "definition",
      "section": "17.5",
      "name": "Antinode",
      "statement": "An antinode is a point of maximum displacement in a standing wave. In a tube it lies at an open end, where the air moves freely.",
      "introduces": "nodes-antinodes",
      "prereqs": [
        "nodes-and-antinodes",
        "standing-wave"
      ]
    },
    {
      "id": "node",
      "kind": "definition",
      "section": "17.5",
      "name": "Node",
      "statement": "A node is a point of zero displacement in a standing wave. In a tube it lies at a closed end, where the air cannot move.",
      "introduces": "nodes-antinodes",
      "prereqs": [
        "nodes-and-antinodes",
        "standing-wave"
      ]
    },
    {
      "id": "fundamental",
      "kind": "definition",
      "section": "17.5",
      "name": "Fundamental",
      "statement": "The fundamental is the lowest-frequency resonance of a system.",
      "introduces": "overtones",
      "prereqs": [
        "fundamental-and-overtones",
        "resonance"
      ]
    },
    {
      "id": "overtones",
      "kind": "definition",
      "section": "17.5",
      "name": "Overtones",
      "statement": "Overtones are all the resonant frequencies of a system higher than the fundamental.",
      "introduces": "overtones",
      "prereqs": [
        "fundamental-and-overtones",
        "fundamental"
      ]
    },
    {
      "id": "harmonics",
      "kind": "definition",
      "section": "17.5",
      "name": "Harmonics",
      "statement": "Harmonics is the term used to refer collectively to the fundamental and its overtones, each an integral multiple of the fundamental. The fundamental is the first harmonic.",
      "introduces": "overtones",
      "prereqs": [
        "fundamental-and-overtones",
        "fundamental",
        "overtones"
      ]
    },
    {
      "id": "note",
      "kind": "definition",
      "section": "17.6",
      "name": "Note",
      "statement": "A note is a basic unit of music with a specific name, such as middle C, and notes are combined to make tunes.",
      "introduces": "timbre-tone",
      "prereqs": [
        "timbre",
        "pitch"
      ]
    },
    {
      "id": "ultrasound",
      "kind": "definition",
      "section": "17.6",
      "name": "Ultrasound",
      "statement": "Ultrasound is sound with frequencies above 20,000 Hz, the top of the range of normal human hearing. The ear does not perceive it.",
      "introduces": "hearing-range",
      "prereqs": [
        "audible-range",
        "sound"
      ]
    },
    {
      "id": "infrasound",
      "kind": "definition",
      "section": "17.6",
      "name": "Infrasound",
      "statement": "Infrasound is sound with frequencies below 20 Hz, the bottom of the range of normal human hearing. The ear does not perceive it, though it can sometimes be felt as vibrations.",
      "introduces": "hearing-range",
      "prereqs": [
        "audible-range",
        "sound"
      ]
    }
  ],
