  "statements": {},
  "new": [
    {
      "id": "resistor",
      "kind": "definition",
      "section": "21.1",
      "name": "Resistor",
      "statement": "A resistor is a component made to have a definite resistance, and in a circuit diagram every device that converts electrical energy, from a lamp to a heater, is drawn as one.",
      "introduces": "connections",
      "prereqs": [
        "resistance"
      ]
    },
    {
      "id": "voltmeter",
      "kind": "definition",
      "section": "21.4",
      "name": "Voltmeter",
      "statement": "A voltmeter is an instrument that measures the potential difference between two points, the voltage across whatever it is connected to.",
      "introduces": "meters",
      "prereqs": [
        "potential-difference"
      ]
    },
    {
      "id": "ammeter",
      "kind": "definition",
      "section": "21.4",
      "name": "Ammeter",
      "statement": "An ammeter is an instrument that measures the current through the branch of a circuit in which it is placed.",
      "introduces": "meters",
      "prereqs": [
        "electric-current"
      ]
    },
    {
      "id": "analog-meter",
      "kind": "definition",
      "section": "21.4",
      "name": "Analog meter",
      "statement": "An analog meter gives its reading as the position of a needle over a marked scale, and most are built around a galvanometer.",
      "introduces": "meters",
      "prereqs": []
    },
    {
      "id": "digital-meter",
      "kind": "definition",
      "section": "21.4",
      "name": "Digital meter",
      "statement": "A digital meter gives its reading as a number on a display, measuring the quantity with electronic circuits rather than a moving needle.",
      "introduces": "meters",
      "prereqs": []
    },
    {
      "id": "full-scale-deflection",
      "kind": "definition",
      "section": "21.4",
      "name": "Full-scale deflection",
      "statement": "The full-scale deflection of a meter is the largest reading its needle can show, and the current that gives it is the galvanometer's current sensitivity.",
      "introduces": "galvanometer",
      "prereqs": [
        "galvanometer"
      ]
    },
    {
      "id": "shunt-resistance",
      "kind": "definition",
      "section": "21.4",
      "name": "Shunt resistance",
      "statement": "A shunt resistance is a small resistance connected in parallel with a galvanometer, so that most of the current passes around the galvanometer and the combination can measure larger currents.",
      "introduces": "as-ammeter",
      "prereqs": [
        "resistance",
        "parallel-connection",
        "galvanometer"
      ]
    },
    {
      "id": "bridge-device",
      "kind": "definition",
      "section": "21.5",
      "name": "Bridge device",
      "statement": "A bridge device connects two branches of a circuit through a meter, and adjusting it until the meter reads zero lets one quantity be found by a null measurement.",
      "introduces": "wheatstone-bridge",
      "prereqs": [
        "null-measurement"
      ]
    },
    {
      "id": "kirchhoffs-rules",
      "kind": "result",
      "section": "21.3",
      "name": "Kirchhoff's rules",
      "statement": "Kirchhoff's rules are the junction rule and the loop rule together, two statements of conservation that let you analyze any circuit, simple or complex.",
      "introduces": "rules",
      "prereqs": [
        "junction-rule",
        "loop-rule"
      ]
    },
    {
      "id": "conservation-laws",
      "kind": "idea",
      "section": "21.3",
      "name": "Conservation laws",
      "statement": "The conservation laws require that energy and charge be conserved in a system, and in a circuit they become Kirchhoff's two rules.",
      "introduces": "rules",
      "prereqs": [
        "conservation-of-charge",
        "conservation-of-energy"
      ]
    },
    {
      "id": "current-sensitivity",
      "kind": "definition",
      "section": "21.4",
      "name": "Current sensitivity",
      "statement": "The current sensitivity of a galvanometer is the current that gives it a full-scale deflection.",
      "introduces": "galvanometer",
      "prereqs": [
        "galvanometer",
        "full-scale-deflection"
      ]
    }
  ],
