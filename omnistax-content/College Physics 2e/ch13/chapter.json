    },
    {
      "id": "eq-force-one-molecule",
      "section": "13.4",
      "latex": "F = \\frac{\\Delta p}{\\Delta t} = \\frac{2mv_x}{\\Delta t} = \\frac{mv_x^2}{l}",
      "important": false,
      "anchor": "13.4-derivation",
      "ktex": "\\kF = \\frac{\\kdp}{\\kdt} = \\frac{2m\\kvx}{\\kdt} = \\frac{m\\kvx^2}{l}"
    },
    {
      "id": "eq-mean-square-components",
      "section": "13.4",
      "latex": "\\overline{v^2} = \\overline{v_x^2} + \\overline{v_y^2} + \\overline{v_z^2} = 3\\overline{v_x^2}",
      "important": false,
      "anchor": "13.4-derivation",
      "ktex": "\\overline{v^2} = \\overline{\\kvx^2} + \\overline{\\kvy^2} + \\overline{v_z^2} = 3\\overline{\\kvx^2}"
