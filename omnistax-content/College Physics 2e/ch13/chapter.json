  "glossary": [
    {
      "section": "13.1",
      "term": "temperature",
      "definition": "the quantity measured by a thermometer"
    },
    {
      "section": "13.1",
      "term": "Celsius scale",
      "definition": "temperature scale in which the freezing point of water is 0 °C and the boiling point of water is 100 °C"
    },
    {
      "section": "13.1",
      "term": "degree Celsius",
      "definition": "unit on the Celsius temperature scale"
    },
    {
      "section": "13.1",
      "term": "Fahrenheit scale",
      "definition": "temperature scale in which the freezing point of water is 32 °F and the boiling point of water is 212 °F"
    },
    {
      "section": "13.1",
      "term": "degree Fahrenheit",
      "definition": "unit on the Fahrenheit temperature scale"
    },
    {
      "section": "13.1",
      "term": "Kelvin scale",
      "definition": "temperature scale in which 0 K is the lowest possible temperature, representing absolute zero"
    },
    {
      "section": "13.1",
      "term": "absolute zero",
      "definition": "the lowest possible temperature; the temperature at which all molecular motion ceases"
    },
    {
      "section": "13.1",
      "term": "thermal equilibrium",
      "definition": "the condition in which heat no longer flows between two objects that are in contact; the two objects have the same temperature"
    },
    {
      "section": "13.1",
      "term": "zeroth law of thermodynamics",
      "definition": "law that states that if two objects are in thermal equilibrium, and a third object is in thermal equilibrium with one of those objects, it is also in thermal equilibrium with the other object"
    },
    {
      "section": "13.2",
      "term": "thermal expansion",
      "definition": "the change in size or volume of an object with change in temperature"
    },
    {
      "section": "13.2",
      "term": "coefficient of linear expansion",
      "definition": "α, the change in length, per unit length, per 1 °C change in temperature; a constant used in the calculation of linear expansion; the coefficient of linear expansion depends on the material and to some degree on the temperature of the material"
    },
    {
      "section": "13.2",
      "term": "coefficient of volume expansion",
      "definition": "β, the change in volume, per unit volume, per 1 °C change in temperature"
    },
    {
      "section": "13.2",
      "term": "thermal stress",
      "definition": "stress caused by thermal expansion or contraction"
    },
    {
      "section": "13.3",
      "term": "ideal gas law",
      "definition": "the physical law that relates the pressure and volume of a gas to the number of gas molecules or number of moles of gas and the temperature of the gas"
    },
    {
      "section": "13.3",
      "term": "Boltzmann constant",
      "definition": "k, a physical constant that relates energy to temperature; k = 1.38 × 10⁻²³ J/K"
    },
    {
      "section": "13.3",
      "term": "Avogadro's number",
      "definition": "N_A, the number of molecules or atoms in one mole of a substance; N_A = 6.02 × 10²³ particles/mole"
    },
    {
      "section": "13.3",
      "term": "mole",
      "definition": "the quantity of a substance whose mass (in grams) is equal to its molecular mass"
    },
    {
      "section": "13.4",
      "term": "thermal energy",
      "definition": "the average translational kinetic energy of a molecule"
    },
    {
      "section": "13.5",
      "term": "PV diagram",
      "definition": "a graph of pressure vs. volume"
    },
    {
      "section": "13.5",
      "term": "critical point",
      "definition": "the temperature above which a liquid cannot exist"
    },
    {
      "section": "13.5",
      "term": "critical temperature",
      "definition": "the temperature above which a liquid cannot exist"
    },
    {
      "section": "13.5",
      "term": "critical pressure",
      "definition": "the minimum pressure needed for a liquid to exist at the critical temperature"
    },
    {
      "section": "13.5",
      "term": "vapor",
      "definition": "a gas at a temperature below the boiling temperature"
    },
    {
      "section": "13.5",
      "term": "vapor pressure",
      "definition": "the pressure at which a gas coexists with its solid or liquid phase"
    },
    {
      "section": "13.5",
      "term": "phase diagram",
      "definition": "a graph of pressure vs. temperature of a particular substance, showing at which pressures and temperatures the three phases of the substance occur"
    },
    {
      "section": "13.5",
      "term": "triple point",
      "definition": "the pressure and temperature at which a substance exists in equilibrium as a solid, liquid, and gas"
    },
    {
      "section": "13.5",
      "term": "sublimation",
      "definition": "the phase change from solid to gas"
    },
    {
      "section": "13.5",
      "term": "partial pressure",
      "definition": "the pressure a gas would create if it occupied the total volume of space available"
    },
    {
      "section": "13.5",
      "term": "Dalton's law of partial pressures",
      "definition": "the physical law that states that the total pressure of a gas is the sum of partial pressures of the component gases"
    },
    {
      "section": "13.6",
      "term": "dew point",
      "definition": "the temperature at which relative humidity is 100%; the temperature at which water starts to condense out of the air"
    },
    {
      "section": "13.6",
      "term": "saturation",
      "definition": "the condition of 100% relative humidity"
    },
    {
      "section": "13.6",
      "term": "percent relative humidity",
      "definition": "the ratio of vapor density to saturation vapor density"
    },
    {
      "section": "13.6",
      "term": "relative humidity",
      "definition": "the amount of water in the air relative to the maximum amount the air can hold"
    }
  ]
}
