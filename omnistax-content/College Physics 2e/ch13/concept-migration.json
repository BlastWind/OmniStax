  "statements": {
    "thermal-equilibrium": "Two systems in thermal contact are in thermal equilibrium when they have the same temperature, so that no heat flows between them and neither temperature changes. Any two systems placed in thermal contact but isolated from the rest of the environment reach this state: heat flows from the hotter object to the cooler one until their temperatures are equal. That is why a thermometer, which actually takes its own temperature, reads the temperature of the object it touches once enough time has passed. A single object is in internal thermal equilibrium when no heat flows within it and its temperature is uniform."
  },
  "new": [
    {
      "id": "coefficient-of-linear-expansion",
      "kind": "definition",
      "section": "13.2",
      "name": "Coefficient of linear expansion $\\alpha$",
      "statement": "The coefficient of linear expansion is the change in length per unit length per degree of temperature change. It depends on the material and varies slightly with temperature, and its unit is the inverse degree Celsius, 1/°C.",
      "introduces": "linear-expansion",
      "prereqs": [
        "length",
        "temperature"
      ]
    },
    {
      "id": "coefficient-of-volume-expansion",
      "kind": "definition",
      "section": "13.2",
      "name": "Coefficient of volume expansion $\\beta$",
      "statement": "The coefficient of volume expansion is the change in volume per unit volume per degree of temperature change. For a solid it is very nearly three times the coefficient of linear expansion, and liquids have much larger values than solids.",
      "introduces": "two-and-three-dimensions",
      "prereqs": [
        "volume",
        "temperature",
        "coefficient-of-linear-expansion"
      ]
    },
    {
      "id": "universal-gas-constant",
      "kind": "definition",
      "section": "13.3",
      "name": "The universal gas constant $R = N_\\text{A}k$",
      "statement": "The universal gas constant is the product of Avogadro's number and the Boltzmann constant, R = 8.31 J/(mol·K). It plays the part for a mole of gas that the Boltzmann constant plays for a single molecule.",
      "introduces": "moles-form",
      "prereqs": [
        "avogadros-number",
        "boltzmann-constant"
      ]
    },
    {
      "id": "vapor",
      "kind": "definition",
      "section": "13.5",
      "name": "Vapor",
      "statement": "A vapor is a gas at a temperature below the boiling temperature of its substance, so that it can coexist with the liquid.",
      "introduces": "equilibrium",
      "prereqs": [
        "phase-equilibrium"
      ]
    },
    {
      "id": "partial-pressure",
      "kind": "definition",
      "section": "13.5",
      "name": "Partial pressure",
      "statement": "The partial pressure of a gas in a mixture is the pressure it would create if it alone occupied the total volume available.",
      "introduces": "vapor-pressure",
      "prereqs": [
        "pressure",
        "volume"
      ]
    },
    {
      "id": "celsius-scale",
      "kind": "definition",
      "section": "13.1",
      "name": "The Celsius scale",
      "statement": "The Celsius scale is the temperature scale on which the freezing point of water is 0 °C and its boiling point is 100 °C, both at standard atmospheric pressure.",
      "introduces": "temperature-scales",
      "prereqs": [
        "temperature-scales"
      ]
    },
    {
      "id": "degree-celsius",
      "kind": "definition",
      "section": "13.1",
      "name": "The degree Celsius, °C",
      "statement": "The degree Celsius is the unit of the Celsius scale, one hundredth of the interval between the freezing and boiling points of water. It is the same size as the kelvin.",
      "introduces": "temperature-scales",
      "prereqs": [
        "celsius-scale"
      ]
    },
    {
      "id": "fahrenheit-scale",
      "kind": "definition",
      "section": "13.1",
      "name": "The Fahrenheit scale",
      "statement": "The Fahrenheit scale is the temperature scale on which the freezing point of water is 32 °F and its boiling point is 212 °F, both at standard atmospheric pressure.",
      "introduces": "temperature-scales",
      "prereqs": [
        "temperature-scales"
      ]
    },
    {
      "id": "degree-fahrenheit",
      "kind": "definition",
      "section": "13.1",
      "name": "The degree Fahrenheit, °F",
      "statement": "The degree Fahrenheit is the unit of the Fahrenheit scale, one hundred eightieth of the interval between the freezing and boiling points of water, so a degree Celsius is 1.8 times as large.",
      "introduces": "temperature-scales",
      "prereqs": [
        "fahrenheit-scale"
      ]
    },
    {
      "id": "kelvin-scale",
      "kind": "definition",
      "section": "13.1",
      "name": "The Kelvin scale",
      "statement": "The Kelvin scale is the absolute temperature scale of science. Its zero is absolute zero, and its unit, the kelvin, is written K with no degree sign and equals a degree Celsius in size, so water freezes at 273.15 K and boils at 373.15 K.",
      "introduces": "temperature-scales",
      "prereqs": [
        "temperature-scales",
        "absolute-zero"
      ]
    },
    {
      "id": "critical-temperature",
      "kind": "definition",
      "section": "13.5",
      "name": "Critical temperature $T_\\text{c}$",
      "statement": "The critical temperature of a substance is the temperature above which its liquid phase cannot exist, however great the pressure.",
      "introduces": "pv-diagrams",
      "prereqs": [
        "critical-point",
        "temperature"
      ]
    },
    {
      "id": "critical-pressure",
      "kind": "definition",
      "section": "13.5",
      "name": "Critical pressure",
      "statement": "The critical pressure of a substance is the minimum pressure needed for its liquid phase to exist at the critical temperature.",
      "introduces": "pv-diagrams",
      "prereqs": [
        "critical-point",
        "critical-temperature",
        "pressure"
      ]
    },
    {
      "id": "saturation",
      "kind": "definition",
      "section": "13.6",
      "name": "Saturation",
      "statement": "Air is saturated when its relative humidity is 100%, so that it holds the most water vapor it can at its temperature and the partial pressure equals the vapor pressure of water.",
      "introduces": "humidity",
      "prereqs": [
        "relative-humidity",
        "vapor-pressure"
      ]
    }
  ],
