  "statements": {
    "work": "In science, work is not effort but a transfer of energy. A force does work on a system only when the system is displaced and the force has a component along that displacement, and the work is the product of that component and the distance the force acts through, $W = Fd\\cos\\theta$.",
    "calculate-work": "Putting a force, a distance and the angle between them into the definition of work gives the energy the force transfers. Setting the answer beside the energy a person eats in a day gives a feel for the size of a joule.",
    "path-independence-of-gravity": "The change in gravitational potential energy is the weight times the change in height for any path between two points, not only for a straight lift, as long as the height change is small compared with the radius of Earth. Multiplying mass, gravity and height therefore replaces working out the work done along a complicated path."
  },
  "new": [
    {
      "id": "energy",
      "kind": "definition",
      "section": "7.1",
      "name": "Energy",
      "statement": "Energy is the ability to do work. Work done on a system transfers energy to it, and work done by a system transfers energy out of it.",
      "introduces": "definition",
      "prereqs": [
        "work"
      ]
    },
    {
      "id": "electrical-energy",
      "kind": "definition",
      "section": "7.6",
      "name": "Electrical energy",
      "statement": "Electrical energy is the energy carried by a flow of charge.",
      "introduces": "forms",
      "prereqs": [
        "energy"
      ]
    },
    {
      "id": "chemical-energy",
      "kind": "definition",
      "section": "7.6",
      "name": "Chemical energy",
      "statement": "Chemical energy is the energy in a substance stored in the bonds between atoms and molecules, which can be released in a chemical reaction.",
      "introduces": "forms",
      "prereqs": [
        "energy"
      ]
    },
    {
      "id": "radiant-energy",
      "kind": "definition",
      "section": "7.6",
      "name": "Radiant energy",
      "statement": "Radiant energy is the energy carried by electromagnetic waves.",
      "introduces": "forms",
      "prereqs": [
        "energy"
      ]
    },
    {
      "id": "nuclear-energy",
      "kind": "definition",
      "section": "7.6",
      "name": "Nuclear energy",
      "statement": "Nuclear energy is energy released by changes within atomic nuclei, such as the fusion of two light nuclei or the fission of a heavy one.",
      "introduces": "forms",
      "prereqs": [
        "energy"
      ]
    },
    {
      "id": "thermal-energy-of-an-object",
      "kind": "definition",
      "section": "7.6",
      "name": "Thermal energy",
      "statement": "Thermal energy is the energy within an object due to the random motion of its atoms and molecules, and it accounts for the object's temperature.",
      "introduces": "forms",
      "prereqs": [
        "energy",
        "kinetic-energy"
      ]
    },
    {
      "id": "kilowatt-hour",
      "kind": "definition",
      "section": "7.7",
      "name": "Kilowatt-hour, $1\\;\\text{kW}\\cdot\\text{h} = 3.6 \\times 10^{6}\\;\\text{J}$",
      "statement": "The kilowatt-hour is a unit of energy, the energy used in one hour at a power of one kilowatt, and it is the unit in which electric utility companies bill electrical energy.",
      "introduces": "consumption",
      "prereqs": [
        "energy-from-power",
        "watt",
        "joule"
      ]
    },
    {
      "id": "horsepower",
      "kind": "definition",
      "section": "7.7",
      "name": "Horsepower, $1\\;\\text{hp} = 746\\;\\text{W}$",
      "statement": "The horsepower is an older non-SI unit of power, with one horsepower equal to 746 watts.",
      "introduces": "what-is-power",
      "prereqs": [
        "power",
        "watt"
      ]
    },
    {
      "id": "basal-metabolic-rate",
      "kind": "definition",
