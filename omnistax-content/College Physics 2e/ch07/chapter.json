 "glossary": [
  {
   "section": "7.1",
   "term": "energy",
   "definition": "the ability to do work"
  },
  {
   "section": "7.1",
   "term": "work",
   "definition": "the transfer of energy by a force that causes an object to be displaced; the product of the component of the force in the direction of the displacement and the magnitude of the displacement"
  },
  {
   "section": "7.1",
   "term": "joule",
   "definition": "SI unit of work and energy, equal to one newton-meter"
  },
  {
   "section": "7.2",
   "term": "net work",
   "definition": "work done by the net force, or vector sum of all the forces, acting on an object"
  },
  {
   "section": "7.2",
   "term": "work-energy theorem",
   "definition": "the result, based on Newton’s laws, that the net work done on an object is equal to its change in kinetic energy"
  },
  {
   "section": "7.2",
   "term": "kinetic energy",
   "definition": "the energy an object has by reason of its motion, equal to ½mv² for the translational (i.e., non-rotational) motion of an object of mass m moving at speed v"
  },
  {
   "section": "7.3",
   "term": "gravitational potential energy",
   "definition": "the energy an object has due to its position in a gravitational field"
  },
  {
   "section": "7.4",
   "term": "conservative force",
   "definition": "a force that does the same work for any given initial and final configuration, regardless of the path followed"
  },
  {
   "section": "7.4",
   "term": "potential energy",
   "definition": "energy due to position, shape, or configuration"
  },
  {
   "section": "7.4",
   "term": "potential energy of a spring",
   "definition": "the stored energy of a spring as a function of its displacement; when Hooke’s law applies, it is given by the expression ½kx² where x is the distance the spring is compressed or extended and k is the spring constant"
  },
  {
   "section": "7.4",
   "term": "conservation of mechanical energy",
   "definition": "the rule that the sum of the kinetic energies and potential energies remains constant if only conservative forces act on and within a system"
  },
  {
   "section": "7.4",
   "term": "mechanical energy",
   "definition": "the sum of kinetic energy and potential energy"
  },
  {
   "section": "7.5",
   "term": "nonconservative force",
   "definition": "a force whose work depends on the path followed between the given initial and final configurations"
  },
  {
   "section": "7.5",
   "term": "friction",
   "definition": "the force between surfaces that opposes one sliding on the other; friction changes mechanical energy into thermal energy"
  },
  {
   "section": "7.6",
   "term": "law of conservation of energy",
   "definition": "the general law that total energy is constant in any process; energy may change in form or be transferred from one system to another, but the total remains the same"
  },
  {
   "section": "7.6",
   "term": "electrical energy",
   "definition": "the energy carried by a flow of charge"
  },
  {
   "section": "7.6",
   "term": "chemical energy",
   "definition": "the energy in a substance stored in the bonds between atoms and molecules that can be released in a chemical reaction"
  },
  {
   "section": "7.6",
   "term": "radiant energy",
   "definition": "the energy carried by electromagnetic waves"
  },
  {
   "section": "7.6",
   "term": "nuclear energy",
   "definition": "energy released by changes within atomic nuclei, such as the fusion of two light nuclei or the fission of a heavy nucleus"
  },
  {
   "section": "7.6",
   "term": "thermal energy",
   "definition": "the energy within an object due to the random motion of its atoms and molecules that accounts for the object's temperature"
  },
  {
   "section": "7.6",
   "term": "efficiency",
   "definition": "a measure of the effectiveness of the input of energy to do work; useful energy or work divided by the total input of energy"
  },
  {
   "section": "7.7",
   "term": "power",
   "definition": "the rate at which work is done"
  },
  {
   "section": "7.7",
   "term": "watt",
   "definition": "(W) SI unit of power, with 1 W = 1 J/s"
  },
  {
   "section": "7.7",
   "term": "horsepower",
   "definition": "an older non-SI unit of power, with 1 hp = 746 W"
  },
  {
   "section": "7.7",
   "term": "kilowatt-hour",
   "definition": "(kW·h) unit used primarily for electrical energy provided by electric utility companies"
  },
  {
   "section": "7.8",
   "term": "metabolic rate",
   "definition": "the rate at which the body uses food energy to sustain life and to do different activities"
  },
  {
   "section": "7.8",
   "term": "basal metabolic rate",
   "definition": "the total energy conversion rate of a person at rest"
  },
  {
   "section": "7.8",
   "term": "useful work",
   "definition": "work done on an external system"
  },
  {
   "section": "7.9",
   "term": "renewable forms of energy",
   "definition": "those sources that cannot be used up, such as water, wind, solar, and biomass"
  },
  {
   "section": "7.9",
   "term": "fossil fuels",
   "definition": "oil, natural gas, and coal"
  }
 ]
}
