   "ktex": "\\frac{1}{2}m\\kvi^2 + m\\kg\\khi + \\frac{1}{2}\\kk\\kxi^2 = \\frac{1}{2}m\\kvf^2 + m\\kg\\khf + \\frac{1}{2}\\kk\\kxf^2",
