  "statements": {
    "magnetic-field": "The magnetic field, traditionally called the B-field, is the representation of magnetic forces. Like the gravitational and electric fields, it maps the forces that surround an object and can act on another object at a distance, and it represents the object that generates it, not the probe that tests it."
  },
  "new": [
    {
      "id": "electromagnetism",
      "kind": "definition",
      "section": "22.2",
      "name": "Electromagnetism",
      "statement": "Electromagnetism is the use of electric currents to produce magnetism, and more broadly the single subject that electricity and magnetism become once a current is known to make a magnetic field.",
      "introduces": "electromagnets",
      "prereqs": [
        "electric-current",
        "magnetic-poles"
      ]
    },
    {
      "id": "magnetic-field-lines",
      "kind": "definition",
      "section": "22.3",
      "name": "Magnetic field lines",
      "statement": "Magnetic field lines are a pictorial representation of a magnetic field: the field points along them, and they are closer together where the field is stronger.",
      "introduces": "field",
      "prereqs": [
        "magnetic-field"
      ]
    },
    {
      "id": "number-of-turns",
      "kind": "definition",
      "section": "22.8",
      "name": "Number of turns, $N$",
      "statement": "A coil is a wire wound into loops, and its number of turns $N$ is how many loops it has. Each turn feels the same torque in a field and encloses the same flux, so many quantities of a coil are $N$ times those of a single loop.",
      "introduces": "torque-on-a-loop",
      "prereqs": []
    },
    {
      "id": "electric-motor",
      "kind": "definition",
      "section": "22.8",
      "name": "Electric motor",
      "statement": "An electric motor is a loop of wire, or a coil of many loops, mounted on a shaft in a magnetic field, so that the torque the field exerts on its current turns the shaft.",
      "introduces": "keeping-the-coil-turning",
      "prereqs": [
        "torque-on-a-current-loop"
      ]
    },
    {
      "id": "solenoid",
      "kind": "definition",
      "section": "22.9",
      "name": "Solenoid, $n = N/l$",
      "statement": "A solenoid is a thin wire wound into a long coil, and the number of loops per unit length, $n = N/l$, describes how tightly it is wound.",
      "introduces": "solenoid",
      "prereqs": [
        "number-of-turns",
        "@Length"
      ]
    },
    {
      "id": "nuclear-magnetic-resonance",
      "kind": "idea",
      "section": "22.11",
      "name": "Nuclear magnetic resonance",
      "statement": "Nuclear magnetic resonance is the interaction of an applied magnetic field with the nuclei of certain atoms, whose own small magnetic fields line up with it and absorb radio waves at a frequency set by the field strength.",
      "introduces": "mri",
      "prereqs": [
        "magnetic-field"
      ]
    },
    {
      "id": "north-magnetic-pole",
      "kind": "definition",
      "section": "22.1",
      "name": "North magnetic pole",
      "statement": "The north magnetic pole of a magnet is the end or side that is attracted toward Earth's geographic north pole, the end that points north when the magnet is free to turn.",
      "introduces": "poles",
      "prereqs": [
        "magnetic-poles"
      ]
    },
    {
      "id": "south-magnetic-pole",
      "kind": "definition",
      "section": "22.1",
      "name": "South magnetic pole",
      "statement": "The south magnetic pole of a magnet is the end or side that is attracted toward Earth's geographic south pole.",
      "introduces": "poles",
      "prereqs": [
        "magnetic-poles"
      ]
    },
    {
      "id": "magnetized",
      "kind": "definition",
      "section": "22.2",
      "name": "Magnetized",
      "statement": "A material is magnetized when it has been turned into a magnet, either induced to be magnetic for a time or made into a permanent magnet.",
      "introduces": "ferromagnets",
      "prereqs": [
        "ferromagnetic-materials"
      ]
    },
    {
      "id": "gauss",
      "kind": "definition",
      "section": "22.4",
      "name": "The gauss, $1\\;\\text{G} = 10^{-4}\\;\\text{T}$",
      "statement": "The gauss is a smaller unit of magnetic field strength than the tesla, with $1\\;\\text{G} = 10^{-4}\\;\\text{T}$.",
      "introduces": "tesla-and-gauss",
      "prereqs": [
        "the-tesla"
      ]
    },
    {
      "id": "biot-savart-law",
      "kind": "axiom",
      "section": "22.9",
      "name": "The Biot-Savart law",
      "statement": "The Biot-Savart law gives the magnetic field made by each small segment of a current, so that the field of any current is the sum of the fields of its segments.",
      "introduces": "amperes-law",
      "prereqs": [
        "electric-current",
        "magnetic-field"
      ]
    },
    {
      "id": "magnetocardiogram",
      "kind": "definition",
      "section": "22.11",
      "name": "Magnetocardiogram (MCG)",
      "statement": "A magnetocardiogram is a recording of the heart's magnetic field as it beats.",
      "introduces": "biomagnetic",
      "prereqs": [
        "biomagnetic-measurement"
      ]
    },
    {
      "id": "magnetoencephalogram",
      "kind": "definition",
      "section": "22.11",
      "name": "Magnetoencephalogram (MEG)",
      "statement": "A magnetoencephalogram is a measurement of the brain's magnetic field.",
      "introduces": "biomagnetic",
      "prereqs": [
        "biomagnetic-measurement"
      ]
    }
  ],
