  "glossary": [
    {
      "section": "19.1",
      "term": "electric potential",
      "definition": "potential energy per unit charge"
    },
    {
      "section": "19.1",
      "term": "potential difference (or voltage)",
      "definition": "change in potential energy of a charge moved from one point to another, divided by the charge; units of potential difference are joules per coulomb, known as volt"
    },
    {
      "section": "19.1",
      "term": "electron volt",
      "definition": "the energy given to a fundamental charge accelerated through a potential difference of one volt"
    },
    {
      "section": "19.1",
      "term": "mechanical energy",
      "definition": "sum of the kinetic energy and potential energy of a system; this sum is a constant"
    },
    {
      "section": "19.2",
      "term": "scalar",
      "definition": "physical quantity with magnitude but no direction"
    },
    {
      "section": "19.2",
      "term": "vector",
      "definition": "physical quantity with both magnitude and direction"
    },
    {
      "section": "19.4",
      "term": "equipotential line",
      "definition": "a line along which the electric potential is constant"
    },
    {
      "section": "19.4",
      "term": "grounding",
      "definition": "fixing a conductor at zero volts by connecting it to the earth or ground"
    },
    {
      "section": "19.5",
      "term": "capacitor",
      "definition": "a device that stores electric charge"
    },
    {
      "section": "19.5",
      "term": "capacitance",
      "definition": "amount of charge stored per unit volt"
    },
    {
      "section": "19.5",
      "term": "dielectric",
      "definition": "an insulating material"
    },
    {
      "section": "19.5",
      "term": "dielectric strength",
      "definition": "the maximum electric field above which an insulating material begins to break down and conduct"
    },
    {
      "section": "19.5",
      "term": "parallel plate capacitor",
      "definition": "two identical conducting plates separated by a distance"
    },
    {
      "section": "19.5",
      "term": "polar molecule",
      "definition": "a molecule with inherent separation of charge"
    },
    {
      "section": "19.7",
      "term": "defibrillator",
      "definition": "a machine used to provide an electrical shock to a heart attack victim's heart in order to restore the heart's normal rhythmic pattern"
    }
  ]
}
