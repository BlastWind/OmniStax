 "equations": [
  {
   "id": "eq-dx",
   "concept": "displacement",
   "section": "2.1",
   "latex": "\\Delta x = x_{\\text{f}} - x_0",
   "ktex": "\\kdx = \\kxf - \\kxo",
   "anchor": "2.1-displacement",
   "important": true
  },
  {
   "id": "eq-notation",
   "section": "2.5",
   "latex": "\\Delta t = t,\\quad \\Delta x = x - x_0,\\quad \\Delta v = v - v_0",
   "ktex": "\\kdt = \\kt,\\quad \\kdx = \\kx - \\kxo,\\quad \\kdv = \\kv - \\kvo",
   "anchor": "2.5-notation",
   "important": false
  },
  {
   "id": "eq-x-vbar",
   "concept": "x-from-vbar",
   "section": "2.5",
   "latex": "x = x_0 + \\bar v t",
   "ktex": "\\kx = \\kxo + \\kvb\\kt",
   "anchor": "2.5-avg-velocity",
   "important": true
  },
  {
   "id": "eq-vbar",
   "concept": "vbar-midpoint",
   "section": "2.5",
   "latex": "\\bar v = \\frac{v_0 + v}{2}",
   "ktex": "\\kvb = \\frac{\\kvo + \\kv}{2}",
   "condition": "constant acceleration",
   "anchor": "2.5-avg-velocity",
   "important": true
  },
  {
   "id": "eq-v",
   "concept": "v-from-at",
   "section": "2.5",
   "latex": "v = v_0 + a t",
   "ktex": "\\kv = \\kvo + \\ka\\kt",
   "condition": "constant acceleration",
   "anchor": "2.5-final-velocity",
   "important": true
  },
  {
   "id": "eq-x",
   "concept": "x-quadratic",
   "section": "2.5",
   "latex": "x = x_0 + v_0 t + \\tfrac12 a t^2",
   "ktex": "\\kx = \\kxo + \\kvo\\kt + \\tfrac{1}{2}\\ka\\kt^2",
   "condition": "constant acceleration",
   "anchor": "2.5-position-quadratic",
   "important": true
  },
  {
   "id": "eq-v2",
   "concept": "v-squared",
   "section": "2.5",
   "latex": "v^2 = v_0^2 + 2a(x - x_0)",
   "ktex": "\\kv^2 = \\kvo^2 + 2\\ka(\\kx - \\kxo)",
   "condition": "constant acceleration",
   "anchor": "2.5-velocity-squared",
   "important": true
  },
  {
   "id": "eq-dt",
   "concept": "elapsed-time",
   "section": "2.3",
   "latex": "\\Delta t = t_{\\text{f}} - t_0",
   "ktex": "\\kdt = \\ktf - \\kto",
   "anchor": "2.3-elapsed-time",
   "important": true
  },
  {
   "id": "eq-vbar-def",
   "concept": "average-velocity",
   "section": "2.3",
   "latex": "\\bar v = \\frac{\\Delta x}{\\Delta t} = \\frac{x_{\\text{f}} - x_0}{t_{\\text{f}} - t_0}",
   "ktex": "\\kvb = \\frac{\\kdx}{\\kdt} = \\frac{\\kxf - \\kxo}{\\ktf - \\kto}",
   "anchor": "2.3-average-velocity",
   "important": true
  },
  {
   "id": "eq-vbar-t",
   "section": "2.3",
   "latex": "\\bar v = \\frac{\\Delta x}{t}",
   "ktex": "\\kvb = \\frac{\\kdx}{\\kt}",
   "condition": "the starting time t_0 taken to be zero",
   "anchor": "2.3-average-velocity",
   "important": false
  },
  {
   "id": "eq-avg-speed",
   "concept": "average-speed",
   "section": "2.3",
   "latex": "\\text{average speed} = \\frac{\\text{distance traveled}}{\\text{elapsed time}}",
   "anchor": "2.3-speed",
   "important": true
  },
  {
   "id": "eq-abar",
   "concept": "average-acceleration",
   "section": "2.4",
   "latex": "\\bar a = \\frac{\\Delta v}{\\Delta t} = \\frac{v_{\\text{f}} - v_0}{t_{\\text{f}} - t_0}",
   "ktex": "\\kab = \\frac{\\kdv}{\\kdt} = \\frac{\\kvf - \\kvo}{\\ktf - \\kto}",
   "anchor": "2.4-average-acceleration",
   "important": true
  },
  {
   "id": "eq-unreasonable-v",
   "section": "2.6",
   "latex": "v = v_0 + at = 0 + (0.40\\ \\text{m/s}^2)(100\\ \\text{s}) = 40\\ \\text{m/s}",
   "ktex": "\\kv = \\kvo + \\ka\\kt = 0 + (0.40\\ \\text{m/s}^2)(100\\ \\text{s}) = 40\\ \\text{m/s}",
   "condition": "the runner who accelerates at 0.40 m/s² for 100 s",
   "anchor": "2.6-unreasonable",
   "important": false
  },
  {
   "id": "eq-unreasonable-mph",
   "section": "2.6",
   "latex": "\\left(\\frac{40\\ \\text{m}}{\\text{s}}\\right)\\left(\\frac{3.28\\ \\text{ft}}{\\text{m}}\\right)\\left(\\frac{1\\ \\text{mi}}{5280\\ \\text{ft}}\\right)\\left(\\frac{60\\ \\text{s}}{\\text{min}}\\right)\\left(\\frac{60\\ \\text{min}}{1\\ \\text{h}}\\right) = 89\\ \\text{mph}",
   "anchor": "2.6-unreasonable",
   "important": false
  },
  {
   "id": "eq-g",
   "concept": "acceleration-due-to-gravity",
   "section": "2.7",
   "latex": "g = 9.80\\ \\text{m/s}^2",
   "ktex": "\\kg = 9.80\\ \\text{m/s}^2",
   "condition": "the average value on Earth; g varies from 9.78 to 9.83 m/s² with latitude, altitude and local geology",
   "anchor": "2.7-accel-gravity",
   "important": true
  },
  {
   "id": "eq-ff-v",
   "section": "2.7",
   "latex": "v = v_0 - gt",
   "ktex": "\\kv = \\kvo - \\kg\\kt",
   "condition": "free fall with up taken as positive, so that a = −g",
   "anchor": "2.7-vertical-motion",
   "important": true
  },
  {
   "id": "eq-ff-y",
   "concept": "free-fall-kinematics",
   "section": "2.7",
   "latex": "y = y_0 + v_0 t - \\tfrac12 g t^2",
   "ktex": "\\ky = \\kyo + \\kvo\\kt - \\tfrac{1}{2}\\kg\\kt^2",
   "condition": "free fall with up taken as positive, so that a = −g",
   "anchor": "2.7-vertical-motion",
   "important": true
  },
  {
   "id": "eq-ff-v2",
   "section": "2.7",
   "latex": "v^2 = v_0^2 - 2g(y - y_0)",
   "ktex": "\\kv^2 = \\kvo^2 - 2\\kg(\\ky - \\kyo)",
   "condition": "free fall with up taken as positive, so that a = −g",
   "anchor": "2.7-vertical-motion",
   "important": true
  },
  {
   "id": "eq-a-from-fall",
   "concept": "g-from-fall-time",
   "section": "2.7",
   "latex": "a = \\frac{2(y - y_0)}{t^2}",
   "ktex": "\\ka = \\frac{2(\\ky - \\kyo)}{\\kt^2}",
   "condition": "an object dropped from rest, v_0 = 0",
   "anchor": "2.7-ex-find-g",
   "important": false
  },
  {
   "id": "eq-line",
   "concept": "straight-line-graph",
   "section": "2.8",
   "latex": "y = mx + b",
   "anchor": "2.8-slopes",
   "important": false
  },
  {
   "id": "eq-x-graph",
   "section": "2.8",
   "latex": "x = x_0 + \\bar v t",
   "ktex": "\\kx = \\kxo + \\kvb\\kt",
   "condition": "read from a straight-line graph of position against time, whose slope is v̄ and whose intercept is x_0",
   "anchor": "2.8-x-t",
   "important": false
  },
  {
   "id": "eq-slope-x",
   "concept": "x-t-slope-velocity",
   "section": "2.8",
   "latex": "\\text{slope} = \\frac{\\Delta x}{\\Delta t} = v",
   "ktex": "\\text{slope} = \\frac{\\kdx}{\\kdt} = \\kv",
   "anchor": "2.8-x-t",
   "important": true
  },
  {
   "id": "eq-slope-v",
   "concept": "v-t-slope-acceleration",
   "section": "2.8",
   "latex": "\\text{slope} = \\frac{\\Delta v}{\\Delta t} = a",
   "ktex": "\\text{slope} = \\frac{\\kdv}{\\kdt} = \\ka",
   "anchor": "2.8-v-t",
   "important": true
  },
  {
   "id": "eq-v-graph",
   "section": "2.8",
   "latex": "v = v_0 + at",
   "ktex": "\\kv = \\kvo + \\ka\\kt",
   "condition": "read from a straight-line graph of velocity against time, whose slope is a and whose intercept is v_0",
   "anchor": "2.8-v-t",
   "important": false
  }
 ],
 "glossary": [
  {
   "section": "2.1",
   "term": "kinematics",
   "definition": "the study of motion without considering its causes"
  },
  {
   "section": "2.1",
   "term": "position",
   "definition": "the location of an object at a particular time"
  },
  {
   "section": "2.1",
   "term": "displacement",
   "definition": "the change in position of an object"
  },
  {
   "section": "2.1",
   "term": "distance",
   "definition": "the magnitude of displacement between two positions"
  },
  {
   "section": "2.1",
   "term": "distance traveled",
   "definition": "the total length of the path traveled between two positions"
  },
  {
   "section": "2.2",
   "term": "scalar",
   "definition": "a quantity that is described by magnitude, but not direction"
  },
  {
   "section": "2.2",
   "term": "vector",
   "definition": "a quantity that is described by both magnitude and direction"
  },
  {
   "section": "2.3",
   "term": "average speed",
   "definition": "distance traveled divided by time during which motion occurs"
  },
  {
   "section": "2.3",
   "term": "average velocity",
   "definition": "displacement divided by time over which displacement occurs"
  },
  {
   "section": "2.3",
   "term": "instantaneous velocity",
   "definition": "velocity at a specific instant, or the average velocity over an infinitesimal time interval"
  },
  {
   "section": "2.3",
   "term": "instantaneous speed",
   "definition": "magnitude of the instantaneous velocity"
  },
  {
   "section": "2.3",
   "term": "time",
   "definition": "change, or the interval over which change occurs"
  },
  {
   "section": "2.3",
   "term": "model",
   "definition": "simplified description that contains only those elements necessary to describe the physics of a physical situation"
  },
  {
   "section": "2.3",
   "term": "elapsed time",
   "definition": "the difference between the ending time and beginning time"
  },
  {
   "section": "2.4",
   "term": "acceleration",
   "definition": "the rate of change in velocity; the change in velocity over time"
  },
  {
   "section": "2.4",
   "term": "average acceleration",
   "definition": "the change in velocity divided by the time over which it changes"
  },
  {
   "section": "2.4",
   "term": "instantaneous acceleration",
   "definition": "acceleration at a specific point in time"
  },
  {
   "section": "2.4",
   "term": "deceleration",
   "definition": "acceleration in the direction opposite to velocity; acceleration that results in a decrease in velocity"
  },
  {
   "section": "2.7",
   "term": "free-fall",
   "definition": "the state of movement that results from gravitational force only"
  },
  {
   "section": "2.7",
   "term": "acceleration due to gravity",
   "definition": "acceleration of an object as a result of gravity"
  },
  {
   "section": "2.8",
   "term": "independent variable",
   "definition": "the variable that the dependent variable is measured with respect to; usually plotted along the x-axis"
  },
  {
   "section": "2.8",
   "term": "dependent variable",
   "definition": "the variable that is being measured; usually plotted along the y-axis"
  },
  {
   "section": "2.8",
   "term": "slope",
   "definition": "the difference in y-value (the rise) divided by the difference in x-value (the run) of two points on a straight line"
  },
  {
   "section": "2.8",
   "term": "y-intercept",
   "definition": "the y-value when x = 0, or when the graph crosses the y-axis"
  }
 ]
}
