  "statements": {
    "reference-frame": "A reference frame is what a position is given relative to, such as the Earth, a whiteboard, or the cabin of an airplane. Choosing the reference frame is the first step in describing any motion.",
    "distance": "Distance is the magnitude of displacement between two positions, so it has no sign and no direction. It is not the same as distance traveled, the total length of the path.",
    "choose-equation": "To solve a problem, first list the quantities you know and the quantity you want to find, and then choose the equation in which the quantity you want is the only unknown."
  },
  "new": [
    {
      "id": "kinematics",
      "kind": "definition",
      "section": "2.1",
      "name": "Kinematics",
      "statement": "Kinematics is the study of motion without considering its causes. In one- and two-dimensional kinematics we study only the motion of an object, without worrying about what forces cause or change it.",
      "introduces": "position",
      "prereqs": [
        "physics"
      ]
    },
    {
      "id": "independent-variable",
      "kind": "definition",
      "section": "2.8",
      "name": "Independent variable",
      "statement": "The independent variable is the quantity plotted on the horizontal axis of a graph, the one other quantities depend upon. Time is usually an independent variable.",
      "introduces": "slopes",
      "prereqs": [
        "straight-line-graph"
      ]
    },
    {
      "id": "dependent-variable",
      "kind": "definition",
      "section": "2.8",
      "name": "Dependent variable",
      "statement": "The dependent variable is the quantity plotted on the vertical axis of a graph, which depends on the independent variable, as position depends on time.",
      "introduces": "slopes",
      "prereqs": [
        "independent-variable"
      ]
    },
    {
      "id": "slope",
      "kind": "definition",
      "section": "2.8",
      "name": "Slope of a graph",
      "statement": "The slope of a graph is the difference in the vertical value, the rise, divided by the difference in the horizontal value, the run.",
      "introduces": "slopes",
      "prereqs": [
        "straight-line-graph"
      ]
    },
    {
      "id": "y-intercept",
      "kind": "definition",
      "section": "2.8",
      "name": "y-intercept",
      "statement": "The y-intercept is the value of the dependent variable where a graph crosses the vertical axis, that is, its value when the independent variable is zero.",
      "introduces": "slopes",
      "prereqs": [
        "straight-line-graph",
        "dependent-variable"
      ]
    }
  ],
