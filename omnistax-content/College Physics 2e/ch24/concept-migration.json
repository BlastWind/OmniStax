  "new": [
    {
      "id": "electromagnetic-wave",
      "kind": "definition",
      "section": "24.1",
      "name": "Electromagnetic wave",
      "statement": "An electromagnetic wave is a pair of changing electric and magnetic fields that generate each other and travel together through space, carrying energy, at the speed of light in a vacuum.",
      "introduces": "prediction",
      "prereqs": [
        "electric-field",
        "magnetic-field",
        "wave"
      ]
    },
    {
      "id": "thermal-agitation",
      "kind": "idea",
      "section": "24.3",
      "name": "Thermal agitation",
      "statement": "Thermal agitation is the thermal motion of the atoms and molecules of any object above absolute zero, which makes them emit and absorb radiation, mostly in the infrared.",
      "introduces": "infrared",
      "prereqs": [
        "temperature"
      ]
    },
    {
      "id": "infrared-radiation",
      "kind": "definition",
      "section": "24.3",
      "name": "Infrared radiation (IR)",
      "statement": "Infrared radiation is the band of the electromagnetic spectrum with frequencies from just below those of red light down to the microwaves.",
      "introduces": "infrared",
      "prereqs": [
        "electromagnetic-spectrum"
      ]
    },
    {
      "id": "visible-light",
      "kind": "definition",
      "section": "24.3",
      "name": "Visible light",
      "statement": "Visible light is the narrow band of the electromagnetic spectrum to which the normal human eye responds, with wavelengths from about 380 nm to 760 nm.",
      "introduces": "visible-light",
      "prereqs": [
        "electromagnetic-spectrum"
      ]
    },
    {
      "id": "ultraviolet-radiation",
      "kind": "definition",
      "section": "24.3",
      "name": "Ultraviolet radiation (UV)",
      "statement": "Ultraviolet radiation is the band of the electromagnetic spectrum extending upward in frequency from violet light and overlapping the lowest x rays.",
      "introduces": "ultraviolet",
      "prereqs": [
        "electromagnetic-spectrum"
      ]
    },
    {
      "id": "x-ray-radiation",
      "kind": "definition",
      "section": "24.3",
      "name": "X rays",
      "statement": "X rays are invisible, penetrating electromagnetic radiation of very high frequency, overlapping the ultraviolet below and the gamma rays above.",
      "introduces": "x-rays",
      "prereqs": [
        "electromagnetic-spectrum"
      ]
    },
    {
      "id": "gamma-ray-radiation",
      "kind": "definition",
      "section": "24.3",
      "name": "Gamma rays ($\\gamma$ rays)",
      "statement": "Gamma rays are electromagnetic radiation of extremely high frequency, emitted by the nucleus of an atom in nuclear decay or in other nuclear and particle processes.",
      "introduces": "gamma-rays",
      "prereqs": [
        "electromagnetic-spectrum"
      ]
    },
    {
      "id": "carrier-wave",
      "kind": "definition",
      "section": "24.3",
      "name": "Carrier wave",
      "statement": "A carrier wave is an electromagnetic wave that carries a signal by the modulation of its amplitude or of its frequency.",
      "introduces": "radio-tv",
      "prereqs": [
        "electromagnetic-wave"
      ]
    },
    {
      "id": "amplitude-modulation",
      "kind": "definition",
      "section": "24.3",
      "name": "Amplitude modulation (AM)",
      "statement": "Amplitude modulation places information on an electromagnetic wave by varying the amplitude of a carrier wave with the signal, while its frequency stays fixed.",
      "introduces": "radio-tv",
      "prereqs": [
        "carrier-wave",
        "amplitude"
      ]
    },
    {
      "id": "frequency-modulation",
      "kind": "definition",
      "section": "24.3",
      "name": "Frequency modulation (FM)",
      "statement": "Frequency modulation places information on an electromagnetic wave by varying the frequency of a carrier wave with the signal, while its amplitude stays fixed.",
      "introduces": "fm-radio",
      "prereqs": [
        "carrier-wave",
        "frequency"
      ]
    },
    {
      "id": "hertz",
      "kind": "definition",
      "section": "24.1",
      "name": "The hertz, $1\\;\\text{Hz} = 1\\;\\text{cycle/s}$",
      "statement": "The hertz is the SI unit of frequency, one cycle per second, named for Heinrich Hertz, who first generated and detected electromagnetic waves.",
      "introduces": "hertz",
      "prereqs": [
        "frequency"
      ]
    },
    {
      "id": "oscillation",
      "kind": "definition",
      "section": "24.2",
      "name": "Oscillation",
      "statement": "To oscillate is to fluctuate back and forth in a steady beat, as the charges in an antenna do and as the fields of the wave they send out do.",
      "introduces": "varying-current",
      "prereqs": [
        "periodic-motion"
      ]
    },
    {
      "id": "radar",
      "kind": "idea",
      "section": "24.3",
      "name": "Radar",
      "statement": "Radar is a common application of microwaves: it finds the distance to objects as diverse as clouds and aircraft from the time a reflected pulse takes to return.",
      "introduces": "microwaves",
      "prereqs": [
        "microwaves-and-their-uses"
      ]
    },
    {
      "id": "extremely-low-frequency",
      "kind": "definition",
      "section": "24.3",
      "name": "Extremely low frequency (ELF)",
      "statement": "Extremely low frequency radiation is electromagnetic radiation of the lowest frequencies, usually from 0 to 300 Hz but also up to about 1 kHz.",
      "introduces": "radio-tv",
      "prereqs": [
        "electromagnetic-spectrum"
      ]
    },
    {
      "id": "television",
      "kind": "idea",
      "section": "24.3",
      "name": "TV",
      "statement": "Television carries video and audio signals on electromagnetic waves, broadcast in the radio band.",
      "introduces": "radio-tv",
      "prereqs": [
        "radio-waves-and-modulation"
      ]
    },
    {
      "id": "very-high-frequency",
      "kind": "definition",
      "section": "24.3",
      "name": "Very high frequency (VHF)",
      "statement": "Very high frequency TV channels use frequencies in the two ranges from 54 to 88 MHz and from 174 to 222 MHz.",
      "introduces": "radio-tv",
      "prereqs": [
        "television"
      ]
    },
    {
      "id": "ultra-high-frequency",
      "kind": "definition",
      "section": "24.3",
      "name": "Ultra-high frequency (UHF)",
      "statement": "Ultra-high frequency TV channels use frequencies above those of VHF, from 470 to 1000 MHz.",
      "introduces": "radio-tv",
      "prereqs": [
        "television"
      ]
    },
    {
      "id": "maximum-field-strength",
      "kind": "definition",
      "section": "24.4",
      "name": "Maximum field strength, $\\kEfo$ and $\\kBmago$",
      "statement": "The maximum field strength of an electromagnetic wave is the amplitude of its electric or magnetic field, the largest value the field reaches as it oscillates.",
      "introduces": "energy-and-amplitude",
      "prereqs": [
        "amplitude",
        "electric-field",
        "magnetic-field-strength-defined"
      ]
    }
  ],
