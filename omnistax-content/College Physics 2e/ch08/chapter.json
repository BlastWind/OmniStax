 "glossary": [
  {
   "section": "8.1",
   "term": "linear momentum",
   "definition": "the product of mass and velocity"
  },
  {
   "section": "8.1",
   "term": "second law of motion",
   "definition": "physical law that states that the net external force equals the change in momentum of a system divided by the time over which it changes"
  },
  {
   "section": "8.2",
   "term": "change in momentum",
   "definition": "the difference between the final and initial momentum; the mass times the change in velocity"
  },
  {
   "section": "8.2",
   "term": "impulse",
   "definition": "the average net external force times the time it acts; equal to the change in momentum"
  },
  {
   "section": "8.3",
   "term": "conservation of momentum principle",
   "definition": "when the net external force is zero, the total momentum of the system is conserved or constant"
  },
  {
   "section": "8.3",
   "term": "isolated system",
   "definition": "a system in which the net external force is zero"
  },
  {
   "section": "8.3",
   "term": "quark",
   "definition": "fundamental constituent of matter and an elementary particle"
  },
  {
   "section": "8.4",
   "term": "elastic collision",
   "definition": "a collision that also conserves internal kinetic energy"
  },
  {
   "section": "8.4",
   "term": "internal kinetic energy",
   "definition": "the sum of the kinetic energies of the objects in a system"
  },
  {
   "section": "8.5",
   "term": "inelastic collision",
   "definition": "a collision in which internal kinetic energy is not conserved"
  },
