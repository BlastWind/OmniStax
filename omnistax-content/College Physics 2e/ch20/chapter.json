 "glossary": [
  {
   "section": "20.1",
   "term": "electric current",
   "definition": "the rate at which charge flows, *I* = Δ*Q*/Δ*t*"
  },
  {
   "section": "20.1",
   "term": "ampere",
   "definition": "(amp) the SI unit for current; 1 A = 1 C/s"
  },
  {
   "section": "20.1",
   "term": "drift velocity",
   "definition": "the average velocity at which free charges flow in response to an electric field"
  },
  {
   "section": "20.2",
   "term": "Ohm’s law",
   "definition": "an empirical relation stating that the current *I* is proportional to the potential difference *V*, *∝ V*; it is often written as *I = V/R*, where *R* is the resistance"
  },
  {
   "section": "20.2",
   "term": "resistance",
   "definition": "the electric property that impedes current; for ohmic materials, it is the ratio of voltage to current, *R = V/I*"
  },
  {
   "section": "20.2",
   "term": "ohm",
   "definition": "the unit of resistance, given by 1Ω = 1 V/A"
  },
  {
   "section": "20.2",
   "term": "ohmic",
   "definition": "a type of a material for which Ohm's law is valid"
  },
  {
   "section": "20.2",
   "term": "simple circuit",
   "definition": "a circuit with a single voltage source and a single resistor"
  },
  {
   "section": "20.3",
   "term": "resistivity",
   "definition": "an intrinsic property of a material, independent of its shape or size, directly proportional to the resistance, denoted by *ρ*"
  },
  {
   "section": "20.3",
   "term": "temperature coefficient of resistivity",
   "definition": "an empirical quantity, denoted by *α*, which describes the change in resistance or resistivity of a material with temperature"
  },
  {
   "section": "20.4",
   "term": "electric power",
   "definition": "the rate at which electrical energy is supplied by a source or dissipated by a device; it is the product of current times voltage"
  },
  {
   "section": "20.5",
   "term": "direct current",
   "definition": "(DC) the flow of electric charge in only one direction"
  },
  {
   "section": "20.5",
   "term": "alternating current",
   "definition": "(AC) the flow of electric charge that periodically reverses direction"
  },
  {
   "section": "20.5",
   "term": "AC voltage",
   "definition": "voltage that fluctuates sinusoidally with time, expressed as *V = V*<sub>0</sub> sin 2*πft*, where *V* is the voltage at time *t, V*<sub>0</sub> is the peak voltage, and *f* is the frequency in hertz"
  },
  {
   "section": "20.5",
   "term": "AC current",
   "definition": "current that fluctuates sinusoidally with time, expressed as *I = I*<sub>0</sub> sin 2*πft*, where *I* is the current at time *t, I*<sub>0</sub> is the peak current, and *f* is the frequency in hertz"
  },
  {
   "section": "20.5",
   "term": "rms current",
   "definition": "the root mean square of the current, *I*<sub>rms</sub> = *I*<sub>0</sub>/√2, where *I*<sub>0</sub> is the peak current, in an AC system"
  },
  {
   "section": "20.5",
   "term": "rms voltage",
   "definition": "the root mean square of the voltage, *V*<sub>rms</sub> = *V*<sub>0</sub>/√2, where *V*<sub>0</sub> is the peak voltage, in an AC system"
  },
  {
   "section": "20.6",
   "term": "thermal hazard",
   "definition": "a hazard in which electric current causes undesired thermal effects"
  },
  {
   "section": "20.6",
   "term": "shock hazard",
   "definition": "when electric current passes through a person"
  },
  {
   "section": "20.6",
   "term": "short circuit",
   "definition": "also known as a “short,” a low-resistance path between terminals of a voltage source"
  },
  {
   "section": "20.6",
   "term": "microshock sensitive",
   "definition": "a condition in which a person’s skin resistance is bypassed, possibly by a medical procedure, rendering the person vulnerable to electrical shock at currents about 1/1000 the normally required level"
  },
  {
   "section": "20.7",
   "term": "nerve conduction",
   "definition": "the transport of electrical signals by nerve cells"
  },
  {
   "section": "20.7",
   "term": "bioelectricity",
   "definition": "electrical effects in and created by biological systems"
  },
  {
   "section": "20.7",
   "term": "semipermeable",
   "definition": "property of a membrane that allows only certain types of ions to cross it"
  },
  {
   "section": "20.7",
   "term": "electrocardiogram (ECG)",
