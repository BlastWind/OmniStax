  "statements": {},
  "new": [
    {
      "id": "motion",
      "kind": "definition",
      "section": "3.4",
      "name": "Motion",
      "statement": "Motion is the displacement of an object as a function of time.",
      "introduces": "projectile",
      "prereqs": [
        "displacement",
        "time"
      ]
    },
    {
      "id": "air-resistance",
      "kind": "definition",
      "section": "3.4",
      "name": "Air resistance",
      "statement": "Air resistance is a frictional force that slows the motion of objects as they travel through the air. When solving basic physics problems, air resistance is assumed to be zero.",
      "introduces": "projectile",
      "prereqs": [
        "free-fall"
      ]
    },
    {
      "id": "angle",
      "kind": "definition",
      "section": "3.2",
      "name": "Angle $\\theta$",
      "statement": "An angle measures the turn between two directions. In two dimensions an angle, such as 29.1º north of east, gives the direction of a vector relative to a reference axis.",
      "introduces": "vectors-2d",
      "prereqs": [
        "vector"
      ]
    },
    {
      "id": "vector-head",
      "kind": "definition",
      "section": "3.2",
      "name": "Head of a vector",
      "statement": "The head of a vector is its end point, the location of the tip of its arrowhead, also called the tip.",
      "introduces": "vectors-2d",
      "prereqs": [
        "vector-in-two-dimensions"
      ]
    },
    {
      "id": "vector-tail",
      "kind": "definition",
      "section": "3.2",
      "name": "Tail of a vector",
      "statement": "The tail of a vector is its start point, at the opposite end of the arrow from the head.",
      "introduces": "vectors-2d",
      "prereqs": [
        "vector-in-two-dimensions"
      ]
    },
    {
      "id": "vector-magnitude",
      "kind": "definition",
      "section": "3.2",
      "name": "Magnitude of a vector",
      "statement": "The magnitude of a vector is its length or size, and it is a scalar quantity.",
      "introduces": "vectors-2d",
      "prereqs": [
        "vector-in-two-dimensions",
        "scalar"
      ]
    },
    {
      "id": "vector-direction",
      "kind": "definition",
      "section": "3.2",
      "name": "Direction of a vector",
      "statement": "The direction of a vector is its orientation in space, given in two dimensions by an angle relative to a reference axis.",
      "introduces": "vectors-2d",
      "prereqs": [
        "vector-in-two-dimensions",
        "angle"
      ]
    },
    {
      "id": "head-to-tail-method-def",
      "kind": "definition",
      "section": "3.2",
      "name": "Head-to-tail method",
      "statement": "The head-to-tail method is a method of adding vectors in which the tail of each vector is placed at the head of the previous vector.",
      "introduces": "head-to-tail",
      "prereqs": [
        "vector-head",
        "vector-tail",
        "resultant-vector"
      ]
    },
    {
      "id": "vector-addition",
      "kind": "definition",
      "section": "3.2",
      "name": "Vector addition",
      "statement": "Vector addition is the set of rules that apply to adding vectors together, giving their resultant.",
      "introduces": "head-to-tail",
      "prereqs": [
        "resultant-vector"
      ]
    },
    {
      "id": "analytical-method",
      "kind": "definition",
      "section": "3.3",
      "name": "Analytical method",
      "statement": "The analytical method determines the magnitude and direction of a resultant vector using the Pythagorean theorem and trigonometric identities.",
      "introduces": "analytical",
      "prereqs": [
        "resultant-vector",
        "vector-components"
      ]
    },
    {
      "id": "projectile",
      "kind": "definition",
      "section": "3.4",
      "name": "Projectile",
      "statement": "A projectile is an object that travels through the air and experiences only acceleration due to gravity.",
      "introduces": "projectile",
      "prereqs": [
        "acceleration-due-to-gravity"
      ]
    },
    {
      "id": "trajectory",
      "kind": "definition",
      "section": "3.4",
      "name": "Trajectory",
      "statement": "The trajectory is the path of a projectile through the air.",
      "introduces": "projectile",
      "prereqs": [
        "projectile"
      ]
    },
    {
      "id": "velocity",
      "kind": "definition",
      "section": "3.5",
      "name": "Velocity",
      "statement": "Velocity is speed in a given direction.",
      "introduces": "relative-velocity",
      "prereqs": [
        "vector",
        "instantaneous-speed"
      ]
    }
  ],
