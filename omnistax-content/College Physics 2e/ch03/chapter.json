  {
   "id": "eq-pythagoras",
   "concept": "right-triangle-resultant",
   "section": "3.1",
   "latex": "a^2 + b^2 = c^2,\\quad c = \\sqrt{a^2 + b^2}",
   "condition": "a right triangle with legs a and b and hypotenuse c",
