  "glossary": [
    {
      "section": "11.1",
      "term": "fluids",
      "definition": "liquids and gases; a fluid is a state of matter that yields to shearing forces"
    },
    {
      "section": "11.2",
      "term": "density",
      "definition": "the mass per unit volume of a substance or object"
    },
    {
      "section": "11.3",
      "term": "pressure",
      "definition": "the force per unit area perpendicular to the force, over which the force acts"
    },
    {
      "section": "11.5",
      "term": "Pascal’s principle",
      "definition": "a change in pressure applied to an enclosed fluid is transmitted undiminished to all portions of the fluid and to the walls of its container"
    },
    {
      "section": "11.6",
      "term": "absolute pressure",
      "definition": "the sum of gauge pressure and atmospheric pressure"
    },
    {
      "section": "11.6",
      "term": "diastolic pressure",
      "definition": "the minimum blood pressure in the artery"
    },
    {
      "section": "11.6",
      "term": "gauge pressure",
      "definition": "the pressure relative to atmospheric pressure"
    },
    {
      "section": "11.6",
      "term": "systolic pressure",
      "definition": "the maximum blood pressure in the artery"
    },
    {
      "section": "11.7",
      "term": "Archimedes’ principle",
      "definition": "the buoyant force on an object equals the weight of the fluid it displaces"
    },
    {
      "section": "11.7",
      "term": "buoyant force",
      "definition": "the net upward force on any object in any fluid"
    },
    {
      "section": "11.7",
      "term": "specific gravity",
      "definition": "the ratio of the density of an object to a fluid (usually water)"
    },
    {
      "section": "11.8",
      "term": "adhesive forces",
      "definition": "the attractive forces between molecules of different types"
    },
    {
      "section": "11.8",
      "term": "capillary action",
      "definition": "the tendency of a fluid to be raised or lowered in a narrow tube"
    },
    {
      "section": "11.8",
      "term": "cohesive forces",
      "definition": "the attractive forces between molecules of the same type"
    },
    {
      "section": "11.8",
      "term": "contact angle",
      "definition": "the angle $\\theta$ between the tangent to the liquid surface and the surface"
    },
    {
      "section": "11.8",
      "term": "surface tension",
      "definition": "the cohesive forces between molecules which cause the surface of a liquid to contract to the smallest possible surface area"
    },
    {
      "section": "11.9",
      "term": "glaucoma",
      "definition": "condition caused by the buildup of fluid pressure in the eye"
    },
    {
      "section": "11.9",
      "term": "intraocular pressure",
      "definition": "fluid pressure in the eye"
    },
    {
      "section": "11.9",
      "term": "micturition reflex",
      "definition": "stimulates the feeling of needing to urinate, triggered by bladder pressure"
    }
  ]
}
