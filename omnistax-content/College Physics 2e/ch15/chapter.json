      "section": "15.7",
      "anchor": "15.7-entropy-change"
    },
    {
      "sym": "W_microf",
      "meaning": "the number of microstates of the final macrostate",
      "unit": "",
      "section": "15.7",
      "anchor": "15.7-entropy-change"
    },
    {
      "sym": "k_boltz",
      "meaning": "Boltzmann’s constant, 1.38 × 10⁻²³ J/K",
      "unit": "J/K",
      "section": "15.7",
      "anchor": "15.7-disorder-in-a-gas"
    },
    {
      "sym": "T_hprime",
      "type": "temperature",
      "meaning": "the temperature of the cooler reservoir that the heat transfer falls to irreversibly before it enters the second Carnot engine",
      "unit": "K",
      "section": "15.6",
      "anchor": "15.6-unavailable-work"
    },
    {
      "sym": "T_cprime",
      "type": "temperature",
      "meaning": "the 250 K reservoir temperature that sets the Carnot efficiency of the second engine in part (b) of Example 15.7",
      "unit": "K",
      "section": "15.6",
      "anchor": "15.6-unavailable-work"
    }
  ],
  "equations": [
    {
      "id": "eq-first-law",
      "concept": "first-law-of-thermodynamics",
      "section": "15.1",
      "latex": "\\Delta E_{\\text{int}} = Q - W",
      "ktex": "\\kdEint = \\kQh - \\kW",
      "important": true,
      "anchor": "15.1-first-law"
    },
    {
      "id": "eq-internal-energy-change",
      "concept": "internal-energy-is-a-state-function",
      "section": "15.1",
      "latex": "\\Delta E_{\\text{int}} = E_{\\text{int2}} - E_{\\text{int1}}",
      "ktex": "\\kdEint = \\kEinttwo - \\kEintone",
      "important": true,
      "anchor": "15.1-path-independence"
    },
    {
      "id": "eq-work-force-distance",
      "section": "15.2",
      "latex": "W = Fd",
      "ktex": "\\kW = \\kF\\kd",
      "important": false,
      "anchor": "15.2-pv-diagrams"
    },
    {
      "id": "eq-isobaric-work",
      "concept": "isobaric-work",
      "section": "15.2",
      "latex": "W = P\\Delta V",
      "ktex": "\\kW = \\kPr\\Delta V",
      "condition": "isobaric process",
      "important": true,
      "anchor": "15.2-pv-diagrams"
    },
    {
      "id": "eq-external-pressure-work",
      "section": "15.2",
      "latex": "W = -P_{\\text{ext}}\\Delta V",
      "ktex": "\\kW = -\\kPrext\\Delta V",
      "condition": "isobaric process, in the sign convention of texts that define work against the external pressure",
      "important": false,
      "anchor": "15.2-pv-diagrams"
    },
    {
      "id": "eq-isochoric-work",
      "concept": "isochoric-process",
      "section": "15.2",
      "latex": "W = 0",
      "ktex": "\\kW = 0",
      "condition": "isochoric process, constant volume",
      "important": true,
      "anchor": "15.2-path-and-cycles"
    },
    {
      "id": "eq-average-kinetic-energy",
      "section": "15.2",
      "latex": "\\tfrac{1}{2}m\\bar{v}^2 = \\tfrac{3}{2}kT",
      "ktex": "\\tfrac{1}{2}m\\kvb^2 = \\tfrac{3}{2}k\\kTemp",
      "condition": "monatomic ideal gas",
      "important": false,
      "anchor": "15.2-isothermal-adiabatic"
    },
    {
      "id": "eq-internal-energy-monatomic",
      "concept": "internal-energy-monatomic-ideal-gas",
      "section": "15.2",
      "latex": "E_{\\text{int}} = N\\tfrac{1}{2}m\\bar{v}^2 = \\tfrac{3}{2}NkT",
      "ktex": "\\kEint = N\\tfrac{1}{2}m\\kvb^2 = \\tfrac{3}{2}Nk\\kTemp",
      "condition": "monatomic ideal gas",
      "important": true,
      "anchor": "15.2-isothermal-adiabatic"
    },
    {
      "id": "eq-isothermal",
      "concept": "isothermal-process",
      "section": "15.2",
      "latex": "Q = W",
      "ktex": "\\kQh = \\kW",
      "condition": "isothermal process of an ideal gas, constant temperature",
      "important": true,
      "anchor": "15.2-isothermal-adiabatic"
    },
    {
      "id": "eq-adiabatic",
      "concept": "adiabatic-process",
      "section": "15.2",
      "latex": "\\Delta E_{\\text{int}} = -W",
      "ktex": "\\kdEint = -\\kW",
      "condition": "adiabatic process, no heat transfer",
      "important": true,
      "anchor": "15.2-isothermal-adiabatic"
    },
    {
      "id": "eq-cycle-first-law",
      "concept": "cyclical-process",
      "section": "15.3",
      "latex": "0 = Q - W",
      "ktex": "0 = \\kQh - \\kW",
      "condition": "cyclical process, the internal energy the same at the start and end of every cycle",
      "important": false,
      "anchor": "15.3-cyclical"
    },
    {
      "id": "eq-cycle-work",
      "concept": "heat-engine-work-output",
      "section": "15.3",
      "latex": "W = Q_{\\text{h}} - Q_{\\text{c}}",
      "ktex": "\\kW = \\kQH - \\kQC",
      "condition": "cyclical process",
      "important": true,
      "anchor": "15.3-cyclical"
    },
    {
      "id": "eq-efficiency",
      "concept": "heat-engine-efficiency",
      "section": "15.3",
      "latex": "\\text{Eff} = \\frac{W}{Q_{\\text{h}}}",
      "ktex": "\\text{Eff} = \\frac{\\kW}{\\kQH}",
      "important": true,
      "anchor": "15.3-efficiency"
    },
    {
      "id": "eq-efficiency-heats",
      "section": "15.3",
      "latex": "\\text{Eff} = \\frac{Q_{\\text{h}} - Q_{\\text{c}}}{Q_{\\text{h}}} = 1 - \\frac{Q_{\\text{c}}}{Q_{\\text{h}}}",
      "ktex": "\\text{Eff} = \\frac{\\kQH - \\kQC}{\\kQH} = 1 - \\frac{\\kQC}{\\kQH}",
      "condition": "cyclical process",
      "important": true,
      "anchor": "15.3-efficiency"
    },
    {
      "id": "eq-carnot-heat-ratio",
      "concept": "carnot-efficiency",
      "section": "15.4",
      "latex": "\\frac{Q_{\\text{c}}}{Q_{\\text{h}}} = \\frac{T_{\\text{c}}}{T_{\\text{h}}}",
      "ktex": "\\frac{\\kQC}{\\kQH} = \\frac{\\kTempc}{\\kTemph}",
      "condition": "Carnot engine, temperatures in kelvins",
      "important": true,
      "anchor": "15.4-maximum-efficiency"
    },
    {
      "id": "eq-carnot-efficiency",
      "concept": "carnot-efficiency",
      "section": "15.4",
      "latex": "\\text{Eff}_{\\text{C}} = 1 - \\frac{T_{\\text{c}}}{T_{\\text{h}}}",
      "ktex": "\\text{Eff}_{\\text{C}} = 1 - \\frac{\\kTempc}{\\kTemph}",
      "condition": "temperatures in kelvins or any other absolute scale",
      "important": true,
      "anchor": "15.4-maximum-efficiency"
    },
    {
      "id": "eq-heat-pump-balance",
      "concept": "heat-pump",
      "section": "15.5",
      "latex": "Q_{\\text{h}} = Q_{\\text{c}} + W",
      "ktex": "\\kQH = \\kQC + \\kW",
      "condition": "heat pump, refrigerator or air conditioner; all three quantities positive",
      "important": true,
      "anchor": "15.5-heat-engines-backward"
    },
    {
      "id": "eq-cop-heat-pump",
      "concept": "coefficient-of-performance-heat-pump",
      "section": "15.5",
      "latex": "\\text{COP}_{\\text{hp}} = \\frac{Q_{\\text{h}}}{W}",
      "ktex": "\\text{COP}_{\\text{hp}} = \\frac{\\kQH}{\\kW}",
      "important": true,
      "anchor": "15.5-coefficient-of-performance"
    },
    {
      "id": "eq-cop-heat-pump-efficiency",
      "section": "15.5",
      "latex": "\\text{COP}_{\\text{hp}} = \\frac{1}{\\text{Eff}}",
      "important": true,
      "anchor": "15.5-coefficient-of-performance"
    },
    {
      "id": "eq-cop-refrigerator",
      "concept": "coefficient-of-performance-refrigerator",
      "section": "15.5",
      "latex": "\\text{COP}_{\\text{ref}} = \\frac{Q_{\\text{c}}}{W}",
      "ktex": "\\text{COP}_{\\text{ref}} = \\frac{\\kQC}{\\kW}",
      "important": true,
      "anchor": "15.5-refrigerators"
    },
    {
      "id": "eq-cop-relation",
      "section": "15.5",
      "latex": "\\text{COP}_{\\text{ref}} = \\text{COP}_{\\text{hp}} - 1",
      "condition": "the same heat engine used as an air conditioner or a heat pump between the same two temperatures",
      "important": true,
      "anchor": "15.5-refrigerators"
    },
    {
      "id": "eq-eer",
      "concept": "energy-efficiency-rating",
      "section": "15.5",
      "latex": "\\text{EER} = \\frac{Q_{\\text{c}}/t_1}{W/t_2}",
      "condition": "Q_c in British thermal units, t_1 in hours, W in joules, t_2 in seconds",
      "important": true,
      "anchor": "15.5-refrigerators"
    },
    {
      "id": "eq-reversible-heat-ratio",
      "section": "15.6",
      "latex": "\\frac{Q_{\\text{c}}}{T_{\\text{c}}} = \\frac{Q_{\\text{h}}}{T_{\\text{h}}}",
      "ktex": "\\frac{\\kQC}{\\kTempc} = \\frac{\\kQH}{\\kTemph}",
      "condition": "any reversible process",
      "important": true,
      "anchor": "15.6-entropy-defined"
    },
    {
      "id": "eq-entropy-change",
      "concept": "change-in-entropy",
      "section": "15.6",
      "latex": "\\Delta S = \\left(\\frac{Q}{T}\\right)_{\\text{rev}}",
      "ktex": "\\kdS = \\left(\\frac{\\kQh}{\\kTemp}\\right)_{\\text{rev}}",
      "condition": "reversible process, or any process whose end states a reversible process could join",
      "important": true,
      "anchor": "15.6-entropy-defined"
    },
    {
      "id": "eq-total-entropy",
      "section": "15.6",
      "latex": "\\Delta S_{\\text{tot}} = \\Delta S_{\\text{h}} + \\Delta S_{\\text{c}}",
      "ktex": "\\kdStot = \\kdSh + \\kdSc",
      "important": true,
      "anchor": "15.6-entropy-second-law"
    },
    {
      "id": "eq-reversible-total-entropy",
      "concept": "second-law-entropy-statement",
      "section": "15.6",
      "latex": "\\Delta S_{\\text{tot}} = -\\frac{Q_{\\text{h}}}{T_{\\text{h}}} + \\frac{Q_{\\text{c}}}{T_{\\text{c}}} = 0",
      "ktex": "\\kdStot = -\\frac{\\kQH}{\\kTemph} + \\frac{\\kQC}{\\kTempc} = 0",
      "condition": "Carnot engine, and any reversible process",
      "important": true,
      "anchor": "15.6-entropy-second-law"
    },
    {
      "id": "eq-unavailable-work",
      "concept": "unavailable-energy",
      "section": "15.6",
      "latex": "W_{\\text{unavail}} = \\Delta S \\cdot T_0",
      "ktex": "\\kWunavail = \\kdS \\cdot \\kTempo",
      "important": true,
      "anchor": "15.6-unavailable-work"
    },
    {
      "id": "eq-melting-heat",
      "section": "15.6",
      "latex": "Q = mL_{\\text{f}}",
      "ktex": "\\kQh = mL_{\\text{f}}",
      "condition": "melting at the melting temperature",
      "important": false,
      "anchor": "15.6-order-to-disorder"
    },
    {
      "id": "eq-entropy-system-environment",
      "concept": "entropy-and-life",
      "section": "15.6",
      "latex": "\\Delta S_{\\text{tot}} = \\Delta S_{\\text{syst}} + \\Delta S_{\\text{envir}} > 0",
      "ktex": "\\kdStot = \\kdSsyst + \\kdSenvir > 0",
      "condition": "any real process",
      "important": true,
      "anchor": "15.6-life-and-evolution"
    },
    {
      "id": "eq-boltzmann-entropy",
      "concept": "boltzmann-entropy",
      "section": "15.7",
      "latex": "S = k\\ln W",
      "ktex": "\\kSent = k\\ln W",
      "condition": "k the Boltzmann constant, W the number of microstates of the macrostate",
      "important": true,
      "anchor": "15.7-disorder-in-a-gas"
    },
    {
      "id": "eq-entropy-change-microstates",
      "concept": "calculate-entropy-from-microstates",
      "section": "15.7",
      "latex": "\\Delta S = S_{\\text{f}} - S_{\\text{i}} = k\\ln W_{\\text{f}} - k\\ln W_{\\text{i}}",
      "ktex": "\\kdS = \\kSf - \\kSi = k\\ln W_{\\text{f}} - k\\ln W_{\\text{i}}",
      "important": true,
      "anchor": "15.7-entropy-change"
    }
  ],
  "glossary": [
    {
      "section": "15.1",
      "term": "first law of thermodynamics",
      "definition": "states that the change in internal energy of a system equals the net heat transfer into the system minus the net work done by the system"
    },
    {
      "section": "15.1",
      "term": "internal energy",
      "definition": "the sum of the kinetic and potential energies of a system’s atoms and molecules"
    },
    {
      "section": "15.1",
      "term": "human metabolism",
      "definition": "conversion of food into heat transfer, work, and stored fat"
    },
    {
      "section": "15.2",
      "term": "heat engine",
      "definition": "a machine that uses heat transfer to do work"
    },
    {
      "section": "15.2",
      "term": "isobaric process",
      "definition": "constant-pressure process in which a gas does work"
    },
    {
      "section": "15.2",
      "term": "isochoric process",
      "definition": "a constant-volume process"
    },
    {
      "section": "15.2",
      "term": "isothermal process",
      "definition": "a constant-temperature process"
    },
    {
      "section": "15.2",
      "term": "adiabatic process",
      "definition": "a process in which no heat transfer takes place"
    },
    {
      "section": "15.2",
      "term": "reversible process",
      "definition": "a process in which both the heat engine system and the external environment theoretically can be returned to their original states"
    },
    {
      "section": "15.3",
      "term": "irreversible process",
      "definition": "any process that depends on path direction"
    },
    {
      "section": "15.3",
      "term": "second law of thermodynamics",
      "definition": "heat transfer flows from a hotter to a cooler object, never the reverse, and some heat energy in any process is lost to available work in a cyclical process"
    },
    {
      "section": "15.3",
      "term": "cyclical process",
      "definition": "a process in which the path returns to its original state at the end of every cycle"
    },
    {
      "section": "15.3",
      "term": "Otto cycle",
      "definition": "a thermodynamic cycle, consisting of a pair of adiabatic processes and a pair of isochoric processes, that converts heat into work, e.g., the four-stroke engine cycle of intake, compression, ignition, and exhaust"
    },
    {
      "section": "15.4",
      "term": "Carnot cycle",
      "definition": "a cyclical process that uses only reversible processes, the adiabatic and isothermal processes"
    },
    {
      "section": "15.4",
      "term": "Carnot engine",
      "definition": "a heat engine that uses a Carnot cycle"
    },
    {
      "section": "15.4",
      "term": "Carnot efficiency",
      "definition": "the maximum theoretical efficiency for a heat engine"
    },
    {
      "section": "15.5",
      "term": "heat pump",
      "definition": "a machine that generates heat transfer from cold to hot"
    },
    {
      "section": "15.5",
      "term": "coefficient of performance",
      "definition": "for a heat pump, it is the ratio of heat transfer at the output (the hot reservoir) to the work supplied; for a refrigerator or air conditioner, it is the ratio of heat transfer from the cold reservoir to the work supplied"
    },
    {
      "section": "15.6",
      "term": "entropy",
      "definition": "a measurement of a system's disorder and its inability to do work in a system"
    },
    {
      "section": "15.6",
      "term": "change in entropy",
      "definition": "the ratio of heat transfer to temperature Q/T"
    },
    {
      "section": "15.6",
      "term": "second law of thermodynamics stated in terms of entropy",
      "definition": "the total entropy of a system either increases or remains constant; it never decreases"
    },
    {
      "section": "15.7",
      "term": "macrostate",
      "definition": "an overall property of a system"
    },
    {
      "section": "15.7",
      "term": "microstate",
      "definition": "each sequence within a larger macrostate"
    },
    {
      "section": "15.7",
      "term": "statistical analysis",
      "definition": "using statistics to examine data, such as counting microstates and macrostates"
    }
  ]
}
