  "statements": {
    "change-in-entropy": "The change in entropy of a system in a reversible process is the heat transfer, positive into the system and negative out of it, divided by the absolute temperature at which it takes place, in joules per kelvin. For a Carnot cycle the heat transfers at the two reservoirs are in the ratio of their absolute temperatures, so this ratio is the same at both. Where the temperature changes a little during the process, use the average temperature. The definition holds strictly for reversible processes, but because entropy is a property of state, you can find the change for any real process by imagining a reversible one between the same two states."
  },
  "new": [
    {
      "id": "isobaric-process",
      "kind": "definition",
      "section": "15.2",
      "name": "Isobaric process",
      "statement": "An isobaric process is one that takes place at constant pressure, as when a gas expands against a piston that keeps its pressure fixed.",
      "introduces": "heat-engine",
      "prereqs": [
        "pressure"
      ]
    },
    {
      "id": "second-law-of-thermodynamics",
      "kind": "axiom",
      "section": "15.3",
      "name": "The second law of thermodynamics",
      "statement": "The second law of thermodynamics states that heat transfer occurs spontaneously only from a hotter body to a colder one, never the reverse, and that no cyclical process can convert heat transfer from a reservoir completely into work. The chapter gives it in several equivalent forms.",
      "introduces": "first-expression",
      "prereqs": [
        "heat",
        "work",
        "cyclical-process"
      ]
    },
    {
      "id": "carnot-engine",
      "kind": "definition",
      "section": "15.4",
      "name": "Carnot engine",
      "statement": "A Carnot engine is a heat engine that runs on the Carnot cycle, using only reversible processes.",
      "introduces": "carnot-cycle",
      "prereqs": [
        "carnot-cycle",
        "heat-engine"
      ]
    },
    {
      "id": "macrostate",
      "kind": "definition",
      "section": "15.7",
      "name": "Macrostate",
      "statement": "A macrostate is an overall property of a system, such as the total number of heads and tails in a set of coin tosses, without regard to the order in which they arise.",
      "introduces": "coin-tosses",
      "prereqs": [
        "macrostate-and-microstate"
      ]
    },
    {
      "id": "microstate",
      "kind": "definition",
      "section": "15.7",
      "name": "Microstate",
      "statement": "A microstate is one detailed arrangement of a system, such as one particular sequence of heads and tails, and many microstates may belong to the same macrostate.",
      "introduces": "coin-tosses",
      "prereqs": [
        "macrostate-and-microstate",
        "macrostate"
      ]
    },
    {
      "id": "statistical-analysis",
      "kind": "idea",
      "section": "15.7",
      "name": "Statistical analysis",
      "statement": "Statistical analysis examines a system by counting its possibilities, such as the microstates that belong to each macrostate, to find how likely each outcome is.",
      "introduces": "coin-tosses",
      "prereqs": [
        "macrostate",
        "microstate"
      ]
    }
  ],
