 "glossary": [
  {
   "section": "29.1",
   "term": "quantized",
   "definition": "the fact that certain physical entities exist only with particular discrete values and not every conceivable value"
  },
  {
   "section": "29.1",
   "term": "correspondence principle",
   "definition": "in the classical limit (large, slow-moving objects), quantum mechanics becomes the same as classical physics"
  },
  {
   "section": "29.1",
   "term": "quantum mechanics",
   "definition": "the branch of physics that deals with small objects and with the quantization of various entities, especially energy"
  },
  {
   "section": "29.1",
   "term": "blackbody",
   "definition": "an ideal radiator, which can radiate equally well at all wavelengths"
  },
  {
   "section": "29.1",
   "term": "blackbody radiation",
   "definition": "the electromagnetic radiation from a blackbody"
  },
  {
   "section": "29.1",
   "term": "Planck’s constant",
   "definition": "$h=6.626\\times 10^{-34}\\;\\text{J}\\cdot\\text{s}$"
  },
  {
   "section": "29.1",
   "term": "atomic spectra",
   "definition": "the electromagnetic emission from atoms and molecules"
  },
  {
   "section": "29.2",
   "term": "photoelectric effect",
   "definition": "the phenomenon whereby some materials eject electrons when light is shined on them"
  },
  {
   "section": "29.2",
   "term": "photon",
   "definition": "a quantum, or particle, of electromagnetic radiation"
  },
  {
   "section": "29.2",
   "term": "photon energy",
   "definition": "the amount of energy a photon has; $E=hf$"
  },
  {
   "section": "29.2",
   "term": "binding energy",
   "definition": "also called the work function; the amount of energy necessary to eject an electron from a material"
  },
  {
   "section": "29.3",
   "term": "gamma ray",
   "definition": "also $\\gamma$-ray; highest-energy photon in the EM spectrum"
  },
  {
   "section": "29.3",
   "term": "ionizing radiation",
   "definition": "radiation that ionizes materials that absorb it"
  },
  {
   "section": "29.3",
   "term": "x ray",
   "definition": "EM photon between $\\gamma$-ray and UV in energy"
  },
  {
   "section": "29.3",
   "term": "bremsstrahlung",
   "definition": "German for braking radiation; produced when electrons are decelerated"
  },
  {
   "section": "29.3",
   "term": "characteristic x rays",
   "definition": "x rays whose energy depends on the material they were produced in"
  },
  {
   "section": "29.3",
   "term": "ultraviolet radiation",
   "definition": "UV; ionizing photons slightly more energetic than violet light"
  },
  {
   "section": "29.3",
   "term": "visible light",
   "definition": "the range of photon energies the human eye can detect"
  },
  {
   "section": "29.3",
   "term": "infrared radiation",
   "definition": "photons with energies slightly less than red light"
  },
  {
   "section": "29.3",
   "term": "microwaves",
   "definition": "photons with wavelengths on the order of a micron ($\\mu\\text{m}$)"
  },
  {
   "section": "29.4",
   "term": "photon momentum",
   "definition": "the amount of momentum a photon has, calculated by $p=\\frac{h}{\\lambda}=\\frac{E}{c}$"
  },
  {
   "section": "29.4",
   "term": "Compton effect",
   "definition": "the phenomenon whereby x rays scattered from materials have decreased energy"
  },
  {
   "section": "29.5",
   "term": "particle-wave duality",
   "definition": "the property of behaving like either a particle or a wave; the term for the phenomenon that all particles have wave characteristics"
  },
  {
   "section": "29.6",
   "term": "de Broglie wavelength",
   "definition": "the wavelength possessed by a particle of matter, calculated by $\\lambda=h/p$"
  },
  {
   "section": "29.7",
   "term": "Heisenberg’s uncertainty principle",
   "definition": "a fundamental limit to the precision with which pairs of quantities (momentum and position, and energy and time) can be measured"
  },
  {
   "section": "29.7",
   "term": "uncertainty in energy",
   "definition": "lack of precision or lack of knowledge of precise results in measurements of energy"
  },
  {
   "section": "29.7",
   "term": "uncertainty in time",
   "definition": "lack of precision or lack of knowledge of precise results in measurements of time"
  },
  {
   "section": "29.7",
   "term": "uncertainty in momentum",
   "definition": "lack of precision or lack of knowledge of precise results in measurements of momentum"
  },
  {
   "section": "29.7",
   "term": "uncertainty in position",
   "definition": "lack of precision or lack of knowledge of precise results in measurements of position"
  },
  {
   "section": "29.7",
   "term": "probability distribution",
   "definition": "the overall spatial distribution of probabilities to find a particle at a given location"
  }
 ]
}
