 "glossary": [
  {
   "section": "18.1",
   "term": "static electricity",
   "concept": "static-electricity",
   "definition": "a buildup of electric charge on the surface of an object"
  },
  {
   "section": "18.1",
   "term": "electromagnetic force",
   "concept": "electromagnetic-force",
   "definition": "one of the four fundamental forces of nature; the electromagnetic force consists of static electricity, moving electricity and magnetism"
  },
  {
   "section": "18.1",
   "term": "electric charge",
   "concept": "electric-charge",
   "definition": "a physical property of an object that causes it to be attracted toward or repelled from another charged object; each charged object generates and is influenced by a force called an electromagnetic force"
  },
  {
   "section": "18.1",
   "term": "law of conservation of charge",
   "concept": "conservation-of-charge",
   "definition": "states that whenever a charge is created, an equal amount of charge with the opposite sign is created simultaneously"
  },
  {
   "section": "18.1",
   "term": "electron",
   "concept": "electron",
   "definition": "a particle orbiting the nucleus of an atom and carrying the smallest unit of negative charge"
  },
  {
   "section": "18.1",
   "term": "proton",
   "concept": "proton",
   "definition": "a particle in the nucleus of an atom and carrying a positive charge equal in magnitude and opposite in sign to the amount of negative charge carried by an electron"
  },
  {
   "section": "18.2",
   "term": "free electron",
   "concept": "free-electron",
   "definition": "an electron that is free to move away from its atomic orbit"
  },
  {
   "section": "18.2",
   "term": "conductor",
   "concept": "conductor",
   "definition": "a material that allows electrons to move separately from their atomic orbits"
  },
  {
   "section": "18.2",
   "term": "insulator",
   "concept": "insulator",
   "definition": "a material that holds electrons securely within their atomic orbits"
  },
  {
   "section": "18.2",
   "term": "grounded",
   "concept": "grounding",
   "definition": "when a conductor is connected to the Earth, allowing charge to freely flow to and from Earth’s unlimited reservoir"
  },
  {
   "section": "18.2",
   "term": "induction",
   "concept": "charging-by-induction",
   "definition": "the process by which an electrically charged object brought near a neutral object creates a charge in that object"
  },
  {
   "section": "18.2",
   "term": "polarization",
   "concept": "polarization",
   "definition": "slight shifting of positive and negative charges to opposite sides of an atom or molecule"
  },
  {
   "section": "18.2",
   "term": "electrostatic repulsion",
   "concept": "electrostatic-repulsion",
   "definition": "the phenomenon of two objects with like charges repelling each other"
  },
  {
   "section": "18.3",
   "term": "Coulomb’s law",
   "concept": "coulombs-law",
   "definition": "the mathematical equation calculating the electrostatic force vector between two charged particles"
