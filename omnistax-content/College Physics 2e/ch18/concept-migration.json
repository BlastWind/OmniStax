  "statements": {},
  "new": [
    {
      "id": "static-electricity",
      "kind": "definition",
      "section": "18.1",
      "name": "Static electricity",
      "statement": "Static electricity is a buildup of electric charge on the surface of an object. It is what makes a comb rubbed through dry hair attract bits of paper and a sock cling to a sweater from the dryer.",
      "introduces": "static-electricity",
      "prereqs": [
        "electric-charge"
      ]
    },
    {
      "id": "electromagnetic-force",
      "kind": "idea",
      "section": "18.1",
      "name": "The electromagnetic force",
      "statement": "The electromagnetic force is one of the four basic forces of nature. It consists of the static electric forces between charges, the magnetic forces between moving charges and magnets, and the electromagnetic waves that carry them through space.",
      "introduces": "static-electricity",
      "prereqs": [
        "four-basic-forces",
        "electric-charge"
      ]
    },
    {
      "id": "free-charge",
      "kind": "definition",
      "section": "18.2",
      "name": "Free charge",
      "statement": "A free charge is an electric charge that can move about separately from its atom or molecule. In metals some electrons are not bound to individual atoms, and these free electrons carry charge through the material.",
      "introduces": "conductors-and-insulators",
      "prereqs": [
        "electric-charge",
        "charge-of-electron-and-proton"
      ]
    },
    {
      "id": "electrostatics",
      "kind": "definition",
      "section": "18.8",
      "name": "Electrostatics",
      "statement": "Electrostatics is the study of electric forces that are static or slow-moving. Its ideas are put to work in machines such as the Van de Graaff generator, the copier and the electrostatic precipitator.",
      "introduces": "what-electrostatics-is",
      "prereqs": [
        "electric-charge",
        "coulombs-law"
      ]
    },
    {
      "id": "electron",
      "kind": "definition",
      "section": "18.1",
      "name": "Electron",
      "statement": "The electron is a particle orbiting the nucleus of an atom and carrying the smallest unit of negative charge.",
      "introduces": "electrons-and-protons",
      "prereqs": [
        "electric-charge",
        "elementary-charge"
      ]
    },
    {
      "id": "proton",
      "kind": "definition",
      "section": "18.1",
      "name": "Proton",
      "statement": "The proton is a particle in the nucleus of an atom carrying a positive charge equal in magnitude to the charge of the electron, and it is far more massive.",
      "introduces": "electrons-and-protons",
      "prereqs": [
        "electric-charge",
        "elementary-charge"
      ]
    },
    {
      "id": "free-electron",
      "kind": "definition",
      "section": "18.2",
      "name": "Free electron",
      "statement": "A free electron is an electron that is free to move away from its atomic orbit. Metals are good conductors because some of their electrons are free.",
      "introduces": "conductors-and-insulators",
      "prereqs": [
        "electron",
        "free-charge"
      ]
    },
    {
      "id": "electrostatic-repulsion",
      "kind": "idea",
      "section": "18.2",
      "name": "Electrostatic repulsion",
      "statement": "Electrostatic repulsion is the phenomenon of two objects with like charges repelling each other.",
      "introduces": "polarization-and-attraction",
      "prereqs": [
        "like-charges-repel"
      ]
    },
    {
      "id": "electrostatic-force",
      "kind": "definition",
      "section": "18.3",
      "name": "The electrostatic force",
      "statement": "The electrostatic force, also called the Coulomb force, is the attraction or repulsion between two charged bodies, with both a magnitude and a direction. Coulomb's law gives it for point charges.",
      "introduces": "electrostatic-force",
      "prereqs": [
        "electric-charge",
        "force"
      ]
    },
    {
      "id": "point-charge",
      "kind": "definition",
      "section": "18.4",
      "name": "Point charge",
      "statement": "A point charge, designated $Q$, is a charged particle that generates an electric field.",
      "introduces": "electric-field-defined",
      "prereqs": [
        "electric-charge"
      ]
    },
    {
      "id": "dipole",
      "kind": "definition",
      "section": "18.6",
      "name": "Dipole",
      "statement": "A dipole is a pair of separated centers of equal and opposite charge, such as a molecule whose charge is not symmetrically distributed, so that one side is more positive and the other more negative.",
      "introduces": "polarity",
      "prereqs": [
        "electric-charge"
      ]
    },
    {
      "id": "ionosphere",
      "kind": "idea",
      "section": "18.7",
      "name": "The ionosphere",
      "statement": "The ionosphere is a layer of charged particles about 100 km above the surface of Earth. It is positive, and with the largely negative Earth it maintains the fair-weather electric field.",
      "introduces": "earths-field",
      "prereqs": [
        "electric-charge",
        "conductor"
      ]
    },
    {
      "id": "photoconductor",
      "kind": "definition",
      "section": "18.8",
      "name": "Photoconductor",
      "statement": "A photoconductor is a substance that is an insulator until it is exposed to light, when it becomes a conductor. Selenium is one.",
      "introduces": "xerography",
      "prereqs": [
        "conductor",
        "insulator"
      ]
    },
    {
      "id": "laser-printer",
      "kind": "idea",
      "section": "18.8",
      "name": "The laser printer",
      "statement": "A laser printer uses a laser to create a photoconductive image on a drum, which attracts dry ink particles that are then rolled onto paper.",
      "introduces": "laser-printers",
      "prereqs": [
        "xerography",
        "photoconductor"
      ]
    }
  ],
