 "footnotes": [
  {
   "id": "c-eq-4-53",
   "kind": "correction",
   "html": "The book prints $-i$, the sign of Eq. (3.99). Eqs. (4.43), (4.58) and (4.69) take $\\krhotwoone = i\\kOmega(\\krhooneone - \\krhotwotwo)/(\\kgammaonetwo - i\\kdelta)$, which follows from the equations of motion $\\dot{\\kctildetwo} = i\\kdelta\\kctildetwo + i\\kOmega\\kcone$ and $\\dot{\\kcone} = i\\kOmega^*\\kctildetwo$ of Section 2.1 and makes $\\mathrm{Im}[\\kchin] &gt; 0$, an absorption; with $-i$, Eq. (4.57) would give $\\kchin$ the opposite sign to Eq. (4.58)."
  },
  {
   "id": "c-fig-4-4",
   "kind": "correction",
   "figure": "sim-saturation-spectroscopy",
   "html": "The book's Figure 4.4 labels the strong field's velocity class $k\\kvz = \\kDelta - \\knu$ and the weak field's $k\\kvz = \\knu - \\kDelta$. The text has the strong field resonant with the atoms for which $\\knu = \\kDelta + k\\kvz$, so its class is $k\\kvz = \\knu - \\kDelta$ and the weak field's $k\\kvz = \\kDelta - \\knu$. The panel titles $\\kDelta - \\knu &gt; \\kgamma$ and $\\kDelta - \\knu &lt; \\kgamma$ mean $|\\kDelta - \\knu|$."
  }
 ],
 "derivations": [
