      {
       "tex": "\\mk{chi}{\\kchin(\\kdelta)} = \\mk{pre}{\\frac{3}{8\\pi^2}\\frac{N}{\\kV}\\klambda^3}\\mk{L}{\\frac{i\\kgamma}{\\kgammaonetwo - i\\kdelta}}\\mk{pop}{\\frac{\\kgamma}{\\kgamma + 2\\kRopt}}",
