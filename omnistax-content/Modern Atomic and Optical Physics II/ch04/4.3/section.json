     "then": {
      "tex": "\\mk{chi}{\\kchin(\\kdelta)} = \\mk{P}{\\frac{\\kPenv(\\kdelta)}{\\epsilon_0\\kEenv(\\kdelta)}}",
      "src": "(4.56)",
      "uses": []
     },
     "steps": [
