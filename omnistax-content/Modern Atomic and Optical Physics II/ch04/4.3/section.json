   "id": "nonlinear-susceptibility",
   "what": "the nonlinear susceptibility of two-level atoms",
   "source": "Modern Atomic and Optical Physics II, 4.3 Nonlinear atomic response",
   "nodes": [
    {
     "assumes": [
      {
       "text": "For two-level atoms $\\kPenv = \\frac{N}{\\kV}\\kmu\\krhotwoone$, with $\\krhotwoone$ taken without the fast phase $e^{i\\kkbar z}$ of the local field.",
       "src": "4.1"
