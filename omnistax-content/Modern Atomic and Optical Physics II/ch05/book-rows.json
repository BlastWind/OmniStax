  "concepts": [
    {
      "id": "multiphoton-process-classes",
      "kind": "idea",
      "section": "5.1",
      "name": "Classes of multi-photon processes",
      "terms": [
        "incoherent interactions",
        "coherent interactions",
        "parametric interactions"
      ],
      "statement": "Multi-photon processes fall roughly into three classes: incoherent interactions, where atomic coherences are not important; coherent interactions, where atomic coherences matter and two or more photons are required to generate them; and parametric interactions, where no energy is exchanged between light and atoms but the atoms mediate interactions between light beams."
    },
    {
      "id": "raman-transition",
      "kind": "idea",
      "section": "5.1",
      "name": "Raman transition",
      "terms": [
        "Raman transition",
        "two photon Raman transitions",
        "two-photon Raman transition"
      ],
      "statement": "In a Raman transition two photons stimulate a dipole-forbidden transition via an excited state: by absorbing a photon on transition ν₁ and emitting a photon of frequency ν₂, population is coherently transferred between the two ground states."
    },
    {
      "id": "three-level-configurations",
      "kind": "definition",
      "section": "5.1",
      "name": "Three-level configurations",
      "terms": [
        "cascade system",
        "V system",
        "cascade",
        "V-type"
      ],
      "statement": "Two-photon transitions occur in three configurations of three levels: the Λ system, in which a single excited state mediates transitions between two lower states; the cascade system, climbing through an intermediate state; and the V system, two excited states sharing a ground state."
    },
    {
      "id": "lambda-system",
      "kind": "definition",
      "section": "5.1",
      "name": "Λ system",
      "terms": [
        "Λ system",
        "lambda system",
        "three-level Λ system"
      ],
      "type": "state",
      "statement": "In the Λ system a single excited state |3⟩ mediates transitions between two lower states; the transitions to |3⟩ are dipole allowed and decay quickly, while |2⟩ → |1⟩ is dipole forbidden, so the metastable state |2⟩ can have a very long lifetime."
    },
    {
      "id": "lambda-detunings",
      "kind": "definition",
      "section": "5.1",
      "name": "Single- and two-photon detunings",
      "symbol": "Delta_1",
      "terms": [
        "single-photon detunings",
        "two-photon detuning",
        "single photon detunings"
      ],
      "type": "frequency",
      "statement": "The single-photon detunings Δ₁ and Δ₂ measure each field from its transition to |3⟩, and the two-photon detuning is their difference.",
      "forms": [
        {
          "id": "eq-5-detunings",
          "latex": "\\delta = \\Delta_1 - \\Delta_2",
          "anchor": "5.1-detunings"
        }
      ]
    },
    {
      "id": "lambda-hamiltonian",
      "kind": "result",
      "section": "5.1",
      "name": "Λ-system Hamiltonian",
      "type": "energy",
      "statement": "In the appropriate rotating frame, with the energy of |1⟩ set to zero, the Hamiltonian of the Λ system holds the detunings on its diagonal and the two Rabi frequencies off it.",
      "forms": [
        {
          "id": "eq-5-1",
          "latex": "\\hat{H} = -\\Delta_1|3\\rangle\\langle 3| - \\delta|2\\rangle\\langle 2| - \\left(\\Omega_1|3\\rangle\\langle 1| + \\Omega_2|3\\rangle\\langle 2| + \\Omega_1^*|1\\rangle\\langle 3| + \\Omega_2^*|2\\rangle\\langle 3|\\right)",
          "anchor": "5.1-eq-5-1"
        }
      ]
    },
    {
      "id": "lambda-equations-of-motion",
      "kind": "result",
      "section": "5.1",
      "name": "Λ-system equations of motion",
      "symbol": "c_3",
      "type": "amplitude",
      "statement": "Neglecting decay, a state c₁|1⟩ + c₂|2⟩ + c₃|3⟩ obeys the Schrodinger equation for the Λ Hamiltonian, giving equations of motion for the three amplitudes.",
      "forms": [
        {
          "id": "eq-5-2",
          "latex": "|\\psi\\rangle = c_1(t)|1\\rangle + c_2(t)|2\\rangle + c_3(t)|3\\rangle",
          "anchor": "5.1-eq-5-2"
        },
        {
          "id": "eq-5-3",
          "latex": "\\dot{c}_1 = i\\Omega_1^* c_3",
          "anchor": "5.1-eq-5-3"
        },
        {
          "id": "eq-5-4",
          "latex": "\\dot{c}_2 = i\\delta c_2 + i\\Omega_2^* c_3",
          "anchor": "5.1-eq-5-4"
        },
        {
          "id": "eq-5-5",
          "latex": "\\dot{c}_3 = i\\Delta_1 c_3 + i\\Omega_1 c_1 + i\\Omega_2 c_2",
          "anchor": "5.1-eq-5-5"
        }
      ]
    },
    {
      "id": "effective-raman-coupling",
      "kind": "result",
      "section": "5.1",
      "name": "Effective two-photon Rabi frequency",
      "symbol": "Omega_eff",
      "terms": [
        "effective Rabi frequency"
      ],
      "type": "coupling",
      "statement": "For large similar single-photon detunings Δ ≫ Ω₁, Ω₂, γ₃, δ the excited amplitude is eliminated and the two lower levels behave as a two-level system coupled by an effective Rabi frequency, each level Stark shifted by |Ω_i|²/Δ.",
      "forms": [
        {
          "id": "eq-5-9",
          "latex": "\\Omega_\\mathrm{eff} = -\\frac{\\Omega_2^*\\Omega_1}{\\Delta}",
          "anchor": "5.1-drv-raman-coupling"
        },
        {
          "id": "eq-5-6",
          "latex": "c_3 = -\\frac{\\Omega_1 c_1 + \\Omega_2 c_2}{\\Delta}",
          "anchor": "5.1-drv-raman-coupling"
        },
        {
          "id": "eq-5-7",
          "latex": "\\dot{c}_1 = -i\\frac{|\\Omega_1|^2}{\\Delta}c_1 - i\\frac{\\Omega_2\\Omega_1^*}{\\Delta}c_2",
          "anchor": "5.1-drv-raman-coupling"
        },
        {
          "id": "eq-5-8",
          "latex": "\\dot{c}_2 = i(\\delta - \\frac{|\\Omega_2|^2}{\\Delta})c_2 - i\\frac{\\Omega_1\\Omega_2^*}{\\Delta}c_1",
          "anchor": "5.1-drv-raman-coupling"
        }
      ]
    },
    {
      "id": "lambda-density-matrix-equations",
      "kind": "result",
      "section": "5.1",
      "name": "Λ-system density matrix equations",
      "statement": "To account for decay and dephasing the Λ system is treated with the density matrix: Liouvillians carry decay from |3⟩ to |1⟩ and |2⟩ and from |2⟩ to |1⟩, and each coherence ρ_ij decays at its own rate γ_ij.",
      "forms": [
        {
          "id": "eq-5-10",
          "latex": "\\dot{\\rho} = \\mathcal{L}_{31}(\\rho) + \\mathcal{L}_{32}(\\rho) + i[\\hat{H}, \\rho]",
          "anchor": "5.1-eq-5-10"
        },
        {
          "id": "eq-5-11",
          "latex": "\\mathcal{L}_{31} = -\\frac{\\gamma_{3\\rightarrow 1}}{2}\\left(\\sigma_{31}\\sigma_{13}\\rho - \\sigma_{13}\\rho\\sigma_{31} + h.c.\\right)",
          "anchor": "5.1-eq-5-11"
        },
        {
          "id": "eq-5-12",
          "latex": "\\dot{\\rho}_{11} = -i\\Omega_1\\rho_{13} + i\\Omega_1^*\\rho_{31} + \\gamma\\rho_{33} + \\gamma'\\rho_{22}",
          "anchor": "5.1-drv-lambda-density-matrix"
        },
        {
          "id": "eq-5-13",
          "latex": "\\dot{\\rho}_{22} = -i\\Omega_2\\rho_{23} + i\\Omega_2^*\\rho_{32} - \\gamma'\\rho_{22} + \\tilde{\\gamma}\\rho_{33}",
          "anchor": "5.1-drv-lambda-density-matrix"
        },
        {
          "id": "eq-5-14",
          "latex": "\\dot{\\rho}_{21} = -\\left(\\gamma_{12} - i\\delta\\right)\\rho_{21} + i\\Omega_2^*\\rho_{31} - i\\Omega_1\\rho_{23}",
          "anchor": "5.1-drv-lambda-density-matrix"
        },
        {
          "id": "eq-5-15",
          "latex": "\\dot{\\rho}_{31} = -\\left(\\gamma_{13} - i\\Delta\\right)\\rho_{31} + i\\Omega_2\\rho_{21} + i\\Omega_1\\left(\\rho_{11} - \\rho_{33}\\right)",
          "anchor": "5.1-drv-lambda-density-matrix"
        },
        {
          "id": "eq-5-16",
          "latex": "\\dot{\\rho}_{32} = -\\left(\\gamma_{23} - i(\\Delta - \\delta)\\right)\\rho_{32} + i\\Omega_2\\left(\\rho_{22} - \\rho_{33}\\right) + i\\Omega_1\\rho_{12}",
          "anchor": "5.1-drv-lambda-density-matrix"
        }
      ]
    },
    {
      "id": "complex-decay-rate",
      "kind": "definition",
      "section": "5.1",
      "name": "Complex decay parameter",
      "symbol": "Gamma_12",
      "terms": [
        "complex decay parameter",
        "complex decay rates"
      ],
      "type": "rate",
      "statement": "The phase evolution and decay of each coherence are expressed together in a complex decay parameter, its real part the decay rate and its imaginary part the detuning.",
      "forms": [
        {
          "id": "eq-5-17",
          "latex": "\\Gamma_{12} = \\gamma_{12} - i\\delta",
          "anchor": "5.1-eq-5-17"
        },
        {
          "id": "eq-5-18",
          "latex": "\\Gamma_{13} = \\gamma_{13} - i\\Delta",
          "anchor": "5.1-eq-5-18"
        },
        {
          "id": "eq-5-19",
          "latex": "\\Gamma_{23} = \\gamma_{23} - i(\\Delta - \\delta)",
          "anchor": "5.1-eq-5-19"
        }
      ]
    },
    {
      "id": "lambda-non-hermitian-evolution",
      "kind": "result",
      "section": "5.1",
      "name": "Stochastic wavefunction treatment of the Λ system",
      "symbol": "gamma_3",
      "type": "rate",
      "statement": "Decay from |3⟩ and |2⟩ enters a non-Hermitian Hamiltonian, and its Schrodinger equation may be used so long as the probability of a quantum jump stays small: for a weak probe starting in |1⟩, or with slow decay from |2⟩ and little excited population.",
      "forms": [
        {
          "id": "eq-5-21",
          "latex": "\\hat{H}_\\mathrm{eff} = \\hat{H} - \\frac{i\\hbar\\gamma_3}{2}|3\\rangle\\langle 3| - \\frac{i\\hbar\\gamma_2}{2}|2\\rangle\\langle 2|",
          "anchor": "5.1-eq-5-21"
        },
        {
          "id": "eq-5-22",
          "latex": "P_\\mathrm{jump} = \\int dt\\left(\\gamma_2|c_2(t)|^2 + \\gamma_3|c_3(t)|^2\\right) \\ll 1",
          "anchor": "5.1-eq-5-22"
        },
        {
          "id": "eq-5-23",
          "latex": "\\dot{c}_1 = i\\Omega_1^* c_3",
          "anchor": "5.1-eq-5-23"
        },
        {
          "id": "eq-5-24",
          "latex": "\\dot{c}_2 = -(\\frac{\\gamma_2}{2} - i\\delta)c_2 + i\\Omega_2^* c_3",
          "anchor": "5.1-eq-5-24"
        },
        {
          "id": "eq-5-25",
          "latex": "\\dot{c}_3 = -(\\frac{\\gamma_3}{2} - i\\Delta_1)c_3 + i\\Omega_1 c_1 + i\\Omega_2 c_2",
          "anchor": "5.1-eq-5-25"
        }
      ]
    },
    {
      "id": "weak-probe-solution",
      "kind": "result",
      "section": "5.1",
      "name": "Weak-probe steady state of the Λ system",
      "statement": "For a weak probe Ω₁ and a constant Ω₂ of arbitrary strength the system stays in |1⟩ to zeroth order in Ω₁, and Fourier transforming the equations of motion gives the two-photon and optical coherences.",
      "forms": [
        {
          "id": "eq-5-29",
          "latex": "\\rho_{21} = c_1^* c_2 = -\\frac{\\Omega_1\\Omega_2^*}{\\Gamma_{12}\\Gamma_{13} + |\\Omega_2|^2}",
          "anchor": "5.1-drv-weak-probe-coherences"
        },
        {
          "id": "eq-5-30",
          "latex": "\\rho_{31} = c_1^* c_3 = i\\Omega_1\\frac{\\Gamma_{12}}{\\Gamma_{12}\\Gamma_{13} + |\\Omega_2|^2}",
          "anchor": "5.1-drv-weak-probe-coherences"
        },
        {
          "id": "eq-5-26",
          "latex": "(\\frac{\\gamma_2}{2} - i(\\delta - \\omega))c_2 = i\\Omega_2^* c_3",
          "anchor": "5.1-eq-5-26"
        },
        {
          "id": "eq-5-27",
          "latex": "(\\frac{\\gamma_3}{2} - i(\\Delta_1 - \\omega))c_3 = i\\Omega_1 + i\\Omega_2 c_2",
          "anchor": "5.1-eq-5-27"
        },
        {
          "id": "eq-5-28",
          "latex": "\\rho_{11} = |c_1|^2 = 1",
          "anchor": "5.1-drv-weak-probe-coherences"
        }
      ]
    },
    {
      "id": "probe-susceptibility",
      "kind": "definition",
      "section": "5.1",
      "name": "Linear susceptibility on the probe transition",
      "symbol": "chi_1",
      "terms": [
        "linear susceptibility"
      ],
      "type": "susceptibility",
      "statement": "When the probe is weak the response of the system is characterized by the linear susceptibility on the probe transition, proportional to ρ₃₁/Ω₁.",
      "forms": [
        {
          "id": "eq-5-31",
          "latex": "\\chi_1 = \\frac{|\\mu|^2}{\\hbar\\epsilon_0}\\frac{\\rho_{31}}{\\Omega_1}",
          "anchor": "5.1-eq-5-31"
        },
        {
          "id": "eq-5-32",
          "latex": "\\frac{\\rho_{31}}{\\Omega_1} = \\frac{i}{\\Gamma_{13}}\\left(\\frac{\\Gamma_{12}}{\\Gamma_{12} + |\\Omega_2|^2/\\Gamma_{13}}\\right)",
          "anchor": "5.1-drv-probe-response"
        },
        {
          "id": "eq-5-33",
          "latex": "\\frac{\\rho_{31}}{\\Omega_1} = \\frac{i}{\\Gamma_{13}}\\left(1 - \\frac{|\\Omega_2|^2/\\Gamma_{13}}{\\Gamma_{12} + |\\Omega_2|^2/\\Gamma_{13}}\\right)",
          "anchor": "5.1-drv-probe-response"
        }
      ]
    },
    {
      "id": "two-photon-resonance",
      "kind": "result",
      "section": "5.1",
      "name": "Two-photon resonance",
      "symbol": "gamma_eff",
      "terms": [
        "two-photon resonance"
      ],
      "type": "rate",
      "statement": "At large Δ the probe susceptibility shows, beside the broad single-photon resonance of width γ₁₃, a narrow two-photon resonance shifted to δ = |Ω₂|²/Δ; its width is set by the metastable decoherence γ₁₂ and an excited-state term strongly suppressed by the detuning.",
      "forms": [
        {
          "id": "eq-5-35",
          "latex": "\\frac{\\rho_{31}}{\\Omega_1} - \\frac{i}{\\Gamma_{13}} \\approx \\frac{i|\\Omega_2|^2/\\Delta^2}{\\gamma_\\mathrm{eff} - i\\delta'}",
          "anchor": "5.1-drv-raman-resonance"
        },
        {
          "id": "eq-5-34",
          "latex": "\\frac{\\rho_{31}}{\\Omega_1} - \\frac{i}{\\Gamma_{13}} \\approx \\frac{i|\\Omega_2|^2/\\Delta^2}{\\Gamma_{12} + (|\\Omega_2|^2/\\Delta^2)(\\gamma_{13} + i\\Delta)}",
          "anchor": "5.1-drv-raman-resonance"
        }
      ]
    },
    {
      "id": "two-photon-detuning-shifted",
      "kind": "definition",
      "section": "5.1",
      "name": "Effective two-photon detuning",
      "symbol": "delta_prime",
      "type": "frequency",
      "statement": "The effective detuning of the two-photon resonance is the two-photon detuning less the light shift of |2⟩.",
      "forms": [
        {
          "id": "eq-5-delta-prime",
          "latex": "\\delta' = \\delta - |\\Omega_2|^2/\\Delta",
          "anchor": "5.1-drv-raman-resonance"
        }
      ]
    },
    {
      "id": "raman-unitarity-limit",
      "kind": "result",
      "section": "5.1",
      "name": "Two-photon resonance at the unitarity limit",
      "terms": [
        "unitarity limit"
      ],
      "statement": "Exactly on two-photon resonance with no dephasing the susceptibility is that of a radiatively broadened system, approaching the unitarity limit, and the two-photon peak has the same amplitude as the single-photon resonance.",
      "forms": [
        {
          "id": "eq-5-36",
          "latex": "\\frac{\\rho_{31}}{\\Omega_1} \\sim \\frac{2i}{\\gamma_3}",
          "anchor": "5.1-eq-5-36"
        }
      ]
    },
    {
      "id": "raman-dressed-states",
      "kind": "result",
      "section": "5.1",
      "name": "Dressed-state picture of the Raman resonance",
      "statement": "The strong field Ω₂ dresses |2⟩ and |3⟩; the single-photon resonance is the transition to |+⟩, nearly |3⟩ with nearly its radiative width, and the two-photon Raman resonance the transition to |−⟩, whose width is its dephasing rate.",
      "forms": [
        {
          "id": "eq-5-37",
          "latex": "|+\\rangle \\approx |3\\rangle - \\frac{\\Omega_2^*}{\\Delta}|2\\rangle",
          "anchor": "5.1-eq-5-37"
        },
        {
          "id": "eq-5-38",
          "latex": "|-\\rangle \\approx |2\\rangle + \\frac{\\Omega_2}{\\Delta}|3\\rangle",
          "anchor": "5.1-eq-5-38"
        },
        {
          "id": "eq-5-39",
          "latex": "\\gamma_- \\approx \\gamma_{12} + \\frac{|\\Omega_2|^2}{\\Delta^2}\\gamma_{13}",
          "anchor": "5.1-eq-5-39"
        }
      ]
    },
    {
      "id": "two-photon-rabi-oscillations",
      "kind": "result",
      "section": "5.1",
      "name": "Two-photon Rabi oscillations",
      "terms": [
        "two-photon Rabi oscillations"
      ],
      "statement": "For large detunings the three-level system behaves as an effective two-level system even for strong fields Ω₁ ∼ Ω₂; since the effective Rabi frequency scales as 1/Δ and the effective decoherence as 1/Δ², a detuning can always be found at which many Rabi oscillations occur before a quantum jump.",
      "forms": [
        {
          "id": "eq-5-41",
          "latex": "\\left|\\frac{\\Omega_1\\Omega_2^*}{\\Delta}\\right|t \\gg 1",
          "anchor": "5.1-eq-5-41"
        },
        {
          "id": "eq-5-40",
          "latex": "\\frac{|\\Omega_1|^2}{\\Delta^2}\\gamma_3 t, \\frac{|\\Omega_2|^2}{\\Delta^2}\\gamma_3 t \\ll 1",
          "anchor": "5.1-eq-5-40"
        }
      ]
    },
    {
      "id": "many-excited-states-raman",
      "kind": "result",
      "section": "5.1",
      "name": "Raman coupling through many excited states",
      "statement": "With many excited states, far detuned, the eliminated system again behaves as a two-level system whose effective Rabi frequency sums the contributions of every excited state.",
      "forms": [
        {
          "id": "eq-5-42",
          "latex": "\\Omega_\\mathrm{eff} = \\sum_i \\frac{\\Omega_{1i}\\Omega_{2i}^*}{\\Delta_i}",
          "anchor": "5.1-eq-5-42"
        }
      ]
    },
    {
      "id": "doppler-free-raman",
      "kind": "result",
      "section": "5.1",
      "name": "Doppler-free two-photon resonance",
      "terms": [
        "Doppler-free"
      ],
      "statement": "A moving atom sees its detunings Doppler shifted; the two-photon detuning shifts by (k₁ − k₂)·v, almost nothing for co-propagating beams of nearly the same frequency, since the Raman process transfers momentum ℏ(k₁ − k₂).",
      "forms": [
        {
          "id": "eq-5-45",
          "latex": "\\delta \\rightarrow \\delta - (\\mathbf{k}_1 - \\mathbf{k}_2)\\cdot\\mathbf{v}",
          "anchor": "5.1-eq-5-45"
        },
        {
          "id": "eq-5-43",
          "latex": "\\Delta_1 \\rightarrow \\Delta_1 - \\mathbf{k}_1\\cdot\\mathbf{v}",
          "anchor": "5.1-eq-5-43"
        },
        {
          "id": "eq-5-44",
          "latex": "\\Delta_2 \\rightarrow \\Delta_2 - \\mathbf{k}_2\\cdot\\mathbf{v}",
          "anchor": "5.1-eq-5-44"
        }
      ]
    },
    {
      "id": "raman-phase-insensitivity",
      "kind": "idea",
      "section": "5.1",
      "name": "Phase insensitivity of the Λ system",
      "statement": "The probe response depends only on |Ω₂|², not on the relative phase of the fields, because the two-photon coherence ρ₂₁ is free to follow the phase of the optical coherences; were |1⟩ → |2⟩ dipole allowed, the relative phase would matter."
    },
    {
      "id": "cascade-two-photon-differences",
      "kind": "idea",
      "section": "5.1",
      "name": "Cascade two-photon resonances",
      "statement": "A far-detuned cascade system shows two-photon resonances too, but they are typically broader, since its final state usually decays by allowed emission, and their Doppler shifts cancel for counter-propagating beams, since both photons are absorbed."
    },
    {
      "id": "dark-resonance",
      "kind": "result",
      "section": "5.2",
      "name": "Dark resonance",
      "terms": [
        "dark resonance"
      ],
      "statement": "With Ω₂ on resonance and the probe swept, the probe absorption vanishes exactly at two-photon resonance as γ₁₂ → 0, leaving a narrow dip in a broad absorption peak, while the coherence on the forbidden transition stays finite.",
      "forms": [
        {
          "id": "eq-5-47",
          "latex": "\\mathrm{Im}[\\frac{\\rho_{31}}{\\Omega_1}] = \\frac{\\gamma_{12}}{\\gamma_{13}\\gamma_{12} + |\\Omega_2|^2} \\rightarrow 0 \\text{ as } \\gamma_{12} \\rightarrow 0",
          "anchor": "5.2-drv-dark-resonance-absorption"
        }
      ]
    },
    {
      "id": "bright-state",
      "kind": "definition",
      "section": "5.2",
      "name": "Bright state",
      "type": "state",
      "statement": "On resonance the excited state |3⟩ couples only to one superposition of the lower states, |B⟩.",
      "forms": [
        {
          "id": "eq-5-49",
          "latex": "\\hat{H}_\\mathrm{eff} = -\\frac{i\\hbar\\gamma_3}{2}|3\\rangle\\langle 3| - (\\Omega_1^*|1\\rangle + \\Omega_2^*|2\\rangle)\\langle 3| - |3\\rangle(\\Omega_1\\langle 1| + \\Omega_2\\langle 2|)",
          "anchor": "5.2-eq-5-49"
        },
        {
          "id": "eq-5-48",
          "latex": "\\hat{H}_\\mathrm{eff} = -\\frac{i\\hbar\\gamma_3}{2}|3\\rangle\\langle 3| - (\\Omega_1^*|1\\rangle\\langle 3| + \\Omega_2^*|2\\rangle\\langle 3| + h.c.)",
          "anchor": "5.2-eq-5-48"
        }
      ],
      "terms": [
        "bright state"
      ]
    },
    {
      "id": "dark-state",
      "kind": "definition",
      "section": "5.2",
      "name": "Dark state",
      "terms": [
        "dark state"
      ],
      "type": "state",
      "statement": "The superposition of the lower states orthogonal to |B⟩ is decoupled from the excited state and so insensitive to its decay: an eigenstate of the effective Hamiltonian with zero energy, with no polarization on the |1⟩ to |3⟩ transition but a finite coherence on the forbidden one.",
      "forms": [
        {
          "id": "eq-5-50",
          "latex": "|D\\rangle = \\frac{\\Omega_2|1\\rangle - \\Omega_1|2\\rangle}{\\sqrt{|\\Omega_1|^2 + |\\Omega_2|^2}}",
          "anchor": "5.2-drv-dark-state"
        },
        {
          "id": "eq-5-51",
          "latex": "\\hat{H}_\\mathrm{eff}|D\\rangle = 0",
          "anchor": "5.2-drv-dark-state"
        },
        {
          "id": "eq-5-53",
          "latex": "\\rho_{21} = -\\frac{\\Omega_2^*\\Omega_1}{|\\Omega_1|^2 + |\\Omega_2|^2}",
          "anchor": "5.2-drv-dark-state"
        }
      ]
    },
    {
      "id": "dark-state-interference",
      "kind": "idea",
      "section": "5.2",
      "name": "Dark resonance as quantum interference",
      "statement": "The vanishing absorption is a quantum interference: the excitations of |3⟩ by Ω₁ and Ω₂ interfere destructively, leaving the excited state unpopulated."
    },
    {
      "id": "eit-dressed-picture",
      "kind": "idea",
      "section": "5.2",
      "name": "Dressed-state picture of the dark resonance",
      "statement": "A strong resonant Ω₂ makes dressed states |±⟩ ∝ |2⟩ ± |3⟩ split by 2Ω₂, and the probe sees two peaks; the picture does not explain why absorption vanishes exactly halfway between them."
    },
    {
      "id": "electromagnetically-induced-transparency",
      "kind": "definition",
      "section": "5.2",
      "name": "Electromagnetically induced transparency",
      "terms": [
        "electro-magnetically induced transparency",
        "electromagnetically induced transparency",
        "slow light",
        "EIT"
      ],
      "statement": "Resonant probe light enters the medium, compresses by v_g/c and propagates slowly, dragging a spin coherence of the dark state, with almost no absorption: electromagnetically induced transparency, or slow light."
    },
    {
      "id": "slow-light",
      "kind": "result",
      "section": "5.2",
      "name": "Group velocity in the transparency window",
      "terms": [
        "group velocity"
      ],
      "statement": "Near the dark resonance the slope of the refractive index, controlled by the intensity of Ω₂, sets the group velocity, which falls toward zero as Ω₂ → 0 together with the width of the transparency window.",
      "forms": [
        {
          "id": "eq-5-56",
          "latex": "v_g \\approx \\frac{c}{1 + \\frac{\\gamma_{13}\\bar{\\nu}3\\pi(N/V)(\\lambda/2\\pi)^3}{|\\Omega_2|^2 + \\gamma_{13}\\gamma_{12}}}",
          "anchor": "5.2-drv-slow-light"
        },
        {
          "id": "eq-5-54",
          "latex": "\\mathrm{Re}[\\chi] \\propto \\mathrm{Re}[\\frac{\\rho_{31}}{\\Omega_1}] \\approx \\frac{\\delta}{|\\Omega_2|^2 + \\gamma_{12}\\gamma_{13}}",
          "anchor": "5.2-drv-dark-resonance-dispersion"
        },
        {
          "id": "eq-5-55",
          "latex": "v_g = \\frac{d\\omega}{dk} = \\frac{c}{n(\\omega) + \\omega\\frac{dn}{d\\omega}}",
          "anchor": "5.2-eq-5-55"
        },
        {
          "id": "eq-5-57",
          "latex": "\\Delta w \\approx \\frac{|\\Omega_2|^2}{\\gamma_{13}} \\rightarrow 0",
          "anchor": "5.2-eq-5-57"
        }
      ]
    },
    {
      "id": "dark-state-preparation",
      "kind": "result",
      "section": "5.2",
      "name": "Adiabatic preparation of the dark state",
      "terms": [
        "counter-intuitive pulse sequence",
        "counterintuitive"
      ],
      "statement": "The dark state is |1⟩ when only Ω₂ shines and −|2⟩ when only Ω₁ does, so a system starting in |1⟩ under Ω₂ is already dark; by slowly decreasing Ω₂ while increasing Ω₁ the atom adiabatically follows the dark state into |2⟩, free of dissipation from the excited state, in a counter-intuitive pulse sequence.",
      "forms": [
        {
          "id": "eq-5-58",
          "latex": "\\Omega_2 \\rightarrow 0, \\Omega_1 \\text{ fixed} \\quad \\Rightarrow \\quad |D\\rangle = -|2\\rangle",
          "anchor": "5.2-eq-5-58"
        },
        {
          "id": "eq-5-59",
          "latex": "\\Omega_1 \\rightarrow 0, \\Omega_2 \\text{ fixed} \\quad \\Rightarrow \\quad |D\\rangle = |1\\rangle",
          "anchor": "5.2-eq-5-59"
        }
      ]
    },
    {
      "id": "parametric-processes",
      "kind": "definition",
      "section": "5.3",
      "name": "Parametric processes",
      "terms": [
        "parametric processes",
        "nonlinear black box"
      ],
      "statement": "In parametric processes no energy is exchanged between photons and atoms; the nonlinear response of the medium, a nonlinear black box, mediates interactions between optical fields, mixing them or generating harmonics and sum and difference frequencies."
    },
    {
      "id": "sum-frequency-generation",
      "kind": "idea",
      "section": "5.3",
      "name": "Sum frequency generation",
      "terms": [
        "sum frequency generation",
        "sum-frequency generation",
        "parametric upconversion",
        "parametric up-conversion"
      ],
      "statement": "Driving a two-photon transition with fields ν₁ and ν₂ makes an atomic coherence and a polarization oscillating at the sum frequency, which radiates at ν₁ + ν₂; it needs both single- and two-photon transitions allowed, which a broken inversion symmetry such as a Stark-mixed 2s–2p level of hydrogen provides.",
      "forms": [
        {
          "id": "eq-5-60",
          "latex": "P_{\\nu_1+\\nu_2} \\propto \\mu_{12}\\mathcal{E}_1\\mathcal{E}_2",
          "anchor": "5.3-eq-5-60"
        }
      ]
    },
    {
      "id": "second-order-susceptibility",
      "kind": "definition",
      "section": "5.3",
      "name": "Second-order nonlinear susceptibility",
      "symbol": "chi_2nd",
      "terms": [
        "second order nonlinear susceptibility"
      ],
      "type": "susceptibility",
      "statement": "The nonlinear susceptibility is the constant of proportionality between the sum-frequency polarization and the product of the two applied fields; whenever it is nonzero, two fields can generate the sum frequency.",
      "forms": [
        {
          "id": "eq-5-61",
          "latex": "\\chi^{(2)} = \\frac{P_{\\nu_1+\\nu_2}}{\\epsilon_0\\mathcal{E}_1\\mathcal{E}_2}",
          "anchor": "5.3-eq-5-61"
        }
      ]
    },
    {
      "id": "cascade-nonlinear-susceptibility",
      "kind": "result",
      "section": "5.3",
      "name": "Nonlinear susceptibility of the cascade system",
      "symbol": "delta_eff",
      "terms": [
        "effective two-photon detuning"
      ],
      "type": "frequency",
      "statement": "Far detuned from the intermediate states, the cascade system is a two-level system coupled by an effective two-photon Rabi frequency, with the Stark shifts in an effective two-photon detuning δ_eff, which gives its polarization and nonlinear susceptibility in terms of the dipole moments.",
      "forms": [
        {
          "id": "eq-5-65",
          "latex": "\\chi^{(2)} = \\frac{N}{V}\\mu^*\\frac{1}{\\epsilon_0\\hbar^2}\\sum_i \\frac{\\mu_{1i}\\mu_{2i}}{\\delta_\\mathrm{eff}\\Delta_i}",
          "anchor": "5.3-drv-cascade-susceptibility"
        },
        {
          "id": "eq-5-62",
          "latex": "\\Omega_\\mathrm{eff} = \\sum_i \\frac{\\Omega_{1i}\\Omega_{2i}}{\\Delta_i} = \\sum_i \\frac{\\mu_{1i}\\mu_{2i}}{\\Delta_i\\hbar^2}\\mathcal{E}_1\\mathcal{E}_2",
          "anchor": "5.3-eq-5-62"
        },
        {
          "id": "eq-5-63",
          "latex": "\\rho_{21} = -\\frac{\\Omega_\\mathrm{eff}}{\\delta_\\mathrm{eff}}",
          "anchor": "5.3-eq-5-63"
        },
        {
          "id": "eq-5-64",
          "latex": "P_3 = \\frac{N}{V}\\mu^*\\rho_{21} = \\frac{N}{V}\\mu^*\\frac{1}{\\hbar^2}\\sum_i \\frac{\\mu_{1i}\\mu_{2i}}{\\delta_\\mathrm{eff}\\Delta_i}\\mathcal{E}_1\\mathcal{E}_2",
          "anchor": "5.3-drv-cascade-susceptibility"
        }
      ]
    },
    {
      "id": "undepleted-pump-approximation",
      "kind": "definition",
      "section": "5.3",
      "name": "Undepleted pump approximation",
      "terms": [
        "undepleted pump approximation"
      ],
      "statement": "If the generated field is weak, the two applied fields act as pumps that are not greatly depleted, and their propagation is that of a linear medium.",
      "forms": [
        {
          "id": "eq-5-67",
          "latex": "\\frac{\\partial}{\\partial z}\\mathcal{E}_{1,2} = \\frac{i\\nu_{1,2}}{2c}\\chi_{1,2}\\mathcal{E}_{1,2}",
          "anchor": "5.3-eq-5-67"
        }
      ]
    },
    {
      "id": "sum-frequency-propagation",
      "kind": "result",
      "section": "5.3",
      "name": "Propagation equations for sum frequency generation",
      "symbol": "E_env_3",
      "type": "electric-field",
      "statement": "For continuous-wave fields along z the total field is a sum of three slowly-varying amplitudes; the generated field grows from the nonlinear polarization and interacts linearly with the medium, and absorbing the linear terms leaves the pumps constant and the generated field driven with a phase mismatch.",
      "forms": [
        {
          "id": "eq-5-66",
          "latex": "\\mathcal{E} = \\mathcal{E}_1 e^{i(\\nu_1 z/c - \\nu_1 t)} + \\mathcal{E}_2 e^{i(\\nu_2 z/c - \\nu_2 t)} + \\mathcal{E}_3 e^{i(\\nu_3 z/c - \\nu_3 t)} + c.c.",
          "anchor": "5.3-eq-5-66"
        },
        {
          "id": "eq-5-68",
          "latex": "\\frac{\\partial}{\\partial z}\\mathcal{E}_3 = \\frac{i\\nu_3}{2c}\\chi^{(2)}\\mathcal{E}_1\\mathcal{E}_2 + \\frac{i\\nu_3}{2c}\\chi_3\\mathcal{E}_3",
          "anchor": "5.3-eq-5-68"
        },
        {
          "id": "eq-5-69",
          "latex": "\\chi_{1,2} \\approx \\frac{N}{V}\\frac{1}{\\epsilon_0\\hbar}\\sum_i \\frac{|\\mu_{1i,2i}|^2}{\\Delta_i}",
          "anchor": "5.3-eq-5-69"
        },
        {
          "id": "eq-5-70",
          "latex": "\\chi_3 \\approx \\frac{N}{V}\\frac{1}{\\epsilon_0\\hbar}\\frac{|\\mu_{12}|^2}{\\delta_\\mathrm{eff}}",
          "anchor": "5.3-eq-5-70"
        },
        {
          "id": "eq-5-72",
          "latex": "\\mathcal{E}_i = \\tilde{\\mathcal{E}}_i e^{i\\nu_i\\chi_i z/2c}",
          "anchor": "5.3-eq-5-72"
        },
        {
          "id": "eq-5-73",
          "latex": "\\frac{\\partial}{\\partial z}\\tilde{\\mathcal{E}}_{1,2} = 0",
          "anchor": "5.3-drv-sfg-propagation"
        },
        {
          "id": "eq-5-74",
          "latex": "\\frac{\\partial}{\\partial z}\\tilde{\\mathcal{E}}_3 = \\frac{i\\nu_3}{2c}\\chi^{(2)}\\tilde{\\mathcal{E}}_1\\tilde{\\mathcal{E}}_2 e^{i\\Delta kz}",
          "anchor": "5.3-drv-sfg-propagation"
        }
      ]
    },
    {
      "id": "wavevector-mismatch",
      "kind": "definition",
      "section": "5.3",
      "name": "Wavevector mismatch",
      "symbol": "Delta_k",
      "type": "wavevector",
      "statement": "Δk is the difference of the total wavevectors of the three fields, the most important quantity determining the growth of the generated field.",
      "forms": [
        {
          "id": "eq-5-75",
          "latex": "\\Delta k = \\frac{\\nu_1\\chi_1}{2c} + \\frac{\\nu_2\\chi_2}{2c} - \\frac{\\nu_3\\chi_3}{2c}",
          "anchor": "5.3-drv-sfg-propagation"
        }
      ]
    },
    {
      "id": "phase-matching",
      "kind": "definition",
      "section": "5.3",
      "name": "Phase-matching condition",
      "terms": [
        "phase-matching condition",
        "phase-matching",
        "phase-matched",
        "phase matching"
      ],
      "statement": "When Δk = 0 the phase velocity of the generated field matches that of the polarization, which always adds constructively, and the field grows linearly with distance; otherwise the polarization slips out of phase after about π/Δk and the field interferes destructively. Equivalently, the process conserves momentum, k₃ = k₁ + k₂, as well as energy.",
      "forms": [
        {
          "id": "eq-5-77",
          "latex": "\\tilde{\\mathcal{E}}_3(L) = \\frac{i\\nu_3}{2c}\\chi^{(2)}\\tilde{\\mathcal{E}}_1\\tilde{\\mathcal{E}}_2 L",
          "anchor": "5.3-drv-sum-frequency-output"
        },
        {
          "id": "eq-5-76",
          "latex": "\\tilde{\\mathcal{E}}_3(L) = \\int_0^L \\frac{i\\nu_3}{2c}\\chi^{(2)}\\tilde{\\mathcal{E}}_1\\tilde{\\mathcal{E}}_2 e^{i\\Delta kz} = \\left(\\frac{e^{i\\Delta kL} - 1}{i\\Delta k}\\right)\\frac{i\\nu_3}{2c}\\chi^{(2)}\\tilde{\\mathcal{E}}_1\\tilde{\\mathcal{E}}_2",
          "anchor": "5.3-drv-sum-frequency-output"
        }
      ]
    },
    {
      "id": "coherence-length",
      "kind": "definition",
      "section": "5.3",
      "name": "Coherence length",
      "terms": [
        "coherence length"
      ],
      "statement": "For distances shorter than the coherence length, ΔkL ≪ 1, the system is phase-matched and the field grows linearly; beyond it momentum conservation fails and destructive interference sets in."
    },
    {
      "id": "competing-processes",
      "kind": "idea",
      "section": "5.3",
      "name": "Competing processes",
      "terms": [
        "competing processes"
      ],
      "statement": "The linear susceptibility, absorption and beam breakup compete with nonlinear generation and frequently overwhelm it, which in large part explains why nonlinearities in practical systems are often so small."
    },
    {
      "id": "cascade-sfg-output",
      "kind": "result",
      "section": "5.3",
      "name": "Sum-frequency output without phase matching",
      "statement": "Without phase matching the generated field peaks at z = π/Δk, set by the ratio of nonlinear to linear susceptibility; the two-photon detuning drops out, and the relative amplitude is of order Ω/Δ, very small.",
      "forms": [
        {
          "id": "eq-5-78",
          "latex": "\\tilde{\\mathcal{E}}_3(\\frac{\\pi}{\\Delta k}) = -\\frac{\\nu_3}{c\\Delta k}\\chi^{(2)}\\tilde{\\mathcal{E}}_1\\tilde{\\mathcal{E}}_2",
          "anchor": "5.3-drv-maximal-sum-frequency-field"
        },
        {
          "id": "eq-5-79",
          "latex": "\\tilde{\\mathcal{E}}_3(\\frac{\\pi}{\\Delta k}) = \\frac{-1}{2}\\mu_{12}^*\\sum_i \\frac{\\mu_{1i}\\mu_{2i}}{\\delta_\\mathrm{eff}\\Delta_i} \\cdot \\frac{\\delta_\\mathrm{eff}}{\\hbar|\\mu_{12}|^2}\\tilde{\\mathcal{E}}_1\\tilde{\\mathcal{E}}_2",
          "anchor": "5.3-drv-maximal-sum-frequency-field"
        },
        {
          "id": "eq-5-80",
          "latex": "\\frac{\\mathcal{E}_3(\\pi/\\Delta k)}{\\mathcal{E}} \\sim \\sum_i \\frac{\\Omega_i}{\\Delta_i} \\ll 1",
          "anchor": "5.3-eq-5-80"
        }
      ]
    },
    {
      "id": "phase-matching-methods",
      "kind": "idea",
      "section": "5.3",
      "name": "Practical phase matching",
      "terms": [
        "angle tuning",
        "birefringence"
      ],
      "statement": "Phase matching is engineered through the linear dispersion: by mixing two gases, one for the nonlinearity and one for dispersion; by strong fields, as in EIT-like configurations that cancel the linear susceptibility; and in crystals by birefringence, temperature and angle tuning."
    },
    {
      "id": "parametric-saturation",
      "kind": "result",
      "section": "5.3",
      "name": "Saturation of the generated field",
      "statement": "Phase-matched growth cannot go on without bound: no energy is exchanged with the atoms, so the total intensity of the three fields is conserved, and the generated field saturates as it approaches the applied fields.",
      "forms": [
        {
          "id": "eq-5-81",
          "latex": "\\frac{\\partial}{\\partial z}\\left(|\\mathcal{E}_1|^2 + |\\mathcal{E}_2|^2 + |\\mathcal{E}_3|^2\\right) = 0",
          "anchor": "5.3-eq-5-81"
        }
      ]
    },
    {
      "id": "difference-frequency-generation",
      "kind": "idea",
      "section": "5.3",
      "name": "Difference frequency generation",
      "terms": [
        "difference frequency"
      ],
      "statement": "The same equations and phase-matching considerations apply to generating a lower difference frequency from a blue and a red field."
    }
  ],
