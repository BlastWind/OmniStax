   "id": "dark-state",
   "what": "the dark state",
   "source": "Modern Atomic and Optical Physics II, 5.2 Resonant excitation: Electromagnetically induced transparency, 5.2.1 The dark resonance, Physical picture of the dark resonance",
   "nodes": [
    {
     "assumes": [
      {
       "text": "The dark state is the superposition $|D\\rangle = a|1\\rangle + b|2\\rangle$ of the lower states with $\\langle D|B\\rangle = 0$.",
       "src": "5.2"
      },
      {
       "tex": "\\kHeff = -\\frac{i\\kgammathree}{2}|3\\rangle\\langle 3| - \\underbrace{(\\kOmegaone^*|1\\rangle + \\kOmegatwo^*|2\\rangle)}_{|B\\rangle}\\langle 3| - |3\\rangle\\underbrace{(\\kOmegaone\\langle 1| + \\kOmegatwo\\langle 2|)}_{\\langle B|}",
       "src": "(5.49)"
      }
     ],
     "then": {
      "tex": "\\mk{B}{\\langle B|D\\rangle} = \\mk{z}{0}",
      "uses": [0]
     },
     "steps": [
      {
       "tex": "\\mk{B}{(\\kOmegaone\\langle 1| + \\kOmegatwo\\langle 2|)(a|1\\rangle + b|2\\rangle)} = \\mk{z}{0}",
       "uses": [1]
      },
      {
       "tex": "\\mk{B}{\\kOmegaone a + \\kOmegatwo b} = \\mk{z}{0}",
       "uses": [],
       "cap": "The states $|1\\rangle$ and $|2\\rangle$ are orthonormal."
      },
      {
       "tex": "\\mk{D}{|D\\rangle} \\propto \\mk{R}{\\kOmegatwo|1\\rangle - \\kOmegaone|2\\rangle}",
       "uses": [],
       "cap": "$a = \\Omega_2$, $b = -\\Omega_1$ solves it, up to a factor."
      },
      {
       "tex": "\\mk{D}{|D\\rangle} = \\mk{R}{\\frac{\\kOmegatwo|1\\rangle - \\kOmegaone|2\\rangle}{\\sqrt{|\\kOmegaone|^2 + |\\kOmegatwo|^2}}}",
       "uses": [],
       "cap": "Normalizing: the squared norm of $\\Omega_2|1\\rangle - \\Omega_1|2\\rangle$ is $|\\Omega_1|^2 + |\\Omega_2|^2$."
      }
     ],
     "num": "(5.50)"
    },
    {
     "assumes": [
      {
       "step": 0
      },
      {
       "tex": "\\kHeff = -\\frac{i\\kgammathree}{2}|3\\rangle\\langle 3| - \\underbrace{(\\kOmegaone^*|1\\rangle + \\kOmegatwo^*|2\\rangle)}_{|B\\rangle}\\langle 3| - |3\\rangle\\underbrace{(\\kOmegaone\\langle 1| + \\kOmegatwo\\langle 2|)}_{\\langle B|}",
       "src": "(5.49)"
      },
      {
