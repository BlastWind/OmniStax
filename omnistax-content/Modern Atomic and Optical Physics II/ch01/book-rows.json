  "concepts": [
    {
      "id": "coherent-and-dissipative-dynamics",
      "kind": "idea",
      "section": "1.1",
      "name": "Coherent and dissipative dynamics on an equal footing",
      "statement": "Atomic physics is approached through a unified picture of coherent evolution and environmental decoherence and dissipation, and to understand the dynamics of the systems studied both must be treated on an equal footing."
    },
    {
      "id": "simple-quantum-systems",
      "kind": "idea",
      "section": "1.1",
      "name": "Simple systems",
      "terms": [
        "simple"
      ],
      "statement": "A theoretical understanding is built first for simple systems, those where only a few states, a few particles, or a few quanta are relevant; more complex systems are then understood by combining these building blocks."
    },
    {
      "id": "state-vector",
      "kind": "definition",
      "section": "1.2",
      "name": "State vector",
      "symbol": "psi",
      "type": "state",
      "statement": "The most complete knowledge of the system is contained in the state vector, an element of a Hilbert space, which can be expanded in any orthonormal basis.",
      "forms": [
        {
          "id": "eq-1-1",
          "latex": "|\\psi\\rangle = \\sum_n |n\\rangle\\langle n|\\psi\\rangle",
          "anchor": "1.2-eq-1-1"
        }
      ]
    },
    {
      "id": "probability-amplitude",
      "kind": "definition",
      "section": "1.2",
      "name": "Expansion coefficient",
      "symbol": "c_n",
      "type": "amplitude",
      "statement": "The projection of the state on a basis state gives the expansion coefficient of the state in that basis.",
      "forms": [
        {
          "id": "eq-cn",
          "latex": "c_n = \\langle n|\\psi\\rangle",
          "anchor": "1.2-states"
        }
      ]
    },
    {
      "id": "born-rule",
      "kind": "axiom",
      "section": "1.2",
      "name": "Probability of a basis state",
      "symbol": "P_n",
      "type": "population",
      "statement": "The probability of finding the system in a basis state is the squared modulus of its expansion coefficient.",
      "forms": [
        {
          "id": "eq-pn",
          "latex": "P_n = |c_n|^2",
          "anchor": "1.2-states"
        }
      ]
    },
    {
      "id": "superposition",
      "kind": "result",
      "section": "1.2",
      "name": "Superposition and interference",
      "statement": "For a superposition of states the probability of a basis state is the absolute value squared of the sum of amplitudes, not the sum of probabilities; the difference is the interference term.",
      "forms": [
        {
          "id": "eq-1-4",
          "latex": "P_n = \\frac{1}{2}\\left|c_n^{(1)} + c_n^{(2)}\\right|^2 \\neq \\frac{1}{2}(P_n^{(1)} + P_n^{(2)})",
          "anchor": "1.2-eq-1-4"
        }
      ]
    },
    {
      "id": "observable",
      "kind": "definition",
      "section": "1.2",
      "name": "Observable",
      "statement": "Observables are represented by Hermitian operators acting on states of the Hilbert space.",
      "forms": [
        {
          "id": "eq-1-5",
          "latex": "\\langle\\psi_1|\\hat{O}|\\psi_2\\rangle = (\\langle\\psi_2|\\hat{O}|\\psi_1\\rangle)^*",
          "anchor": "1.2-eq-1-5"
        }
      ]
    },
    {
      "id": "expectation-value",
      "kind": "definition",
      "section": "1.2",
      "name": "Expectation value",
      "statement": "The expectation value of an observable in a state is the average of its eigenvalues weighted by the probabilities of the eigenstates.",
      "forms": [
        {
          "id": "eq-1-6",
          "latex": "\\langle\\hat{O}\\rangle = \\langle\\psi|\\hat{O}|\\psi\\rangle",
          "anchor": "1.2-eq-1-6"
        },
        {
          "id": "eq-1-8",
          "latex": "\\langle\\hat{O}\\rangle = \\sum_n \\mathcal{O}_n|c_n|^2 = \\sum_n \\mathcal{O}_n p_n",
          "anchor": "1.2-eq-1-8"
        }
      ]
    },
    {
      "id": "commutator",
      "kind": "definition",
      "section": "1.2",
      "name": "Commutator",
      "statement": "Operators in general do not commute; when their commutator is nonzero they do not have the same eigenstates.",
      "forms": [
        {
          "id": "eq-1-9",
          "latex": "[\\hat{A}, \\hat{B}] = i\\hat{C}",
          "anchor": "1.2-eq-1-9"
        }
      ]
    },
    {
      "id": "heisenberg-uncertainty-principle",
      "kind": "result",
      "section": "1.2",
      "name": "Heisenberg's uncertainty principle",
      "statement": "For any two operators the product of their uncertainties is at least half the expectation value of their commutator.",
      "forms": [
        {
          "id": "eq-1-10",
          "latex": "\\Delta A \\cdot \\Delta B \\geq \\frac{1}{2}\\langle[\\hat{A}, \\hat{B}]\\rangle",
          "anchor": "1.2-eq-1-10"
        }
      ]
    },
    {
      "id": "hamiltonian",
      "kind": "definition",
      "section": "1.2",
      "name": "Hamiltonian",
      "symbol": "H",
      "type": "energy",
      "statement": "The Hamiltonian is the operator of the system's energy that generates its time evolution; its eigenstates are the stationary states."
    },
    {
      "id": "schrodinger-equation",
      "kind": "axiom",
      "section": "1.2",
      "name": "Schrodinger's equation",
      "terms": [
        "Schrodinger’s equation"
      ],
      "statement": "In Schrodinger's picture the state vector evolves in time according to Schrodinger's equation while the operators are stationary.",
      "forms": [
        {
          "id": "eq-1-11",
          "latex": "i\\hbar\\frac{d}{dt}|\\psi\\rangle = \\hat{H}|\\psi\\rangle",
          "anchor": "1.2-eq-1-11"
        }
      ]
    },
    {
      "id": "stationary-states",
      "kind": "definition",
      "section": "1.2",
      "name": "Stationary states",
      "statement": "The stationary solutions of Schrodinger's equation are the eigenstates of the Hamiltonian.",
      "forms": [
        {
          "id": "eq-stationary",
          "latex": "\\hat{H}|E_n\\rangle = E_n|E_n\\rangle",
          "anchor": "1.2-schrodinger-picture"
        }
      ]
    },
    {
      "id": "evolution-in-energy-eigenbasis",
      "kind": "result",
      "section": "1.2",
      "name": "Time evolution in the energy eigenbasis",
      "statement": "Expanded in the eigenstates of the Hamiltonian, each coefficient of a state only acquires the phase of its energy.",
      "forms": [
        {
          "id": "eq-1-12",
          "latex": "|\\psi(t)\\rangle = \\sum_n e^{-iE_nt/\\hbar}c_n|E_n\\rangle",
          "anchor": "1.2-eq-1-12"
        }
      ]
    },
    {
      "id": "time-evolution-operator",
      "kind": "definition",
      "section": "1.2",
      "name": "Time evolution operator",
      "statement": "Formally integrating the time evolution equation gives the operator that carries the initial state to the state at time t.",
      "forms": [
        {
          "id": "eq-u",
          "latex": "|\\psi(t)\\rangle = \\exp[-i\\hat{H}t/\\hbar]|\\psi(0)\\rangle = \\hat{U}(t)|\\psi(0)\\rangle",
          "anchor": "1.2-schrodinger-picture"
        }
      ]
    },
    {
      "id": "heisenberg-picture",
      "kind": "result",
      "section": "1.2",
      "name": "Heisenberg's equation of motion",
      "statement": "In Heisenberg's picture the state does not evolve; the observables depend on time and evolve according to Heisenberg's equation of motion.",
      "forms": [
        {
          "id": "eq-1-13",
          "latex": "i\\hbar\\frac{d}{dt}\\hat{O}(t) = [\\hat{O}, \\hat{H}] + i\\hbar\\frac{\\partial\\hat{O}}{\\partial t}",
          "anchor": "1.2-eq-1-13"
        }
      ]
    },
    {
      "id": "hydrogen-hamiltonian",
      "kind": "definition",
      "section": "1.3",
      "name": "Hydrogen atom Hamiltonian",
      "statement": "Hydrogen is one electron bound by the Coulomb force to a proton, with energy the electron's kinetic energy plus the Coulomb potential.",
      "forms": [
        {
          "id": "eq-1-14",
          "latex": "\\hat{H} = \\frac{\\hat{p}^2}{2m} - \\frac{e^2}{\\hat{r}}",
          "anchor": "1.3-eq-1-14"
        }
      ]
    },
    {
      "id": "hydrogen-energy-levels",
      "kind": "result",
      "section": "1.3",
      "name": "Hydrogen bound-state energies",
      "statement": "Hydrogen has an infinite set of discrete bound states with energies -R∞/n² and a continuum of unbound states with positive energy.",
      "forms": [
        {
          "id": "eq-hydrogen-en",
          "latex": "E_n = -\\frac{R_\\infty}{n^2}",
          "anchor": "1.3-hydrogen-levels"
        }
      ]
    },
    {
      "id": "rydberg-constant",
      "kind": "result",
      "section": "1.3",
      "name": "Rydberg's constant",
      "symbol": "R_inf",
      "terms": [
        "Rydberg’s constant"
      ],
      "type": "energy",
      "statement": "The binding energy of the hydrogen ground state for an infinitely heavy nucleus.",
      "forms": [
        {
          "id": "eq-1-16",
          "latex": "E_0 = -R_\\infty \\sim -\\frac{me^4}{2\\hbar^2}",
          "anchor": "1.3-drv-rydberg-estimate"
        }
      ]
    },
    {
      "id": "uncertainty-energy-estimate",
      "kind": "skill",
      "section": "1.3",
      "name": "Estimating a binding energy from the uncertainty principle",
      "statement": "Taking Heisenberg's inequality as an equality in the ground state and minimizing the resulting average energy over the size of the state estimates its binding energy.",
      "forms": [
        {
          "id": "eq-1-15",
          "latex": "E = \\frac{\\hbar^2}{2m\\Delta r^2} - \\frac{e^2}{\\Delta r}",
          "anchor": "1.3-drv-rydberg-estimate"
        }
      ]
    },
    {
      "id": "degeneracy-and-symmetry",
      "kind": "result",
      "section": "1.3",
      "name": "Degeneracy and symmetry",
      "statement": "An operator that commutes with the Hamiltonian shares its eigenvectors, and the energy does not depend on its eigenvalue: level degeneracies come from symmetries, invariance under a set of unitary transformations.",
      "forms": [
        {
          "id": "eq-1-17",
          "latex": "\\hat{A}|E_n, A_l\\rangle = A_l|E_n, A_l\\rangle",
          "anchor": "1.3-eq-1-17"
        },
        {
          "id": "eq-1-18",
          "latex": "\\hat{H}|E_n, A_l\\rangle = E_n|E_n, A_l\\rangle",
          "anchor": "1.3-eq-1-18"
        }
      ]
    },
    {
      "id": "principal-quantum-number",
      "kind": "definition",
      "section": "1.3",
      "name": "Principal quantum number",
      "statement": "The quantum number n on which alone the energies of the hydrogen atom depend; all angular momentum states l = 0, …, n−1 share it."
    },
    {
      "id": "l-degeneracy-lifting",
      "kind": "result",
      "section": "1.3",
      "name": "Lifting of the L degeneracy",
      "statement": "Deviations of the potential from 1/r, such as the screening of the nuclear charge by inner electrons, make the energy a function of both n and l, with large l states less deeply bound.",
      "forms": [
        {
          "id": "eq-enl",
          "latex": "E = E(n, l)",
          "anchor": "1.3-l-lifting"
        }
      ]
    },
    {
      "id": "rydberg-states",
      "kind": "definition",
      "section": "1.3",
      "name": "Rydberg states",
      "terms": [
        "Rydberg states"
      ],
      "statement": "Very large n states, whose reduced splitting between different l makes their spectra nearly hydrogen-like."
    },
    {
      "id": "fine-structure",
      "kind": "result",
      "section": "1.3",
      "name": "Fine structure",
      "terms": [
        "fine structure"
      ],
      "statement": "Relativistic corrections, the kinetic-energy correction, the spin-orbit term and the Darwin term, split each principal level so that different J have different energies."
    },
    {
      "id": "total-electronic-angular-momentum",
      "kind": "definition",
      "section": "1.3",
      "name": "Total electronic angular momentum",
      "symbol": "J",
      "type": "angular-momentum",
      "statement": "The sum of the orbital and spin angular momenta of the electron, whose quantum numbers label the states once spin-orbit coupling acts.",
      "forms": [
        {
          "id": "eq-j",
          "latex": "\\hat{J} = \\hat{S} + \\hat{L}",
          "anchor": "1.3-good-numbers"
        }
      ]
    },
    {
      "id": "spin-orbit-coupling",
      "kind": "result",
      "section": "1.3",
      "name": "Spin-orbit interaction",
      "terms": [
        "spin-orbit term"
      ],
      "statement": "The interaction of the electron's spin magnetic dipole with the atom's internal magnetic field, which splits the J = 3/2 and J = 1/2 levels of a P state by A.",
      "forms": [
        {
          "id": "eq-1-19",
          "latex": "V_{SL} = A\\hat{S} \\cdot \\hat{L}",
          "anchor": "1.3-eq-1-19"
        },
        {
          "id": "eq-1-22",
          "latex": "V_{SL} = A\\hat{S} \\cdot \\hat{L} = (A/2)(J^2 - L^2 - S^2)",
          "anchor": "1.3-drv-fine-structure-splitting"
        },
        {
          "id": "eq-1-23",
          "latex": "\\Delta E_{3/2} - \\Delta E_{1/2} = A",
          "anchor": "1.3-drv-fine-structure-splitting"
        }
      ]
    },
    {
      "id": "darwin-term",
      "kind": "definition",
      "section": "1.3",
      "name": "Darwin term",
      "terms": [
        "Darwin term"
      ],
      "statement": "A relativistic correction to the potential energy that acts only at the origin and so is nonzero only for L = 0 states."
    },
    {
      "id": "d1-d2-lines",
      "kind": "definition",
      "section": "1.3",
      "name": "D1 and D2 lines",
      "terms": [
        "D1 line",
        "D2 line"
      ],
      "statement": "The transitions from the sodium ground state to the P₁/₂ and P₃/₂ excited states."
    },
    {
      "id": "wavefunction-parity",
      "kind": "result",
      "section": "1.3",
      "name": "Parity of hydrogen-like wavefunctions",
      "statement": "A hydrogen-like wavefunction is a radial function times a spherical harmonic, and its parity is (−1)^l.",
      "forms": [
        {
          "id": "eq-1-24",
          "latex": "Y_{lm}(\\theta, \\phi) = P_l^m(\\cos\\theta)e^{im\\phi}",
          "anchor": "1.3-eq-1-24"
        },
        {
          "id": "eq-parity",
          "latex": "Y_{lm}(\\pi - \\theta, \\phi + \\pi) = (-1)^l Y_{lm}(\\theta, \\phi)",
          "anchor": "1.3-parity"
        }
      ]
    },
    {
      "id": "hyperfine-interaction",
      "kind": "result",
      "section": "1.3",
      "name": "Hyperfine interaction",
      "terms": [
        "hyperfine interaction"
      ],
      "statement": "The interaction of the valence electron's magnetic dipole with the nuclear spin, strongest for S states through the contact term.",
      "forms": [
        {
          "id": "eq-1-26",
          "latex": "V_{HFS} = A_{HFS}\\hat{I} \\cdot \\hat{J}",
          "anchor": "1.3-eq-1-26"
        },
        {
          "id": "eq-1-25",
          "latex": "\\mathbf{B}(\\mathbf{R}) = \\frac{\\mu_0}{4\\pi}\\left(\\frac{3\\mathbf{n}(\\mathbf{n} \\cdot \\mathbf{m}_N) - \\mathbf{m}_N}{R^3} + \\frac{8\\pi}{3}\\mathbf{m}_N\\delta(\\mathbf{R})\\right)",
          "anchor": "1.3-eq-1-25"
        }
      ]
    },
    {
      "id": "total-angular-momentum-f",
      "kind": "definition",
      "section": "1.3",
      "name": "Total angular momentum F",
      "symbol": "F",
      "type": "angular-momentum",
      "statement": "With fine and hyperfine interactions the conserved quantum number is the total angular momentum, nuclear spin plus electronic.",
      "forms": [
        {
          "id": "eq-1-27",
          "latex": "\\hat{F} = \\hat{I} + \\hat{S} + \\hat{L}",
          "anchor": "1.3-eq-1-27"
        }
      ]
    },
    {
      "id": "alkali-ground-hyperfine",
      "kind": "result",
      "section": "1.3",
      "name": "Hyperfine structure of the alkali ground state",
      "statement": "The hydrogen ground state splits into F = 0 and 1 by A_HFS/2; the ground states of ²³Na and ⁸⁷Rb into F = 1 and 2 by 3A_HFS/2."
    },
    {
      "id": "zeeman-effect",
      "kind": "result",
      "section": "1.3",
      "name": "Zeeman effect",
      "terms": [
        "Zeeman effect"
      ],
      "statement": "In a static external magnetic field the energy levels shift by the interaction of the magnetic moments with the field.",
      "forms": [
        {
          "id": "eq-1-28",
          "latex": "H = -\\mu \\cdot \\mathbf{B}",
          "anchor": "1.3-eq-1-28"
        },
        {
          "id": "eq-1-30",
          "latex": "H_Z = -\\mu_e S_Z B_Z - \\mu_N I_Z B_Z",
          "anchor": "1.3-eq-1-30"
        }
      ]
    },
    {
      "id": "bohr-magneton",
      "kind": "definition",
      "section": "1.3",
      "name": "Bohr magneton",
      "symbol": "mu_B",
      "type": "magnetic-moment",
      "statement": "The unit of atomic magnetic moment in which the electron and nuclear moments are written through their g-factors."
    },
    {
      "id": "zeeman-field-regimes",
      "kind": "idea",
      "section": "1.3",
      "name": "Strong and weak field regimes",
      "statement": "In a strong field m_S and m_I are good quantum numbers; in a weak field F and m_F are."
    },
    {
      "id": "clebsch-gordan-coefficients",
      "kind": "definition",
      "section": "1.3",
      "name": "Clebsch-Gordan coefficients",
      "terms": [
        "Clebsch-Gordon coefficients"
      ],
      "statement": "The coefficients relating the coupled basis |J, m_J⟩ to the product basis of two angular momenta.",
      "forms": [
        {
          "id": "eq-1-31",
          "latex": "|J, m_J\\rangle = \\sum_{j_1, j_2}\\langle J_1J_2j_1j_2|Jm_J\\rangle|J_1J_2j_1j_2\\rangle",
          "anchor": "1.3-eq-1-31"
        }
      ]
    },
    {
      "id": "weak-field-zeeman-shift",
      "kind": "result",
      "section": "1.3",
      "name": "Weak-field Zeeman shift",
      "statement": "At low field the Zeeman effect is a perturbation on the fine and hyperfine levels, and the shift of |F, m_F⟩ is proportional to the field.",
      "forms": [
        {
          "id": "eq-1-37",
          "latex": "\\Delta E_Z = g_F\\mu_B m_F B_z",
          "anchor": "1.3-eq-1-37"
        }
      ]
    },
    {
      "id": "lande-g-factor",
      "kind": "result",
      "section": "1.3",
      "name": "Lande g-factor",
      "statement": "The factors g_J and g_F that scale the Zeeman shift of a J or F level.",
      "forms": [
        {
          "id": "eq-1-38",
          "latex": "g_F = g_J\\frac{F(F+1) + J(J+1) - I(I+1)}{2F(F+1)}",
          "anchor": "1.3-eq-1-38"
        },
        {
          "id": "eq-1-39",
          "latex": "g_J = 1 + \\frac{J(J+1) + S(S+1) - L(L+1)}{2J(J+1)}",
          "anchor": "1.3-eq-1-39"
        }
      ]
    },
    {
      "id": "dipole-interaction",
      "kind": "axiom",
      "section": "1.3",
      "name": "Electric dipole interaction",
      "statement": "A neutral atom in an electric field develops an electric dipole moment that interacts with the field; off resonance the levels shift, near resonance transitions occur.",
      "forms": [
        {
          "id": "eq-1-40",
          "latex": "U = -\\mathbf{d} \\cdot \\mathbf{E}",
          "anchor": "1.3-eq-1-40"
        }
      ]
    },
    {
      "id": "dipole-matrix-element",
      "kind": "definition",
      "section": "1.3",
      "name": "Dipole matrix element",
      "type": "dipole",
      "statement": "Transitions between two states are possible only when the matrix element of the dipole operator between them is nonzero.",
      "forms": [
        {
          "id": "eq-1-43",
          "latex": "\\mu_{a'a} \\equiv \\langle a'|\\hat{\\mathbf{d}}|a\\rangle \\neq 0",
          "anchor": "1.3-eq-1-43"
        }
      ]
    },
    {
      "id": "selection-rules",
      "kind": "result",
      "section": "1.3",
      "name": "Selection rules",
      "terms": [
        "selection rules"
      ],
      "statement": "The restrictions on the states between which the dipole matrix element is nonzero: ΔL = ±1, ΔS = 0, ΔJ and ΔF = ±1, 0 with 0 → 0 forbidden.",
      "forms": [
        {
          "id": "eq-1-45",
          "latex": "\\Delta L = \\pm 1",
          "anchor": "1.3-eq-1-45"
        },
        {
          "id": "eq-1-47",
          "latex": "\\Delta S = 0",
          "anchor": "1.3-eq-1-47"
        },
        {
          "id": "eq-1-48",
          "latex": "\\Delta J = \\pm 1, 0",
          "anchor": "1.3-eq-1-48"
        },
        {
          "id": "eq-1-49",
          "latex": "\\Delta F = \\pm 1, 0",
          "anchor": "1.3-eq-1-49"
        }
      ]
    },
    {
      "id": "polarization-selection-rules",
      "kind": "result",
      "section": "1.3",
      "name": "Magnetic selection rules",
      "statement": "The change of the magnetic quantum number is set by the light's polarization: +1 for σ⁺, −1 for σ⁻ and 0 for ẑ light.",
      "forms": [
        {
          "id": "eq-1-58",
          "latex": "\\sigma^+ \\Rightarrow \\Delta m_L = +1",
          "anchor": "1.3-eq-1-58"
        },
        {
          "id": "eq-1-59",
          "latex": "\\sigma^- \\Rightarrow \\Delta m_L = -1",
          "anchor": "1.3-eq-1-59"
        },
        {
          "id": "eq-1-60",
          "latex": "\\hat{z} \\Rightarrow \\Delta m_L = 0",
          "anchor": "1.3-eq-1-60"
        }
      ]
    },
    {
      "id": "spherical-polarization-basis",
      "kind": "definition",
      "section": "1.3",
      "name": "Circular polarization components",
      "statement": "An electric field written as right and left circularly polarized and ẑ linearly polarized components.",
      "forms": [
        {
          "id": "eq-1-57",
          "latex": "\\hat{\\epsilon}_\\pm = \\mp(\\hat{\\epsilon}_x \\pm i\\hat{\\epsilon}_y)/\\sqrt{2}",
          "anchor": "1.3-eq-1-57"
        }
      ]
    }
  ],
