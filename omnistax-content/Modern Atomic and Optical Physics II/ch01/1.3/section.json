 "exercises": [
  {
   "id": "ex-rinf",
   "source_id": "it is a good exercize to know how to derive an expression for it from basic principles",
   "kind": "exercise",
   "bloom": "Apply",
   "place": {
    "at": "inline",
    "after": "rinf-invitation"
   },
   "cite": "estimate",
   "prompt": "Derive an expression for Rydberg’s constant $R_\\infty$ from basic principles.",
   "answer": {
    "type": "open",
    "generated_by": "source",
    "solution": "$$E_0 = -R_\\infty \\sim -\\frac{me^4}{2\\hbar^2}$$ Taking Heisenberg’s inequality as an equality in the ground state, $\\Delta p \\cdot \\Delta r \\sim \\hbar$, the average energy is $E = \\frac{\\hbar^2}{2m\\Delta r^2} - \\frac{e^2}{\\Delta r}$; minimizing it with respect to $\\Delta r$ gives $\\Delta r \\sim \\frac{\\hbar^2}{me^2}$ and the ground state energy above, which is exact for an infinitely heavy nucleus."
   }
  }
 ],
