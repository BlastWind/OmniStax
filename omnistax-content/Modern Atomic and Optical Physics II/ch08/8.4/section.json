      "tex": "\\mk{L}{\\int_0^{\\kt} d\\kt'\\sum_j|\\kg_j|^2e^{-i(\\knu_j-\\komega)(\\kt-\\kt')}\\kShat(\\kt')} \\approx \\mk{R}{\\sum_j|\\kg_j|^2\\int_0^{\\kt} d\\kt' e^{-i(\\knu_j-\\komega)(\\kt-\\kt')}\\,\\kShat(\\kt)}",
