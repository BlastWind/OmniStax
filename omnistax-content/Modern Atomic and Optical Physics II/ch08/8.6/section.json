      },
      {
       "tex": "\\mk{L}{\\frac{d}{d\\kt}\\kDeltarho} = \\mk{R}{2\\left(-\\frac{2}{9}\\kRopt\\sin^2(\\kkmag z)\\rho_{\\frac{1}{2}\\frac{1}{2}} + \\frac{2}{9}\\kRopt\\cos^2(\\kkmag z)\\rho_{-\\frac{1}{2}-\\frac{1}{2}}\\right)}",
