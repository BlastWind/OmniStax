     "then": {
      "tex": "\\mk{L}{\\frac{d}{d\\kt}\\kDeltarho} = \\mk{R}{\\frac{d}{d\\kt}\\rho_{\\frac{1}{2}\\frac{1}{2}} - \\frac{d}{d\\kt}\\rho_{-\\frac{1}{2}-\\frac{1}{2}}}",
      "uses": [2]
