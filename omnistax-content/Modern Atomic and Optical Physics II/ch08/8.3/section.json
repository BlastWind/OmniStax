      }
     ],
     "then": {
      "tex": "\\mk{S}{\\kFp + \\kFm} = \\mk{p}{\\hbar\\kkmag\\kRoptzero\\left(1 + \\frac{2\\kdelta\\kkmag\\kvz}{\\kgammaonetwo^2 + \\kdelta^2}\\right)} - \\mk{m}{\\hbar\\kkmag\\kRoptzero\\left(1 - \\frac{2\\kdelta\\kkmag\\kvz}{\\kgammaonetwo^2 + \\kdelta^2}\\right)}",
      "uses": [0, 1]
     },
     "steps": [
