 "footnotes": [
  {
   "id": "c-eta-sign",
   "kind": "correction",
   "html": "The book writes $\\frac{d}{dt}\\kpcm = -\\keta\\kpcm$ with $\\keta$ positive. By <a href=\"#eq-8-29\">Eqs. (8.29)</a>–<a href=\"#drv-friction-coefficient\">(8.30)</a> $\\keta$ has the sign of $\\kdelta$ and is negative when the beams cool ($\\kdelta < 0$), so the equation of motion is $\\frac{d}{dt}\\kpcm = \\keta\\kpcm$; here and in Eqs. (8.31)–(8.33) $\\keta$ stands for its magnitude $|\\keta|$, which is largest near $\\kdelta = -\\kgammaonetwo$."
  },
  {
   "id": "c-cooling-timescale",
   "kind": "correction",
   "html": "The book calls $\\komegaR \\sim 10$ kHz a timescale. It is the rate of cooling; the timescale for cooling is $1/\\komegaR$."
  }
 ],
 "derivations": [
  {
   "id": "doppler-force-expansion",
   "what": "the dissipative force on a slowly moving atom",
   "source": "Modern Atomic and Optical Physics II, 8.3 Doppler Cooling, Optical molasses",
   "nodes": [
    {
     "assumes": [
      {
       "text": "The atom moves slowly, $\\mathbf{k}\\cdot\\mathbf{v} \\ll \\delta, \\gamma_{12}$.",
       "src": "8.3"
      }
     ],
     "then": {
      "tex": "\\mk{F}{\\kFmag} \\approx \\mk{R}{\\hbar\\kk\\frac{2\\kgammaonetwo|\\kOmega|^2}{\\kgammaonetwo^2 + (\\kdelta - \\kk\\cdot\\kv)^2}}",
      "src": "(8.23)",
      "uses": []
     },
     "steps": [
      {
       "tex": "\\mk{F}{\\kFmag} \\approx \\mk{R}{\\hbar\\kk\\frac{2\\kgammaonetwo|\\kOmega|^2}{\\kgammaonetwo^2 + \\kdelta^2 - 2\\kdelta\\kk\\cdot\\kv}}",
       "uses": [
        0
       ],
       "cap": "To first order in $\\mathbf{k}\\cdot\\mathbf{v}$, $(\\delta - \\mathbf{k}\\cdot\\mathbf{v})^2 \\approx \\delta^2 - 2\\delta\\,\\mathbf{k}\\cdot\\mathbf{v}$."
      },
      {
       "tex": "\\mk{F}{\\kFmag} \\approx \\mk{R}{\\hbar\\kk\\frac{2\\kgammaonetwo|\\kOmega|^2}{\\kgammaonetwo^2 + \\kdelta^2}\\left(1 + \\frac{2\\kdelta\\kk\\cdot\\kv}{\\kgammaonetwo^2 + \\kdelta^2}\\right)}",
       "uses": [
        0
       ],
       "cap": "$1/(A - x) \\approx (1 + x/A)/A$ for small $x$."
      },
      {
       "tex": "\\mk{F}{\\kFmag} \\approx \\mk{R}{\\hbar\\kk\\underbrace{\\frac{2\\kgammaonetwo|\\kOmega|^2}{\\kgammaonetwo^2 + \\kdelta^2}}_{\\kRoptzero}\\left(1 + \\frac{2\\kdelta\\kk\\cdot\\kv}{\\kgammaonetwo^2 + \\kdelta^2}\\right)}",
       "uses": [],
       "cap": "Naming the optical excitation rate at zero velocity, $R^0_{opt}$."
      }
     ],
     "num": "(8.28)"
    }
   ]
  },
  {
   "id": "friction-coefficient",
   "what": "the Doppler friction coefficient",
   "source": "Modern Atomic and Optical Physics II, 8.3 Doppler Cooling, Optical molasses",
   "nodes": [
    {
     "assumes": [
      {
       "tex": "\\kFmag \\approx \\hbar\\kk\\kRoptzero\\left(1 + \\frac{2\\kdelta\\kk\\cdot\\kv}{\\kgammaonetwo^2 + \\kdelta^2}\\right),\\quad \\kRoptzero = \\frac{2\\kgammaonetwo|\\kOmega|^2}{\\kgammaonetwo^2 + \\kdelta^2}",
       "src": "(8.28)"
      },
      {
       "text": "The two beams counterpropagate along $\\pm z$, $\\mathbf{k} = \\pm k\\hat{z}$, so $\\mathbf{k}\\cdot\\mathbf{v} = \\pm kv_z$.",
