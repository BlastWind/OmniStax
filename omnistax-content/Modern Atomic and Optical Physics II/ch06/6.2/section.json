      },
      {
       "tex": "\\mk{K}{|\\kpsi(\\kt)\\rangle} = \\mk{R}{\\kaone|1\\rangle + \\katwo e^{-(\\kgamma/2+i\\kDelta)\\kt}|2\\rangle}",
