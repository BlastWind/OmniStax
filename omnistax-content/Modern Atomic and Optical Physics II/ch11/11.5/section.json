  {
   "id": "landau-critical-velocity",
   "what": "the Landau critical velocity",
   "source": "Modern Atomic and Optical Physics II, 11.5 Excitations in a Bose condensate, 11.5.1",
   "nodes": [
    {
     "assumes": [
      {
       "tex": "\\Delta \\kpcm_\\mathrm{object} = \\hbar \\kq",
       "src": "(11.157)"
