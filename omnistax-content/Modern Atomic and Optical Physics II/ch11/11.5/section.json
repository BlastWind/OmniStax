   "id": "bogoliubov-spectrum",
   "what": "the Bogoliubov dispersion relation",
   "source": "Modern Atomic and Optical Physics II, 11.5 Excitations in a Bose condensate, 11.5.1",
   "nodes": [
    {
     "assumes": [
      {
       "text": "The negative square root does not satisfy the normalization condition (11.145).",
       "src": "11.5.1"
      }
     ],
     "then": {
      "tex": "\\mk{M}{\\begin{pmatrix} \\kepsq + \\knzero\\kUzero - \\hbar\\komegaq & -\\knzero\\kUzero \\\\ -\\knzero\\kUzero & \\kepsq + \\knzero\\kUzero + \\hbar\\komegaq \\end{pmatrix}\\begin{pmatrix} u_q \\\\ v_q \\end{pmatrix}} = \\mk{z}{0}",
      "src": "(11.150)",
      "uses": []
     },
     "steps": [
      {
       "tex": "\\mk{M}{(\\kepsq + \\knzero\\kUzero - \\hbar\\komegaq)(\\kepsq + \\knzero\\kUzero + \\hbar\\komegaq) - (\\knzero\\kUzero)^2} = \\mk{z}{0}",
       "uses": [],
       "cap": "A solution with $(u_q, v_q) \\neq 0$ needs the determinant of the matrix to vanish."
      },
      {
       "tex": "\\mk{M}{(\\kepsq + \\knzero\\kUzero)^2 - (\\hbar\\komegaq)^2 - (\\knzero\\kUzero)^2} = \\mk{z}{0}",
       "uses": [],
       "cap": "A difference of squares, $(x - y)(x + y) = x^2 - y^2$."
      },
      {
       "tex": "\\mk{w}{(\\hbar\\komegaq)^2} = \\mk{M}{\\kepsq^2 + 2\\knzero\\kUzero\\kepsq}",
       "uses": []
      },
      {
       "tex": "\\mk{w}{\\hbar\\komegaq} = \\mk{M}{\\sqrt{\\kepsq^2 + 2\\knzero\\kUzero\\kepsq}}",
       "uses": [
        0
       ]
      }
     ],
     "num": "(11.151)"
    }
   ]
