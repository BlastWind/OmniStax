  {
   "id": "bogoliubov-equations",
   "what": "the Bogoliubov equations",
   "source": "Modern Atomic and Optical Physics II, 11.5 Excitations in a Bose condensate, 11.5.1",
   "nodes": [
    {
     "assumes": [
      {
       "text": "$\\kpsiGP = \\tilde{\\kpsiGP}e^{-i\\kmuchem \\kt/\\hbar}$, with $\\tilde{\\kpsiGP} \\in \\mathbb{R}$.",
       "src": "11.5.1"
      },
      {
       "tex": "\\delta\\hat{\\psi} = e^{-i\\kmuchem \\kt/\\hbar}\\sum_j\\left(u_j(r)\\hat{\\alpha}_j e^{-i\\komega_j \\kt} - v_j^*(r)\\hat{\\alpha}_j^\\dagger e^{i\\komega_j \\kt}\\right)",
       "src": "(11.144)"
      },
      {
       "text": "The coefficients for each normal mode are independent, so there is a set of equations for each mode $j$.",
       "src": "11.5.1"
      }
     ],
     "then": {
      "tex": "\\mk{Ld}{i\\hbar\\frac{\\partial}{\\partial \\kt}\\delta\\hat{\\psi}} = \\mk{Rd}{\\left(-\\frac{\\hbar^2}{2\\km}\\nabla^2 + \\kV(r)\\right)\\delta\\hat{\\psi} + \\kUzero\\delta\\hat{\\psi}^\\dagger\\kpsiGP^2 + 2\\kUzero|\\kpsiGP|^2\\delta\\hat{\\psi}}",
      "src": "(11.143)",
      "uses": []
     },
     "steps": [
      {
       "tex": "\\mk{Ld}{i\\hbar\\frac{\\partial}{\\partial \\kt}\\delta\\hat{\\psi}} = \\mk{R}{\\left(-\\frac{\\hbar^2\\nabla^2}{2\\km} + \\kV(r) + 2\\kUzero\\tilde{\\kpsiGP}^2\\right)\\delta\\hat{\\psi}} + \\mk{U}{\\kUzero\\tilde{\\kpsiGP}^2e^{-2i\\kmuchem \\kt/\\hbar}\\delta\\hat{\\psi}^\\dagger}",
       "uses": [
        0
       ],
       "map": {
        "Rd": [
         "R",
         "U"
        ]
       }
      },
      {
       "tex": "\\mk{Ld}{(\\kmuchem + \\hbar\\komega_j)u_j\\hat{\\alpha}_je^{-i\\komega_j \\kt} - (\\kmuchem - \\hbar\\komega_j)v_j^*\\hat{\\alpha}_j^\\dagger e^{i\\komega_j \\kt}} = \\mk{R}{\\left(-\\frac{\\hbar^2\\nabla^2}{2\\km} + \\kV(r) + 2\\kUzero\\tilde{\\kpsiGP}^2\\right)(u_j\\hat{\\alpha}_je^{-i\\komega_j \\kt} - v_j^*\\hat{\\alpha}_j^\\dagger e^{i\\komega_j \\kt})} + \\mk{U}{\\kUzero\\tilde{\\kpsiGP}^2(u_j^*\\hat{\\alpha}_j^\\dagger e^{i\\komega_j \\kt} - v_j\\hat{\\alpha}_je^{-i\\komega_j \\kt})}",
       "uses": [
        1,
        2
       ],
       "cap": "Mode by mode. The time derivative brings $\\mu + \\hbar\\omega_j$ and $\\mu - \\hbar\\omega_j$ down from the two exponentials, $\\delta\\hat{\\psi}^\\dagger$ carries $e^{i\\mu t/\\hbar}$, and the common factor $e^{-i\\mu t/\\hbar}$ cancels."
      }
     ]
    },
    {
     "assumes": [
      {
       "step": 0
      }
     ],
     "then": {
      "tex": "\\mk{Ld}{(\\kmuchem + \\hbar\\komega_j)u_j\\hat{\\alpha}_je^{-i\\komega_j \\kt} - (\\kmuchem - \\hbar\\komega_j)v_j^*\\hat{\\alpha}_j^\\dagger e^{i\\komega_j \\kt}} = \\mk{R}{\\left(-\\frac{\\hbar^2\\nabla^2}{2\\km} + \\kV(r) + 2\\kUzero\\tilde{\\kpsiGP}^2\\right)(u_j\\hat{\\alpha}_je^{-i\\komega_j \\kt} - v_j^*\\hat{\\alpha}_j^\\dagger e^{i\\komega_j \\kt})} + \\mk{U}{\\kUzero\\tilde{\\kpsiGP}^2(u_j^*\\hat{\\alpha}_j^\\dagger e^{i\\komega_j \\kt} - v_j\\hat{\\alpha}_je^{-i\\komega_j \\kt})}",
      "uses": []
     },
     "steps": [
      {
       "tex": "\\mk{Ld}{(\\kmuchem + \\hbar\\komega_j)u_j} = \\mk{R}{\\left(-\\frac{\\hbar^2\\nabla^2}{2\\km} + \\kV(r) + 2\\kUzero\\tilde{\\kpsiGP}^2\\right)u_j}\\mk{U}{ - \\kUzero\\tilde{\\kpsiGP}^2v_j}",
       "uses": [],
       "cap": "Equating the terms $\\propto e^{-i\\omega_j t}$."
      },
      {
       "tex": "\\mk{R}{\\left(-\\kmuchem - \\hbar\\komega_j - \\frac{\\hbar^2\\nabla^2}{2\\km} + \\kV(r) + 2\\kUzero\\tilde{\\kpsiGP}^2\\right)u_j(r)} = \\mk{U}{\\kUzero\\tilde{\\kpsiGP}^2 v_j(r)}",
       "uses": [],
       "map": {
        "Ld": "R"
       }
      }
     ],
     "num": "(11.146)"
    },
    {
     "assumes": [
      {
       "step": 0
      },
      {
       "text": "The operator $-\\hbar^2\\nabla^2/2m + V(r)$ is real, as is $\\tilde{\\kpsiGP}$.",
       "src": "11.5.1"
      }
     ],
     "then": {
      "tex": "\\mk{Ld}{(\\kmuchem + \\hbar\\komega_j)u_j\\hat{\\alpha}_je^{-i\\komega_j \\kt} - (\\kmuchem - \\hbar\\komega_j)v_j^*\\hat{\\alpha}_j^\\dagger e^{i\\komega_j \\kt}} = \\mk{R}{\\left(-\\frac{\\hbar^2\\nabla^2}{2\\km} + \\kV(r) + 2\\kUzero\\tilde{\\kpsiGP}^2\\right)(u_j\\hat{\\alpha}_je^{-i\\komega_j \\kt} - v_j^*\\hat{\\alpha}_j^\\dagger e^{i\\komega_j \\kt})} + \\mk{U}{\\kUzero\\tilde{\\kpsiGP}^2(u_j^*\\hat{\\alpha}_j^\\dagger e^{i\\komega_j \\kt} - v_j\\hat{\\alpha}_je^{-i\\komega_j \\kt})}",
      "uses": []
     },
     "steps": [
      {
       "tex": "\\mk{Ld}{-(\\kmuchem - \\hbar\\komega_j)v_j^*} = \\mk{R}{-\\left(-\\frac{\\hbar^2\\nabla^2}{2\\km} + \\kV(r) + 2\\kUzero\\tilde{\\kpsiGP}^2\\right)v_j^*} + \\mk{U}{\\kUzero\\tilde{\\kpsiGP}^2u_j^*}",
       "uses": [],
       "cap": "Equating the terms $\\propto e^{i\\omega_j t}$."
      },
      {
       "tex": "\\mk{R}{\\left(-\\kmuchem + \\hbar\\komega_j - \\frac{\\hbar^2\\nabla^2}{2\\km} + \\kV(r) + 2\\kUzero\\tilde{\\kpsiGP}^2\\right)v_j^*} = \\mk{U}{\\kUzero\\tilde{\\kpsiGP}^2 u_j^*}",
       "uses": [],
       "map": {
        "Ld": "R"
       }
      },
      {
       "tex": "\\mk{R}{\\left(-\\kmuchem + \\hbar\\komega_j - \\frac{\\hbar^2\\nabla^2}{2\\km} + \\kV(r) + 2\\kUzero\\tilde{\\kpsiGP}^2\\right)v_j(r)} = \\mk{U}{\\kUzero\\tilde{\\kpsiGP}^2 u_j(r)}",
       "uses": [
        1
       ],
       "cap": "Taking the complex conjugate."
      }
     ],
     "num": "(11.147)"
    }
   ]
