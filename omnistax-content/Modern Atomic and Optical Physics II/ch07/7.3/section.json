       "tex": "\\mk{P}{|\\Phi_2\\rangle} = \\mk{S}{\\sin\\kphi|3\\rangle - \\cos\\kphi|4\\rangle},\\quad \\mk{t}{\\tan\\kphi} = \\mk{v}{\\frac{\\kOmegafour}{\\kOmegathree}}",
