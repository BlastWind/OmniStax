  "statements": {
    "catalyst": "A catalyst is a substance that increases the rate of a reaction without itself being consumed by the reaction."
  },
  "new": [
    {
      "id": "average-rate",
      "kind": "definition",
      "section": "12.1",
      "name": "Average rate",
      "statement": "The average rate of a reaction is the change in the amount or concentration of a reactant or product divided by the time interval over which it was measured.",
      "introduces": null,
      "prereqs": [
        "reaction-rate",
        "time"
      ]
    },
    {
      "id": "instantaneous-rate",
      "kind": "definition",
      "section": "12.1",
      "name": "Instantaneous rate",
      "statement": "The instantaneous rate of a reaction is its rate at one instant, the slope of the line tangent to the graph of concentration against time at that instant.",
      "introduces": null,
      "prereqs": [
        "average-rate"
      ]
    },
    {
      "id": "initial-rate",
      "kind": "definition",
      "section": "12.1",
      "name": "Initial rate",
      "statement": "The initial rate of a reaction is its instantaneous rate at t = 0 s, immediately after the reaction has begun.",
      "introduces": null,
      "prereqs": [
        "instantaneous-rate"
      ]
    },
    {
      "id": "rate-expression",
      "kind": "definition",
      "section": "12.1",
      "name": "Rate expression",
      "statement": "A rate expression is a mathematical representation that defines the rate of a reaction as the change in the amount, concentration or pressure of a reactant or product per unit time.",
      "introduces": null,
      "prereqs": [
        "reaction-rate"
      ]
    },
    {
      "id": "overall-reaction-order",
      "kind": "definition",
      "section": "12.3",
      "name": "Overall reaction order",
      "statement": "The overall reaction order is the sum of the reaction orders of all the substances that appear in the rate law.",
      "introduces": null,
      "prereqs": [
        "reaction-order"
      ]
    },
    {
      "id": "initial-rates-method",
      "kind": "idea",
      "section": "12.3",
      "name": "The method of initial rates",
      "statement": "The method of initial rates is a common experimental approach to determining a rate law: the initial rate of a reaction is measured in trials with varying initial concentrations of its reactants.",
      "introduces": null,
      "prereqs": [
        "initial-rate",
        "rate-law"
      ]
    },
    {
      "id": "activated-complex",
      "kind": "definition",
      "section": "12.5",
      "name": "Activated complex",
      "statement": "An activated complex, or transition state, is the unstable combination of reactant species formed during a reaction at the highest energy along its path.",
      "introduces": null,
      "prereqs": [
        "collision-theory"
      ]
    },
    {
      "id": "frequency-factor",
      "kind": "definition",
      "section": "12.5",
      "name": "Frequency factor, $A$",
      "statement": "The frequency factor is the proportionality constant in the Arrhenius equation, related to the relative number of collisions that have an orientation capable of leading to product formation.",
      "introduces": null,
      "prereqs": [
        "collision-orientation"
      ]
    },
    {
      "id": "reaction-energy-diagram",
      "kind": "definition",
      "section": "12.5",
      "name": "Reaction diagram",
      "statement": "A reaction diagram is a graph used in chemical kinetics to show how the energy of a reacting system changes as the reaction proceeds from reactants to products.",
      "introduces": null,
      "prereqs": [
        "activation-energy",
        "enthalpy-change"
      ]
    },
    {
      "id": "elementary-reaction",
      "kind": "definition",
      "section": "12.6",
      "name": "Elementary reaction",
      "statement": "An elementary reaction is a reaction that takes place in a single step, precisely as depicted in its chemical equation.",
      "introduces": null,
      "prereqs": [
        "chemical-equation"
      ]
    },
    {
      "id": "reaction-intermediate",
      "kind": "definition",
      "section": "12.6",
      "name": "Intermediate",
      "statement": "An intermediate is a species produced in one step of a reaction mechanism and consumed in a later step.",
      "introduces": null,
      "prereqs": [
        "reaction-mechanism"
      ]
    },
    {
      "id": "unimolecular-reaction",
      "kind": "definition",
      "section": "12.6",
      "name": "Unimolecular reaction",
      "statement": "A unimolecular reaction is an elementary reaction involving a single reactant entity.",
      "introduces": null,
      "prereqs": [
        "molecularity"
      ]
    },
    {
      "id": "bimolecular-reaction",
      "kind": "definition",
      "section": "12.6",
      "name": "Bimolecular reaction",
      "statement": "A bimolecular reaction is an elementary reaction involving two reactant entities.",
      "introduces": null,
      "prereqs": [
        "molecularity"
      ]
    },
    {
      "id": "termolecular-reaction",
      "kind": "definition",
      "section": "12.6",
      "name": "Termolecular reaction",
      "statement": "A termolecular reaction is an elementary reaction involving three reactant entities.",
      "introduces": null,
      "prereqs": [
        "molecularity"
      ]
    }
  ],
