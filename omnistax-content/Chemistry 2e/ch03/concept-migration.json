  "statements": {
    "formula-mass": "You calculate the formula mass of a substance by multiplying each element’s average atomic mass by its subscript and adding the products."
  },
  "new": [
    {
      "id": "empirical-formula-mass",
      "kind": "definition",
      "section": "3.2",
      "name": "Empirical formula mass",
      "statement": "The empirical formula mass of a compound is the sum of the average atomic masses of all the atoms its empirical formula represents.",
      "introduces": "molecular",
      "prereqs": [
        "formula-mass-of-a-substance",
        "empirical-formula-of-a-compound"
      ]
    },
    {
      "id": "formula-mass-of-a-substance",
      "kind": "definition",
      "section": "3.1",
      "name": "Formula mass",
      "statement": "The formula mass of a substance is the sum of the average masses of all the atoms represented in its chemical formula; for a covalent compound it is also the molecular mass.",
      "introduces": "formula-mass",
      "prereqs": [
        "average-atomic-mass",
        "molecular-formula"
      ]
    },
    {
      "id": "solvent",
      "kind": "definition",
      "section": "3.3",
      "name": "Solvent",
      "statement": "The solvent is the component of a solution present at a concentration higher than that of the other components.",
      "introduces": "solutions",
      "prereqs": [
        "solution-components",
        "homogeneous-mixture"
      ]
    },
    {
      "id": "solute",
      "kind": "definition",
      "section": "3.3",
      "name": "Solute",
      "statement": "A solute is a component of a solution present at a concentration less than that of the solvent.",
      "introduces": "solutions",
      "prereqs": [
        "solvent"
      ]
    },
    {
      "id": "aqueous-solution",
      "kind": "definition",
      "section": "3.3",
      "name": "Aqueous solution",
      "statement": "An aqueous solution is a solution for which water is the solvent.",
      "introduces": "solutions",
      "prereqs": [
        "solvent"
      ]
    },
    {
      "id": "dissolved",
      "kind": "definition",
      "section": "3.3",
      "name": "Dissolved",
      "statement": "A solute is dissolved when its components are dispersed in a solvent.",
      "introduces": "solutions",
      "prereqs": [
        "solute",
        "solvent"
      ]
    },
    {
      "id": "concentrated",
      "kind": "definition",
      "section": "3.3",
      "name": "Concentrated",
      "statement": "A concentrated solution is one containing solute at a relatively high concentration; the term is qualitative.",
      "introduces": "solutions",
      "prereqs": [
        "concentration"
      ]
    },
    {
      "id": "dilute",
      "kind": "definition",
      "section": "3.3",
      "name": "Dilute",
      "statement": "A dilute solution is one containing solute at a relatively low concentration; the term is qualitative.",
      "introduces": "solutions",
      "prereqs": [
        "concentration"
      ]
    },
    {
      "id": "parts-per-million",
      "kind": "definition",
      "section": "3.4",
      "name": "Parts per million, ppm",
      "statement": "Parts per million (ppm) is the ratio of solute-to-solution mass multiplied by 10⁶.",
      "introduces": "ppm-ppb",
      "prereqs": [
        "ppm-and-ppb"
      ]
    },
    {
      "id": "parts-per-billion",
      "kind": "definition",
      "section": "3.4",
      "name": "Parts per billion, ppb",
      "statement": "Parts per billion (ppb) is the ratio of solute-to-solution mass multiplied by 10⁹.",
      "introduces": "ppm-ppb",
      "prereqs": [
        "ppm-and-ppb"
      ]
    }
  ],
