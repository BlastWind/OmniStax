    {
      "id": "law-of-mass-action",
      "kind": "axiom",
      "section": "13.2",
      "name": "The law of mass action",
      "statement": "At a given temperature, the reaction quotient for a system at equilibrium is constant, whatever the initial concentrations from which equilibrium was approached.",
      "introduces": null,
      "prereqs": [
        "reaction-quotient",
        "chemical-equilibrium"
      ]
    },
    {
      "id": "homogeneous-equilibrium",
      "kind": "definition",
      "section": "13.2",
      "name": "Homogeneous equilibrium",
      "statement": "A homogeneous equilibrium is one in which all reactants and products, and any catalysts, are present in the same phase.",
      "introduces": null,
