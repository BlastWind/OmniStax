  "statements": {},
  "new": [
    {
      "id": "alpha-particle",
      "kind": "definition",
      "section": "2.2",
      "name": "Alpha particle, α",
      "statement": "An alpha particle is a positively charged particle consisting of two protons and two neutrons.",
      "introduces": "gold-foil",
      "prereqs": [
        "subatomic-particles"
      ]
    },
    {
      "id": "nucleus",
      "kind": "definition",
      "section": "2.2",
      "name": "Nucleus",
      "statement": "The nucleus is the massive, positively charged center of an atom, made up of protons and neutrons.",
      "introduces": "nucleus",
      "prereqs": [
        "nuclear-model-of-the-atom",
        "subatomic-particles"
      ]
    },
    {
      "id": "periodic-table",
      "kind": "definition",
      "section": "2.5",
      "name": "The periodic table",
      "statement": "The periodic table is a table of the elements that places elements with similar chemical properties close together.",
      "introduces": "grouping-elements",
      "prereqs": [
        "elements-and-compounds"
      ]
    },
    {
      "id": "hydrate",
      "kind": "definition",
      "section": "2.7",
      "name": "Hydrate",
      "statement": "A hydrate is a compound containing one or more water molecules bound within its crystals, written with a dot between the formula of the anhydrous compound and the number of water molecules per formula unit.",
      "introduces": "hydrates",
      "prereqs": [
        "ionic-compounds"
      ]
    },
    {
      "id": "nomenclature",
      "kind": "definition",
      "section": "2.7",
      "name": "Nomenclature",
      "statement": "Nomenclature is a system of rules for naming objects of interest, and chemical nomenclature gives every compound a name from which its formula can be written.",
      "introduces": "nomenclature",
      "prereqs": []
    },
    {
      "id": "binary-compound",
      "kind": "definition",
      "section": "2.7",
      "name": "Binary compound",
      "statement": "A binary compound is a compound containing two different elements.",
      "introduces": "molecular-compounds",
      "prereqs": [
        "elements-and-compounds"
      ]
    },
    {
      "id": "binary-acid",
      "kind": "definition",
      "section": "2.7",
      "name": "Binary acid",
      "statement": "A binary acid is a compound of hydrogen and one other element, bonded so that it releases H⁺ ions when dissolved in water.",
      "introduces": "binary-acids",
      "prereqs": [
        "binary-compound"
      ]
    },
    {
      "id": "oxyacid",
      "kind": "definition",
      "section": "2.7",
      "name": "Oxyacid",
      "statement": "An oxyacid is a compound of hydrogen, oxygen and one other element, bonded so that it releases H⁺ ions when dissolved in water.",
      "introduces": "oxyacids",
      "prereqs": [
        "polyatomic-ions"
      ]
    },
    {
      "id": "electron",
      "kind": "definition",
      "section": "2.2",
      "name": "Electron",
      "statement": "An electron is a negatively charged subatomic particle of relatively low mass located outside the nucleus.",
      "introduces": "cathode-ray",
      "prereqs": [
        "subatomic-particles",
        "discovery-of-the-electron"
      ]
    },
    {
      "id": "proton",
      "kind": "definition",
      "section": "2.2",
      "name": "Proton",
      "statement": "A proton is a positively charged subatomic particle located in the nucleus.",
      "introduces": "nucleus",
      "prereqs": [
        "subatomic-particles",
        "nucleus"
      ]
    },
    {
      "id": "neutron",
      "kind": "definition",
      "section": "2.2",
      "name": "Neutron",
      "statement": "A neutron is an uncharged subatomic particle located in the nucleus.",
      "introduces": "neutron",
      "prereqs": [
        "subatomic-particles",
        "nucleus"
      ]
    },
    {
      "id": "ion",
      "kind": "definition",
      "section": "2.3",
      "name": "Ion",
      "statement": "An ion is an electrically charged atom or molecule, one that contains unequal numbers of protons and electrons.",
      "introduces": "ions",
      "prereqs": [
        "ions-and-atomic-charge"
      ]
    },
    {
      "id": "cation",
      "kind": "definition",
      "section": "2.3",
      "name": "Cation",
      "statement": "A cation is a positively charged atom or molecule, one that contains fewer electrons than protons.",
      "introduces": "ions",
      "prereqs": [
        "ion"
      ]
    },
    {
      "id": "anion",
      "kind": "definition",
      "section": "2.3",
      "name": "Anion",
      "statement": "An anion is a negatively charged atom or molecule, one that contains more electrons than protons.",
      "introduces": "ions",
      "prereqs": [
        "ion"
      ]
    },
    {
      "id": "atomic-number",
      "kind": "definition",
      "section": "2.3",
      "name": "Atomic number, $Z$",
      "statement": "The atomic number (Z) of an atom is the number of protons in its nucleus.",
      "introduces": "atomic-number",
      "prereqs": [
        "atomic-number-and-mass-number",
        "proton"
      ]
    },
    {
      "id": "mass-number",
      "kind": "definition",
      "section": "2.3",
      "name": "Mass number, $A$",
      "statement": "The mass number (A) of an atom is the sum of the numbers of neutrons and protons in its nucleus.",
      "introduces": "atomic-number",
      "prereqs": [
        "atomic-number-and-mass-number",
        "proton",
        "neutron"
      ]
    },
    {
      "id": "empirical-formula-of-a-compound",
      "kind": "definition",
      "section": "2.4",
      "name": "Empirical formula",
      "statement": "An empirical formula shows the composition of a compound as the simplest whole-number ratio of its atoms.",
      "introduces": "empirical-formula",
      "prereqs": [
        "molecular-formula"
      ]
    },
    {
      "id": "structural-formula",
      "kind": "definition",
      "section": "2.4",
      "name": "Structural formula",
      "statement": "A structural formula shows the atoms in a molecule and how they are connected.",
      "introduces": "molecular-formula",
      "prereqs": [
        "structural-formulas-and-models"
      ]
    },
    {
      "id": "structural-isomer",
      "kind": "definition",
      "section": "2.4",
      "name": "Structural isomer",
      "statement": "Structural isomers are substances that have the same molecular formula but different physical and chemical properties because their atoms are bonded differently.",
      "introduces": "isomers",
      "prereqs": [
        "isomers"
      ]
    },
    {
      "id": "spatial-isomer",
      "kind": "definition",
      "section": "2.4",
      "name": "Spatial isomers",
      "statement": "Spatial isomers are compounds in which the relative orientations of the atoms in space differ.",
      "introduces": "spatial-isomers",
      "prereqs": [
        "isomers"
      ]
    },
    {
      "id": "group-of-the-periodic-table",
      "kind": "definition",
      "section": "2.5",
      "name": "Group",
      "statement": "A group is a vertical column of the periodic table.",
      "introduces": "modern-table",
      "prereqs": [
        "periods-and-groups",
        "periodic-table"
      ]
    },
    {
      "id": "period-of-the-periodic-table",
      "kind": "definition",
      "section": "2.5",
      "name": "Period",
      "statement": "A period, also called a series, is a horizontal row of the periodic table.",
      "introduces": "modern-table",
      "prereqs": [
        "periods-and-groups",
        "periodic-table"
      ]
    },
    {
      "id": "metal",
      "kind": "definition",
      "section": "2.5",
      "name": "Metal",
      "statement": "A metal is an element that is shiny, malleable, and a good conductor of heat and electricity.",
      "introduces": "metals-nonmetals",
      "prereqs": [
        "metals-nonmetals-metalloids"
      ]
    },
    {
      "id": "nonmetal",
      "kind": "definition",
      "section": "2.5",
      "name": "Nonmetal",
      "statement": "A nonmetal is an element that appears dull and is a poor conductor of heat and electricity.",
      "introduces": "metals-nonmetals",
      "prereqs": [
        "metals-nonmetals-metalloids"
      ]
    },
    {
      "id": "metalloid",
      "kind": "definition",
      "section": "2.5",
      "name": "Metalloid",
      "statement": "A metalloid is an element that conducts heat and electricity moderately well and has some properties of metals and some of nonmetals.",
      "introduces": "metals-nonmetals",
      "prereqs": [
        "metals-nonmetals-metalloids"
      ]
    },
    {
      "id": "main-group-element",
      "kind": "definition",
      "section": "2.5",
      "name": "Main-group element",
      "statement": "A main-group element, also called a representative element, is an element in groups 1, 2, and 13–18.",
      "introduces": "element-families",
      "prereqs": [
        "element-families"
      ]
    },
    {
      "id": "transition-metal",
      "kind": "definition",
      "section": "2.5",
      "name": "Transition metal",
      "statement": "A transition metal is an element in groups 3–12 (more strictly, 3–11).",
      "introduces": "element-families",
      "prereqs": [
        "element-families"
      ]
    },
    {
      "id": "inner-transition-metal",
      "kind": "definition",
      "section": "2.5",
      "name": "Inner transition metal",
      "statement": "An inner transition metal is an element in the bottom two rows of the periodic table; those of the first row are lanthanides and those of the second actinides.",
      "introduces": "element-families",
      "prereqs": [
        "element-families"
      ]
    },
    {
      "id": "lanthanide",
      "kind": "definition",
      "section": "2.5",
      "name": "Lanthanide",
      "statement": "A lanthanide is an inner transition metal in the top of the bottom two rows of the periodic table.",
      "introduces": "element-families",
      "prereqs": [
        "inner-transition-metal"
      ]
    },
    {
      "id": "actinide",
      "kind": "definition",
      "section": "2.5",
      "name": "Actinide",
      "statement": "An actinide is an inner transition metal in the bottom of the bottom two rows of the periodic table.",
      "introduces": "element-families",
      "prereqs": [
        "inner-transition-metal"
      ]
    },
    {
      "id": "alkali-metal",
      "kind": "definition",
      "section": "2.5",
      "name": "Alkali metal",
      "statement": "An alkali metal is an element in group 1.",
      "introduces": "element-families",
      "prereqs": [
        "element-families"
      ]
    },
    {
      "id": "alkaline-earth-metal",
      "kind": "definition",
      "section": "2.5",
      "name": "Alkaline earth metal",
      "statement": "An alkaline earth metal is an element in group 2.",
      "introduces": "element-families",
      "prereqs": [
        "element-families"
      ]
    },
    {
      "id": "pnictogen",
      "kind": "definition",
      "section": "2.5",
      "name": "Pnictogen",
      "statement": "A pnictogen is an element in group 15.",
      "introduces": "element-families",
      "prereqs": [
        "element-families"
      ]
    },
    {
      "id": "chalcogen",
      "kind": "definition",
      "section": "2.5",
      "name": "Chalcogen",
      "statement": "A chalcogen is an element in group 16.",
      "introduces": "element-families",
      "prereqs": [
        "element-families"
      ]
    },
    {
      "id": "halogen",
      "kind": "definition",
      "section": "2.5",
      "name": "Halogen",
      "statement": "A halogen is an element in group 17.",
      "introduces": "element-families",
      "prereqs": [
        "element-families"
      ]
    },
    {
      "id": "noble-gas",
      "kind": "definition",
      "section": "2.5",
      "name": "Noble gas",
      "statement": "A noble gas, also called an inert gas, is an element in group 18.",
      "introduces": "element-families",
      "prereqs": [
        "element-families"
      ]
    },
    {
      "id": "monatomic-ion",
      "kind": "definition",
      "section": "2.6",
      "name": "Monatomic ion",
      "statement": "A monatomic ion is an ion composed of a single atom.",
      "introduces": "ions",
      "prereqs": [
        "ion"
      ]
    },
    {
      "id": "oxyanion",
      "kind": "definition",
      "section": "2.6",
      "name": "Oxyanion",
      "statement": "An oxyanion is a polyatomic anion composed of a central atom bonded to oxygen atoms.",
      "introduces": "polyatomic-ions",
      "prereqs": [
        "polyatomic-ions"
      ]
    },
    {
      "id": "covalent-bond",
      "kind": "definition",
      "section": "2.6",
      "name": "Covalent bond",
      "statement": "A covalent bond is a bond formed when electrons are shared between atoms.",
      "introduces": "bonds",
      "prereqs": [
        "ionic-and-covalent-bonds",
        "electron"
      ]
    }
  ],
