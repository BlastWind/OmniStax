      "section": "15.1",
      "name": "Molar solubility",
      "statement": "The molar solubility of a compound is its solubility expressed in moles of solute per liter of saturated solution.",
      "introduces": null,
      "prereqs": [
        "solubility",
        "molarity"
      ]
    },
    {
      "id": "complex-ion",
      "kind": "definition",
      "section": "15.2",
      "name": "Complex ion",
      "statement": "A complex ion is an ion consisting of a central atom, typically a transition metal cation, surrounded by molecules or ions called ligands.",
      "introduces": null,
      "prereqs": [
        "complex-ions-and-ligands",
        "lewis-acid"
      ]
    },
    {
      "id": "ligand",
      "kind": "definition",
      "section": "15.2",
      "name": "Ligand",
      "statement": "A ligand is a molecule or ion that surrounds the central atom of a complex ion, bonding to it by donating an electron pair as a Lewis base.",
      "introduces": null,
      "prereqs": [
        "complex-ions-and-ligands",
        "lewis-base"
      ]
    },
    {
      "id": "dissociation-constant",
      "kind": "definition",
      "section": "15.2",
      "name": "Dissociation constant, $K_{\\text{d}}$",
      "statement": "The dissociation constant, $K_{\\text{d}}$, is the equilibrium constant for the decomposition of a complex ion into its components in solution; it is the reciprocal of the formation constant.",
      "introduces": null,
      "prereqs": [
        "formation-constant",
        "equilibrium-constant"
      ]
    },
    {
      "id": "lewis-acid",
      "kind": "definition",
      "section": "15.2",
      "name": "Lewis acid",
      "statement": "A Lewis acid is any species that can accept a pair of electrons and form a coordinate covalent bond.",
      "introduces": null,
      "prereqs": [
        "lewis-acids-and-bases",
        "coordinate-covalent-bond"
      ]
    },
    {
      "id": "lewis-base",
      "kind": "definition",
      "section": "15.2",
      "name": "Lewis base",
      "statement": "A Lewis base is any species that can donate a pair of electrons and form a coordinate covalent bond.",
      "introduces": null,
      "prereqs": [
        "lewis-acids-and-bases",
        "coordinate-covalent-bond"
      ]
    },
    {
      "id": "lewis-acid-base-adduct",
      "kind": "definition",
      "section": "15.2",
      "name": "Lewis acid-base adduct",
      "statement": "A Lewis acid-base adduct is the compound or ion that contains the coordinate covalent bond formed between a Lewis acid and a Lewis base.",
      "introduces": null,
      "prereqs": [
        "lewis-acid",
        "lewis-base"
      ]
    }
