      {
       "text": "$\\sin^2 x + \\cos^2 x = 1$.",
       "src": "Calculus, 1.3 Trigonometric Functions"
      }
     ],
     "then": {
      "tex": "\\mk{a}{\\kuoneprime \\cos x} + \\mk{b}{\\kutwoprime \\sin x} = \\mk{z}{0} , \\qquad \\mk{c}{-\\kuoneprime \\sin x} + \\mk{d}{\\kutwoprime \\cos x} = \\mk{f}{\\tan x}",
