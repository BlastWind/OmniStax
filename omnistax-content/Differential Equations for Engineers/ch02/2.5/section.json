       "uses": []
      },
      {
       "tex": "\\mk{a}{\\kuoneprime \\cos x \\sin x} + \\mk{b}{\\kutwoprime \\sin^2 x} = \\mk{z}{0} , \\qquad \\mk{c}{-\\kuoneprime \\sin x \\cos x} + \\mk{d}{\\kutwoprime \\cos^2 x} = \\mk{f}{\\sin x}",
       "uses": [],
       "cap": "$\\tan x \\cos x = \\sin x$, since $\\tan x = \\sin x / \\cos x$."
      },
      {
       "tex": "\\mk{d}{\\kutwoprime \\bigl(\\sin^2 x + \\cos^2 x\\bigr)} = \\mk{f}{\\sin x}",
