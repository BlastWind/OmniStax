 "exercises": [
  {
   "id": "e1",
   "source_id": "7.1.1",
   "source_number": "7.1.1",
   "kind": "exercise",
   "bloom": "Apply",
   "place": {
    "at": "end"
   },
   "cite": "thm-7-1-2",
   "prompt": "<p>Is $\\displaystyle \\sum_{k=0}^\\infty e^k x^k$ a convergent power series? If so, find the radius of convergence.</p>",
   "answer": {
    "type": "number",
    "generated_by": "ai",
    "value": 0.3679,
    "tol": 0.01,
    "solution": "Yes, with radius of convergence $\\rho = 1/e \\approx 0.3679$. Here $\\ka_k = e^k$ and $x_0 = 0$, so $A = \\lim_{k\\to\\infty} \\left\\lvert \\frac{\\ka_{k+1}}{\\ka_k} \\right\\rvert = \\lim_{k\\to\\infty} \\frac{e^{k+1}}{e^k} = e$. Since $A$ is finite and not zero, Theorem 7.1.2 gives $\\rho = 1/A = 1/e$: the series converges absolutely for $\\lvert x \\rvert &lt; 1/e$ and diverges for $\\lvert x \\rvert &gt; 1/e$, so it is a convergent power series."
   }
  },
  {
   "id": "e2",
   "source_id": "7.1.2",
   "source_number": "7.1.2",
   "kind": "exercise",
   "bloom": "Apply",
   "place": {
    "at": "end"
   },
   "cite": "thm-7-1-2",
   "prompt": "<p>Is $\\displaystyle \\sum_{k=0}^\\infty k x^k$ a convergent power series? If so, find the radius of convergence.</p>",
   "answer": {
    "type": "number",
    "generated_by": "ai",
    "value": 1,
    "solution": "Yes, with radius of convergence $\\rho = 1$. Here $\\ka_k = k$, so $A = \\lim_{k\\to\\infty} \\frac{k+1}{k} = 1$ and Theorem 7.1.2 gives $\\rho = 1/A = 1$: the series converges absolutely for $\\lvert x \\rvert &lt; 1$ (for instance at $x = \\frac{1}{2}$), so it is a convergent power series."
   }
  },
  {
   "id": "e3",
   "source_id": "7.1.3",
   "source_number": "7.1.3",
   "kind": "exercise",
   "bloom": "Apply",
   "place": {
    "at": "end"
   },
   "cite": "thm-7-1-2",
   "prompt": "<p>Is $\\displaystyle \\sum_{k=0}^\\infty k! x^k$ a convergent power series? If so, find the radius of convergence.</p>",
   "answer": {
    "type": "choice",
    "generated_by": "ai",
    "options": [
     "Yes",
     "No"
    ],
    "correct": 1,
    "solution": "No, the series is divergent. Here $\\ka_k = k!$, so $\\left\\lvert \\frac{\\ka_{k+1}}{\\ka_k} \\right\\rvert = \\frac{(k+1)!}{k!} = k+1$, and the limit for $A$ diverges to $\\infty$. By Theorem 7.1.2 the series is divergent: it converges only at its center $x = 0$, that is, $\\rho = 0$."
   }
  },
  {
   "id": "e4",
   "source_id": "7.1.4",
   "source_number": "7.1.4",
   "kind": "exercise",
   "bloom": "Apply",
   "place": {
    "at": "end"
   },
   "cite": "thm-7-1-2",
   "prompt": "<p>Is $\\displaystyle \\sum_{k=0}^\\infty \\frac{1}{(2k)!} {(x-10)}^k$ a convergent power series? If so, find the radius of convergence.</p>",
   "answer": {
    "type": "choice",
    "generated_by": "ai",
    "options": [
     "Yes",
     "No"
    ],
    "correct": 0,
    "solution": "Yes, and the radius of convergence is $\\rho = \\infty$. The center is $x_0 = 10$ and $\\ka_k = \\frac{1}{(2k)!}$, so $A = \\lim_{k\\to\\infty} \\frac{(2k)!}{(2k+2)!} = \\lim_{k\\to\\infty} \\frac{1}{(2k+1)(2k+2)} = 0$. By Theorem 7.1.2 the radius of convergence is $\\infty$: the series converges at every $x$."
   }
  },
