 "derivations": [
  {
   "id": "radius-from-ratio-test",
   "what": "the ratio test applied to a power series",
   "source": "Differential Equations for Engineers, 7.1 Power series",
   "nodes": [
    {
     "assumes": [
      {
       "tex": "\\kc_k = \\ka_k {(x - x_0)}^k"
      }
     ],
     "then": {
      "tex": "\\mk{L}{L} = \\lim_{k\\to\\infty} \\left\\lvert \\frac{\\mk{c1}{\\kc_{k+1}}}{\\mk{c0}{\\kc_k}} \\right\\rvert",
      "src": "7.1, ratio test"
     },
     "steps": [
      {
       "tex": "\\mk{L}{L} = \\lim_{k\\to\\infty} \\left\\lvert \\frac{\\mk{a1}{\\ka_{k+1}} \\mk{p1}{{(x - x_0)}^{k+1}}}{\\mk{a0}{\\ka_k} \\mk{p0}{{(x - x_0)}^k}} \\right\\rvert",
       "uses": [
        0
       ],
       "map": {
        "c1": [
         "a1",
         "p1"
        ],
        "c0": [
         "a0",
         "p0"
        ]
       }
      },
      {
       "tex": "\\mk{L}{L} = \\lim_{k\\to\\infty} \\left\\lvert \\frac{\\mk{a1}{\\ka_{k+1}}}{\\mk{a0}{\\ka_k}} \\right\\rvert \\mk{d}{\\lvert x - x_0 \\rvert}",
       "uses": [],
       "map": {
        "p1": "d",
        "p0": "d"
       },
       "cap": "The powers of $(x - x_0)$ cancel to a single factor $\\lvert x - x_0 \\rvert$, which does not depend on $k$ and so comes out of the limit."
      }
     ],
     "src": "7.1"
    }
   ]
  }
