  "derivations": [
    {
      "id": "determinant-of-inverse",
      "what": "the determinant of the inverse",
      "source": "Differential Equations for Engineers, 3.2 Matrices and linear systems",
      "nodes": [
        {
          "assumes": [
            {
              "text": "$\\kA$ and $\\kB$ are inverses of each other, that is, $\\kA\\kB = \\kI$.",
              "src": "3.2, The determinant"
            },
            {
              "tex": "\\det(\\kA\\kB) = \\det(\\kA)\\det(\\kB)",
              "src": "3.2, The determinant"
            },
            {
              "tex": "\\det(\\kI) = 1",
              "src": "3.2, The determinant"
            }
          ],
          "then": {
            "tex": "\\mk{l}{\\det(\\kA)\\det(\\kB)} = \\mk{r}{\\det(\\kA\\kB)}",
            "src": "3.2, The determinant",
            "uses": [
              1
            ]
          },
          "steps": [
            {
              "tex": "\\mk{l}{\\det(\\kA)\\det(\\kB)} = \\mk{r}{\\det(\\kI)}",
              "uses": [
                0
              ]
            },
            {
              "tex": "\\mk{l}{\\det(\\kA)\\det(\\kB)} = \\mk{r}{1}",
              "uses": [
                2
              ],
              "cap": "Expanding $\\det(\\kI)$ along its first row leaves $1$ times the determinant of the next smaller identity matrix, and so on down to $1$."
            }
          ],
          "src": "3.2, The determinant"
        },
        {
          "assumes": [
            {
              "step": 0
            },
            {
              "text": "$\\kB$ is the inverse of $\\kA$, denoted $\\kAinv$.",
              "src": "3.2, Matrix multiplication"
            }
          ],
          "then": {
            "tex": "\\mk{l}{\\det(\\kA)\\det(\\kB)} = \\mk{r}{1}",
            "uses": [
              0
            ]
          },
          "steps": [
            {
              "tex": "\\mk{a}{\\det(\\kA)}\\,\\mk{b}{\\det(\\kAinv)} = \\mk{r}{1}",
              "uses": [
                1
              ],
              "map": {
                "l": [
                  "a",
                  "b"
                ]
              }
            },
            {
              "tex": "\\mk{b}{\\det(\\kAinv)} = \\frac{\\mk{r}{1}}{\\mk{a}{\\det(\\kA)}}",
              "uses": [],
              "cap": "The product is $1$, so $\\det(\\kA)$ is not zero, and we may divide by it."
            }
          ],
          "src": "3.2, The determinant"
        }
      ]
    }
