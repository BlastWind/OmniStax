       "step": 3
      }
     ],
     "then": {
      "tex": "\\mk{f}{\\kf(x)} = \\mk{u}{\\ku(x,0)}",
      "src": "Example 1.9.1",
      "why": "The initial condition says that $u(x, 0)$ is the given $f(x)$."
     },
     "steps": [
      {
       "tex": "\\mk{f}{\\kf(x)} = \\mk{u}{A(x - \\alpha 0)}",
       "uses": [
        0
       ]
      },
      {
       "tex": "\\mk{f}{\\kf(x)} = \\mk{u}{A(x)}",
       "uses": []
      },
