  },
  {
   "id": "evidence-for-quarks",
   "kind": "idea",
   "section": "33.5",
   "name": "夸克存在的证据",
   "statement": "还没有分离出任何夸克，但夸克存在的证据很有力：$\\Omega^{-}$ 正如夸克模型所预言的那样被发现；高能电子从质子内部的三个点状电荷上散射；碰撞还产生由单个夸克形成的粒子喷注。"
  },
  {
   "id": "quark-color-and-confinement",
   "kind": "idea",
   "section": "33.5",
   "name": "夸克的色与禁闭",
   "statement": "每个夸克带有三种色中的一种，强子总是白色的，重子由三种色组合而成，介子由一种色及其反色组合而成。色使处于 $sss$ 等态的夸克服从不相容原理，并解释了为什么单个夸克不能被分离出来。"
  },
  {
   "id": "three-families",
   "kind": "idea",
   "section": "33.5",
   "name": "三代",
   "statement": "轻子、夸克和媒介粒子各自分为三代类似的粒子，即正常的、奇特的和更奇特的，较高代的粒子衰变为第一代的粒子。"
  },
  {
   "id": "up-quark",
   "kind": "definition",
   "section": "33.5",
   "name": "上夸克",
   "terms": [
    "上"
   ],
   "statement": "上夸克是第一代中电荷为 $+\\frac{2}{3}q_{e}$ 的夸克味；质子是 $uud$。"
  },
  {
   "id": "down-quark",
   "kind": "definition",
   "section": "33.5",
   "name": "下夸克",
   "terms": [
    "下"
   ],
   "statement": "下夸克是第一代中电荷为 $-\\frac{1}{3}q_{e}$ 的夸克味；中子是 $udd$。"
  },
  {
   "id": "strange-quark",
   "kind": "definition",
   "section": "33.5",
   "name": "奇夸克",
   "terms": [
    "奇"
   ],
   "statement": "奇夸克是第二代中电荷为 $-\\frac{1}{3}q_{e}$、奇异数为 $-1$ 的夸克味。"
  },
  {
   "id": "charm-quark",
   "kind": "definition",
   "section": "33.5",
   "name": "粲夸克",
   "terms": [
    "粲"
   ],
   "statement": "粲夸克是第二代中电荷为 $+\\frac{2}{3}q_{e}$ 的夸克味。"
  },
  {
   "id": "bottom-quark",
   "kind": "definition",
   "section": "33.5",
   "name": "底夸克",
   "terms": [
    "底"
   ],
   "statement": "底夸克是第三代中电荷为 $-\\frac{1}{3}q_{e}$ 的夸克味。"
  },
  {
   "id": "top-quark",
   "kind": "definition",
   "section": "33.5",
   "name": "顶夸克",
   "terms": [
    "顶"
   ],
   "statement": "顶夸克是第三代中电荷为 $+\\frac{2}{3}q_{e}$ 的夸克味，是远远最重的夸克。"
  },
  {
   "id": "quark-color",
   "kind": "definition",
   "section": "33.5",
   "name": "色",
   "terms": [
    "色"
   ],
   "statement": "色是夸克的一个量子数，有三个值，称为红、绿、蓝，反夸克则带有它们的反色；它与可见光的颜色毫无关系。"
  },
  {
   "id": "quark-confinement",
   "kind": "idea",
   "section": "33.5",
   "name": "夸克禁闭",
   "terms": [
    "夸克禁闭理论"
   ],
   "statement": "夸克禁闭理论认为，夸克之间的力随它们的间距增大而增大，所以单个夸克永远不能被分离出来，夸克只存在于白色的组合中。"
  },
  {
   "id": "quantum-chromodynamics",
   "kind": "idea",
   "section": "33.5",
   "name": "量子色动力学",
   "terms": [
    "量子色动力学"
   ],
   "statement": "量子色动力学是夸克之间强力的理论，这种力由胶子传递，并作用于夸克的色。"
  },
  {
   "id": "electroweak-unification",
   "kind": "idea",
   "section": "33.6",
   "name": "电弱理论",
   "terms": [
    "电弱理论"
   ],
   "statement": "电弱理论统一了电磁力和弱力，表明它们在高能下是同一种力。它在 $W^{\\pm}$ 和 $Z^{0}$ 被发现之前就预言了它们及其质量。"
  },
  {
   "id": "gluons-and-qcd",
   "kind": "idea",
   "section": "33.6",
   "name": "胶子与色",
   "statement": "八种胶子在夸克之间传递强力，并能改变夸克的色。核子之间交换 π 介子，其实质是交换夸克和胶子。"
  },
  {
   "id": "standard-model",
   "kind": "idea",
   "section": "33.6",
   "name": "标准模型",
   "terms": [
    "标准模型"
   ],
   "statement": "标准模型是电弱理论与量子色动力学的结合，是目前关于基本粒子和力的理论，希格斯玻色子是它最后一个被预言的部分。"
  },
  {
   "id": "grand-unified-theories",
   "kind": "idea",
   "section": "33.6",
   "name": "大统一理论",
   "terms": [
    "大统一理论"
   ],
   "statement": "大统一理论把强力与电弱力统一起来。能量越高，探测的距离越小，在极高的能量下各种力的强度趋于一致，这远远超出了任何加速器所能达到的范围。"
  },
  {
   "id": "proton-decay",
   "kind": "result",
   "section": "33.6",
   "name": "质子衰变",
   "statement": "大统一理论预言质子会衰变，如 $p \\to \\pi^{0} + e^{+}$，寿命接近 $10^{31}$ y。质子衰变尚未被观测到，这对这些理论构成了限制。",
   "forms": [
    {
     "id": "eq-proton-decay",
     "latex": "p \\to \\pi^{0} + e^{+}",
     "anchor": "33.6-proton-decay"
    }
   ]
  },
  {
   "id": "higgs-boson",
   "kind": "definition",
   "section": "33.6",
   "name": "希格斯玻色子",
   "terms": [
    "希格斯玻色子"
   ],
   "statement": "希格斯玻色子是标准模型所预言的一种有质量的粒子，用来解释其他粒子为何有质量，并于 2012 年被发现。"
  },
  {
   "id": "particle-decay",
   "kind": "definition",
   "section": "33.4",
   "name": "粒子衰变",
   "terms": [
    "粒子衰变",
    "衰变方式"
   ],
   "statement": "不稳定粒子，如 μ 子、τ 子、K 介子或自由中子，会衰变为较轻的粒子。每种衰变模式都守恒电荷、重子数、轻子数和质能，而驱动衰变的力决定了寿命：通过强力的衰变最快，通过弱力的衰变慢得多。"
  }
