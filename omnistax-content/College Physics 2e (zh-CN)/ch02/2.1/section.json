     },
     {
      "part": "(b)",
      "value": 5,
      "unit": "km",
      "hint": "路程要把路径的每一段都加起来。"
     },
     {
      "part": "(c)",
      "value": 1,
      "unit": "km",
      "hint": "大小舍去正负号。"
     }
