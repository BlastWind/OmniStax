   "id": "adaptive-optics",
   "kind": "idea",
   "section": "26.5",
   "name": "自适应光学",
   "terms": [
    "自适应光学"
   ],
   "statement": "自适应光学是一种光学技术，其中由计算机调整装置的透镜和面镜，以校正像的迅速变化的畸变，例如大气在望远镜中造成的畸变。"
  },
  {
   "id": "chromatic-aberration",
   "kind": "definition",
   "section": "26.6",
   "name": "色差",
   "statement": "色差是透镜的焦距对光的颜色的依赖。由于折射率依赖于波长，单个透镜使紫光聚焦的位置比红光更近。面镜没有色差，而用两种玻璃做成的双合透镜可以部分校正它。"
  },
  {
   "id": "coma-and-spherical-aberration",
   "kind": "definition",
   "section": "26.6",
   "name": "彗差与球差",
   "statement": "彗差是离轴物体发出的光线不能会聚于一点。球差是穿过透镜边缘的光线比靠近其轴的光线聚焦得更近。两者即使在单色光中也会出现。"
  },
  {
   "id": "correcting-aberrations",
   "kind": "idea",
   "section": "26.6",
   "name": "减小像差",
   "statement": "减小像差的办法有：缩小孔径、采用成形的表面、采用由多个元件组成的系统、采用梯度折射率透镜，以及用计算机校正像，其代价是亮度的损失或复杂性的增加。"
  },
  {
   "id": "aberration",
   "kind": "definition",
   "section": "26.6",
   "name": "像差",
   "terms": [
    "像差"
   ],
   "statement": "像差是由于透镜或面镜的局限或缺陷，光线不能会聚于一个焦点。"
  }
 ],
