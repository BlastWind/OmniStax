 "concepts": [
  {
   "id": "eye-as-a-single-thin-lens",
   "kind": "idea",
   "section": "26.1",
   "name": "单个薄透镜式的眼睛",
   "statement": "眼睛的角膜和晶状体可以看作单个薄会聚透镜，它与视网膜相距固定的距离，并在视网膜上形成倒立的实像。于是薄透镜公式就描述了眼睛，而每一种缺陷及其矫正都成了关于这一个透镜的问题。"
  },
  {
   "id": "cornea-supplies-most-of-the-power",
   "kind": "idea",
   "section": "26.1",
   "name": "角膜的光焦度",
   "statement": "折射率变化最大、因而光线弯折最厉害的地方，是光从空气进入角膜之处，所以角膜提供了眼睛约三分之二的光焦度，晶状体提供其余部分。这就是为什么改变角膜的形状可以矫正视力。"
  },
  {
   "id": "accommodation",
   "kind": "definition",
   "section": "26.1",
   "name": "调节",
   "terms": [
    "调节"
   ],
   "statement": "调节是眼睛调整其焦距的能力。由于晶状体到视网膜的距离是固定的，眼睛通过改变其晶状体的光焦度来对不同距离的物体聚焦。"
  },
  {
   "id": "thin-lens-equations-for-the-eye",
   "kind": "result",
   "section": "26.1",
   "name": "眼睛的薄透镜公式",
   "statement": "用光焦度表示，眼睛的薄透镜公式为 $P = 1/d_{\\text{o}} + 1/d_{\\text{i}}$，其中像距固定为晶状体到视网膜的距离，而放大率为 $h_{\\text{i}}/h_{\\text{o}} = -d_{\\text{i}}/d_{\\text{o}}$。",
   "forms": [
    {
     "id": "eq-power-of-the-eye",
     "latex": "P = \\frac{1}{d_{\\text{o}}} + \\frac{1}{d_{\\text{i}}}",
     "ktex": "P = \\frac{1}{\\kdobj} + \\frac{1}{\\kdimg}",
     "anchor": "26.1-thin-lens-equations-for-the-eye"
    },
    {
     "id": "eq-magnification-of-the-eye",
     "latex": "\\frac{h_{\\text{i}}}{h_{\\text{o}}} = -\\frac{d_{\\text{i}}}{d_{\\text{o}}} = m",
     "ktex": "\\frac{\\khimg}{\\khobj} = -\\frac{\\kdimg}{\\kdobj} = m",
     "anchor": "26.1-thin-lens-equations-for-the-eye"
    }
   ]
  },
  {
   "id": "solve-for-an-image-on-the-retina",
   "kind": "skill",
   "section": "26.1",
   "name": "求视网膜上的像",
   "statement": "要求眼睛所需的光焦度或视网膜上像的大小，就把像距取为晶状体到视网膜的距离，把所有距离都用米表示，再应用眼睛的薄透镜公式。",
   "forms": [
    {
     "id": "eq-image-height-on-retina",
     "latex": "h_{\\text{i}} = -h_{\\text{o}} \\cdot \\frac{d_{\\text{i}}}{d_{\\text{o}}}",
     "ktex": "\\khimg = -\\khobj \\cdot \\frac{\\kdimg}{\\kdobj}",
     "anchor": "26.1-thin-lens-equations-for-the-eye"
    }
   ]
  },
  {
   "id": "presbyopia",
   "kind": "definition",
   "section": "26.1",
   "name": "老视",
   "terms": [
    "老视"
   ],
   "statement": "老视是这样一种状况：随着年龄增长，调节能力不断缩小，眼睛的晶状体逐渐无法对靠近观看者的物体聚焦。它是近距离视物时附加光焦度的丧失，而会聚透镜可以提供所缺少的光焦度。"
  },
  {
   "id": "myopia-and-hyperopia",
   "kind": "definition",
   "section": "26.2",
   "name": "近视与远视",
   "statement": "近视是一种视觉缺陷，其中远处的物体显得模糊，因为它们的像聚焦在视网膜之前；眼睛的光焦度过大。远视是这样一种状况：入射光线在会聚成清晰的像之前就到达了视网膜；对于近处的物体，眼睛的光焦度过小。"
  },
  {
   "id": "near-point-and-far-point",
   "kind": "definition",
   "section": "26.2",
   "name": "近点与远点",
   "statement": "远点是未经调节的眼睛在视网膜上成像的物点，通常在无穷远处。近点是在充分调节时，物体能在视网膜上准确聚焦的、离眼睛最近的点，通常在 25 cm 远处。"
  },
  {
   "id": "correct-nearsightedness",
   "kind": "skill",
   "section": "26.2",
   "name": "近视的矫正",
   "statement": "发散透镜通过在人的远点处形成远处物体的像来矫正近视。它的光焦度由薄透镜公式得出，其中像距为负，并从眼镜片量起。"
  },
  {
   "id": "correct-farsightedness",
   "kind": "skill",
   "section": "26.2",
   "name": "远视的矫正",
   "statement": "会聚透镜通过在人的近点处形成近处物体的像来矫正远视，这个像比物体本身更远。两个距离都从眼镜片量起，并让像距取负号。"
  },
  {
   "id": "astigmatism",
   "kind": "definition",
   "section": "26.2",
   "name": "散光",
   "terms": [
    "散光"
   ],
   "statement": "散光是角膜无法将像正确聚焦到视网膜上的结果，即眼睛沿不同轴的光焦度有差别。它用柱面透镜而不是球面透镜来矫正。"
  },
  {
   "id": "powers-of-close-lenses-add",
   "kind": "result",
   "section": "26.2",
   "name": "密接透镜的光焦度",
   "statement": "紧靠在一起的薄透镜的光焦度近似等于各透镜光焦度之和。这使得角膜接触镜、泪膜或改变形状后的角膜都可以看作眼睛光焦度的一个附加量。"
  },
  {
   "id": "laser-vision-correction",
   "kind": "idea",
   "section": "26.2",
   "name": "激光视力矫正",
   "terms": [
    "激光视力矫正"
   ],
   "statement": "激光视力矫正是一种医疗手术，它通过改变角膜的形状来矫正近视、远视和散光，而角膜提供了眼睛的大部分光焦度。激光使用紫外线，角膜对它吸收很强。"
  },
  {
   "id": "myopia",
   "kind": "definition",
   "section": "26.2",
   "name": "近视",
   "terms": [
