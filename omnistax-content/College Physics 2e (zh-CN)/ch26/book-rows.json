  },
  {
   "id": "rods-and-cones",
   "kind": "definition",
   "section": "26.3",
   "name": "视杆细胞和视锥细胞",
   "terms": [
    "视杆细胞和视锥细胞"
   ],
   "statement": "视杆细胞和视锥细胞是人类视网膜中两种光感受器。视杆细胞灵敏而无色，用于弱光下的视觉；视锥细胞在较强的光下起作用，给出颜色和精细的细节，并密集分布在中央凹。"
  },
  {
   "id": "simplified-theory-of-color-vision",
   "kind": "idea",
   "section": "26.3",
   "name": "简化色觉理论",
   "terms": [
    "简化色觉理论"
   ],
   "statement": "简化色觉理论指出，有三种原色，它们对应于三种视锥细胞，每种对不同范围的波长敏感。它解释了三种颜色的光如何能产生成千上万种色调，不过有些证据表明它并不完备。"
  },
  {
   "id": "true-color-of-an-object",
   "kind": "idea",
   "section": "26.3",
   "name": "物体的真实颜色",
   "statement": "物体的真实颜色由它吸收和反射的波长决定，是物体本身的性质，而不是照在它上面的光的性质。由它我们可以预言，有色物体在非白光下看起来是什么样。"
  },
  {
   "id": "color-of-a-light-source",
   "kind": "idea",
   "section": "26.3",
   "name": "光源的颜色",
   "statement": "光源的颜色由它发出的波长谱决定，从激光的尖锐谱线到太阳的宽广光谱。"
  },
  {
   "id": "color-constancy",
   "kind": "definition",
   "section": "26.3",
   "name": "颜色恒常性",
   "terms": [
    "颜色恒常性"
   ],
   "statement": "颜色恒常性是视觉感知系统的一部分，它使人们能在各种条件下一致地感知颜色，所以白色桌布在阳光下和烛光下看起来都是白的。眼睛和大脑通过把物体与其周围环境相比较来做到这一点。"
  },
  {
   "id": "hue",
   "kind": "definition",
   "section": "26.3",
   "name": "色调",
   "terms": [
    "色调"
   ],
   "statement": "一种颜色的色调是它与光谱特定相关的特征，例如红、橙或蓝。"
  },
  {
   "id": "retinex-theory",
   "kind": "idea",
   "section": "26.3",
   "name": "视网膜皮层理论",
   "terms": [
    "视网膜皮层系统",
    "视网膜皮层色觉理论"
   ],
   "statement": "视网膜皮层理论把颜色和亮度的感知及其恒常性解释为视网膜（retina）和皮层（cortex）共同作用的结果，这两个名称合在一起就成了它自己的名称（retinex）。它说明了在环境色背景中感知颜色的能力。"
  },
  {
   "id": "compound-microscope",
   "kind": "definition",
   "section": "26.4",
   "name": "复显微镜",
   "terms": [
    "复式显微镜"
   ],
   "statement": "复显微镜由两个凸透镜构成，即物镜和目镜。物镜形成一个放大的实像，这个像又是目镜的物，目镜像放大镜那样把它进一步放大。"
  },
  {
   "id": "overall-magnification",
   "kind": "result",
   "section": "26.4",
   "name": "总放大率",
   "statement": "由薄透镜和面镜组成的系统的总放大率是其各元件放大率的乘积，$m = m_{\\text{o}}m_{\\text{e}}$，因为每个元件都把送给它的像高乘以一个倍数。",
   "forms": [
    {
     "id": "eq-overall-magnification",
     "latex": "m = m_{\\text{o}} m_{\\text{e}}",
     "anchor": "26.4-compound-microscope"
    }
   ]
  },
  {
   "id": "solve-a-multiple-element-system",
   "kind": "skill",
   "section": "26.4",
   "name": "求解双透镜系统",
   "statement": "要求由两个或更多透镜组成的系统的像和放大率，先找出第一个透镜所成的像，把它到第二个透镜的距离作为第二个透镜的物距，由此求得最终像和总放大率。",
   "forms": [
    {
     "id": "eq-objective-magnification",
     "latex": "m_{\\text{o}} = -\\frac{d_{\\text{i}}}{d_{\\text{o}}}",
     "ktex": "m_{\\text{o}} = -\\frac{\\kdimg}{\\kdobj}",
     "anchor": "26.4-microscope-magnification"
    },
    {
     "id": "eq-objective-image-distance",
     "latex": "\\frac{1}{d_{\\text{i}}} = \\frac{1}{f_{\\text{o}}} - \\frac{1}{d_{\\text{o}}}",
     "ktex": "\\frac{1}{\\kdimg} = \\frac{1}{\\kfobj} - \\frac{1}{\\kdobj}",
     "anchor": "26.4-microscope-magnification"
    },
    {
     "id": "eq-eyepiece-magnification",
     "latex": "m_{\\text{e}} = -\\frac{d_{\\text{i}}'}{d_{\\text{o}}'}",
     "ktex": "m_{\\text{e}} = -\\frac{\\kdimgp}{\\kdobjp}",
     "anchor": "26.4-microscope-magnification"
    }
   ]
  },
  {
   "id": "numerical-aperture",
   "kind": "definition",
   "section": "26.4",
   "name": "数值孔径",
   "symbol": "NA",
   "terms": [
    "数值孔径"
   ],
   "statement": "透镜的数值孔径 $\\text{NA} = n \\sin\\alpha$ 表示它聚集光和分辨精细细节的能力，其中 $n$ 是透镜与标本之间介质的折射率，$\\alpha$ 是接收角的一半。",
   "forms": [
    {
     "id": "eq-numerical-aperture",
     "latex": "\\text{NA} = n \\sin \\alpha",
     "anchor": "26.4-numerical-aperture"
    },
    {
     "id": "eq-numerical-aperture-27",
     "latex": "\\text{NA} = n\\sin\\alpha",
     "section": "27.6",
     "anchor": "27.6-resolving-power"
    }
   ]
  },
  {
   "id": "f-number",
   "kind": "definition",
   "section": "26.4",
   "name": "F 数",
   "statement": "照相机镜头的 $f$ 数是它的焦距除以其孔径的直径，$f/\\# = f/D \\approx 1/(2\\,\\text{NA})$。$f$ 数越小，表示孔径越宽、光越多。",
   "forms": [
    {
     "id": "eq-f-number",
     "latex": "f/\\# = \\frac{f}{D} \\approx \\frac{1}{2\\,\\text{NA}}",
     "ktex": "f/\\# = \\frac{\\kffoc}{\\kD} \\approx \\frac{1}{2\\,\\text{NA}}",
     "anchor": "26.4-f-number"
    }
   ]
  },
