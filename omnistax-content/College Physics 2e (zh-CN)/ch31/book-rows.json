 "concepts": [
  {
   "id": "nuclear-radioactivity",
   "kind": "idea",
   "section": "31.1",
   "name": "放射性",
   "terms": [
    "放射性"
   ],
   "statement": "放射性是某些原子核的自发衰变，它使这些原子核损失一小部分质量，并从核中发射出高能射线。"
  },
  {
   "id": "radiation-is-nuclear-in-origin",
   "kind": "idea",
   "section": "31.1",
   "name": "辐射的核起源",
   "statement": "放射性的射线来自原子核，而不是电子：它们不随化学状态、温度、压强或电离状态而变化，而这些因素都会影响电子；并且每次事件所带的能量约为一百万电子伏，远大于几 eV 的原子能量。"
  },
  {
   "id": "alpha-beta-gamma-rays",
   "kind": "idea",
   "section": "31.1",
   "name": "α 射线、β 射线和 γ 射线",
   "statement": "物理学家在没有人知道这三种核辐射是什么之前就给它们命名了。磁场使 α 射线和 β 射线向相反方向偏转，而对 γ 射线没有影响，这显示出它们的电荷。后来的研究表明，α 粒子是氦核，β 粒子是在衰变瞬间产生的电子，γ 射线是来自原子核的高能光子。"
  },
  {
   "id": "ionizing-radiation",
   "kind": "definition",
   "section": "31.1",
   "name": "电离辐射",
   "terms": [
    "电离辐射"
   ],
   "statement": "电离辐射是使吸收它的物质电离的辐射，无论它是否起源于核。核衰变每次事件发射的能量从几 keV 到超过 10 MeV，而使一个原子电离只需要几 eV，所以这种辐射会损伤组织和电子器件，也能被探测到。"
  },
  {
   "id": "range-of-radiation",
   "kind": "idea",
   "section": "31.1",
   "name": "辐射的射程",
   "terms": [
    "辐射的射程"
   ],
   "statement": "辐射的射程是它穿过某种物质所走的距离。能量越高，辐射的射程越大；电子密度大的物质使辐射的射程变小；在相同能量下，α 粒子最先被阻止，β 粒子走得更远，γ 射线走得最远，因为更大的电荷和更低的速率使粒子更容易电离。"
  },
  {
   "id": "nuclear-radiation",
   "kind": "definition",
   "section": "31.1",
   "name": "核辐射",
   "terms": [
    "核辐射"
   ],
   "statement": "核辐射是起源于原子核的射线，其第一批例子是由贝克勒尔发现的。"
  },
  {
   "id": "radioactive",
   "kind": "definition",
   "section": "31.1",
   "name": "放射性的",
   "terms": [
    "放射性的"
   ],
   "statement": "当一种物质或物体发射核辐射时，它就是放射性的。"
  },
  {
   "id": "alpha-rays",
   "kind": "definition",
   "section": "31.1",
   "name": "α 射线",
   "terms": [
    "α 射线"
   ],
   "statement": "α 射线是一种核辐射，在磁场中像正电荷一样偏转，后来发现它们是氦核。"
  },
  {
   "id": "beta-rays",
   "kind": "definition",
   "section": "31.1",
   "name": "β 射线",
   "terms": [
    "β 射线"
   ],
   "statement": "β 射线是一种核辐射，在磁场中的偏转方向与 α 射线相反，后来发现它们是在衰变瞬间产生的电子。"
  },
  {
   "id": "ionization-energy-to-count",
   "kind": "skill",
   "section": "31.2",
   "name": "离子对的计数",
   "statement": "一个粒子能产生的离子对数目等于它沉积的能量除以产生每个离子对所需的能量，这把核辐射的 MeV 量级能量与一次电离所需的几十 eV 联系起来。"
  },
  {
   "id": "radiation-detection-by-ionization",
   "kind": "idea",
   "section": "31.2",
   "name": "基于电离的探测",
   "statement": "电离辐射无法被直接感知，而每一种辐射探测器，从照相底板到半导体，都是把辐射产生的电离或激发转变为可以看到或测量的东西。"
  },
  {
   "id": "geiger-tube",
   "kind": "idea",
   "section": "31.2",
   "name": "盖革管",
   "terms": [
    "盖革管"
   ],
   "statement": "在盖革管中，圆筒与沿其轴线的导线之间的电压把辐射在气体中产生的离子对扫集起来，计数器把这一短暂的电流记录为一次计数。一次计数并不能给出辐射的能量、电荷或类型。"
  },
  {
   "id": "scintillator-and-photomultiplier",
   "kind": "idea",
   "section": "31.2",
   "name": "闪烁体与光电倍增管",
   "statement": "第二类探测器记录的是光而不是电荷。闪烁体把辐射的能量转换为短暂的闪光，光电倍增管则在一系列倍增极上把每次闪光产生的光电子倍增为与所沉积能量成正比的可测电流。因为输出是成正比的，这些探测器能够分辨能量、电荷和类型，而盖革管做不到。"
  },
  {
   "id": "solid-state-detector",
   "kind": "idea",
   "section": "31.2",
   "name": "固体探测器",
   "terms": [
    "固体辐射探测器"
   ],
   "statement": "一块被制成只有在电离释放其中的电荷时才导电的半导体，其作用就像一个固体盖革管，并且因为它是固体，所以能在很短的距离内阻止辐射，漏掉的粒子很少。其电流与所沉积的能量密切相关，所以这些探测器像闪烁体一样给出精细的信息。"
  },
  {
   "id": "radiation-detector",
   "kind": "definition",
   "section": "31.2",
   "name": "辐射探测器",
   "terms": [
    "辐射探测器"
   ],
   "statement": "辐射探测器是探测和追踪放射性衰变所产生辐射的装置，可以直接探测，也可以通过辐射产生的电离间接探测。"
  },
  {
   "id": "scintillator",
   "kind": "definition",
   "section": "31.2",
   "name": "闪烁体",
   "terms": [
    "闪烁体"
   ],
   "statement": "闪烁体是一种辐射探测器，它记录辐射与其材料相互作用时产生的光。"
  },
  {
   "id": "photomultiplier",
   "kind": "definition",
   "section": "31.2",
   "name": "光电倍增管",
   "terms": [
    "光电倍增管"
   ],
   "statement": "光电倍增管是一种通过使一次闪光产生的光电子倍增而把光转换为电信号的装置。"
  },
  {
   "id": "nucleons",
   "kind": "definition",
   "section": "31.3",
   "name": "核子",
   "terms": [
    "核子"
   ],
   "statement": "核子是在原子核内部发现的粒子，即带正电的质子和电中性的中子，二者质量几乎相同，并且都比电子重得多。"
  },
  {
   "id": "atomic-mass-unit",
   "kind": "definition",
   "section": "31.3",
   "name": "原子质量单位",
   "statement": "原子质量单位的定义使一个中性的 $^{12}$C 原子的质量恰好为 12 u，并且 $1\\;\\text{u} = 1.6605 \\times 10^{-27}$ kg $= 931.5$ MeV/$c^{2}$。以 MeV/$c^{2}$ 为单位的质量乘以 $c^{2}$ 就变为以 MeV 为单位的能量。",
   "forms": [
    {
     "id": "eq-atomic-mass-unit",
     "latex": "1\\;\\text{u} = 1.6605\\times10^{-27}\\;\\text{kg} = 931.5\\;\\text{MeV}/c^{2}",
     "ktex": "1\\;\\text{u} = 1.6605\\times10^{-27}\\;\\text{kg} = 931.5\\;\\text{MeV}/\\kc^{2}",
     "anchor": "31.3-nucleons"
    },
    {
     "id": "eq-proton-rest-energy",
     "latex": "E = mc^{2} = (938.27\\;\\text{MeV}/c^{2})c^{2} = 938.27\\;\\text{MeV}",
     "ktex": "\\kE = mc^{2} = (938.27\\;\\text{MeV}/\\kc^{2})\\kc^{2} = 938.27\\;\\text{MeV}",
     "anchor": "31.3-nucleons"
    }
   ]
  },
  {
   "id": "nuclide-notation",
   "kind": "skill",
   "section": "31.3",
   "name": "核素的写法",
   "statement": "核素写成 ${}^{A}_{Z}\\text{X}_{N}$，质量数 $A$ 在上方，原子序数 $Z$ 在下方，接着是元素符号，中子数 $N$ 在其后，而由于 $A = N + Z$，这几个量中的任何一个都可以由其余的求出。",
   "forms": [
    {
     "id": "eq-nuclide-notation",
     "latex": "{}^{A}_{Z}\\text{X}_{N}",
     "anchor": "31.3-nuclides"
    }
   ]
  },
  {
   "id": "isotopes",
   "kind": "definition",
   "section": "31.3",
   "name": "同位素",
   "terms": [
    "同位素"
   ],
   "statement": "同位素是 $Z$ 相同而 $N$ 不同的原子核，例如氢、氘和氚。它们的化学性质取决于 $Z$，而它们的质量和稳定性取决于整个原子核。"
  },
  {
   "id": "nuclear-radius",
   "kind": "axiom",
   "section": "31.3",
   "name": "核半径",
   "terms": [
    "核半径"
   ],
   "statement": "原子核的半径是 $r = r_0 A^{1/3}$，其中 $r_0 = 1.2$ fm，所以它的体积与核子数 $A$ 成正比。如果核子被紧密堆积到彼此之间没有空隙，就会出现这种情况。",
   "forms": [
    {
     "id": "eq-nuclear-radius",
     "latex": "r = r_0 A^{1/3}",
     "ktex": "\\krnuc = \\kronuc A^{1/3}",
     "anchor": "31.3-nuclear-size"
    }
   ]
  },
  {
   "id": "nuclear-density",
   "kind": "skill",
   "section": "31.3",
   "name": "求核密度",
   "statement": "核物质的密度由 $r = r_0 A^{1/3}$ 和 $A$ u 的质量求得；每个原子核的密度都大致相同，约为水的 $2 \\times 10^{14}$ 倍。",
   "forms": [
    {
     "id": "eq-nuclear-density",
     "latex": "\\rho = \\frac{m}{V} = \\frac{m}{(4/3)\\pi r^{3}}",
     "ktex": "\\krho = \\frac{m}{V} = \\frac{m}{(4/3)\\pi \\krnuc^{3}}",
     "anchor": "31.3-nuclear-density"
    }
   ]
  },
  {
   "id": "strong-and-weak-nuclear-forces",
   "kind": "axiom",
   "section": "31.3",
   "name": "强核力和弱核力",
   "statement": "在原子核中，除库仑力之外还有两种力在起作用：强核力，其吸引作用约比质子之间的电磁排斥力强 100 倍，但在几 fm 之内就降为零；以及弱核力。它们的强度正是核衰变能量如此之大的原因。"
  },
  {
