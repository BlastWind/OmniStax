 "concepts": [
  {
   "id": "atom",
   "kind": "definition",
   "section": "30.1",
   "name": "原子",
   "terms": [
    "原子"
   ],
   "statement": "原子是元素的最小单元，是由带正电的原子核和环绕它的带负电的电子构成的。原子可以再分，但在这一过程中它们会失去自身的特性，而且原子结合起来形成分子，分子是化合物的最小单元。"
  },
  {
   "id": "brownian-motion",
   "kind": "idea",
   "section": "30.1",
   "name": "布朗运动",
   "terms": [
    "布朗运动"
   ],
   "statement": "布朗运动是悬浮在流体中的可见颗粒受到周围看不见的分子不均匀撞击而做的连续无规则运动。它是原子和分子存在的第一个直接证据。"
  },
  {
   "id": "size-of-atoms",
   "kind": "result",
   "section": "30.1",
   "name": "原子的大小",
   "statement": "爱因斯坦的布朗运动理论与佩兰的测量一起，给出原子的大小约为 $10^{-10}$ m。知道了原子的大小，就能得到阿伏伽德罗常量，因为它说明了一定体积中能容纳多少个原子。"
  },
  {
   "id": "cathode-ray-tube",
   "kind": "idea",
   "section": "30.2",
   "name": "阴极射线",
   "statement": "在气体放电管中，从气体中释放出来的电子由阴极加速到阳极，磁体使它们的路径朝着带负电荷所预期的方向弯曲，所以阴极射线是电子流。"
  },
  {
   "id": "electron-charge-to-mass-ratio",
   "kind": "axiom",
   "section": "30.2",
   "name": "电子荷质比",
   "statement": "汤姆孙利用正交的电场和磁场，测出了电子的电荷与质量之比，$\\kqe/m_{\\text{e}} = \\ka/\\kEf = -1.76 \\times 10^{11}$ C/kg。这个比值约为电镀某种材料每千克所需电荷的一千倍，所以电子的质量非常小。",
   "forms": [
    {
     "id": "eq-electron-charge-to-mass",
     "latex": "\\frac{q_{\\text{e}}}{m_{\\text{e}}} = \\frac{a}{E}",
     "ktex": "\\frac{\\kqe}{\\kme} = \\frac{\\ka}{\\kEf}",
     "anchor": "30.2-thomson-charge-to-mass"
    },
    {
     "id": "eq-electron-charge-to-mass-value",
     "latex": "\\frac{q_{\\text{e}}}{m_{\\text{e}}} = -1.76 \\times 10^{11}\\;\\text{C/kg}",
     "ktex": "\\frac{\\kqe}{\\kme} = -1.76 \\times 10^{11}\\;\\text{C/kg}",
     "anchor": "30.2-thomson-charge-to-mass"
    },
    {
     "id": "eq-proton-charge-to-mass-value",
     "latex": "\\frac{q_{\\text{p}}}{m_{\\text{p}}} = 9.58 \\times 10^{7}\\;\\text{C/kg}",
     "ktex": "\\frac{\\kqp}{\\kmp} = 9.58 \\times 10^{7}\\;\\text{C/kg}",
     "anchor": "30.2-thomson-charge-to-mass"
    }
   ]
  },
  {
   "id": "millikan-oil-drop",
   "kind": "idea",
   "section": "30.2",
   "name": "密立根油滴实验",
   "statement": "密立根把一个带电油滴静止地悬在两块板之间，此时电场力与它的重力平衡，由此直接测出了电子的电荷。他发现的每一个电荷都是某一个基本电荷的整数倍。",
   "forms": [
    {
     "id": "eq-millikan-charge",
     "latex": "q = \\frac{m_{\\text{drop}}g}{E} = \\frac{m_{\\text{drop}}gd}{V}",
     "ktex": "\\kq = \\frac{\\kmdrop\\kg}{\\kEf} = \\frac{\\kmdrop\\kg\\kd}{\\kV}",
     "anchor": "30.2-millikan-oil-drop"
    },
    {
     "id": "eq-millikan-balance",
     "latex": "m_{\\text{drop}}g = q_{\\text{e}}E",
     "ktex": "\\kmdrop\\kg = \\kqe\\kEf",
     "anchor": "30.2-millikan-oil-drop"
    }
   ]
  },
  {
   "id": "electron-mass",
   "kind": "result",
   "section": "30.2",
   "name": "电子质量",
   "type": "mass",
   "statement": "由密立根测得的电荷和汤姆孙测得的比值，可以得出电子的质量 $m_{\\text{e}} = 9.11 \\times 10^{-31}$ kg，这是所有有质量的粒子中最小的。质子约重 1836 倍，并且几乎占了氢原子的全部质量。",
   "forms": [
    {
     "id": "eq-electron-mass",
     "latex": "m_{\\text{e}} = 9.11 \\times 10^{-31}\\;\\text{kg}",
     "anchor": "30.2-electron-mass"
    }
   ]
  },
  {
   "id": "identical-particles",
   "kind": "axiom",
   "section": "30.2",
   "name": "全同电子",
   "statement": "每个电子的电荷和质量都完全相同；这些数值并不是许多电子的平均值。这类事实在日常物理学中的沙粒或行星那里找不到对应。"
  },
  {
   "id": "rutherford-scattering",
   "kind": "idea",
   "section": "30.2",
   "name": "卢瑟福散射",
   "statement": "在卢瑟福的金箔实验中，大多数 α 粒子径直穿过金箔，但有少数几乎被原路弹回，只有一个非常小、非常重、带正电的中心才能做到这一点。原子核的直径约为 $10^{-15}$ m，比原子小 100,000 倍。"
  },
  {
   "id": "planetary-model",
   "kind": "idea",
   "section": "30.2",
   "name": "原子的行星模型",
   "terms": [
    "原子的行星模型"
   ],
   "statement": "在原子的行星模型中，质量很小的电子在远大于原子核尺寸的距离上绕着一个小而重的原子核运行，由库仑力束缚，正如行星由重力束缚一样。"
  },
  {
   "id": "cathode-ray-tube-device",
   "kind": "definition",
   "section": "30.2",
   "name": "阴极射线管",
   "terms": [
    "阴极射线管"
   ],
   "statement": "阴极射线管是一种真空管，内有一个电子源和一块荧光屏，电子束在屏上形成一个可见的光点。"
  },
  {
   "id": "discrete-atomic-spectra",
   "kind": "idea",
   "section": "30.3",
   "name": "分立原子光谱",
   "statement": "原子只发射和吸收某些特定的波长，而且每种元素都有自己的一组波长。这些谱线是原子的指纹，它们的分立性意味着原子的能量是量子化的。"
  },
  {
   "id": "hydrogen-spectrum-wavelengths",
   "kind": "axiom",
   "section": "30.3",
   "name": "氢光谱波长",
   "terms": [
    "氢光谱波长"
   ],
   "statement": "氢光谱的每一条谱线都由 $1/\\lambda = R(1/n_{\\text{f}}^2 - 1/n_{\\text{i}}^2)$ 给出。每个线系都终止于一个能级：紫外区的莱曼系是 $n_{\\text{f}} = 1$，延伸到可见光区的巴耳末系是 2，红外区的帕邢系是 3。这个公式在玻尔理论推导出它之前，就已被发现与数据相符。",
   "forms": [
    {
     "id": "eq-hydrogen-wavelengths",
     "latex": "\\frac{1}{\\lambda} = R\\left(\\frac{1}{n_{\\text{f}}^2} - \\frac{1}{n_{\\text{i}}^2}\\right)",
     "ktex": "\\frac{1}{\\klam} = R\\left(\\frac{1}{n_{\\text{f}}^2} - \\frac{1}{n_{\\text{i}}^2}\\right)",
     "anchor": "30.3-mysteries-of-atomic-spectra"
    }
   ]
  },
  {
   "id": "bohr-transition-energy",
   "kind": "axiom",
   "section": "30.3",
   "name": "玻尔跃迁能量",
   "statement": "玻尔提出，原子的轨道是量子化的，电子通过吸收或发射一个光子在轨道之间移动，光子的能量恰好等于两个轨道能量之差，$\\Delta E = hf = E_{\\text{i}} - E_{\\text{f}}$。一组量子化的轨道给出一组量子化的光子，也就是分立光谱。",
   "forms": [
    {
     "id": "eq-bohr-transition",
     "latex": "\\Delta E = hf = E_{\\text{i}} - E_{\\text{f}}",
     "ktex": "\\kdE = h\\kf = \\kEini - \\kEfin",
     "anchor": "30.3-bohr-solution"
    }
   ]
  },
  {
   "id": "energy-level-diagram",
   "kind": "skill",
   "section": "30.3",
   "name": "读能级图",
   "statement": "读和画能级图的方法是：把系统允许的能量竖直地标出，基态在最下面，并把每一次跃迁画成两个能级之间的一个箭头。"
  },
  {
   "id": "bohr-angular-momentum-quantization",
   "kind": "axiom",
   "section": "30.3",
   "name": "玻尔的量子化角动量",
   "statement": "玻尔假设，电子在轨道上的角动量只能取 $h/2\\pi$ 的整数倍，$L = m_{\\text{e}}vr_n = nh/2\\pi$。借助这条规则和圆周运动的物理学，他算出了氢的光谱。",
   "forms": [
    {
     "id": "eq-bohr-angular-momentum",
     "latex": "L = m_{\\text{e}}vr_n = n\\frac{h}{2\\pi}\\;(n = 1, 2, 3, \\ldots)",
     "ktex": "\\kL = \\kme\\kv\\krn = n\\frac{h}{2\\pi}\\;(n = 1, 2, 3, \\ldots)",
     "anchor": "30.3-quantized-angular-momentum"
    }
   ]
  },
  {
   "id": "bohr-orbit-radii",
   "kind": "result",
   "section": "30.3",
   "name": "玻尔轨道半径",
   "type": "position",
   "statement": "令库仑力等于向心力，并用量子化角动量给出的速率，就得到类氢原子每个允许轨道的半径，$r_n = (n^2/Z)a_{\\text{B}}$。半径按 $n^2$ 增长，其中最小的，即玻尔半径，与测得的氢的大小一致。",
   "forms": [
    {
     "id": "eq-bohr-radii",
     "latex": "r_n = \\frac{n^2}{Z}a_{\\text{B}}",
     "ktex": "\\krn = \\frac{n^2}{Z}\\kaB",
     "anchor": "30.3-orbit-radii"
    }
   ]
  },
  {
   "id": "hydrogen-like-energies",
   "kind": "result",
   "section": "30.3",
   "name": "类氢原子的能量",
   "terms": [
    "类氢原子的能量"
   ],
   "type": "energy",
   "statement": "轨道能量是电子的动能与其为负的电势能之和，用玻尔的半径算出，氢的轨道能量为 $-13.6$ eV 除以 $n^2$。能量为负，是因为电子被束缚；随着 $n$ 增大，能量向零靠拢；它们的差值重现了光谱的每一条谱线。同一个公式，带上 $Z^2$，适用于任何被剥得只剩一个电子的原子。",
   "forms": [
    {
     "id": "eq-hydrogen-like-energies",
     "latex": "E_n = -\\frac{Z^2}{n^2}E_0\\;(n = 1, 2, 3, \\ldots)",
     "ktex": "\\kEn = -\\frac{Z^2}{n^2}\\kEobohr\\;(n = 1, 2, 3, \\ldots)",
     "anchor": "30.3-orbital-energies"
    },
    {
     "id": "eq-orbital-energy-sum",
     "latex": "E_n = \\frac{1}{2}m_{\\text{e}}v^2 - k\\frac{Zq_{\\text{e}}^2}{r_n}",
     "ktex": "\\kEn = \\frac{1}{2}\\kme\\kv^2 - k\\frac{Z\\kqe^2}{\\krn}",
     "anchor": "30.3-orbital-energies"
    },
    {
     "id": "eq-ground-state-energy",
     "latex": "E_0 = \\frac{2\\pi^2 q_{\\text{e}}^4 m_{\\text{e}} k^2}{h^2} = 13.6\\;\\text{eV}",
     "ktex": "\\kEobohr = \\frac{2\\pi^2 \\kqe^4 \\kme k^2}{h^2} = 13.6\\;\\text{eV}",
     "anchor": "30.3-orbital-energies"
    },
    {
     "id": "eq-hydrogen-energies",
     "latex": "E_n = -\\frac{13.6\\;\\text{eV}}{n^2}",
     "ktex": "\\kEn = -\\frac{13.6\\;\\text{eV}}{n^2}",
     "anchor": "30.3-orbital-energies"
    }
   ]
  },
  {
   "id": "ionization-energy",
   "kind": "skill",
   "section": "30.3",
   "name": "求电离能",
   "statement": "从能级 $n$ 使一个原子电离所需的能量等于 $E_n$ 的大小，因为处于零能量的电子是自由的：从氢的基态电离需要 13.6 eV，从激发态电离则更少。超出的任何能量都变成被释放电子的动能。"
  },
  {
   "id": "limits-of-bohr-theory",
   "kind": "idea",
   "section": "30.3",
   "name": "玻尔理论的局限",
   "statement": "玻尔理论解释了氢的光谱和大小，并表明轨道能量和角动量是量子化的。但它的轨道是半经典的，虽然量子化了，却仍被想象成圆，而且它无法处理有两个电子的原子，也无法解释双重线。"
  },
  {
   "id": "rydberg-constant",
   "kind": "axiom",
   "section": "30.3",
   "name": "里德伯常量",
   "symbol": "R_ryd",
   "terms": [
    "里德伯常量"
   ],
   "statement": "里德伯常量 $R = 1.097 \\times 10^{7}$ m⁻¹ 是实测常量，它决定了氢光谱波长的尺度。",
   "forms": [
    {
     "id": "eq-rydberg-constant",
     "latex": "R = 1.097 \\times 10^{7}\\;\\text{m}^{-1}",
     "anchor": "30.3-mysteries-of-atomic-spectra"
    }
   ]
  },
  {
   "id": "energy-level-diagram-definition",
   "kind": "definition",
   "section": "30.3",
   "name": "能级图",
   "terms": [
    "能级图"
   ],
   "statement": "能级图是表示原子（或任何系统）中电子所允许能量的图，这些能量画成一条条上下排列的水平线。"
  },
  {
   "id": "bohr-radius",
   "kind": "definition",
   "section": "30.3",
   "name": "玻尔半径",
   "symbol": "a_B",
   "terms": [
    "玻尔半径"
   ],
   "type": "position",
   "statement": "玻尔半径 $a_{\\text{B}} = h^2/4\\pi^2 m_{\\text{e}} k q_{\\text{e}}^2 = 0.529 \\times 10^{-10}$ m 是氢原子的电子在基态时轨道的平均半径。",
   "forms": [
    {
     "id": "eq-bohr-radius",
     "latex": "a_{\\text{B}} = \\frac{h^2}{4\\pi^2 m_{\\text{e}} k q_{\\text{e}}^2} = 0.529 \\times 10^{-10}\\;\\text{m}",
     "ktex": "\\kaB = \\frac{h^2}{4\\pi^2 \\kme k \\kqe^2} = 0.529 \\times 10^{-10}\\;\\text{m}",
     "anchor": "30.3-orbit-radii"
    }
   ]
  },
  {
   "id": "hydrogen-like-atom",
   "kind": "definition",
   "section": "30.3",
   "name": "类氢原子",
   "terms": [
    "类氢原子"
   ],
   "statement": "类氢原子是只有一个电子的任何原子或离子。"
  },
  {
   "id": "atomic-number",
   "kind": "definition",
   "section": "30.3",
   "name": "原子序数",
   "symbol": "Z",
   "terms": [
    "原子序数"
   ],
   "statement": "原子的原子序数 $Z$ 是其原子核中质子的数目。"
  },
  {
   "id": "bremsstrahlung-and-characteristic-x-rays",
   "kind": "idea",
   "section": "30.4",
   "name": "X 射线管的发射",
   "statement": "X 射线管同时产生两种辐射。电子在阳极中减速，给出一条宽而平滑的轫致辐射曲线；而击出内层电子的电子，则给出阳极材料所特有的尖锐峰。"
  },
  {
   "id": "x-ray-maximum-energy",
   "kind": "result",
   "section": "30.4",
   "name": "X 射线的最高能量",
   "type": "energy",
   "statement": "X 射线管所能产生的能量最高的 X 射线，是电子的全部动能变成单个光子的那一种，$E_{\\text{max}} = hf_{\\text{max}} = q_{\\text{e}}V$。100 kV 的管所产生的光子至多为 100 keV。",
   "forms": [
    {
     "id": "eq-x-ray-maximum-energy-30",
     "latex": "E_{\\text{max}} = hf_{\\text{max}} = q_{\\text{e}}V",
     "ktex": "\\kEmax = hf_{\\text{max}} = \\kqe\\kV",
     "anchor": "30.4-x-ray-production"
    }
   ]
  },
  {
   "id": "characteristic-x-ray-energy",
   "kind": "skill",
   "section": "30.4",
   "name": "估算特征 X 射线能量",
   "statement": "特征 X 射线的能量可由类氢能级估算，有效电荷取 $Z - 1$，因为内层电子感受到的几乎是整个原子核。标记指明有空位的壳层和电子来自的壳层：$n = 2$ 到 $n = 1$ 是 $K_\\alpha$，$n = 3$ 到 $n = 1$ 是 $K_\\beta$。",
   "forms": [
    {
     "id": "eq-k-alpha-energy",
     "latex": "E_{K_\\alpha} = \\Delta E = E_{\\text{i}} - E_{\\text{f}} = E_2 - E_1",
     "ktex": "E_{K_\\alpha} = \\kdE = \\kEini - \\kEfin = E_2 - E_1",
     "anchor": "30.4-characteristic-x-ray-energy"
    }
   ]
  },
  {
   "id": "x-ray-imaging",
   "kind": "idea",
   "section": "30.4",
