 "concepts": [
  {
   "id": "electric-potential-energy",
   "kind": "definition",
   "section": "19.1",
   "name": "电势能",
   "symbol": "PE",
   "type": "energy",
   "statement": "静电力或库仑力是保守力，这意味着电场对电荷所做的功与路径无关，与无摩擦时的重力完全一样。当一个力是保守力时，就可以定义与该力相关联的势能，而且处理势能通常比直接计算功更容易，因为势能只取决于位置。保守力所做的功等于势能变化的负值，所以使正电荷从静止开始加速所做的功为正，它来自 PE 的减少。",
   "forms": [
    {
     "id": "eq-work-and-pe",
     "latex": "W = -\\Delta\\text{PE}",
     "ktex": "\\kW = -\\kdPE",
     "anchor": "19.1-electric-potential-energy"
    }
   ]
  },
  {
   "id": "electric-potential",
   "kind": "definition",
   "section": "19.1",
   "name": "电势",
   "symbol": "V_volt",
   "terms": [
    "电势"
   ],
   "type": "voltage",
   "statement": "电势是单位电荷的势能，$V = \\text{PE}/q$。由于电场所做的功，从而势能的变化，与检验电荷成正比，所以对电荷的依赖相互抵消，$V$ 与 $q$ 无关。",
   "forms": [
    {
     "id": "eq-electric-potential",
     "latex": "V = \\frac{\\text{PE}}{q}",
     "ktex": "\\kV = \\frac{\\kPEtot}{\\kq}",
     "anchor": "19.1-electric-potential"
    }
   ]
  },
  {
   "id": "potential-difference",
   "kind": "definition",
   "section": "19.1",
   "name": "电势差",
   "symbol": "ΔV_volt",
   "terms": [
    "电势差（或电压）",
    "电压",
    "电势差"
   ],
   "type": "voltage",
   "statement": "A、B 两点之间的电势差，是电荷从 A 移到 B 时势能的变化除以电荷。它的单位焦耳每库仑就是伏特，以亚历山德罗·伏打命名。电压是电势差的通称，电压总是指两点之间的电势差。电压与能量不同：摩托车蓄电池和汽车蓄电池都可以是 12 V，但其中一个储存的能量比另一个多得多。",
   "forms": [
    {
     "id": "eq-potential-difference",
     "latex": "\\Delta V = V_{\\text{B}} - V_{\\text{A}} = \\frac{\\Delta\\text{PE}}{q}",
     "ktex": "\\kdV = \\kVB - \\kVA = \\frac{\\kdPE}{\\kq}",
     "anchor": "19.1-potential-difference"
    },
    {
     "id": "eq-volt",
     "latex": "1\\ \\text{V} = 1\\ \\frac{\\text{J}}{\\text{C}}",
     "anchor": "19.1-potential-difference"
    }
   ]
  },
  {
   "id": "energy-from-potential-difference",
   "kind": "skill",
   "section": "19.1",
   "name": "由电势差求能量",
   "statement": "电势差与电势能之间的关系可以从两个方向来读：电势差是单位电荷的势能变化，而势能的变化是电荷乘以电势差。要求电池所输送的能量，就用它所移动的电荷乘以它的电压；要求移动了多少电荷，就用能量除以电压。这样求得的能量是绝对值，而失去能量的电池，其势能的变化为负。",
   "forms": [
    {
     "id": "eq-pe-from-voltage",
     "latex": "\\Delta V = \\frac{\\Delta\\text{PE}}{q}\\ \\text{和}\\ \\Delta\\text{PE} = q\\Delta V",
     "ktex": "\\kdV = \\frac{\\kdPE}{\\kq}\\ \\text{和}\\ \\kdPE = \\kq\\kdV",
     "anchor": "19.1-energy-from-voltage"
    }
   ]
  },
  {
   "id": "charge-sign-and-potential",
   "kind": "result",
   "section": "19.1",
   "name": "电荷的运动与电势",
   "statement": "对电子来说的下坡，对正电荷来说就是上坡。电池把电子从其负极排斥开，并把它们吸引到正极，所以负电荷从 A 移到 B 时电势变化为 +12 V，而由于电荷是负的，$\\Delta\\text{PE} = q\\Delta V$ 为负，电池的势能减少了。就电势而言，无论哪种符号的电荷在移动，正极的电压都比负极高。"
  },
  {
   "id": "zero-of-potential",
   "kind": "idea",
   "section": "19.1",
   "name": "电势零点",
   "statement": "你选作零伏的那一点是任意的，正如重力势能的零点是任意的，比如海平面或阶梯教室的地板。每个电池都有两个接线端，其电压就是两个接线端之间的电势差；对单个点所给出的电势，是以某个参考点为前提的，对点电荷通常取无穷远处，对仪表通常取地，而重要的是两点之间的电势差。"
  },
  {
   "id": "electron-volt",
   "kind": "definition",
   "section": "19.1",
   "name": "电子伏",
   "terms": [
    "电子伏"
   ],
   "statement": "在亚微观尺度上，每个粒子的能量只是一焦耳的极小一部分，但它却足以破坏有机分子并伤害活组织，所以这个尺度上的能量单位很方便。电子伏是元电荷经 1 V 的电势差加速后所获得的能量。电子经 50 V 加速获得 50 eV，二价离子经 100 V 加速获得 200 eV。以电子伏为单位的电子能量，在数值上与极板之间的电压相同。",
   "forms": [
    {
     "id": "eq-electron-volt",
     "latex": "1\\ \\text{eV} = (1.60 \\times 10^{-19}\\ \\text{C})(1\\ \\text{V}) = (1.60 \\times 10^{-19}\\ \\text{C})(1\\ \\text{J/C}) = 1.60 \\times 10^{-19}\\ \\text{J}",
     "anchor": "19.1-electron-volt"
    }
   ]
  },
  {
   "id": "energy-conservation-for-charges",
   "kind": "result",
   "section": "19.1",
   "name": "电荷的能量守恒",
   "statement": "如果没有功或热传递对系统增加或带走能量，系统的总能量保持不变。对于静电力这样的保守力，能量守恒表明，机械能，即动能与势能之和，是一个常量。带电粒子 PE 的减少变成它 KE 的增加，这里的 PE 现在是电势能。正如此前许多次那样，能量给人以深入的理解，使问题比跟踪力更容易。",
   "forms": [
    {
     "id": "eq-energy-conservation-charge",
     "latex": "\\text{KE}_{\\text{i}} + \\text{PE}_{\\text{i}} = \\text{KE}_{\\text{f}} + \\text{PE}_{\\text{f}}",
     "ktex": "\\kKEi + \\kPEi = \\kKEf + \\kPEf",
     "condition": "只有保守力",
     "anchor": "19.1-conservation-of-energy"
    },
    {
     "id": "eq-mechanical-energy-constant",
     "latex": "\\text{KE} + \\text{PE} = \\text{常量}",
     "ktex": "\\kKE + \\kPEtot = \\text{常量}",
     "condition": "只有保守力",
     "anchor": "19.1-conservation-of-energy"
    }
   ]
  },
  {
   "id": "speed-from-potential-difference",
   "kind": "skill",
   "section": "19.1",
   "name": "求被加速电荷的速率",
   "statement": "只有保守力作用时，在真空中从静止被加速的电荷，其全部电势能都变为动能，所以由 $qV = mv^2/2$ 可得末速率。电子的末速率很大，证实了重力可以忽略。这也表明，由于电子的质量非常小，很小的电压就能轻易地把它们加速。远高于 100 V 的电压所产生的速率非常大，以至于相对论效应变得重要。",
   "forms": [
    {
     "id": "eq-speed-from-voltage",
     "latex": "v = \\sqrt{\\frac{2qV}{m}}",
     "ktex": "\\kv = \\sqrt{\\frac{2\\kq\\kV}{m}}",
     "condition": "电荷从静止开始被加速，非相对论",
     "anchor": "19.1-ex-electron-speed"
    }
   ]
  },
  {
   "id": "voltage-across-uniform-field",
   "kind": "result",
   "section": "19.2",
   "name": "平行板之间的电压与电场",
   "statement": "在匀强电场中，两点之间的电压等于电场强度乘以它们沿电场方向的距离，$V_\\text{AB} = Ed$，所以电场等于电压除以距离。电场对从正极板移到负极板的正电荷所做的功既是 $qV_\\text{AB}$，也是 $qEd$，电荷相互抵消。",
   "forms": [
    {
     "id": "eq-uniform-field-voltage",
     "latex": "V_{\\text{AB}} = Ed \\quad E = \\frac{V_{\\text{AB}}}{d}",
     "ktex": "\\kVAB = \\kEf\\kd \\quad \\kEf = \\frac{\\kVAB}{\\kd}",
     "condition": "仅限匀强电场",
     "anchor": "19.2-voltage-between-plates"
    },
    {
     "id": "eq-work-in-uniform-field",
     "latex": "W = -\\Delta\\text{PE} = -q\\Delta V = qV_{\\text{AB}}",
     "ktex": "\\kW = -\\kdPE = -\\kq\\kdV = \\kq\\kVAB",
     "anchor": "19.2-voltage-between-plates"
    }
   ]
  },
  {
   "id": "potential-scalar-field-vector",
   "kind": "idea",
   "section": "19.2",
   "name": "电势是标量，电场是矢量",
   "statement": "电势差或电场都可以描述任何电荷分布。电势差与能量联系最紧密，是没有方向的标量，而电场与力联系最紧密，是既有大小又有方向的矢量。当有几个电荷作用时，这一区别就很重要：电压按数值相加，而电场按矢量相加。"
  },
  {
   "id": "volts-per-meter",
   "kind": "result",
   "section": "19.2",
   "name": "电场的单位",
   "statement": "关系式 $E = V_\\text{AB}/d$ 意味着电场的单位是伏特每米，而由电场的定义已知的单位是牛顿每库仑，所以这两者必定是同一个单位。写哪一个取决于电场是从力还是从电压来读；例题 19.5 中电荷所受的力以牛顿为单位，因为 1 V/m 就是 1 N/C。",
   "forms": [
    {
     "id": "eq-field-units",
     "latex": "1\\ \\text{N/C} = 1\\ \\text{V/m}",
     "anchor": "19.2-voltage-between-plates"
    }
   ]
  },
  {
   "id": "dielectric-breakdown-of-air",
   "kind": "idea",
   "section": "19.2",
   "name": "空气的击穿",
   "statement": "干空气能承受的最大电场强度约为 $3.0 \\times 10^6$ V/m。超过这个值，电场会使足够多的空气电离而成为导体，产生放电或火花，从而使电场减小。因此要让火花跳过 2.5 cm 的间隙，大约需要 75 kV，这就限制了导体之间能够存在的电压，例如输电线上的电压。表面上的尖端比光滑表面产生更大的电场，因此在较小的电压下就会产生火花，而潮湿空气在比干空气更低的电场强度下被击穿。"
  },
  {
   "id": "field-is-potential-gradient",
   "kind": "result",
   "section": "19.2",
   "name": "电场是电势的梯度",
   "statement": "一般来说，无论电场是否均匀，它都指向电势降低的方向，因为作用在正电荷上的力既沿着电场方向，又指向较低的电势。电场的大小等于电势随距离的降低率：电势在距离上降低得越快，电场就越大。负号表示电场指向电势降低的方向。对于连续变化的电势，差值变成无穷小量，就需要用到微分学。",
   "forms": [
    {
     "id": "eq-field-gradient",
     "latex": "E = -\\frac{\\Delta V}{\\Delta s}",
     "ktex": "\\kEf = -\\frac{\\kdV}{\\kds}",
     "anchor": "19.2-field-as-gradient"
    }
   ]
  },
  {
   "id": "potential-of-point-charge",
   "kind": "result",
   "section": "19.3",
   "name": "点电荷的电势",
   "statement": "电子这样的点电荷是物质的基本构成单元之一，而球形电荷分布产生的外部电场与点电荷的电场完全一样，所以点电荷的电势至关重要。微积分给出了把检验电荷从很远处移到距点电荷 $r$ 处所需的功。结合 $W = -q\\Delta V$，可知电势为 $kQ/r$，无穷远处的电势为零。负值意味着该电荷会把正电荷从较远处吸引过来，因为那里的电势比较远处的电势低。",
   "forms": [
    {
     "id": "eq-point-charge-potential",
     "latex": "V = \\frac{kQ}{r}",
     "ktex": "\\kV = \\frac{k\\kQch}{\\kr}",
     "condition": "点电荷，无穷远处 V = 0",
     "anchor": "19.3-point-charge-potential"
    }
   ]
  },
  {
   "id": "potential-versus-field-of-point-charge",
   "kind": "idea",
   "section": "19.3",
   "name": "点电荷的电势与电场之比较",
   "statement": "点电荷的电势随距离增大而减小，而点电荷的电场随距离的平方增大而减小，因为电场是单位电荷所受的力，而库仑定律是平方反比定律。两者以两种方式描述同一个电荷，它们衰减快慢的差别，就是单位电荷的能量与单位电荷的力之间的差别：前者在从无穷远处一路移入的整个路径上累积，后者只作用在一点。"
  },
  {
   "id": "superposition-of-potential",
   "kind": "result",
   "section": "19.3",
   "name": "电势的叠加",
   "statement": "要求几个点电荷产生的电压，就把各个电压按数值相加。要求合电场，就把各个电场按矢量相加，同时考虑大小和方向。这与电势对应于能量（标量）、而电场对应于力（矢量）这一事实相符。这使电势在有几个电荷存在时成为更容易处理的量。"
  },
  {
   "id": "sphere-potential-as-point-charge",
   "kind": "result",
   "section": "19.3",
   "name": "带电球外的电势",
   "statement": "金属球上的电荷均匀地分布开来，产生的电场就像位于球心的点电荷的电场。因此球面上和球外的电势，就是球心处等量点电荷的电势，而球面附近的电势取球的半径处的值。这就是范德格拉夫起电机的接线端的电荷和半径决定其电压的原因，也是孤立电荷难以储存的原因：相对较小的电荷就会产生很大的电压。"
  },
  {
   "id": "potential-energy-of-point-charges",
   "kind": "skill",
   "section": "19.3",
   "name": "求两个电荷的电势能",
   "statement": "要求一对点电荷的势能，取其中一个电荷在另一个电荷所在位置产生的电势，再乘以第二个电荷，因为电势是单位电荷的势能。几个电荷组成的系统的能量，是对每一对电荷求和。异号电荷相互吸引，其值为负，同号电荷相互排斥，其值为正。使同号电荷靠近会使它升高，使异号电荷靠近则使它降低。",
   "forms": [
    {
     "id": "eq-potential-energy-of-point-charges",
     "latex": "\\text{PE} = qV = kqQ/r",
     "ktex": "\\kPEtot = \\kq\\kV = k\\kq\\kQch/\\kr"
    }
   ]
  },
  {
   "id": "equipotential-lines",
   "kind": "definition",
   "section": "19.4",
   "name": "等势线与等势面",
   "terms": [
    "等势线"
   ],
   "statement": "你可以把电势形象化，正如用场线把电场形象化。电势恒定的线，在二维中是等势线，在三维中是等势面，等势（equipotential）也可用作名词。点电荷的电势 $kQ/r$ 在围绕该电荷、半径为 $r$ 的球面上任何地方都相同。因此点电荷的等势面是球面，在平面内则是圆。使电荷沿这些线上任何地方移动都不需要做功，而使电荷从一条等势线移到另一条等势线则需要做功。"
  },
  {
   "id": "equipotentials-perpendicular-to-field",
   "kind": "result",
   "section": "19.4",
   "name": "等势线与场线垂直",
