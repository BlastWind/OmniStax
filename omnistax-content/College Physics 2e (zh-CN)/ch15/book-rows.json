 "concepts": [
  {
   "id": "first-law-of-thermodynamics",
   "kind": "axiom",
   "section": "15.1",
   "name": "热力学第一定律",
   "terms": [
    "热力学第一定律"
   ],
   "statement": "第一定律是能量守恒定律在热传递和功作为能量进出系统的方式时最有用的形式。系统内能的变化等于流入系统的净热传递量减去系统所做的净功。正的热传递量为系统增加能量，正的功则从系统取走能量，凡是进入而没有作为功耗掉的，都留在系统中成为内能。",
   "forms": [
    {
     "id": "eq-first-law",
     "latex": "\\Delta E_{\\text{int}} = Q - W",
     "ktex": "\\kdEint = \\kQh - \\kW",
     "anchor": "15.1-first-law"
    }
   ]
  },
  {
   "id": "heat-and-work-sign-convention",
   "kind": "definition",
   "section": "15.1",
   "name": "热量与功的符号约定",
   "statement": "在第一定律中，热传递量在流入系统时为正，功在由系统所做时为正。这一约定之所以重要，是因为同一个物理事件，即热量离开一个物体或对一个物体做功，要带着负号进入方程，而把两种约定混用的读者会发现内能朝错误的方向变化。有些教材按抵抗外部压强来定义功，因而把定律写成带加号的形式；本书不这样做。"
  },
  {
   "id": "heat-and-work-are-energy-in-transit",
   "kind": "idea",
   "section": "15.1",
   "name": "热量和功是传递中的能量",
   "statement": "热传递和做功是把能量带入或带出系统的两种日常方式，它们是不同的过程。热传递由温差驱动，是无组织的；功是作用于一段距离上的宏观力，是有组织的。然而两者可以产生同样的结果：无论是太阳晒热了轮胎，还是打气筒压缩了它，轮胎都会变热，而一旦它的温度升高，就没有任何迹象能说明是哪一种所致。系统并不以其本身的形式储存二者中的任何一种；二者都改变它的内能，而内能是另一类不同的东西。"
  },
  {
   "id": "internal-energy",
   "kind": "definition",
   "section": "15.1",
   "name": "内能",
   "symbol": "ΔE_int",
   "terms": [
    "内能"
   ],
   "type": "energy",
   "statement": "系统的内能是其原子和分子的动能与势能之和，也就是它们的机械能之和。因为没有人能追踪每一个原子，所以本节处理的是平均值和分布，并且在宏观上处理少数几个量，如压强、体积和温度，内能恰好取决于它们。内能就像一个账户，热传递和功向其存入，又从中支取。"
  },
  {
   "id": "internal-energy-is-a-state-function",
   "kind": "axiom",
   "section": "15.1",
   "name": "内能与路径无关",
   "statement": "实验表明，系统的内能只取决于系统的状态，而与它如何到达该状态无关。因此，状态 1 与状态 2 之间内能的变化对两者之间的每一条路径都相同，而热传递量和所做的功则各自取决于所经路径。这使得内能比热量或功更容易处理：只要状态已知，内能的变化就可由少数几个宏观变量得出。",
   "forms": [
    {
     "id": "eq-internal-energy-change",
     "latex": "\\Delta E_{\\text{int}} = E_{\\text{int2}} - E_{\\text{int1}}",
     "ktex": "\\kdEint = \\kEinttwo - \\kEintone",
     "anchor": "15.1-path-independence"
    }
   ]
  },
  {
   "id": "calculate-internal-energy-change",
   "kind": "skill",
   "section": "15.1",
   "name": "求内能的变化",
   "statement": "已知流入和流出系统的热传递量，以及对系统和由系统所做的功，把净热传递量求为流入的热量减去流出的热量，把净功求为系统所做的功减去对系统所做的功；然后由第一定律得出内能的变化。同样的步骤反过来用，可由已知的内能变化和已知的功求出未知的热传递量，如关于人体的问题。"
  },
  {
   "id": "human-metabolism-first-law",
   "kind": "idea",
   "section": "15.1",
   "name": "人体代谢与热力学第一定律",
   "terms": [
    "人体代谢"
   ],
   "statement": "人体代谢是把食物转化为热传递、功和储存的脂肪。以身体为系统，向周围环境的热传递使 Q 为负，身体对外界所做的功使 W 为正，因此身体失去内能。食物以化学势能的形式进入，算作对身体所做的功，它补充了这部分损失。吃得过多使内能的变化为正，身体把多余部分储存为脂肪；吃得过少使其为负，身体就代谢自身的脂肪。身体还表明许多热力学过程是不可逆的：脂肪可以变成功和热，但功和热不能再变回脂肪。"
  },
  {
   "id": "heat-engine",
   "kind": "definition",
   "section": "15.2",
   "name": "热机",
   "terms": [
    "热机"
   ],
   "statement": "热机是利用热传递来做功的机器。汽车发动机和汽轮机都是例子。流入气缸中气体的热传递量使其压强升高，气体推动活塞移动一段距离，对外界做功。要重复这一过程，热量必须离开气体，使其压强下降，活塞才能返回。第一定律支配着每一步，而几个简单的过程是构成每一台热机的基本部分。"
  },
  {
   "id": "isobaric-work",
   "kind": "result",
   "section": "15.2",
   "name": "恒定压强下的功",
   "statement": "气体在恒定压强下对活塞做功的过程是等压过程。活塞所受的力是压强乘以活塞的面积，功是该力乘以活塞移动的距离，而面积乘以距离就是体积的变化，所以所做的功是压强乘以体积的变化。体积的变化为正，意味着气体对外界做了功。如流体各章所指出的，压强是单位体积的能量，在这里其中一部分能量变成了功。",
   "forms": [
    {
     "id": "eq-isobaric-work",
     "latex": "W = P\\Delta V",
     "ktex": "\\kW = \\kPr\\Delta V",
     "condition": "等压过程",
     "anchor": "15.2-pv-diagrams"
    },
    {
     "id": "eq-external-pressure-work",
     "latex": "W = -P_{\\text{ext}}\\Delta V",
     "ktex": "\\kW = -\\kPrext\\Delta V",
     "condition": "等压过程，在按抵抗外部压强来定义功的教材的符号约定下",
     "anchor": "15.2-pv-diagrams"
    }
   ]
  },
  {
   "id": "pv-diagram-work-as-area",
   "kind": "result",
   "section": "15.2",
   "name": "PV 图上以面积表示的功",
   "statement": "压强对体积的图把一个过程表示为一条路径，系统从一个状态到另一个状态所做的功或对系统所做的功，就是这条路径下方的面积。压强恒定时，面积是一个矩形，即压强乘以体积的变化。压强变化时，把面积分成若干窄条，每一条是其平均压强乘以其微小的体积变化，再把它们相加。朝较小体积去的路径具有负的面积，那是对系统所做的功。"
  },
  {
   "id": "work-depends-on-path",
   "kind": "result",
   "section": "15.2",
   "name": "功对路径的依赖",
   "statement": "PV 图上同样两个状态之间的两条路径所围的面积不同，所以沿它们所做的功也不同，沿压强较高的那条路径所做的功更多。这就是第一定律中 Q 和 W 都具有、而内能不具有的路径依赖性，现在被直观地显示出来：端点决定内能的变化，而路径决定其中有多少以功的形式出现。"
  },
  {
   "id": "isochoric-process",
   "kind": "result",
   "section": "15.2",
   "name": "等容过程",
   "terms": [
    "等容过程"
   ],
   "statement": "体积恒定的过程是等容的。体积不变，所以气体不推动活塞，不做功，任何热传递都全部进入内能。在 PV 图上，等容过程是一条竖直的路径，不围成面积。",
   "forms": [
    {
     "id": "eq-isochoric-work",
     "latex": "W = 0",
     "ktex": "\\kW = 0",
     "condition": "等容过程，体积恒定",
     "anchor": "15.2-path-and-cycles"
    }
   ]
  },
  {
   "id": "net-work-of-a-cycle",
   "kind": "result",
   "section": "15.2",
   "name": "循环的净功",
   "statement": "循环过程使系统回到起点，它的净功是它在 PV 图上形成的环路内部的面积。向外各段下方的正面积和返回各段下方的负面积相抵，只剩下内部。沿顺时针方向运行的环路给出正的净功，所以热机向外输出功；沿逆时针方向运行时，同一个环路则输入功。面积往往比沿每一段求功更容易计算，比较不同环路的面积就能看出哪一个过程产生的功最多。"
  },
  {
   "id": "isothermal-process",
   "kind": "result",
   "section": "15.2",
   "name": "等温过程",
   "terms": [
    "等温过程"
   ],
   "statement": "等温过程是温度恒定的过程。对理想气体，PV 此时为常量，而且由于单原子理想气体的内能只取决于温度，它不变，所以流入气体的净热传递量必须等于气体所做的净功：流入的热量刚好补偿所做的功。等温过程本质上是缓慢的，因为热量必须不断流动并在气体中扩散，使任何区域都不比其他区域更热。",
   "forms": [
    {
     "id": "eq-isothermal",
     "latex": "Q = W",
     "ktex": "\\kQh = \\kW",
     "condition": "理想气体的等温过程，温度恒定",
     "anchor": "15.2-isothermal-adiabatic"
    }
   ]
  },
  {
   "id": "adiabatic-process",
   "kind": "result",
   "section": "15.2",
   "name": "绝热过程",
   "terms": [
    "绝热过程"
   ],
   "statement": "绝热过程是不发生热传递的过程，靠极好的隔热，或靠让过程进行得极快，使热量来不及流动而实现。因为 Q 为零，气体所做的功完全来自它的内能，所以绝热膨胀时温度下降，压强也随之下降。因此，从一点出发的绝热路径位于从同一点出发的等温路径下方，沿它所做的功更少。",
   "forms": [
    {
     "id": "eq-adiabatic",
     "latex": "\\Delta E_{\\text{int}} = -W",
     "ktex": "\\kdEint = -\\kW",
     "condition": "绝热过程，没有热传递",
     "anchor": "15.2-isothermal-adiabatic"
    }
   ]
  },
  {
   "id": "internal-energy-monatomic-ideal-gas",
   "kind": "result",
   "section": "15.2",
   "name": "单原子理想气体的内能",
   "statement": "单原子理想气体中一个原子的平均动能是玻尔兹曼常量乘以热力学温度的二分之三倍，而动能是这种气体仅有的内能，所以它的总内能是 N 乘以这个平均值。因此，理想气体的内能只取决于它的温度，这正是等温和绝热论证得以成立的原因。空气等双原子气体的公式则不同。",
   "forms": [
    {
     "id": "eq-internal-energy-monatomic",
     "latex": "E_{\\text{int}} = N\\tfrac{1}{2}m\\bar{v}^2 = \\tfrac{3}{2}NkT",
     "ktex": "\\kEint = N\\tfrac{1}{2}m\\kvb^2 = \\tfrac{3}{2}Nk\\kTemp",
     "condition": "单原子理想气体",
     "anchor": "15.2-isothermal-adiabatic"
    }
   ]
  },
  {
   "id": "reversible-process",
   "kind": "definition",
   "section": "15.2",
   "name": "可逆过程",
   "terms": [
    "可逆过程"
   ],
   "statement": "可逆过程是这样一种过程：系统及其环境都可以沿相反的路径回到原来所处的确切状态。等温过程和绝热过程原则上是可逆的，但实际的宏观过程从来不可逆。任何耗散机制，如摩擦或湍流，在活塞往返的两个方向上都会产生向环境的热传递，而可逆就要求这种热传递反过来。实际过程不能逆转，这指向一条热力学第二定律。"
  },
  {
   "id": "isobaric-process",
   "kind": "definition",
   "section": "15.2",
   "name": "等压过程",
   "terms": [
    "等压过程"
   ],
   "statement": "等压过程是在恒定压强下发生的过程，例如气体抵抗一个使其压强保持不变的活塞而膨胀。"
  },
  {
   "id": "irreversible-process",
   "kind": "definition",
   "section": "15.3",
   "name": "不可逆过程",
   "terms": [
    "不可逆过程"
   ],
   "statement": "不可逆过程是依赖于路径的过程：在给定的一组条件下，它只朝一个方向进行，而其逆向路径在根本上不同。热量由热传向冷，摩擦把动能转化为热，一小团气体在真空室中扩散，都是单向的，而且它们都不违反第一定律，所以必定有别的定律禁止它们的逆过程。这条定律就是热力学第二定律。"
  },
  {
   "id": "second-law-heat-flow-direction",
   "kind": "axiom",
   "section": "15.3",
   "name": "热力学第二定律的第一种表述",
   "statement": "熟悉的热传递方向是第二定律的第一种形式。热传递自发地从温度较高的物体流向温度较低的物体，而从不自发地反向进行；换一种说法，没有任何过程能以热量从较冷的物体传向较热的物体作为其唯一结果。与热物体接触的冷物体绝不会变得更冷。"
  },
  {
   "id": "second-law-no-perfect-engine",
   "kind": "axiom",
   "section": "15.3",
   "name": "热力学第二定律的第二种表述",
   "statement": "在任何系统中，都不可能在系统回到初态的循环过程中，使来自热库的热传递量完全转化为功。因此每一台热机都必须向低温热库排出一些热量；想让输出功等于输入热量、而不向环境损失任何东西的愿望是无法满足的。这是限制每一台热机效率的那种形式的第二定律。"
  },
  {
