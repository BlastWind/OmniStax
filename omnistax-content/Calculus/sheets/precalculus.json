     "$\\begin{array}{rllllrll}{\\text{sin}}^{2}\\theta +{\\text{cos}}^{2}\\theta &amp; = &amp; 1 &amp; &amp; &amp; \\text{sin}(\\text{−}\\;\\theta ) &amp; = &amp; \\text{−}\\text{sin}\\;\\theta \\\\ 1+{\\text{tan}}^{2}\\theta &amp; = &amp; {\\text{sec}}^{2}\\theta &amp; &amp; &amp; \\text{cos}(\\text{−}\\;\\theta ) &amp; = &amp; \\text{cos}\\;\\theta \\\\ 1+{\\text{cot}}^{2}\\theta &amp; = &amp; {\\text{csc}}^{2}\\theta &amp; &amp; &amp; \\text{tan}(\\text{−}\\;\\theta ) &amp; = &amp; \\text{−}\\text{tan}\\;\\theta \\\\ \\text{sin}(\\frac{\\pi}{2}-\\theta ) &amp; = &amp; \\text{cos}\\;\\theta &amp; &amp; &amp; \\text{sin}(\\theta +2\\pi ) &amp; = &amp; \\text{sin}\\;\\theta \\\\ \\text{cos}(\\frac{\\pi}{2}-\\theta ) &amp; = &amp; \\text{sin}\\;\\theta &amp; &amp; &amp; \\text{cos}(\\theta +2\\pi ) &amp; = &amp; \\text{cos}\\;\\theta \\\\ \\text{tan}(\\frac{\\pi}{2}-\\theta ) &amp; = &amp; \\text{cot}\\;\\theta &amp; &amp; &amp; \\text{tan}(\\theta +\\pi ) &amp; = &amp; \\text{tan}\\;\\theta \\end{array}$"
