   "rows": [
    [
     "$\\begin{array}{rllllrllllrll}{x}^{m}{x}^{n} &amp; = &amp; {x}^{m+n} &amp; &amp; &amp; \\frac{{x}^{m}}{{x}^{n}} &amp; = &amp; {x}^{m-n} &amp; &amp; &amp; {({x}^{m})}^{n} &amp; = &amp; {x}^{mn} \\\\ {x}^{\\text{−}n} &amp; = &amp; \\frac{1}{{x}^{n}} &amp; &amp; &amp; {(xy)}^{n} &amp; = &amp; {x}^{n}{y}^{n} &amp; &amp; &amp; {(\\frac{x}{y})}^{n} &amp; = &amp; \\frac{{x}^{n}}{{y}^{n}} \\\\ {x}^{1\\text{/}n} &amp; = &amp; \\sqrt[n]{x} &amp; &amp; &amp; \\sqrt[n]{xy} &amp; = &amp; \\sqrt[n]{x}\\sqrt[n]{y} &amp; &amp; &amp; \\sqrt[n]{\\frac{x}{y}} &amp; = &amp; \\frac{\\sqrt[n]{x}}{\\sqrt[n]{y}} \\\\ {x}^{m\\text{/}n} &amp; = &amp; \\sqrt[n]{{x}^{m}}={(\\sqrt[n]{x})}^{m} &amp; &amp; &amp; &amp; &amp; &amp; &amp; &amp; &amp; &amp; \\end{array}$"
    ]
   ],
   "notes": []
  },
