     "$\\begin{array}{lll}\\text{sin}\\;(x+y) &amp; = &amp; \\text{sin}\\;x\\;\\text{cos}\\;y+\\text{cos}\\;x\\;\\text{sin}\\;y \\\\ \\text{sin}\\;(x-y) &amp; = &amp; \\text{sin}\\;x\\;\\text{cos}\\;y-\\text{cos}\\;x\\;\\text{sin}\\;y \\\\ \\text{cos}\\;(x+y) &amp; = &amp; \\text{cos}\\;x\\;\\text{cos}\\;y-\\text{sin}\\;x\\;\\text{sin}\\;y \\\\ \\text{cos}\\;(x-y) &amp; = &amp; \\text{cos}\\;x\\;\\text{cos}\\;y+\\text{sin}\\;x\\;\\text{sin}\\;y \\\\ \\text{tan}\\;(x+y) &amp; = &amp; \\frac{\\text{tan}\\;x+\\text{tan}y}{1-\\text{tan}\\;x\\;\\text{tan}y} \\\\ \\text{tan}(x-y) &amp; = &amp; \\frac{\\text{tan}\\;x-\\text{tan}y}{1+\\text{tan}\\;x\\;\\text{tan}y}\\end{array}$"
    ]
