   "rows": [
    [
     "${(a+b)}^{n}={a}^{n}+(\\begin{array}{l}n \\\\ 1\\end{array}){a}^{n-1}b+(\\begin{array}{l}n \\\\ 2\\end{array}){a}^{n-2}{b}^{2}+⋯+(\\begin{array}{l}n \\\\ n-1\\end{array})a{b}^{n-1}+{b}^{n},$"
    ],
    [
     "where $(\\begin{array}{l}n \\\\ k\\end{array})=\\frac{n(n-1)(n-2)⋯(n-k+1)}{k(k-1)(k-2)⋯3⋅2⋅1}=\\frac{n!}{k!(n-k)!}$"
    ]
