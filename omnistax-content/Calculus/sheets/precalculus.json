   "rows": [
    [
     "$A=\\text{area},$ $V=\\text{Volume},\\;\\text{and}$ $S=\\text{lateral surface area}$"
    ],
    [
     "$\\text{Parallelogram: } A=bh$"
    ],
    [
     "$\\text{Triangle: } A=\\frac{1}{2}bh$"
    ],
    [
     "$\\text{Trapezoid: } A=\\frac{1}{2}(a+b)h$"
    ],
    [
     "$\\text{Circle: } A=\\pi r^2,\\; C=2\\pi r$"
    ],
    [
     "$\\text{Sector of circle: } A=\\frac{1}{2}r^2\\theta,\\; s=r\\theta\\; (\\theta \\text{ in radians})$"
    ],
    [
     "$\\text{Cylinder: } V=\\pi r^2h,\\; S=2\\pi rh$"
    ],
    [
     "$\\text{Cone: } V=\\frac{1}{3}\\pi r^2h,\\; S=\\pi rl$"
    ],
    [
     "$\\text{Sphere: } V=\\frac{4}{3}\\pi r^3,\\; S=4\\pi r^2$"
    ]
   ],
   "notes": []
  },
